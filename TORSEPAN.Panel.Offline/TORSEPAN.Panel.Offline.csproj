<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
<PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RootNamespace>TORSEPAN.Panel</RootNamespace></PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10"/><PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10"/><ProjectReference Include="../TORSEPAN.Application/TORSEPAN.Application.csproj"/></ItemGroup>
<ItemGroup>
<RazorComponent Include="../TORSEPAN.Panel/Components/**/*.razor" Exclude="../TORSEPAN.Panel/Components/App.razor;../TORSEPAN.Panel/Components/Routes.razor;../TORSEPAN.Panel/Components/Pages/Error.razor;../TORSEPAN.Panel/Components/Pages/NotFound.razor" Link="Components/%(RecursiveDir)%(Filename)%(Extension)"/>
<Content Include="../TORSEPAN.Panel/Components/**/*.razor.css" Link="Components/%(RecursiveDir)%(Filename)%(Extension)"/>
<Compile Include="../TORSEPAN.Panel/Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)"/>
<Compile Include="../TORSEPAN.Panel/Authentication/**/*.cs" Link="Authentication/%(RecursiveDir)%(Filename)%(Extension)"/>
<Compile Include="../TORSEPAN.Panel/Services/**/*.cs" Exclude="../TORSEPAN.Panel/Services/DatabaseBackupRelay.cs;../TORSEPAN.Panel/Services/Auth/AuthStateProvider.cs;../TORSEPAN.Panel/Services/Auth/AuthenticationService.cs;../TORSEPAN.Panel/Services/Api/HandpanPhotoService.cs" Link="Services/Shared/%(RecursiveDir)%(Filename)%(Extension)"/>
<Content Include="../TORSEPAN.Panel/wwwroot/**/*" Exclude="../TORSEPAN.Panel/wwwroot/blazor.web.js;../TORSEPAN.Panel/wwwroot/service-worker*;../TORSEPAN.Panel/wwwroot/connection.js" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../android/app/src/main/assets/offline/model.js" Link="wwwroot/offline-model.js" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../android/app/src/main/assets/offline/workspace.js" Link="wwwroot/offline-workspace.js" CopyToOutputDirectory="PreserveNewest"/>
</ItemGroup></Project>
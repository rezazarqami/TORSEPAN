@inject IServiceProvider LocalServices
@implements IDisposable
@page "/"

@inject ProductionService ProductionService
@inject NavigationManager Navigation
@using System.Net
@using System.Globalization

<PageTitle>TORSEPAN · WORKSHOP</PageTitle>
<div class="workshop-panorama" role="img" aria-label="نمای کارگاه تورسپن در غروب"></div>
<PageHero CssClass="dashboard-hero" HeadingId="dashboard-title" Title="TORSEPAN · WORKSHOP" Description="نمای یکپارچهٔ ورود به عملیات، صف‌های آماده و عملکرد کارگاه">
    <div class="theme-stats dashboard-statistics">
        <span class="theme-stat"><span class="stat-copy"><strong>@(_loading ? "—" : _dashboard.Queues.Count(x=>x.Codes.Count>0).ToString())</strong><small>صف فعال</small></span><ThemeIcon Name="users" /></span>
        <i aria-hidden="true"></i>
        <span class="theme-stat"><span class="stat-copy"><strong>@(_loading ? "—" : _dashboard.Queues.Sum(x=>x.Codes.Count).ToString())</strong><small>کد منتظر</small></span><ThemeIcon Name="clock" /></span>
    </div>
</PageHero>
@if (_loading)
{
    <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <span data-torsepan-startup-ready hidden></span>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error <button class="btn btn-sm btn-outline-danger me-2" @onclick="ReloadAsync">تلاش دوباره</button></div>
    }
    <div class="card shadow-sm mb-3 production-entry-card">
        <div class="card-body">
            <div class="dashboard-section-intro"><span class="entry-accent" aria-hidden="true"></span><h4 class="fw-bold mb-2">ورود به عملیات تولید</h4></div>
            <div class="input-group input-group-lg">
                <input class="form-control" placeholder="کد کاسه یا ساز را وارد کنید"
                       @bind="_productionCode" @bind:event="oninput" @onkeydown="OpenProductionOnEnter" />
                <button class="btn btn-primary px-5" @onclick="OpenProduction">ورود</button>
            </div>
        </div>
    </div>

    <nav class="dashboard-tabs" aria-label="بخش‌های داشبورد">
        <button type="button" class="dashboard-tab @(_activeTab == DashboardTab.Queues ? "active" : "")" aria-current="@(_activeTab == DashboardTab.Queues ? "page" : null)" @onclick="() => _activeTab = DashboardTab.Queues"><span aria-hidden="true"><ThemeIcon Name="layers" /></span><strong>صف‌های تولید</strong></button>
        <button type="button" class="dashboard-tab @(_activeTab == DashboardTab.Calendar ? "active" : "")" aria-current="@(_activeTab == DashboardTab.Calendar ? "page" : null)" @onclick="() => _activeTab = DashboardTab.Calendar"><span aria-hidden="true"><ThemeIcon Name="calendar" /></span><strong>تقویم</strong></button>
        <button type="button" class="dashboard-tab @(_activeTab == DashboardTab.Performance ? "active" : "")" aria-current="@(_activeTab == DashboardTab.Performance ? "page" : null)" @onclick="() => _activeTab = DashboardTab.Performance"><span aria-hidden="true"><ThemeIcon Name="chart" /></span><strong>خلاصه عملکرد کاربران</strong></button>
    </nav>
    <div class="dashboard-sections navy-dashboard-panels">
    @if (_activeTab == DashboardTab.Queues)
    {
    <div class="queue-column">
    <Card>
        <div class="queue-heading">
            <span class="dashboard-eyebrow">جریان کارگاه</span>
            <h4 class="mb-1">صف‌های آماده تولید</h4>
            <p>کد کاسه‌ها و سازهایی که منتظر مرحلهٔ بعد هستند</p>
            <button class="btn btn-outline-primary queue-refresh" @onclick="ReloadAsync"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7a9 9 0 0 0-15-2L2 8m0-6v6h6M4 17a9 9 0 0 0 15 2l3-3m0 6v-6h-6" /></svg>به‌روزرسانی صف‌ها</button>
        </div>

        <div class="ready-queue-list">
            @foreach (var queue in _dashboard.Queues)
            {
                <details class="ready-queue" open>
                    <summary class="ready-queue-summary">
                        <svg class="ready-queue-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="@QueueIconPath(queue.Stage)" /></svg>
                        <strong>@queue.Stage</strong>
                        <span class="ready-queue-count">@queue.Codes.Count</span>
                        <svg class="ready-queue-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </summary>
                    <div class="ready-queue-codes">
                            @if (queue.Codes.Count == 0)
                            {
                                <span class="text-muted">موردی وجود ندارد</span>
                            }
                            else if (queue.Groups.Count > 0)
                            {
                                @foreach (var userGroups in queue.Groups.GroupBy(x => x.UserName))
                                {
                                    <div class="queue-group">
                                        @if(!string.IsNullOrWhiteSpace(userGroups.Key)){<strong class="queue-performer">@userGroups.Key</strong>}
                                        @foreach (var group in userGroups)
                                        {
                                            <div class="queue-code-group">
                                                @if (!string.IsNullOrWhiteSpace(group.BowlTypeLabel))
                                                {
                                                    <span class="queue-type">@group.BowlTypeLabel</span>
                                                }
                                                @foreach (var item in group.Items)
                                                {
                                                    <span class="dashboard-code @(queue.ColorByAge ? AgeClass(item.DaysInStage) : "age-neutral")" title="@(queue.ColorByAge ? AgeTitle(item.DaysInStage) : null)">@item.Code</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="queue-code-list">
                                    @foreach (var item in queue.Items)
                                    {
                                        <span class="dashboard-code @(queue.ColorByAge ? AgeClass(item.DaysInStage) : "age-neutral")" title="@(queue.ColorByAge ? AgeTitle(item.DaysInStage) : null)">@item.Code</span>
                                    }
                                </div>
                            }

                    </div>
                </details>
            }
        </div>
        <section class="hall-stock" aria-labelledby="hall-stock-title">
            <div class="hall-stock-heading">
                <span class="hall-stock-eyebrow">موجودی سالن تولید</span>
                <h5 id="hall-stock-title">جمع کاسه‌ها و سازهای داخل سالن</h5>
                <p>موجودی فعلی صف‌ها تا آماده بسته‌بندی؛ بدون موجودی انبار</p>
            </div>
            @if (_dashboard.HallStock is { } hallStock)
            {
            <dl class="hall-stock-grid">
                <div><dt>کاسه رو</dt><dd>@hallStock.TopBowls.ToString("N0")</dd></div>
                <div><dt>کاسه زیر</dt><dd>@hallStock.BottomBowls.ToString("N0")</dd></div>
                <div class="hall-stock-handpans"><dt>ساز</dt><dd>@hallStock.Handpans.ToString("N0")</dd></div>
            </dl>
            }
            else
            {
                <p class="hall-stock-note">آمار موجودی سالن هنوز دریافت نشده است؛ صف‌ها را به‌روزرسانی کنید.</p>
            }
            <p class="hall-stock-note">هر ساز از اتاق چسب تا آماده بسته‌بندی، یک بار شمرده می‌شود؛ کاسه‌های آن دوباره حساب نمی‌شوند.</p>
        </section>
    </Card>
    </div>
    }
    @if (_activeTab == DashboardTab.Calendar)
    {
    <div>
        <Card>
            <div class="dashboard-panel-heading mb-3"><span class="dashboard-eyebrow">نمای روزانه</span><h4 class="mb-1">تقویم @_dashboard.CurrentPersianMonthTitle</h4><p>برای دیدن عملکرد، یک روز را انتخاب کنید.</p></div>
            <div class="dashboard-calendar" dir="rtl">
                @foreach(var title in WeekTitles){<div class="calendar-weekday">@title</div>}
                @for(var i=0;i<_dashboard.FirstDayOffset;i++){<div></div>}
                @for(var day=1;day<=_dashboard.DaysInMonth;day++)
                {
                    var selectedDay = day;
                    <button class="calendar-day @(day == _dashboard.SelectedPersianDay ? "selected" : "")" disabled="@_dayLoading" @onclick="() => SelectDayAsync(selectedDay)">@day</button>
                }
            </div>
            <div class="daily-performance mt-4">
                <h5 class="mb-2">عملکرد روز @_dashboard.SelectedPersianDay @_dashboard.CurrentPersianMonthTitle</h5>
                @if (_dayLoading)
                { <div class="daily-loading"><span class="spinner-border spinner-border-sm text-success"></span><span>در حال دریافت عملکرد روز...</span></div> }
                else if (_dashboard.DailyUserOperations.Count == 0)
                { <div class="text-center text-muted py-3">در این روز عملیاتی ثبت نشده است.</div> }
                else
                {
                    @foreach(var user in DailyUsers)
                    {
                        <div class="daily-user"><strong>@user.UserName</strong><div class="daily-operation-list">@foreach(var op in user.Operations){<section class="daily-operation"><div class="operation-chip"><span>@op.Operation</span><b>@op.Count</b></div><div class="daily-operation-codes" aria-label="کدهای عملیات @op.Operation">@if(op.Codes.Count == 0){<small>کدها در دسترس نیست</small>}else{@foreach(var operationCode in op.Codes){<bdi dir="ltr">@operationCode</bdi>}}</div></section>}</div></div>
                    }
                }
            </div>
    </Card>
    </div>
    }
    @if (_activeTab == DashboardTab.Performance)
    {
    <div>
        <Card>
            <div class="dashboard-panel-heading mb-3"><span class="dashboard-eyebrow">نمای ماهانه</span><h4 class="mb-1">خلاصه عملکرد کاربران</h4><p>از ابتدای @_dashboard.CurrentPersianMonthTitle تا امروز</p></div>
            @if (_dashboard.MonthlyUserOperations.Count == 0)
            { <div class="text-center text-muted py-4">هنوز عملیاتی در این ماه ثبت نشده است.</div> }
            else
            {
                <div class="table-responsive monthly-table"><table class="table table-sm align-middle mb-0"><thead><tr><th>کاربر</th><th>عملیات</th><th class="text-center">تعداد</th></tr></thead><tbody>
                @foreach(var user in MonthlyUsers){<tr><td class="small fw-semibold">@user.UserName</td><td><div class="operation-list">@foreach(var op in user.Operations){<span class="operation-chip"><span>@op.Operation</span><b>@op.Count</b></span>}</div></td><td class="text-center"><strong>@user.Operations.Sum(x=>x.Count)</strong></td></tr>}
                </tbody></table></div>
            }
    </Card>
    </div>
    }
    </div>
}

@code {
    private enum DashboardTab { Queues, Calendar, Performance }
    private DashboardTab _activeTab = DashboardTab.Queues;
    private bool _loading = true;
    private ProductionDashboardDto _dashboard = new();
    private string _productionCode = string.Empty;
    private string? _error;
    private bool _dayLoading;
    private IEnumerable<UserMonthlyGroup> MonthlyUsers => _dashboard.MonthlyUserOperations.GroupBy(x=>new{x.UserName,x.DisplayOrder}).OrderBy(x=>x.Key.DisplayOrder).ThenBy(x=>x.Key.UserName).Select(x=>new UserMonthlyGroup(x.Key.UserName,x.ToList()));
    private IEnumerable<UserMonthlyGroup> DailyUsers => _dashboard.DailyUserOperations.GroupBy(x=>new{x.UserName,x.DisplayOrder}).OrderBy(x=>x.Key.DisplayOrder).ThenBy(x=>x.Key.UserName).Select(x=>new UserMonthlyGroup(x.Key.UserName,x.ToList()));
    private static readonly string[] WeekTitles = ["ش", "ی", "د", "س", "چ", "پ", "ج"];
    private sealed record UserMonthlyGroup(string UserName,List<MonthlyUserOperationDto> Operations);
    private static string QueueIconPath(string stage) => stage.Contains("دیمپل") ? "M12 3c-3 0-3 4-5 5s-5 2-5 6a5 5 0 0 0 8 4c2 3 7 3 9 0s2-7-1-9c-2-1-3-6-6-6ZM8 11h.01M15 12h.01M12 16h.01" :
        stage.Contains("شیپ") ? "m14 3 7 7-3 3-3-3L6 21l-3-3L14 7l-3-1Z" :
        stage.Contains("پخت") || stage.Contains("کوره") || stage.Contains("حرارت") ? "M12 2c1 6-5 6-3 11-3-1-3-4-3-4-5 7-1 13 6 13s11-9 5-15c0 4-2 5-3 5 2-6-2-10-2-10Z" :
        stage.Contains("تیون") || stage.Contains("کوک") ? "M5 2v6m0 4v10M12 2v12m0 4v4M19 2v3m0 4v13M3 8h4v4H3ZM10 14h4v4h-4ZM17 5h4v4h-4Z" :
        stage.Contains("چسب") ? "m14 3 7 7-6 6-3-3-7 8-2-2 8-7-3-3Z" :
        stage.Contains("بسته") ? "m12 3 9 5-9 5-9-5Zm-9 5v10l9 4 9-4V8M12 13v9M7 5l9 5" : "M4 4h16v16H4ZM8 12l3 3 5-6";
    private static string AgeClass(int days) => days < 3 ? "age-green" : days < 7 ? "age-orange" : days <= 10 ? "age-purple" : "age-red";
    private static string AgeTitle(int days) => $"{days} روز در این مرحله";

    private ILocalDataRefresh? _localRefresh;
    protected override async Task OnInitializedAsync(){_localRefresh=LocalServices.GetService(typeof(ILocalDataRefresh)) as ILocalDataRefresh;if(_localRefresh is not null)_localRefresh.DataChanged+=RefreshCached;await ReloadAsync();}
    private void RefreshCached()=>_ = InvokeAsync(async()=>{await ReloadAsync();StateHasChanged();});
    public void Dispose(){if(_localRefresh is not null)_localRefresh.DataChanged-=RefreshCached;}

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _dashboard = await ProductionService.GetDashboardAsync() ?? new(); }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/login", true); }
        catch
        { _error = "دریافت اطلاعات داشبورد انجام نشد. لطفاً دوباره تلاش کنید."; }
        finally { _loading = false; }
    }

    private async Task SelectDayAsync(int day)
    {
        if (_dayLoading || day == _dashboard.SelectedPersianDay) return;
        _dayLoading = true;
        try
        {
            var date = new PersianCalendar().ToDateTime(_dashboard.PersianYear, _dashboard.PersianMonth, day, 0, 0, 0, 0);
            _dashboard = await ProductionService.GetDashboardAsync(date) ?? new();
        }
        catch { _error = "نمایش عملکرد روز انتخاب‌شده انجام نشد."; }
        finally { _dayLoading = false; }
    }

    private void OpenProduction()
    {
        if (!string.IsNullOrWhiteSpace(_productionCode))
            Navigation.NavigateTo($"/production/process?code={Uri.EscapeDataString(_productionCode.Trim())}");
    }

    private void OpenProductionOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") OpenProduction();
    }
}

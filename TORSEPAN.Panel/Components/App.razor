<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123d62" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TORSEPAN" />
    <base href="/" />

    <link rel="manifest" href="/manifest.webmanifest?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon-v3.png" />

    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TORSEPAN.Panel.styles.css"]" />

    <style>
        #torsepan-startup{position:fixed;inset:0;z-index:1900;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fafafa;color:#173956;direction:ltr}
        #torsepan-startup img{display:block;width:min(80vw,380px);height:auto}
        #torsepan-startup p{margin:-18px 0 0;font:500 16px/1.5 Arial,sans-serif;letter-spacing:2px}
        body:has(#torsepan-startup){overflow:hidden}
    </style>
    <link rel="preload" as="image" href="/images/brand/torsepan-splash.png" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>

    <div id="torsepan-startup" role="status" aria-label="Loading" aria-live="polite">
        <img src="/images/brand/torsepan-splash.png" alt="TORSEPAN" width="432" height="432" />
        <p>Loading</p>
    </div>
    <script src="@Assets["startup.js"]"></script>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <script src="@Assets["login.js"]"></script>
    <script src="@Assets["handpan-photos.js"]"></script>
    <script src="@Assets["reports.js"]"></script>
    <script src="@Assets["pwa-install.js"]"></script>
    <div id="torsepan-connection" role="status" aria-live="polite" hidden style="position:fixed;bottom:16px;left:16px;z-index:2000;background:#fff8e5;color:#633d00;padding:12px 18px;border:1px solid #ecd59c;border-radius:12px;max-width:90vw">
        <span id="torsepan-connection-text">در حال برقراری اتصال…</span>
        <button type="button" id="torsepan-connection-retry">تلاش دوباره</button>
        <button type="button" id="torsepan-connection-reload" hidden>بازکردن مجدد صفحه</button>
    </div>
    <script src="@Assets["workshop-messages.js"]"></script>
    <script src="/blazor.web.js" autostart="false"></script>
    <script src="@Assets["connection.js"]"></script>

</body>

</html>

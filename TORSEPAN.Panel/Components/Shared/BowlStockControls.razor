@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject MaterialService MaterialService

<div class="bowl-stock-inline">
    <div class="compact-field"><label class="form-label">تعداد رو</label><input type="number" min="0" class="form-control" @bind="_top" /></div>
    <div class="compact-field"><label class="form-label">تعداد زیر</label><input type="number" min="0" class="form-control" @bind="_bottom" /></div>
    <div class="compact-actions"><button class="btn btn-outline-primary" disabled="@_saving" @onclick="AddAsync">افزایش</button><button class="btn btn-outline-secondary" disabled="@_saving" @onclick="SetAsync">ثبت دقیق</button></div>
    <div class="compact-separator"></div>
    <div class="compact-field"><label class="form-label text-danger">هشدار رو</label><input type="number" min="0" class="form-control" @bind="_topThreshold" /></div>
    <div class="compact-field"><label class="form-label text-danger">هشدار زیر</label><input type="number" min="0" class="form-control" @bind="_bottomThreshold" /></div>
    <button class="btn btn-outline-danger compact-save" disabled="@_saving" @onclick="SaveThresholdAsync">ثبت هشدار</button>
    <div class="compact-separator"></div>
    <div class="compact-field template-field"><label class="form-label">قالب رو</label><input class="form-control" maxlength="8" placeholder="VT-00000" @bind="_topTemplate" /></div>
    <div class="compact-field template-field"><label class="form-label">قالب زیر</label><input class="form-control" maxlength="8" placeholder="VB-00000" @bind="_bottomTemplate" /></div>
    <button class="btn btn-outline-success compact-save" disabled="@_saving" @onclick="SaveTemplatesAsync">ثبت قالب</button>
    @if (!string.IsNullOrWhiteSpace(_error)) { <small class="text-danger">@_error</small> }
</div>

@code {
    [Parameter, EditorRequired] public MaterialDto Item { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }
    private int _top;
    private int _bottom;
    private int _topThreshold; private int _bottomThreshold; private string _topTemplate="",_bottomTemplate="";
    private bool _saving;
    private string? _error;
    private Guid _loadedItemId;
    protected override void OnParametersSet(){if(_loadedItemId!=Item.Id){_loadedItemId=Item.Id;_topThreshold=Item.TopBowlLowStockThreshold;_bottomThreshold=Item.BottomBowlLowStockThreshold;_topTemplate=Item.TopBowlCodeTemplate;_bottomTemplate=Item.BottomBowlCodeTemplate;}}
    private async Task SaveTemplatesAsync(){_saving=true;_error=null;try{await MaterialService.SetBowlCodeTemplatesAsync(Item.Id,_topTemplate,_bottomTemplate);await OnSaved.InvokeAsync();}catch{_error="قالب باید مانند AB-00000 باشد.";}finally{_saving=false;}}
    private async Task SaveThresholdAsync(){_saving=true;try{await MaterialService.SetLowStockThresholdAsync(Item.Id,0,_topThreshold,_bottomThreshold);await OnSaved.InvokeAsync();}catch{_error="ثبت حد هشدار انجام نشد.";}finally{_saving=false;}}

    private Task AddAsync() => SaveAsync(false);
    private Task SetAsync() => SaveAsync(true);

    private async Task SaveAsync(bool absolute)
    {
        if (_top < 0 || _bottom < 0 || (!absolute && _top == 0 && _bottom == 0))
        {
            _error = "حداقل یکی از تعدادها را وارد کنید.";
            return;
        }
        _saving = true;
        _error = null;
        try
        {
            await MaterialService.AdjustBowlStockAsync(Item.Id, _top, _bottom, absolute);
            await OnSaved.InvokeAsync();
        }
        catch { _error = "ثبت موجودی انجام نشد. لطفاً دوباره وارد حساب مدیر شوید."; }
        finally { _saving = false; }
    }
}

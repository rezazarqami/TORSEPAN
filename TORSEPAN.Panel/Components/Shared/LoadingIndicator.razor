@if (Visible)
{
    <div class="text-center py-5">

        <div class="spinner-border"></div>

        <div class="mt-3 text-secondary">

            @Text

        </div>

    </div>
}

@code {

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Text { get; set; } = "در حال بارگذاری...";

}
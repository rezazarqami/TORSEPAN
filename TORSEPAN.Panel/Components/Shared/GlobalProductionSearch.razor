@inject NavigationManager Navigation
@implements IDisposable
@if (!IsExcluded)
{
    <form class="global-production-search" role="search" aria-label="بررسی مرحلهٔ کاسه یا ساز" @onsubmit="Open" @onsubmit:preventDefault="true">
        <input class="global-production-code" aria-label="کد کاسه یا ساز" placeholder="کد کاسه یا ساز را وارد کنید" @bind="_code" @bind:event="oninput" />
        <button type="submit">بررسی مرحله</button>
    </form>
}
@code {
    private string _code = "";
    private bool IsExcluded => new[] { "", "/dimpling", "/production/process", "/my-activity", "/my-account", "/notifications" }.Contains(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), StringComparer.OrdinalIgnoreCase);
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _code = "";
        _ = InvokeAsync(StateHasChanged);
    }
    private void Open()
    {
        if (!string.IsNullOrWhiteSpace(_code)) Navigation.NavigateTo($"/production/process?code={Uri.EscapeDataString(_code.Trim())}");
    }
    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}

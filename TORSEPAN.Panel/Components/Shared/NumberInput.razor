<div class="mb-3">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label">

            @Label

        </label>
    }

    <InputNumber class="form-control"
                 @bind-Value="Value" />

</div>

@code {

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

}
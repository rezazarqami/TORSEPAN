<div class="card h-100 shadow-sm border-0">

    <div class="card-body">

        <div class="text-secondary mb-2">

            @Title

        </div>

        <div class="fs-5 fw-bold">

            @Value

        </div>

    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

}
<div class="card shadow-sm border-0 mb-4">

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="card-header bg-white fw-bold">

            @Title

        </div>
    }

    <div class="card-body">

        @ChildContent

    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
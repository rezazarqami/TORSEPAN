<div class="card border-0 shadow-sm h-100">

    <div class="card-body">

        <div class="text-secondary small">

            @Title

        </div>

        <div class="fs-4 fw-bold mt-2">

            @Value

        </div>

    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

}
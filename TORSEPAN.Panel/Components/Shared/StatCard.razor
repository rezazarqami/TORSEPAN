<div class="card shadow-sm border-0 h-100">

    <div class="card-body">

        <div class="text-secondary small">

            @Title

        </div>

        <h2 class="fw-bold mt-2 mb-0">

            @Value

        </h2>

    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

}
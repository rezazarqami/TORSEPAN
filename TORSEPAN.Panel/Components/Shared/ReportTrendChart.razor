@if(Points.Count>0){<div class="trend-chart"><div class="trend-head"><div><h3>@Title</h3><small>مقایسه شش ماه اخیر با میانگین</small></div><span>میانگین @Points.Last().Average.ToString("N1")</span></div><div class="bars">@foreach(var p in Points){<div class="bar-column"><b>@p.Count</b><div class="bar-track"><i style="height:@Height(p.Count)%"></i><u style="bottom:@Height(p.Average)%"></u></div><small>@p.Label</small></div>}</div></div>}
@code{[Parameter]public IReadOnlyList<ReportTrendDto> Points{get;set;}=[];[Parameter]public string Title{get;set;}="روند ماهانه";private double Max=>Math.Max(1,Points.Select(x=>Math.Max(x.Count,x.Average)).DefaultIfEmpty(1).Max());private string Height(double value)=>Math.Max(2,value/Max*100).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture);}

@inject PersonalWorkspaceService Workspace
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable
<a class="notification-bell" href="/notifications" title="مدیریت پیام‌ها" aria-label="@Label">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
    @if(Workspace.UnreadCount>0){<span class="unread-count">@(Workspace.UnreadCount>99?"99+":Workspace.UnreadCount.ToString())</span>}
    @if(Workspace.UnreadCount is null){<span class="unavailable" title="شمارنده پیام‌ها در دسترس نیست">•</span>}
</a>
@code{
    private bool _disposed,_loading;
    private readonly CancellationTokenSource _pollCancellation = new();
    private string Label=>Workspace.UnreadCount.HasValue?$"پیام‌ها؛ {Workspace.UnreadCount} خوانده‌نشده":"پیام‌ها؛ شمارنده در دسترس نیست";
    protected override async Task OnInitializedAsync(){Workspace.UnreadChanged+=Changed;Workspace.IncomingMessagesChanged+=Incoming;Navigation.LocationChanged+=LocationChanged;await Load();}
    private async Task Load(){if(_loading||_disposed)return;_loading=true;try{await Workspace.RefreshUnreadAsync();}finally{_loading=false;}}
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ = PollAsync();
        try { await Workspace.ConfigureAlertsAsync(JS); } catch { }
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try { while (await timer.WaitForNextTickAsync(_pollCancellation.Token)) await InvokeAsync(Load); }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }
    private void Incoming(Guid user, long total)
    {
        if (!_disposed) _ = InvokeAsync(async () =>
        {
            try { await JS.InvokeVoidAsync("workshopMessages.playIncoming", user.ToString(), total); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (TaskCanceledException) { }
        });
    }
    private void Changed(){if(!_disposed)_=InvokeAsync(StateHasChanged);}
    private async void LocationChanged(object? sender,LocationChangedEventArgs e){try{await InvokeAsync(Load);}catch{}}
    public void Dispose(){if(_disposed)return;_disposed=true;_pollCancellation.Cancel();_pollCancellation.Dispose();Workspace.UnreadChanged-=Changed;Workspace.IncomingMessagesChanged-=Incoming;Navigation.LocationChanged-=LocationChanged;}
}

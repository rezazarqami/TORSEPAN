@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject MaterialService MaterialService

<div class="other-stock-inline">
    <div class="input-group stock-adjust-group">
        <input type="number" min="0" class="form-control" @bind="_quantity" />
        <button class="btn btn-outline-primary" disabled="@_saving" @onclick="AddAsync">افزایش</button>
        <button class="btn btn-outline-secondary" disabled="@_saving" @onclick="SetAsync">ثبت دقیق</button>
    </div>
    <div class="input-group threshold-group"><span class="input-group-text">حد هشدار</span><input type="number" min="0" class="form-control" @bind="_threshold" />
    <button class="btn btn-outline-danger" disabled="@_saving" @onclick="SaveThresholdAsync">ثبت</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_error)) { <small class="text-danger">@_error</small> }
</div>

@code {
    [Parameter, EditorRequired] public MaterialDto Item { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private int _quantity = 1;
    private int _threshold;
    private bool _saving;
    private string? _error;
    private Guid _loadedItemId;
    protected override void OnParametersSet(){if(_loadedItemId!=Item.Id){_loadedItemId=Item.Id;_threshold=Item.LowStockThreshold;}}
    private async Task SaveThresholdAsync(){ _saving=true; try { await MaterialService.SetLowStockThresholdAsync(Item.Id,_threshold,0,0); await OnSaved.InvokeAsync(); } catch { _error="ثبت حد هشدار انجام نشد."; } finally {_saving=false;} }

    private async Task AddAsync() => await SaveAsync(false);
    private async Task SetAsync() => await SaveAsync(true);

    private async Task SaveAsync(bool absolute)
    {
        if (_quantity < 0 || (!absolute && _quantity == 0))
        {
            _error = "تعداد معتبر وارد کنید.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            if (absolute)
                await MaterialService.SetStockAsync(Item.Id, _quantity);
            else
                await MaterialService.AddStockAsync(Item.Id, _quantity);
            await OnSaved.InvokeAsync();
        }
        catch
        {
            _error = "ثبت موجودی انجام نشد.";
        }
        finally
        {
            _saving = false;
        }
    }
}

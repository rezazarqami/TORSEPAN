<div class="mb-4">

    <InputText class="form-control"
               placeholder="@Placeholder"
               @bind-Value="Value" />

</div>

@code {

    [Parameter]
    public string Placeholder { get; set; } = "جستجو...";

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

}
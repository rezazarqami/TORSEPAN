<div class="d-flex justify-content-between align-items-center py-2 border-bottom">

    <strong>

        @Label

    </strong>

    <span>

        @Value

    </span>

</div>

@code {

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

}
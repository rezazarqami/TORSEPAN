@if (IsOpen)
{
    <div class="app-confirm-overlay" @onclick="CancelAsync">
        <section class="app-confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="@_titleId" aria-describedby="@_messageId" @onclick:stopPropagation="true">
            <div class="app-confirm-mark" aria-hidden="true">↩</div>
            <div class="app-confirm-heading">
                <small>تأیید عملیات</small>
                <h3 id="@_titleId">@Title</h3>
            </div>
            <p id="@_messageId">@Message</p>
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="app-confirm-error" role="alert">@Error</div>
            }
            <footer>
                <button type="button" class="btn app-confirm-cancel" disabled="@Busy" @onclick="CancelAsync">انصراف</button>
                <button type="button" class="btn app-confirm-submit" disabled="@Busy" @onclick="ConfirmAsync">
                    @if (Busy)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>در حال انجام…</span>
                    }
                    else
                    {
                        <span>@ConfirmText</span>
                    }
                </button>
            </footer>
        </section>
    </div>
}

@code {
    private readonly string _titleId = $"app-confirm-title-{Guid.NewGuid():N}";
    private readonly string _messageId = $"app-confirm-message-{Guid.NewGuid():N}";

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = "تأیید عملیات";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "تأیید";
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task ConfirmAsync() => Busy ? Task.CompletedTask : OnConfirm.InvokeAsync();
    private Task CancelAsync() => Busy ? Task.CompletedTask : OnCancel.InvokeAsync();
}

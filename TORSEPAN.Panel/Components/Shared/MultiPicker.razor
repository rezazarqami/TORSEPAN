<div class="multi-picker"><span>@Title</span><details><summary>@Summary</summary><div class="picker-menu">@foreach(var item in Items){<label><input type="checkbox" checked="@Selected.Contains(item.Id)" @onchange="()=>OnToggle.InvokeAsync(item.Id)" /><span>@item.Name</span></label>}</div></details></div>
@code{[Parameter]public string Title{get;set;}="";[Parameter]public IEnumerable<PickerItem> Items{get;set;}=[];[Parameter]public IReadOnlySet<Guid> Selected{get;set;}=new HashSet<Guid>();[Parameter]public EventCallback<Guid> OnToggle{get;set;}private string Summary=>Selected.Count==0?"همه موارد":$"{Selected.Count} مورد انتخاب شده";}

@using Microsoft.AspNetCore.Components.Forms
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject HandpanPhotoService PhotoService
@inject IJSRuntime JS

<section class="photo-gallery">
    @if (_loading) { <div class="gallery-empty"><div class="spinner-border spinner-border-sm"></div></div> }
    else if (_photos.Count == 0) { <div class="gallery-empty"><span>📷</span><small>بدون عکس</small></div> }
    else
    {
        <button type="button" class="gallery-main" title="نمایش بزرگ عکس" @onclick="OpenPreview">@if(_mainUrl is not null){<img src="@_mainUrl" alt="عکس ساز" />}<span class="gallery-zoom-hint">⛶</span></button>
        <div class="gallery-thumbs">
            @foreach(var photo in _photos)
            {
                <button type="button" class="gallery-thumb @(photo.Id==_selectedId?"selected":"")" @onclick="()=>SelectAsync(photo.Id)">
                    @if(_thumbs.TryGetValue(photo.Id,out var url)){<img src="@url" alt="تصویر کوچک ساز" />}
                    <span class="photo-delete" title="حذف عکس" @onclick:stopPropagation @onclick="()=>DeleteAsync(photo)">×</span>
                </button>
            }
        </div>
    }
    <div class="gallery-upload-actions">
        <label class="gallery-action @(Uploading?"disabled":"")" title="گرفتن عکس با دوربین">
            <span>📷</span> @(Uploading ? "ثبت..." : "دوربین")
            <InputFile id="@CameraInputId" class="d-none" OnChange="UploadCameraAsync" accept="image/*" capture="environment" disabled="@Uploading" />
        </label>
        <label class="gallery-action @(Uploading?"disabled":"")" title="انتخاب از گالری">
            <span>🖼️</span> گالری
            <InputFile id="@GalleryInputId" class="d-none" OnChange="UploadGalleryAsync" multiple accept="image/jpeg,image/png,image/webp" disabled="@Uploading" />
        </label>
    </div>
    @if(!string.IsNullOrWhiteSpace(_error)){<div class="text-danger small mt-2">@_error</div>}
</section>
@if(_showPreview && _mainUrl is not null)
{
    <div class="photo-preview-backdrop" role="presentation" @onclick="ClosePreview">
        <div class="photo-preview-dialog" role="dialog" aria-modal="true" aria-label="نمایش بزرگ عکس ساز" @onclick:stopPropagation>
            <button type="button" class="photo-preview-close" title="بستن" @onclick="ClosePreview">×</button>
            <img src="@_mainUrl" alt="نمایش بزرگ عکس ساز" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid HandpanId { get; set; }
    private readonly Dictionary<Guid,string> _thumbs=[]; private List<HandpanPhotoDto> _photos=[];
    private Guid _loadedId,_selectedId; private string? _mainUrl,_error; private bool _loading,Uploading,_showPreview;
    private string GalleryInputId => $"handpan-photo-gallery-{HandpanId:N}";
    private string CameraInputId => $"handpan-photo-camera-{HandpanId:N}";
    protected override async Task OnParametersSetAsync(){if(HandpanId==Guid.Empty||HandpanId==_loadedId)return;_loadedId=HandpanId;await LoadAsync();}
    private async Task LoadAsync(){_loading=true;try{_photos=await PhotoService.ListAsync(HandpanId);_thumbs.Clear();foreach(var p in _photos)_thumbs[p.Id]=await PhotoService.DataUrlAsync(HandpanId,p.Id,true);if(_photos.Count>0)await SelectAsync(_photos[0].Id);}catch{_error="بارگذاری عکس‌ها انجام نشد.";}finally{_loading=false;}}
    private async Task SelectAsync(Guid id){_selectedId=id;_mainUrl=await PhotoService.DataUrlAsync(HandpanId,id,false);}
    private void OpenPreview()=>_showPreview=true;
    private void ClosePreview()=>_showPreview=false;
    private Task UploadGalleryAsync(InputFileChangeEventArgs _) => OptimizeAndUploadAsync(GalleryInputId,8);
    private Task UploadCameraAsync(InputFileChangeEventArgs _) => OptimizeAndUploadAsync(CameraInputId,1);
    private async Task OptimizeAndUploadAsync(string inputId,int limit){Uploading=true;_error=null;try{var files=await JS.InvokeAsync<List<OptimizedPhoto>>("handpanPhotos.optimize",inputId);foreach(var file in files.Take(limit))await PhotoService.UploadAsync(HandpanId,file.Image,file.Thumbnail,file.Name);await LoadAsync();if(_photos.Count>0)await SelectAsync(_photos[^1].Id);}catch(Exception){_error="ثبت عکس انجام نشد؛ لطفاً دوباره امتحان کنید.";}finally{Uploading=false;}}
    private async Task DeleteAsync(HandpanPhotoDto photo){if(!await JS.InvokeAsync<bool>("confirm","این عکس حذف شود؟"))return;await PhotoService.DeleteAsync(HandpanId,photo.Id);_photos.Remove(photo);_thumbs.Remove(photo.Id);if(_selectedId==photo.Id){_mainUrl=null;if(_photos.Count>0)await SelectAsync(_photos[0].Id);}}
    private sealed class OptimizedPhoto { public string Name { get; set; }="photo"; public byte[] Image { get; set; }=[]; public byte[] Thumbnail { get; set; }=[]; }
}

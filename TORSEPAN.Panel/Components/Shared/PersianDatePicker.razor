@using System.Globalization
<div class="position-relative"><button type="button" class="form-control text-start" @onclick="Toggle">@(Value.HasValue ? Format(Value.Value) : "انتخاب تاریخ")</button>
@if(_open){<div class="position-absolute bg-white border rounded shadow p-3 mt-1" style="z-index:1050;width:300px;right:0"><div class="d-flex justify-content-between align-items-center mb-2"><button class="btn btn-sm btn-light" @onclick="Previous">‹</button><strong>@MonthNames[_month-1] @_year</strong><button class="btn btn-sm btn-light" @onclick="Next">›</button></div><div class="d-grid gap-1" style="grid-template-columns:repeat(7,1fr)">@for(var i=0;i<_leading;i++){<span></span>}@for(var day=1;day<=_days;day++){var d=day;<button type="button" class="btn btn-sm btn-light" @onclick="() => Select(d)">@d</button>}</div><button class="btn btn-sm btn-link text-danger mt-2" @onclick="Clear">پاک‌کردن</button></div>}</div>
@code { private static readonly PersianCalendar Calendar=new(); private static readonly string[] MonthNames=["فروردین","اردیبهشت","خرداد","تیر","مرداد","شهریور","مهر","آبان","آذر","دی","بهمن","اسفند"];
[Parameter] public DateTime? Value{get;set;} [Parameter] public EventCallback<DateTime?> ValueChanged{get;set;} private bool _open;private int _year,_month,_days,_leading;
protected override void OnInitialized(){var d=Value??DateTime.Today;_year=Calendar.GetYear(d);_month=Calendar.GetMonth(d);Refresh();} private void Toggle()=>_open=!_open; private void Previous(){if(--_month<1){_month=12;_year--;}Refresh();} private void Next(){if(++_month>12){_month=1;_year++;}Refresh();} private void Refresh(){_days=Calendar.GetDaysInMonth(_year,_month);var f=Calendar.ToDateTime(_year,_month,1,0,0,0,0);_leading=((int)f.DayOfWeek+1)%7;} private async Task Select(int d){_open=false;await ValueChanged.InvokeAsync(Calendar.ToDateTime(_year,_month,d,0,0,0,0));} private async Task Clear(){_open=false;await ValueChanged.InvokeAsync(null);} public static string Format(DateTime d)=>$"{Calendar.GetYear(d):0000}/{Calendar.GetMonth(d):00}/{Calendar.GetDayOfMonth(d):00}"; }

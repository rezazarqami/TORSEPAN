<PageHero CssClass="theme-page-intro" HeadingId="@HeadingId" Title="@Title" Description="@SubTitle" Eyebrow="TORSEPAN · WORKSHOP">
    @if (Actions is not null)
    {
        <div class="theme-page-actions">@Actions</div>
    }
</PageHero>

@code {
    private readonly string HeadingId = "page-title-" + Guid.NewGuid().ToString("N");
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SubTitle { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
}

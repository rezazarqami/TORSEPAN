<label class="sale-money-label" for="@Id">@Label <small>اختیاری</small></label>
<div class="sale-money-input">
    <input id="@Id" type="number" min="0" step="@(Currency==2?"0.01":"1")" inputmode="decimal" value="@(Amount?.ToString(System.Globalization.CultureInfo.InvariantCulture))" @onchange="ChangeAmount" placeholder="مبلغ" />
    <select aria-label="ارز @Label" value="@Currency" @onchange="ChangeCurrency"><option value="1">تومان</option><option value="2">دلار (USD)</option></select>
</div>
@code{
 [Parameter]public string Id{get;set;}="money";[Parameter]public string Label{get;set;}="مبلغ";
 [Parameter]public decimal? Amount{get;set;}[Parameter]public EventCallback<decimal?> AmountChanged{get;set;}
 [Parameter]public int Currency{get;set;}=1;[Parameter]public EventCallback<int> CurrencyChanged{get;set;}
 private Task ChangeAmount(ChangeEventArgs e)=>AmountChanged.InvokeAsync(decimal.TryParse(e.Value?.ToString(),System.Globalization.NumberStyles.Number,System.Globalization.CultureInfo.InvariantCulture,out var n)?n:null);
 private Task ChangeCurrency(ChangeEventArgs e)=>CurrencyChanged.InvokeAsync(int.TryParse(e.Value?.ToString(),out var c)?c:1);
}

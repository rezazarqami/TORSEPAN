@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@implements IDisposable

<div class="topbar-left">
    <img class="topbar-brandmark" src="/images/brand/torsepan-mark-new.webp" alt="TORSEPAN" />
    <div class="topbar-title-block">
        <div class="page-title"><span class="page-title-main">سامانه مدیریت تولید</span><span class="page-title-brand">TORSEPAN</span></div>
        <div class="page-subtitle">مدیریت هوشمند کارگاه ساخت هنگدرام</div>
    </div>
</div>

<div class="topbar-right">
    <a class="dashboard-button" href="/" title="بازگشت به داشبورد" aria-label="داشبورد"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11.2 12 3l9 8.2v9.3a.5.5 0 0 1-.5.5h-5.8v-6.4H9.3V21H3.5a.5.5 0 0 1-.5-.5z"/></svg></span><b>داشبورد</b></a>
    <button type="button" class="install-app-button" title="افزودن برنامه به صفحه اصلی" aria-label="افزودن برنامه به صفحه اصلی" @onclick="InstallAppAsync">
        <span class="install-app-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M9.5 5h5M12 8v7m0 0-2.7-2.7M12 15l2.7-2.7M10 18.5h4"/></svg></span>
        <b>نصب روی گوشی</b>
    </button>
    <div class="header-notification"><NotificationBell /></div>
    <div class="user-box user-box-clean">
        <div><div class="user-name">@DisplayName</div><div class="user-role">@UserTitle</div></div>
    </div>
</div>

@code {
    private string DisplayName { get; set; } = "کاربر";
    private string UserTitle { get; set; } = "همکار TORSEPAN";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += AuthenticationStateChanged;
        SetUser((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
    }

    private void SetUser(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true) return;
        DisplayName = user.FindFirst("FullName")?.Value ?? user.FindFirst(ClaimTypes.GivenName)?.Value ?? user.Identity?.Name ?? "کاربر";
        var customTitle = user.FindFirst("Title")?.Value;
        UserTitle = !string.IsNullOrWhiteSpace(customTitle) ? customTitle : ResolveRoleTitle(user.FindAll(ClaimTypes.Role).Select(x => x.Value));
    }

    private async void AuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        try { SetUser((await stateTask).User); await InvokeAsync(StateHasChanged); } catch { }
    }

    public void Dispose() => AuthenticationStateProvider.AuthenticationStateChanged -= AuthenticationStateChanged;

    private static string ResolveRoleTitle(IEnumerable<string> roles)
    {
        var titles = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["Administrator"] = "مدیر سیستم", ["ProductionManager"] = "مدیر تولید", ["Workshop"] = "کارگاه و بسته‌بندی",
            ["Dimpler"] = "دیمپل‌کار", ["Shaper"] = "شیپر", ["Tuner"] = "تیونر", ["FineTuner"] = "فاین تیونر", ["QualityControl"] = "کنترل کیفیت", ["Marketer"] = "بازاریاب", ["SalesAdmin"] = "ادمین فروش"
        };
        return roles.Select(role => titles.GetValueOrDefault(role, role)).FirstOrDefault() ?? "همکار TORSEPAN";
    }

    private Task InstallAppAsync() => JS.InvokeVoidAsync("torsepanPwa.install").AsTask();
}

@page "/login"

@using TORSEPAN.Application.Auth.Commands.Login
@using TORSEPAN.Panel.Services.Auth

<PageTitle>ورود</PageTitle>

<PageContainer>

    <PageHeader Title="ورود به سامانه"
                SubTitle="احراز هویت">
    </PageHeader>

    <PageCard>

        <FormSection Title="اطلاعات ورود">

            <ErrorAlert Visible="@(!string.IsNullOrWhiteSpace(ErrorMessage))"
                        Message="@ErrorMessage" />

            <TextInput Label="نام کاربری"
                       @bind-Value="Username" />

            <TextInput Label="رمز عبور"
                       @bind-Value="Password" />

            <FormActions>

                <PrimaryButton Text="@(IsSubmitting ? "در حال ورود..." : "ورود")"
                               Disabled="@IsSubmitting"
                               OnClick="LoginUser" />

            </FormActions>

        </FormSection>

    </PageCard>

</PageContainer>

@code {

    [Inject]
    NavigationManager Navigation { get; set; } = default!;

    [Inject]
    IAuthService AuthenticationService { get; set; } = default!;

    string Username = "";

    string Password = "";

    string ErrorMessage = "";

    bool IsSubmitting;

    async Task LoginUser()
    {
        ErrorMessage = "";
        IsSubmitting = true;

        try
        {
            var result = await AuthenticationService.LoginAsync(
                new LoginCommand(
                    Username,
                    Password));

            if (result.Success)
            {
                Navigation.NavigateTo("/", true);
                return;
            }

            ErrorMessage = "نام کاربری یا رمز عبور صحیح نیست.";
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "ارتباط با سرویس ورود برقرار نشد. لطفاً دوباره تلاش کنید.";
        }
        catch
        {
            ErrorMessage = "ورود انجام نشد. لطفاً اطلاعات خود را بررسی و دوباره تلاش کنید.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

}
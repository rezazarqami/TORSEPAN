@page "/handpans"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject HandpanService HandpanService
@inject NavigationManager Navigation

<PageTitle>هنگدرام‌ها</PageTitle>

<div class="d-flex justify-content-between mb-3">

    <h3>هنگدرام‌ها</h3>

    <button class="btn btn-primary"
            @onclick="CreateNew">
        ثبت هنگدرام
    </button>

</div>

@if (_loading)
{
    <div class="spinner-border"></div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">
        هیچ هنگدرامی ثبت نشده است.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>

            <tr>

                <th>Serial</th>
                <th>کاسه بالا</th>
                <th>کاسه پایین</th>
                <th>مرحله</th>
                <th>وضعیت</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in _items)
            {
                <tr>

                    <td>@item.SerialNumber</td>

                    <td>@item.TopBowlId</td>

                    <td>@item.BottomBowlId</td>

                    <td>@item.Stage</td>

                    <td>@item.Status</td>

                </tr>
            }

        </tbody>

    </table>
}

@code
{
    private readonly List<HandpanDto> _items = [];

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items.AddRange(
                await HandpanService.GetReadyForPackagingAsync());
        }
        finally
        {
            _loading = false;
        }
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/handpans/new");
    }
}
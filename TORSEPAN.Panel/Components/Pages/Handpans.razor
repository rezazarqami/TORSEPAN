@page "/handpans"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject HandpanService HandpanService
@inject NavigationManager Navigation

<PageTitle>Handpans</PageTitle>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Handpans
            </h2>

            <p class="text-secondary m-0">
                Ready For Packaging
            </p>

        </div>

        <button class="btn btn-primary"
                @onclick="Create">

            + New Handpan

        </button>

    </div>

    @if (_loading)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"></div>

        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <h4>No Handpans</h4>

                <p class="text-secondary">
                    No handpans are ready for packaging.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Serial Number</th>

                            <th>Stage</th>

                            <th>Created</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in _items)
                        {
                            <tr>

                                <td class="fw-semibold">

                                    @item.SerialNumber

                                </td>

                                <td>

                                    @item.Stage

                                </td>

                                <td>

                                    @item.CreatedAt.ToString("yyyy/MM/dd")

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

@code
{
    private readonly List<HandpanDto> _items = [];

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var result = await HandpanService.GetReadyForPackagingAsync();

        if (result is not null)
            _items.AddRange(result);

        _loading = false;
    }

    private void Create()
    {
        Navigation.NavigateTo("/handpans/new");
    }
}
@page "/users/{UserId:guid}/edit"

@using TORSEPAN.Application.Auth.Commands.UpdateUser

@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>ویرایش کاربر</PageTitle>

<PageHeader Title="ویرایش کاربر"
            SubTitle="ویرایش مشخصات و نقش‌های کاربر" />

<Card>
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <p>در حال دریافت اطلاعات...</p>
    }
    else
    {
        <EditForm Model="_model">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">نام کاربری</label>
                    <InputText class="form-control" @bind-Value="_model.UserName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">نام کامل</label>
                    <InputText class="form-control" @bind-Value="_model.FullName" />
                </div>

                <div class="col-12">
                    <label class="form-label">نقش‌ها</label>
                    <div class="row g-2">
                        @foreach (var role in _roles)
                        {
                            <div class="col-md-4">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input"
                                                   @bind-Value="role.IsSelected" />
                                    <label class="form-check-label">@role.DisplayName</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="button" @onclick="Save" disabled="@_isSaving">
                    ذخیره
                </button>
                <button class="btn btn-secondary" type="button" @onclick="Back">
                    انصراف
                </button>
            </div>
        </EditForm>
    }
</Card>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private readonly EditUserModel _model = new();
    private List<RoleOption> _roles = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        var userTask = UserService.GetUserAsync(UserId);
        var rolesTask = UserService.GetRolesAsync();
        await Task.WhenAll(userTask, rolesTask);

        var user = await userTask;

        if (user is null)
        {
            Navigation.NavigateTo("/users/list");
            return;
        }

        _model.UserName = user.UserName;
        _model.FullName = user.FullName;

        var selectedRoleIds = user.RoleIds.ToHashSet();
        _roles = (await rolesTask)
            .Select(role => new RoleOption(
                role.Id,
                role.DisplayName,
                selectedRoleIds.Contains(role.Id)))
            .ToList();

        _isLoading = false;
    }

    private async Task Save()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            await UserService.UpdateUserAsync(new UpdateUserCommand(
                UserId,
                _model.UserName,
                _model.FullName,
                _roles.Where(x => x.IsSelected).Select(x => x.Id).ToList()));

            Navigation.NavigateTo("/users/list");
        }
        catch (Exception ex)
        {
            _errorMessage = $"ذخیره تغییرات انجام نشد: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Back() => Navigation.NavigateTo("/users/list");

    private sealed class EditUserModel
    {
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
    }

    private sealed class RoleOption
    {
        public RoleOption(Guid id, string displayName, bool isSelected)
        {
            Id = id;
            DisplayName = displayName;
            IsSelected = isSelected;
        }

        public Guid Id { get; }
        public string DisplayName { get; }
        public bool IsSelected { get; set; }
    }
}

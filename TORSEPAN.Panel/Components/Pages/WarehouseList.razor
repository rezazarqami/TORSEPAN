@page "/warehouse/list"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ProductionService ProductionService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject HandpanPhotoService PhotoService
@inject SalesAttributionService AttributionService
@inject IJSRuntime JS
<PageTitle>انبار سازها</PageTitle>
<section class="warehouse-hero instrument-hero">
    <span class="hero-kicker">INSTRUMENT INVENTORY</span>
    <div class="hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M3 10 12 4l9 6v10H3V10Z"/><path d="M8 20v-7h8v7M8 9h8M10 16h4"/></svg></div>
    <h1>انبار سازها</h1>
    <div class="hero-stats"><span><strong>@_items.Count</strong> موجودی کل</span></div>
    @if (_canManage) { <details class="warehouse-menu hero-menu"><summary aria-label="گزینه‌های مدیریت انبار">⋯</summary><div><button @onclick="OpenWarehouseManagement">مدیریت انبارها</button></div></details> }
</section>
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="warehouse-notice" role="status">✓ @_notice <button aria-label="بستن پیام" @onclick="()=>_notice=null">×</button></div> }
<nav class="warehouse-tabs" role="tablist" aria-label="انبارهای ساز">
    @foreach (var warehouse in _warehouses)
    {
        <button type="button" id="warehouse-tab-@warehouse.Id" role="tab" aria-selected="@(_activeWarehouseId==warehouse.Id?"true":"false")" tabindex="@(_activeWarehouseId==warehouse.Id?0:-1)" @onkeydown="e=>WarehouseTabKeyAsync(warehouse.Id,e)" aria-controls="warehouse-inventory" class="warehouse-tab tier-@warehouse.Id @(_activeWarehouseId==warehouse.Id?"active":null)" @onclick="()=>SelectWarehouse(warehouse.Id)">
            <span class="warehouse-tier-mark" aria-hidden="true">@("0"+warehouse.Id)</span>
            <span class="warehouse-tier-text"><small>انبار سازها</small><strong dir="auto">@warehouse.Name</strong></span>
            <b class="warehouse-tier-count" aria-label="@($"{_items.Count(x=>x.QualityWarehouseId==warehouse.Id)} ساز")">@_items.Count(x=>x.QualityWarehouseId==warehouse.Id)</b>
        </button>
    }
</nav>
<section class="warehouse-content-panel" id="warehouse-inventory" role="tabpanel" aria-labelledby="warehouse-tab-@_activeWarehouseId"><div class="warehouse-collection">
    <div class="warehouse-collection-heading"><div><span class="collection-label">موجودی انبار</span><h2 dir="auto">@ActiveWarehouseName</h2></div><span class="collection-count">@Items.Count() ساز @(HasActiveFilter?"در نتیجهٔ جست‌وجو":"آمادهٔ تحویل")</span></div>
    <div class="warehouse-tools">
        <div class="warehouse-search-wrap"><span aria-hidden="true">⌕</span><input class="form-control warehouse-search" aria-label="جست‌وجو در انبار انتخاب‌شده" placeholder="کد ساز، کاسه، متریال یا Scale…" @bind="_search" @bind:event="oninput" /></div>
        <button class="btn warehouse-filter-toggle" aria-expanded="@(_showFilters?"true":"false")" @onclick="()=>_showFilters=!_showFilters">فیلترها <span>@(_showFilters?"−":"+")</span></button>
        <button class="btn gallery-open" disabled="@(!Items.Any() || _galleryLoading)" @onclick="OpenGalleryAsync">@if(_galleryLoading){<span class="spinner-border spinner-border-sm"></span>}else{<span aria-hidden="true">▦</span>} گالری</button>
    </div>
    @if (_showFilters)
    { <div class="warehouse-filter-bar">
        <select class="form-select" aria-label="متریال" @bind="_materialFilter"><option value="">همه متریال‌ها</option>@foreach(var name in _items.Where(x=>x.QualityWarehouseId==_activeWarehouseId).Select(x=>x.MaterialName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select>
        <select class="form-select" aria-label="اسکیل" @bind="_scaleFilter"><option value="">همه Scale‌ها</option>@foreach(var name in _items.Where(x=>x.QualityWarehouseId==_activeWarehouseId).Select(x=>x.ScaleName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select>
        <select class="form-select" aria-label="فیلتر توضیحات ساز" @bind="_notesFilter"><option value="all">همه سازها</option><option value="with">دارای توضیحات</option><option value="without">بدون توضیحات</option></select>
        <button class="btn btn-primary" @onclick="ApplyFilters">اعمال فیلتر</button><button class="btn btn-light" @onclick="ClearFilters">پاک کردن</button>
    </div> }
    <div class="warehouse-selection-bar"><span>@(SelectedVisibleCount>0?$"{SelectedVisibleCount} ساز انتخاب‌شده":"برای عملیات گروهی، سازها را انتخاب کنید")</span><div>
        @if(_canTransfer){<button class="btn transfer-selected" disabled="@(SelectedVisibleCount==0)" @onclick="BeginSelectedTransfer">انتقال به انبار دیگر</button>}
        @if(_canSell){<button class="btn btn-success bulk-sale-button" disabled="@(SelectedVisibleCount==0)" @onclick="BeginSelectedSale">ثبت فروش <span>@SelectedVisibleCount</span></button>}
    </div></div>
</div>

<Card>
@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}
else if(!string.IsNullOrWhiteSpace(_error)){<div class="alert alert-danger">@_error</div>}
else
{
    <div class="stock-list">
    @if(_canSell||_canTransfer){<label class="stock-select-all"><input type="checkbox" aria-label="انتخاب همه سازهای نمایش‌داده‌شده" checked="@AllVisibleSelected" @onchange="ToggleAllVisible" /> انتخاب همه</label>}
    @if(!Items.Any()){<EmptyState Title="انبار خالی است" Description="در این انبار ساز آماده‌ای پیدا نشد؛ انبار دیگر یا فیلترها را بررسی کنید." />}
    @foreach(var item in Items)
    {
        <article class="stock-item @(_selected.Contains(item.HandpanId)?"selected-row":null)">
            <div class="stock-summary">
                @if(_canSell||_canTransfer){<input class="stock-checkbox" type="checkbox" aria-label="انتخاب ساز @item.SerialNumber" checked="@_selected.Contains(item.HandpanId)" @onchange="e=>ToggleSelected(item.HandpanId,(bool?)e.Value==true)" />}
                <button class="stock-expand" aria-label="جزئیات ساز @item.SerialNumber" aria-expanded="@(_expanded.Contains(item.HandpanId)?"true":"false")" disabled="@_detailsLoading.Contains(item.HandpanId)" @onclick="()=>ToggleAsync(item)">@if(_detailsLoading.Contains(item.HandpanId)){<span class="spinner-border spinner-border-sm"></span>}else{@(_expanded.Contains(item.HandpanId)?"−":"+")}</button>
                <strong class="stock-code" dir="ltr">@item.SerialNumber</strong>
                <span class="stock-material" dir="auto" title="@item.MaterialName">@item.MaterialName</span>
                <span class="stock-scale" dir="auto" title="@item.ScaleName">@item.ScaleName</span>
            </div>
            <div class="stock-entry">تاریخ ورود: <bdi>@(item.WarehouseEntryDate.HasValue?PersianDateTime.FormatDateTime(item.WarehouseEntryDate.Value):"—")</bdi></div>
            @if(_expanded.Contains(item.HandpanId))
            {
                <section class="stock-details">
                    <div class="stock-bowls"><span>متریال <bdi>@item.MaterialName</bdi></span><span>Scale <bdi>@item.ScaleName</bdi></span><span>کاسه رو <bdi>@item.TopBowlCode</bdi></span><span>کاسه زیر <bdi>@item.BottomBowlCode</bdi></span></div>
                    <div class="warehouse-row-actions">@if(_canTransfer){<button class="btn btn-sm row-transfer" @onclick="()=>BeginTransfer(item)">⇄ انتقال</button>}@if(_canSell){<button class="btn btn-sm btn-success" @onclick="()=>BeginSale(item)">ثبت فروش</button>}<AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-warning" disabled="@_rollingBack.Contains(item.HandpanId)" @onclick="()=>RequestRollback(item)">↩ بازگشت</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item)">حذف</button></AuthorizeView></div>
                    @if(_detailErrors.Contains(item.HandpanId)){<div class="alert alert-warning">دریافت جزئیات انجام نشد. <button class="btn btn-sm btn-outline-warning" @onclick="()=>RetryDetailsAsync(item)">تلاش دوباره</button></div>}
                    else if(_detailsLoaded.Contains(item.HandpanId))
                    {
                        <div class="warehouse-detail">
                            <div class="warehouse-notes"><h6>توضیحات ثبت‌شده</h6>@if(item.Notes.Count==0){<span class="text-muted">توضیحی ثبت نشده است.</span>}else{<ul>@foreach(var note in item.Notes){<li>@note</li>}</ul>}</div>
                            <div class="warehouse-packaging"><h6>اقلام بسته‌بندی ساز @item.SerialNumber</h6><div>@if(item.PackagingItems.Count==0){<span class="text-muted">ثبت نشده</span>}else{@foreach(var packaging in item.PackagingItems){<span class="badge bg-success">✓ @packaging</span>}}</div></div>
                            <div class="warehouse-photo"><HandpanPhotoGallery HandpanId="@item.HandpanId" /></div>
                            <div class="warehouse-history"><h6>سوابق تولید</h6>@foreach(var op in item.Operations){<div class="stock-operation"><strong>@op.Operation</strong><span>@op.PerformedBy</span><time>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</time></div>}</div>
                        </div>
                    }
                    else {<div class="detail-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات ساز…</div>}
                </section>
            }
        </article>
    }
    </div>
}
</Card>
</section>

@if (_manageWarehouses)
{
    <div class="warehouse-dialog-overlay" @onclick="CloseWarehouseManagement"><section class="warehouse-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="warehouse-settings-title" @onclick:stopPropagation="true">
        <header><div><small>تنظیمات انبار</small><h3 id="warehouse-settings-title">مدیریت انبارها</h3></div><button aria-label="بستن مدیریت انبارها" disabled="@_renameBusyId.HasValue" @onclick="CloseWarehouseManagement">×</button></header>
        <p class="dialog-hint">نام هر انبار را تغییر دهید؛ سازهای داخل آن در همان رده باقی می‌مانند.</p>
        <div class="warehouse-settings-list">@foreach(var warehouse in _warehouses){<div class="warehouse-name-row"><span class="tier-dot tier-@warehouse.Id"></span><label><span>انبار @warehouse.Id</span><input class="form-control" aria-label="نام انبار @warehouse.Id" maxlength="60" @bind="_warehouseNames[warehouse.Id]" /></label><button class="btn" disabled="@(_renameBusyId.HasValue || string.IsNullOrWhiteSpace(_warehouseNames[warehouse.Id]) || _warehouseNames[warehouse.Id].Trim()==warehouse.Name)" @onclick="()=>RenameWarehouseAsync(warehouse.Id)">@(_renameBusyId==warehouse.Id?"ذخیره…":"ذخیره")</button></div>}</div>
        @if (!string.IsNullOrWhiteSpace(_manageError)) { <div class="dialog-error" role="alert">@_manageError <button class="btn btn-sm btn-light" disabled="@_renameBusyId.HasValue" @onclick="ReloadWarehousesAsync">دریافت اطلاعات تازه</button></div> }
        <footer><button class="btn btn-light" disabled="@_renameBusyId.HasValue" @onclick="CloseWarehouseManagement">بستن</button></footer>
    </section></div>
}
@if (_transferItems.Count>0)
{
    <div class="warehouse-dialog-overlay" @onclick="CancelTransfer"><section class="warehouse-transfer-dialog" role="dialog" aria-modal="true" aria-labelledby="warehouse-transfer-title" @onclick:stopPropagation="true">
        <header><div><small>جابه‌جایی موجودی</small><h3 id="warehouse-transfer-title">انتقال @(_transferItems.Count==1?"ساز":$"{_transferItems.Count} ساز")</h3></div><button aria-label="بستن انتقال" disabled="@_transferring" @onclick="CancelTransfer">×</button></header>
        <div class="transfer-codes">@foreach(var row in _transferItems){<span dir="ltr">@row.SerialNumber</span>}</div>
        <div class="transfer-route"><div><small>انبار فعلی</small><strong dir="auto">@ActiveWarehouseName</strong></div><span aria-hidden="true">←</span><label><small>انبار مقصد</small><select class="form-select" aria-label="انبار مقصد انتقال" @bind="_transferWarehouseId"><option value="">انتخاب کنید</option>@foreach(var warehouse in _warehouses.Where(x=>x.Id!=_activeWarehouseId)){<option value="@warehouse.Id">@warehouse.Name</option>}</select></label></div>
        <p class="dialog-hint">این انتقال فقط ردهٔ انبار را تغییر می‌دهد؛ مراحل تولید و اقلام بسته‌بندی حفظ می‌شوند.</p>
        @if (!string.IsNullOrWhiteSpace(_transferError)) { <div class="dialog-error" role="alert">@_transferError <button class="btn btn-sm btn-light" disabled="@_transferring" @onclick="ReloadInventoryAsync">دریافت موجودی تازه</button></div> }
        <footer><button class="btn btn-light" disabled="@_transferring" @onclick="CancelTransfer">انصراف</button><button class="btn btn-primary" disabled="@(_transferring||!_transferWarehouseId.HasValue)" @onclick="ConfirmTransferAsync">@(_transferring?"در حال انتقال…":"تأیید انتقال")</button></footer>
    </section></div>
}

<AppConfirmDialog IsOpen="@(_rollbackCandidate is not null)"
                  Title="بازگشت از انبار سازها"
                  Message="@RollbackMessage"
                  ConfirmText="بازگشت به بسته‌بندی"
                  Error="@_rollbackError"
                  Busy="@RollbackBusy"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />

@if(_showGallery)
{
    <div class="inventory-gallery-overlay" @onclick="CloseGallery"><section class="inventory-gallery-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><small>انتخاب ساز بر اساس ظاهر</small><h3>گالری موجودی فیلترشده</h3><p>@_galleryPhotos.Count عکس از @Items.Count() ساز این فهرست</p></div><button @onclick="CloseGallery">×</button></header>
        @if(_galleryPhotos.Count==0){<div class="gallery-no-photo">برای سازهای این فهرست هنوز عکسی ثبت نشده است.</div>}
        else{<div class="inventory-gallery-grid">@foreach(var photo in _galleryPhotos){var item=_items.First(x=>x.HandpanId==photo.HandpanId);<button @onclick="()=>PreviewGalleryPhotoAsync(photo)"><img loading="lazy" src="@ThumbnailUrl(photo)" alt="ساز @item.SerialNumber" /><strong dir="ltr">@item.SerialNumber</strong></button>}</div>}
    </section></div>
}
@if(_galleryPreviewUrl is not null){<div class="gallery-preview-overlay" @onclick="CloseGalleryPreview"><button aria-label="بستن" @onclick="CloseGalleryPreview">×</button><img src="@_galleryPreviewUrl" alt="نمایش بزرگ عکس ساز" /></div>}

@if(_saleIds.Count > 0)
{
    <div class="sale-overlay" role="presentation" @onclick="Cancel">
        <section class="sale-dialog" role="dialog" aria-modal="true" aria-labelledby="sale-title" @onclick:stopPropagation="true">
            <header><div><span class="sale-eyebrow">ثبت خروج از انبار</span><h3 id="sale-title">@(_saleIds.Count==1?$"فروش ساز {SaleCodes.FirstOrDefault()}":$"فروش گروهی {_saleIds.Count} ساز")</h3></div><button class="sale-close" aria-label="بستن" @onclick="Cancel">×</button></header>
            @if(_saleIds.Count>1){<div class="selected-sales">@foreach(var saleCode in SaleCodes){<span>@saleCode</span>}</div>}
            <div class="sale-fields">
                <label><span>خریدار از حسابداری</span><select class="form-select" @bind="_selectedPartyId"><option value="">انتخاب نشده</option>@foreach(var p in _parties){<option value="@p.Id">@p.DisplayName @(string.IsNullOrWhiteSpace(p.Phone)?"":$"— {p.Phone}")</option>}</select></label>
                <label><span>نام خریدار آزاد</span><input class="form-control" @bind="_buyer" placeholder="اختیاری" /></label>
                <label><span>شماره تلفن خریدار</span><input class="form-control" inputmode="tel" @bind="_buyerPhone" placeholder="اختیاری" /></label>
                <label><span>مبلغ کل</span><input type="number" min="0" class="form-control" @bind="_price" placeholder="اختیاری" /></label>
                <label><span>مبلغ دریافتی</span><input type="number" min="0" class="form-control" @bind="_receivedAmount" placeholder="اختیاری" /></label>
                <label><span>مبلغ مانده</span><input class="form-control" value="@RemainingAmountText" disabled /></label>
                <fieldset class="wide sale-kind-field">
                    <legend>نوع فروش <strong>*</strong></legend>
                    <label><input type="radio" name="sale-kind" checked="@(_isExportSale==false)" @onchange="()=>SetSaleKind(false)" /><span>داخلی</span></label>
                    <label><input type="radio" name="sale-kind" checked="@(_isExportSale==true)" @onchange="()=>SetSaleKind(true)" /><span>صادراتی</span></label>
                </fieldset>
                @if(_isExportSale==true){<label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="مثلاً کانادا (اختیاری)" /></label>}
                <label><span>نحوه آشنایی</span><select class="form-select" @bind="_leadSourceId" @bind:after="LeadSourceChanged"><option value="">انتخاب نشده</option>@foreach(var source in _attribution.Sources){<option value="@source.Id">@source.Name</option>}</select></label>
                <div class="inline-add"><input class="form-control" @bind="_newSource" placeholder="روش جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddSourceAsync">افزودن</button></div>
                @if(SelectedSourceRequiresReferrer){<label><span>نام معرف <strong>*</strong></span><select class="form-select" @bind="_referrerId"><option value="">انتخاب معرف</option>@foreach(var item in _attribution.Referrers){<option value="@item.Id">@item.Name</option>}</select></label><div class="inline-add"><input class="form-control" @bind="_newReferrer" placeholder="نام معرف جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddReferrerAsync">افزودن</button></div>}
                <label class="paid-field wide"><input type="checkbox" checked disabled /><span>فعال‌سازی گارانتی</span></label>
            </div>
            @if(!string.IsNullOrWhiteSpace(_saleError)){<div class="sale-error">@_saleError</div>}
            <footer><button class="btn btn-light" disabled="@_saving" @onclick="Cancel">انصراف</button><button class="btn btn-success" disabled="@_saving" @onclick="SellAsync">@if(_saving){<span class="spinner-border spinner-border-sm"></span>} ثبت فروش @(_saleIds.Count>1?$"{_saleIds.Count} ساز":"")</button></footer>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name="sell")] public Guid? SellHandpanId { get; set; }
    private List<WarehouseHandpanDto> _items=[]; private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties=[];
    private readonly HashSet<Guid> _expanded=[]; private readonly HashSet<Guid> _selected=[]; private readonly HashSet<Guid> _detailsLoaded=[]; private readonly HashSet<Guid> _detailsLoading=[]; private readonly HashSet<Guid> _detailErrors=[]; private readonly HashSet<Guid> _rollingBack=[]; private readonly List<Guid> _saleIds=[];
    private bool _canSell, _canTransfer, _canManage, _showFilters, _manageWarehouses, _transferring;
    private int _activeWarehouseId=1;
    private int? _renameBusyId, _transferWarehouseId;
    private List<InstrumentWarehouseDto> _warehouses=InstrumentWarehouseDto.Defaults();
    private Dictionary<int,string> _warehouseNames=[];
    private List<WarehouseHandpanDto> _transferItems=[];
    private string? _notice, _manageError, _transferError;
    private string ActiveWarehouseName=>_warehouses.FirstOrDefault(x=>x.Id==_activeWarehouseId)?.Name??"Economy";
    private int SelectedVisibleCount=>Items.Count(x=>_selected.Contains(x.HandpanId));
    private static string TierDescription(int id)=>id switch {1=>"اقتصادی و در دسترس",2=>"کیفیت بالاتر، انتخاب میانی",_=>"ممتاز و منتخب"};
    private bool _loading=true,_saving,_galleryLoading,_showGallery; private string _search="",_materialFilter="",_scaleFilter="",_appliedMaterialFilter="",_appliedScaleFilter="",_notesFilter="all",_appliedNotesFilter="all",_buyer="",_buyerPhone="",_destination="";
    private List<WarehouseGalleryPhotoDto> _galleryPhotos=[]; private string? _galleryPreviewUrl;
    private string? _error,_saleError,_rollbackError; private WarehouseHandpanDto? _rollbackCandidate; private decimal? _price,_receivedAmount; private Guid? _selectedPartyId,_leadSourceId,_referrerId; private bool? _isExportSale;private string _newSource="",_newReferrer="";private SalesAttributionOptionsDto _attribution=new();
    private bool SelectedSourceRequiresReferrer=>_attribution.Sources.FirstOrDefault(x=>x.Id==_leadSourceId)?.RequiresReferrer==true;
    private string RemainingAmountText=>_price.HasValue?Math.Max(0,_price.Value-(_receivedAmount??0)).ToString("N0"):"—";
    private IEnumerable<WarehouseHandpanDto> Items=>_items.Where(x=>x.QualityWarehouseId==_activeWarehouseId&&(string.IsNullOrWhiteSpace(_search)||x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.TopBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BottomBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(_appliedMaterialFilter)||x.MaterialName==_appliedMaterialFilter)&&(string.IsNullOrWhiteSpace(_appliedScaleFilter)||x.ScaleName==_appliedScaleFilter)&&(_appliedNotesFilter switch {"with"=>x.Notes.Count>0,"without"=>x.Notes.Count==0,_=>true}));
    private bool HasActiveFilter=>!string.IsNullOrWhiteSpace(_search)||!string.IsNullOrWhiteSpace(_appliedMaterialFilter)||!string.IsNullOrWhiteSpace(_appliedScaleFilter)||_appliedNotesFilter!="all";
    private bool AllVisibleSelected=>Items.Any()&&Items.All(x=>_selected.Contains(x.HandpanId));
    private IEnumerable<string> SaleCodes=>_items.Where(x=>_saleIds.Contains(x.HandpanId)).Select(x=>x.SerialNumber);
    protected override async Task OnInitializedAsync(){try{var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;_canManage=user.IsInRole("Administrator");_canTransfer=_canManage||user.IsInRole("ProductionManager")||user.IsInRole("QualityControl");_warehouses=await ProductionService.GetInstrumentWarehousesAsync();_canSell=user.IsInRole("Administrator")||user.IsInRole("ProductionManager")||user.IsInRole("SalesAdmin");_items=(await ProductionService.GetWarehouseAsync()).ToList();if(_canSell){_parties=await AccountingService.PartiesAsync();_attribution=await AttributionService.OptionsAsync();}if(_canSell&&SellHandpanId.HasValue){var item=_items.FirstOrDefault(x=>x.HandpanId==SellHandpanId.Value);if(item is not null){_activeWarehouseId=item.QualityWarehouseId;BeginSale(item);}}}catch(Exception e){_error=e.Message;}finally{_loading=false;}}
    private async Task WarehouseTabKeyAsync(int id, KeyboardEventArgs e)
    {
        var next=e.Key switch {"ArrowLeft"=>id==3?1:id+1,"ArrowRight"=>id==1?3:id-1,"Home"=>1,"End"=>3,_=>0};
        if(next==0)return;SelectWarehouse(next);await JS.InvokeVoidAsync("torsepanWarehouse.focusTab",next);
    }
    private void SelectWarehouse(int id){_activeWarehouseId=id;_selected.Clear();_expanded.Clear();ClearFilters();CloseGallery();}
    private void ClearFilters(){_search=_materialFilter=_scaleFilter=_appliedMaterialFilter=_appliedScaleFilter="";_notesFilter=_appliedNotesFilter="all";_selected.Clear();}
    private void OpenWarehouseManagement(){if(!_canManage)return;_warehouseNames=_warehouses.ToDictionary(x=>x.Id,x=>x.Name);_manageError=null;_manageWarehouses=true;}
    private void CloseWarehouseManagement(){if(!_renameBusyId.HasValue)_manageWarehouses=false;}
    private async Task ReloadWarehousesAsync(){try{_warehouses=await ProductionService.GetInstrumentWarehousesAsync();_manageError=null;}catch(Exception ex){_manageError=ex.Message;}}
    private async Task RenameWarehouseAsync(int id){if(!_canManage||_renameBusyId.HasValue)return;_renameBusyId=id;_manageError=null;try{var item=_warehouses.Single(x=>x.Id==id);var updated=await ProductionService.RenameWarehouseAsync(id,_warehouseNames[id],item.Version);if(updated is null)throw new InvalidOperationException("ذخیره نام انجام نشد.");item.Name=updated.Name;item.Version=updated.Version;_warehouseNames[id]=item.Name;_notice="نام انبار ذخیره شد.";}catch(Exception ex){_manageError=ex.Message;}finally{_renameBusyId=null;}}
    private void BeginTransfer(WarehouseHandpanDto item){if(!_canTransfer)return;_transferItems=[item];_transferWarehouseId=null;_transferError=null;}
    private void BeginSelectedTransfer(){if(!_canTransfer)return;_transferItems=Items.Where(x=>_selected.Contains(x.HandpanId)).ToList();_transferWarehouseId=null;_transferError=null;}
    private void CancelTransfer(){if(!_transferring)_transferItems=[];}
    private async Task ReloadInventoryAsync(){try{_items=(await ProductionService.GetWarehouseAsync()).ToList();_transferItems=[];_selected.Clear();_transferError=null;_notice="موجودی تازه دریافت شد؛ سازها را دوباره انتخاب کنید.";}catch(Exception ex){_transferError=ex.Message;}}
    private async Task ConfirmTransferAsync(){if(_transferring||!_canTransfer||!_transferWarehouseId.HasValue||_transferItems.Count==0)return;_transferring=true;_transferError=null;try{var result=await ProductionService.TransferWarehouseAsync(_transferWarehouseId.Value,_transferItems.Select(x=>new WarehouseMoveItem(x.HandpanId,x.Version)).ToList());if(result.Count!=_transferItems.Count)throw new InvalidOperationException("پاسخ انتقال کامل نیست؛ موجودی را تازه کنید.");foreach(var row in result){var item=_items.Single(x=>x.HandpanId==row.HandpanId);item.QualityWarehouseId=row.QualityWarehouseId;item.Version=row.Version;}_notice=$"{result.Count} ساز به {_warehouses.Single(x=>x.Id==_transferWarehouseId).Name} منتقل شد.";_transferItems=[];_selected.Clear();_expanded.Clear();}catch(Exception ex){_transferError=ex.Message;}finally{_transferring=false;}}
    private void ApplyFilters(){_appliedMaterialFilter=_materialFilter;_appliedScaleFilter=_scaleFilter;_appliedNotesFilter=_notesFilter;_expanded.Clear();_selected.Clear();}
    private async Task OpenGalleryAsync(){if(_galleryLoading)return;_galleryLoading=true;try{_galleryPhotos=await ProductionService.GetWarehouseGalleryAsync(Items.Select(x=>x.HandpanId).ToList());_showGallery=true;}finally{_galleryLoading=false;}}
    private void CloseGallery(){_showGallery=false;_galleryPreviewUrl=null;}
    private static string ThumbnailUrl(WarehouseGalleryPhotoDto photo)=>$"data:image/webp;base64,{Convert.ToBase64String(photo.Thumbnail)}";
    private async Task PreviewGalleryPhotoAsync(WarehouseGalleryPhotoDto photo)=>_galleryPreviewUrl=await PhotoService.DataUrlAsync(photo.HandpanId,photo.Id,false);
    private void CloseGalleryPreview()=>_galleryPreviewUrl=null;
    private void ToggleSelected(Guid id,bool selected){if(selected)_selected.Add(id);else _selected.Remove(id);}
    private void ToggleAllVisible(ChangeEventArgs e){var select=(bool?)e.Value==true;foreach(var item in Items.ToList()){if(select)_selected.Add(item.HandpanId);else _selected.Remove(item.HandpanId);}}
    private async Task DeleteAsync(WarehouseHandpanDto item){if(!await JS.InvokeAsync<bool>("confirm",$"ساز {item.SerialNumber} و تمام سوابق آن برای همیشه حذف شود؟"))return;await ProductionService.DeleteAsync(item.HandpanId);_items.Remove(item);_selected.Remove(item.HandpanId);}
    private bool RollbackBusy=>_rollbackCandidate is not null&&_rollingBack.Contains(_rollbackCandidate.HandpanId);
    private string RollbackMessage=>_rollbackCandidate is null?string.Empty:$"ساز {_rollbackCandidate.SerialNumber} به مرحله «در انتظار بسته‌بندی عادی» برگردد؟ اقلام بسته‌بندی مصرف‌شده نیز به موجودی انبار مواد اولیه بازمی‌گردند.";
    private void RequestRollback(WarehouseHandpanDto item){if(_rollingBack.Contains(item.HandpanId))return;_rollbackCandidate=item;_rollbackError=null;}
    private void CancelRollback(){if(RollbackBusy)return;_rollbackCandidate=null;_rollbackError=null;}
    private async Task ConfirmRollbackAsync(){var item=_rollbackCandidate;if(item is null||!_rollingBack.Add(item.HandpanId))return;_rollbackError=null;try{await ProductionService.RollbackAsync(item.HandpanId);_items.Remove(item);_selected.Remove(item.HandpanId);_rollbackCandidate=null;}catch{_rollbackError="بازگشت ساز انجام نشد. وضعیت ساز را دوباره بررسی کنید.";}finally{_rollingBack.Remove(item.HandpanId);}}
    private async Task ToggleAsync(WarehouseHandpanDto item){if(!_expanded.Add(item.HandpanId)){_expanded.Remove(item.HandpanId);return;}if(!_detailsLoaded.Contains(item.HandpanId))await LoadDetailsAsync(item);}
    private async Task RetryDetailsAsync(WarehouseHandpanDto item){_detailErrors.Remove(item.HandpanId);await LoadDetailsAsync(item);}
    private async Task LoadDetailsAsync(WarehouseHandpanDto item){if(!_detailsLoading.Add(item.HandpanId))return;try{var details=await ProductionService.GetWarehouseDetailsAsync(item.HandpanId);if(details is null)throw new InvalidOperationException();item.Operations=details.Operations;item.PackagingItems=details.PackagingItems;item.Notes=details.Notes;_detailsLoaded.Add(item.HandpanId);_detailErrors.Remove(item.HandpanId);}catch{_detailErrors.Add(item.HandpanId);}finally{_detailsLoading.Remove(item.HandpanId);}}
    private void BeginSale(WarehouseHandpanDto item){_selected.Clear();_selected.Add(item.HandpanId);OpenSale([item.HandpanId]);}
    private void BeginSelectedSale()=>OpenSale(Items.Where(x=>_selected.Contains(x.HandpanId)).Select(x=>x.HandpanId).ToList());
    private void OpenSale(IEnumerable<Guid> ids){_saleIds.Clear();_saleIds.AddRange(ids);_buyer="";_buyerPhone="";_destination="";_selectedPartyId=null;_leadSourceId=null;_referrerId=null;_isExportSale=null;_price=null;_receivedAmount=null;_saleError=null;}
    private void LeadSourceChanged(){if(!SelectedSourceRequiresReferrer)_referrerId=null;}
    private async Task AddSourceAsync(){if(string.IsNullOrWhiteSpace(_newSource))return;try{var item=await AttributionService.AddSourceAsync(_newSource);if(item is not null){_attribution.Sources.Add(item);_leadSourceId=item.Id;_newSource="";}}catch(Exception ex){_saleError=ex.Message;}}
    private async Task AddReferrerAsync(){if(string.IsNullOrWhiteSpace(_newReferrer))return;try{var item=await AttributionService.AddReferrerAsync(_newReferrer);if(item is not null){_attribution.Referrers.Add(item);_referrerId=item.Id;_newReferrer="";}}catch(Exception ex){_saleError=ex.Message;}}
    private void SetSaleKind(bool isExport){_isExportSale=isExport;if(!isExport)_destination="";_saleError=null;}
    private void Cancel(){if(_saving)return;_saleIds.Clear();}
    private async Task SellAsync(){if(_saleIds.Count==0)return;if(!_isExportSale.HasValue){_saleError="نوع فروش (داخلی یا صادراتی) را انتخاب کنید.";return;}if(SelectedSourceRequiresReferrer&&!_referrerId.HasValue){_saleError="نام معرف را انتخاب کنید.";return;}_saving=true;_saleError=null;try{var party=_parties.FirstOrDefault(x=>x.Id==_selectedPartyId);var buyer=party?.Name??_buyer.Trim();var phone=party?.Phone??_buyerPhone.Trim();await ProductionService.SellManyAsync(_saleIds,buyer,phone,_price,_receivedAmount,_isExportSale.Value,_destination.Trim(),party?.Id,true,_leadSourceId,_referrerId);_items.RemoveAll(x=>_saleIds.Contains(x.HandpanId));_selected.Clear();_saleIds.Clear();}catch(HttpRequestException ex){_saleError=string.IsNullOrWhiteSpace(ex.Message)?"ثبت فروش انجام نشد.":ex.Message;}finally{_saving=false;}}
}

    private async Task LoadGalleryAsync(){var generation=++_galleryGeneration;_galleryLoading=true;_galleryError=null;try{var ids=Items.Select(x=>x.HandpanId).ToList();var photos=ids.Count==0?new List<WarehouseGalleryPhotoDto>():await ProductionService.GetWarehouseGalleryAsync(ids);if(generation==_galleryGeneration)_galleryPhotos=photos;}catch{if(generation==_galleryGeneration)_galleryError="دریافت عکس‌ها کامل نشد؛ موجودی محفوظ است.";}finally{if(generation==_galleryGeneration)_galleryLoading=false;}}

    private static string StageKey(string name)=>name.Contains("دیمپل")?"dimple":name.Contains("شیپ")?"shape":name.Contains("فاین")?"fine":name.Contains("تیون")?"tuning":name.Contains("QC")||name.Contains("کیفیت")?"qc":"pack";

@page "/warehouse/list"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ProductionService ProductionService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject HandpanPhotoService PhotoService
@inject IJSRuntime JS
<PageTitle>انبار سازها</PageTitle>
<PageHeader Title="انبار سازها" SubTitle="سازهای بسته‌بندی‌شده و آماده فروش" />

<div class="warehouse-tools">
    <input class="form-control warehouse-search" placeholder="جست‌وجوی کد ساز، کاسه، متریال یا اسکیل..." @bind="_search" @bind:event="oninput" />
    @if(_canSell){<button class="btn btn-success bulk-sale-button" disabled="@(_selected.Count == 0)" @onclick="BeginSelectedSale">فروش انتخاب‌شده‌ها <span>@_selected.Count</span></button>}
</div>
<div class="warehouse-overview"><div class="warehouse-count"><span>@(HasActiveFilter?"نتیجه فیلتر":"موجودی فعلی انبار")</span><strong>@Items.Count()</strong><small>ساز</small></div><button class="btn gallery-open" disabled="@(!Items.Any() || _galleryLoading)" @onclick="OpenGalleryAsync">@if(_galleryLoading){<span class="spinner-border spinner-border-sm"></span>}else{<span>▦</span>} گالری عکس‌های همین فهرست</button></div>
<div class="warehouse-filter-bar">
    <select class="form-select" @bind="_materialFilter"><option value="">همه متریال‌ها</option>@foreach(var name in _items.Select(x=>x.MaterialName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select>
    <select class="form-select" @bind="_scaleFilter"><option value="">همه اسکیل‌ها</option>@foreach(var name in _items.Select(x=>x.ScaleName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select>
    <button class="btn btn-primary" @onclick="ApplyFilters">اعمال</button>
</div>

<Card>
@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}
else if(!string.IsNullOrWhiteSpace(_error)){<div class="alert alert-danger">@_error</div>}
else
{
    <DataTable><thead><tr><th class="select-column">@if(_canSell){<input type="checkbox" aria-label="انتخاب همه سازهای نمایش‌داده‌شده" checked="@AllVisibleSelected" @onchange="ToggleAllVisible" />}</th><th></th><th>کد ساز</th><th>کاسه رو</th><th>کاسه زیر</th><th>متریال</th><th>اسکیل</th><th>تاریخ ورود</th><th>فروش</th><th class="warehouse-admin-cell">مدیریت</th></tr></thead><tbody>
    @if(!Items.Any()){<tr><td colspan="10"><EmptyState Title="انبار خالی است" Description="ساز آماده فروشی در انبار وجود ندارد." /></td></tr>}
    @foreach(var item in Items)
    {
        <tr class="@(_selected.Contains(item.HandpanId)?"selected-row":null)">
            <td class="select-column">@if(_canSell){<input type="checkbox" aria-label="انتخاب ساز @item.SerialNumber" checked="@_selected.Contains(item.HandpanId)" @onchange="e=>ToggleSelected(item.HandpanId,(bool?)e.Value==true)" />}</td>
            <td><button class="btn btn-sm btn-outline-primary" disabled="@_detailsLoading.Contains(item.HandpanId)" @onclick="()=>ToggleAsync(item)">@if(_detailsLoading.Contains(item.HandpanId)){<span class="spinner-border spinner-border-sm"></span>}else{@(_expanded.Contains(item.HandpanId)?"−":"+")}</button></td>
            <td><strong>@item.SerialNumber</strong></td><td>@item.TopBowlCode</td><td>@item.BottomBowlCode</td><td>@item.MaterialName</td><td>@item.ScaleName</td><td>@(item.WarehouseEntryDate.HasValue?PersianDateTime.FormatDateTime(item.WarehouseEntryDate.Value):"—")</td>
            <td>@if(_canSell){<button class="btn btn-sm btn-success" @onclick="()=>BeginSale(item)">فروخته شد</button>}</td>
            <td class="warehouse-admin-cell"><AuthorizeView Roles="Administrator"><div class="warehouse-admin-actions"><button class="btn btn-sm btn-outline-warning rollback-action" title="بازگشت به مرحله قبل" disabled="@_rollingBack.Contains(item.HandpanId)" @onclick="()=>RequestRollback(item)">@(_rollingBack.Contains(item.HandpanId)?"در حال انجام…":"↩ بازگشت")</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item)">حذف</button></div></AuthorizeView></td>
        </tr>
        @if(_expanded.Contains(item.HandpanId)){<tr class="table-light warehouse-detail-row"><td colspan="10">@if(_detailErrors.Contains(item.HandpanId)){<div class="alert alert-warning m-2">دریافت جزئیات انجام نشد. <button class="btn btn-sm btn-outline-warning" @onclick="()=>RetryDetailsAsync(item)">تلاش دوباره</button></div>}else if(_detailsLoaded.Contains(item.HandpanId)){<div class="p-3 warehouse-detail"><div class="warehouse-packaging"><h6>اقلام بسته‌بندی ساز @item.SerialNumber</h6><div>@if(item.PackagingItems.Count==0){<span class="text-muted">ثبت نشده</span>}else{@foreach(var p in item.PackagingItems){<span class="badge bg-success me-2">✓ @p</span>}}</div></div><div class="warehouse-photo"><HandpanPhotoGallery HandpanId="@item.HandpanId" /></div><div class="warehouse-history"><div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>عملیات</th><th>انجام‌دهنده</th><th>زمان</th></tr></thead><tbody>@foreach(var op in item.Operations){<tr><td>@op.Operation</td><td>@op.PerformedBy</td><td>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</td></tr>}</tbody></table></div></div></div>}else{<div class="detail-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت جزئیات ساز…</div>}</td></tr>}
    }
    </tbody></DataTable>
}
</Card>

<AppConfirmDialog IsOpen="@(_rollbackCandidate is not null)"
                  Title="بازگشت از انبار سازها"
                  Message="@RollbackMessage"
                  ConfirmText="بازگشت به بسته‌بندی"
                  Error="@_rollbackError"
                  Busy="@RollbackBusy"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />

@if(_showGallery)
{
    <div class="inventory-gallery-overlay" @onclick="CloseGallery"><section class="inventory-gallery-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><small>انتخاب ساز بر اساس ظاهر</small><h3>گالری موجودی فیلترشده</h3><p>@_galleryPhotos.Count عکس از @Items.Count() ساز این فهرست</p></div><button @onclick="CloseGallery">×</button></header>
        @if(_galleryPhotos.Count==0){<div class="gallery-no-photo">برای سازهای این فهرست هنوز عکسی ثبت نشده است.</div>}
        else{<div class="inventory-gallery-grid">@foreach(var photo in _galleryPhotos){var item=_items.First(x=>x.HandpanId==photo.HandpanId);<button @onclick="()=>PreviewGalleryPhotoAsync(photo)"><img loading="lazy" src="@ThumbnailUrl(photo)" alt="ساز @item.SerialNumber" /><strong dir="ltr">@item.SerialNumber</strong></button>}</div>}
    </section></div>
}
@if(_galleryPreviewUrl is not null){<div class="gallery-preview-overlay" @onclick="CloseGalleryPreview"><button aria-label="بستن" @onclick="CloseGalleryPreview">×</button><img src="@_galleryPreviewUrl" alt="نمایش بزرگ عکس ساز" /></div>}

@if(_saleIds.Count > 0)
{
    <div class="sale-overlay" role="presentation" @onclick="Cancel">
        <section class="sale-dialog" role="dialog" aria-modal="true" aria-labelledby="sale-title" @onclick:stopPropagation="true">
            <header><div><span class="sale-eyebrow">ثبت خروج از انبار</span><h3 id="sale-title">@(_saleIds.Count==1?$"فروش ساز {SaleCodes.FirstOrDefault()}":$"فروش گروهی {_saleIds.Count} ساز")</h3></div><button class="sale-close" aria-label="بستن" @onclick="Cancel">×</button></header>
            <div class="selected-sales">@foreach(var saleCode in SaleCodes){<span>@saleCode</span>}</div>
            <div class="sale-hint">تمام اطلاعات فروش زیر اختیاری است و بعداً از صفحه فروش قابل تکمیل یا ویرایش خواهد بود.</div>
            <div class="warranty-option">
                <label class="warranty-switch"><input type="checkbox" @bind="_activateWarranty" /><span><strong>فعال‌سازی هم‌زمان گارانتی</strong><small>گارانتی این سازها پس از ثبت فروش آغاز شود.</small></span></label>
                @if(_activateWarranty){<div class="warranty-fields"><label><span>نام و نام خانوادگی مالک</span><input class="form-control" @bind="_warrantyFullName" maxlength="150" /></label><label><span>شماره موبایل مالک</span><input class="form-control" @bind="_warrantyPhone" maxlength="20" inputmode="tel" /></label><label><span>شهر مالک</span><input class="form-control" @bind="_warrantyCity" maxlength="100" /></label></div>}
            </div>
            <div class="sale-fields">
                <label class="wide"><span>جست‌وجوی شخص یا شرکت</span><input class="form-control" @bind="_partySearch" @bind:event="oninput" placeholder="نام یا شرکت را جست‌وجو کنید..." /></label>
                <label><span>خریدار از حسابداری</span><select class="form-select" @bind="_selectedPartyId"><option value="">انتخاب نشده</option>@foreach(var p in SaleParties){<option value="@p.Id">@p.DisplayName</option>}</select></label>
                <label><span>نام خریدار آزاد</span><input class="form-control" @bind="_buyer" placeholder="اختیاری" /></label>
                <label><span>قیمت هر ساز</span><input type="number" min="0" class="form-control" @bind="_price" placeholder="اختیاری" /></label>
                <label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="مثلاً کانادا (اختیاری)" /></label>
                <label class="paid-field"><input type="checkbox" @bind="_isPaid" /><span>مبلغ کامل دریافت شده است</span></label>
                @if(!_isPaid){<label><span>تاریخ سررسید پرداخت</span><input type="date" class="form-control" @bind="_dueDate" /></label>}
            </div>
            @if(!string.IsNullOrWhiteSpace(_saleError)){<div class="sale-error">@_saleError</div>}
            <footer><button class="btn btn-light" disabled="@_saving" @onclick="Cancel">انصراف</button><button class="btn btn-success" disabled="@_saving" @onclick="SellAsync">@if(_saving){<span class="spinner-border spinner-border-sm"></span>} ثبت فروش @(_saleIds.Count>1?$"{_saleIds.Count} ساز":"")</button></footer>
        </section>
    </div>
}

@code {
    private List<WarehouseHandpanDto> _items=[]; private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties=[];
    private readonly HashSet<Guid> _expanded=[]; private readonly HashSet<Guid> _selected=[]; private readonly HashSet<Guid> _detailsLoaded=[]; private readonly HashSet<Guid> _detailsLoading=[]; private readonly HashSet<Guid> _detailErrors=[]; private readonly HashSet<Guid> _rollingBack=[]; private readonly List<Guid> _saleIds=[];
    private bool _canSell;
    private bool _loading=true,_saving,_isPaid,_galleryLoading,_showGallery,_activateWarranty; private string _search="",_materialFilter="",_scaleFilter="",_appliedMaterialFilter="",_appliedScaleFilter="",_partySearch="",_buyer="",_destination="",_warrantyFullName="",_warrantyPhone="",_warrantyCity="";
    private List<WarehouseGalleryPhotoDto> _galleryPhotos=[]; private string? _galleryPreviewUrl;
    private string? _error,_saleError,_rollbackError; private WarehouseHandpanDto? _rollbackCandidate; private decimal? _price; private Guid? _selectedPartyId; private DateTime? _dueDate;
    private IEnumerable<TORSEPAN.Panel.Models.AccountingPartyDto> SaleParties=>_parties.Where(x=>string.IsNullOrWhiteSpace(_partySearch)||x.DisplayName.Contains(_partySearch,StringComparison.OrdinalIgnoreCase));
    private IEnumerable<WarehouseHandpanDto> Items=>_items.Where(x=>(string.IsNullOrWhiteSpace(_search)||x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.TopBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BottomBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(_appliedMaterialFilter)||x.MaterialName==_appliedMaterialFilter)&&(string.IsNullOrWhiteSpace(_appliedScaleFilter)||x.ScaleName==_appliedScaleFilter));
    private bool HasActiveFilter=>!string.IsNullOrWhiteSpace(_search)||!string.IsNullOrWhiteSpace(_appliedMaterialFilter)||!string.IsNullOrWhiteSpace(_appliedScaleFilter);
    private bool AllVisibleSelected=>Items.Any()&&Items.All(x=>_selected.Contains(x.HandpanId));
    private IEnumerable<string> SaleCodes=>_items.Where(x=>_saleIds.Contains(x.HandpanId)).Select(x=>x.SerialNumber);
    protected override async Task OnInitializedAsync(){try{var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;_canSell=user.IsInRole("Administrator")||user.IsInRole("ProductionManager")||user.IsInRole("SalesAdmin");_items=(await ProductionService.GetWarehouseAsync()).ToList();if(_canSell)_parties=await AccountingService.PartiesAsync();}catch(Exception e){_error=e.Message;}finally{_loading=false;}}
    private void ApplyFilters(){_appliedMaterialFilter=_materialFilter;_appliedScaleFilter=_scaleFilter;_expanded.Clear();}
    private async Task OpenGalleryAsync(){if(_galleryLoading)return;_galleryLoading=true;try{_galleryPhotos=await ProductionService.GetWarehouseGalleryAsync(Items.Select(x=>x.HandpanId).ToList());_showGallery=true;}finally{_galleryLoading=false;}}
    private void CloseGallery(){_showGallery=false;_galleryPreviewUrl=null;}
    private static string ThumbnailUrl(WarehouseGalleryPhotoDto photo)=>$"data:image/webp;base64,{Convert.ToBase64String(photo.Thumbnail)}";
    private async Task PreviewGalleryPhotoAsync(WarehouseGalleryPhotoDto photo)=>_galleryPreviewUrl=await PhotoService.DataUrlAsync(photo.HandpanId,photo.Id,false);
    private void CloseGalleryPreview()=>_galleryPreviewUrl=null;
    private void ToggleSelected(Guid id,bool selected){if(selected)_selected.Add(id);else _selected.Remove(id);}
    private void ToggleAllVisible(ChangeEventArgs e){var select=(bool?)e.Value==true;foreach(var item in Items.ToList()){if(select)_selected.Add(item.HandpanId);else _selected.Remove(item.HandpanId);}}
    private async Task DeleteAsync(WarehouseHandpanDto item){if(!await JS.InvokeAsync<bool>("confirm",$"ساز {item.SerialNumber} و تمام سوابق آن برای همیشه حذف شود؟"))return;await ProductionService.DeleteAsync(item.HandpanId);_items.Remove(item);_selected.Remove(item.HandpanId);}
    private bool RollbackBusy=>_rollbackCandidate is not null&&_rollingBack.Contains(_rollbackCandidate.HandpanId);
    private string RollbackMessage=>_rollbackCandidate is null?string.Empty:$"ساز {_rollbackCandidate.SerialNumber} به مرحله «در انتظار بسته‌بندی عادی» برگردد؟ اقلام بسته‌بندی مصرف‌شده نیز به موجودی انبار مواد اولیه بازمی‌گردند.";
    private void RequestRollback(WarehouseHandpanDto item){if(_rollingBack.Contains(item.HandpanId))return;_rollbackCandidate=item;_rollbackError=null;}
    private void CancelRollback(){if(RollbackBusy)return;_rollbackCandidate=null;_rollbackError=null;}
    private async Task ConfirmRollbackAsync(){var item=_rollbackCandidate;if(item is null||!_rollingBack.Add(item.HandpanId))return;_rollbackError=null;try{await ProductionService.RollbackAsync(item.HandpanId);_items.Remove(item);_selected.Remove(item.HandpanId);_rollbackCandidate=null;}catch{_rollbackError="بازگشت ساز انجام نشد. وضعیت ساز را دوباره بررسی کنید.";}finally{_rollingBack.Remove(item.HandpanId);}}
    private async Task ToggleAsync(WarehouseHandpanDto item){if(!_expanded.Add(item.HandpanId)){_expanded.Remove(item.HandpanId);return;}if(!_detailsLoaded.Contains(item.HandpanId))await LoadDetailsAsync(item);}
    private async Task RetryDetailsAsync(WarehouseHandpanDto item){_detailErrors.Remove(item.HandpanId);await LoadDetailsAsync(item);}
    private async Task LoadDetailsAsync(WarehouseHandpanDto item){if(!_detailsLoading.Add(item.HandpanId))return;try{var details=await ProductionService.GetWarehouseDetailsAsync(item.HandpanId);if(details is null)throw new InvalidOperationException();item.Operations=details.Operations;item.PackagingItems=details.PackagingItems;_detailsLoaded.Add(item.HandpanId);_detailErrors.Remove(item.HandpanId);}catch{_detailErrors.Add(item.HandpanId);}finally{_detailsLoading.Remove(item.HandpanId);}}
    private void BeginSale(WarehouseHandpanDto item){_selected.Clear();_selected.Add(item.HandpanId);OpenSale([item.HandpanId]);}
    private void BeginSelectedSale()=>OpenSale(_selected.ToList());
    private void OpenSale(IEnumerable<Guid> ids){_saleIds.Clear();_saleIds.AddRange(ids);_buyer="";_destination="";_partySearch="";_selectedPartyId=null;_isPaid=false;_dueDate=null;_price=null;_activateWarranty=false;_warrantyFullName="";_warrantyPhone="";_warrantyCity="";_saleError=null;}
    private void Cancel(){if(_saving)return;_saleIds.Clear();}
    private async Task SellAsync(){if(_saleIds.Count==0)return;if(_activateWarranty&&(string.IsNullOrWhiteSpace(_warrantyFullName)||string.IsNullOrWhiteSpace(_warrantyPhone)||string.IsNullOrWhiteSpace(_warrantyCity))){_saleError="برای فعال‌سازی گارانتی، نام مالک، شماره موبایل و شهر را کامل کنید.";return;}_saving=true;_saleError=null;try{var party=_parties.FirstOrDefault(x=>x.Id==_selectedPartyId);var result=await ProductionService.SellManyAsync(_saleIds,party?.Name??_buyer.Trim(),_price,_destination.Trim(),party?.Id,_isPaid,_dueDate,_activateWarranty,_warrantyFullName.Trim(),_warrantyPhone.Trim(),_warrantyCity.Trim());_items.RemoveAll(x=>_saleIds.Contains(x.HandpanId));_selected.Clear();_saleIds.Clear();if(!string.IsNullOrWhiteSpace(result?.Warning))await JS.InvokeVoidAsync("alert",result.Warning);}catch(HttpRequestException ex){_saleError=string.IsNullOrWhiteSpace(ex.Message)?"ثبت فروش انجام نشد.":"ثبت فروش انجام نشد؛ لطفاً دوباره تلاش کنید.";}finally{_saving=false;}}
}

    private async Task AddSourceAsync(){if(string.IsNullOrWhiteSpace(_newSource))return;try{var item=await AttributionService.AddSourceAsync(_newSource);if(item is not null){_attribution.Sources.Add(item);_leadSourceId=item.Id;_newSource="";}}catch(Exception ex){_saleError=ex.Message;}}
    private async Task AddReferrerAsync(){if(string.IsNullOrWhiteSpace(_newReferrer))return;try{var item=await AttributionService.AddReferrerAsync(_newReferrer);if(item is not null){_attribution.Referrers.Add(item);_referrerId=item.Id;_newReferrer="";}}catch(Exception ex){_saleError=ex.Message;}}
    private void SetSaleKind(bool isExport){_isExportSale=isExport;if(!isExport)_destination="";_saleError=null;}
    private void Cancel(){if(_saving)return;_saleIds.Clear();}
    private async Task SellAsync(){if(_saleIds.Count==0)return;_saving=true;_saleError=null;try{var party=_parties.FirstOrDefault(x=>x.Id==_selectedPartyId);var buyer=party?.Name??_buyer.Trim();var phone=party?.Phone??_buyerPhone.Trim();await ProductionService.SellManyAsync(_saleIds,buyer,phone,_price,_receivedAmount,(_isExportSale??false),_destination.Trim(),party?.Id,true,_leadSourceId,_referrerId,_priceCurrency,_netProfit,_profitCurrency,true);_items.RemoveAll(x=>_saleIds.Contains(x.HandpanId));_selected.Clear();_saleIds.Clear();}catch(HttpRequestException ex){_saleError=string.IsNullOrWhiteSpace(ex.Message)?"ثبت فروش انجام نشد.":ex.Message;}finally{_saving=false;}}

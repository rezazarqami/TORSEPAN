    private async Task OpenRequestedSaleAsync()
    {
        if(!_canSell||!SellHandpanId.HasValue||_openedSaleId==SellHandpanId)return;
        _openedSaleId=SellHandpanId;
        var item=_items.FirstOrDefault(x=>x.HandpanId==SellHandpanId);
        if(item is null){_error="این ساز در موجودی قابل فروش نیست؛ ممکن است قبلاً فروخته شده باشد.";return;}
        _activeWarehouseId=item.QualityWarehouseId;await BeginSale(item);
    }
    private async Task WarehouseTabKeyAsync(int id, KeyboardEventArgs e)
    {
        var next=e.Key switch {"ArrowLeft"=>id==3?1:id+1,"ArrowRight"=>id==1?3:id-1,"Home"=>1,"End"=>3,_=>0};
        if(next==0)return;await SelectWarehouse(next);await JS.InvokeVoidAsync("torsepanWarehouse.focusTab",next);
    }

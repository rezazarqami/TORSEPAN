    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            _canManage = user.IsInRole("Administrator");
            _canTransfer = _canManage || user.IsInRole("ProductionManager") || user.IsInRole("QualityControl");
            _canSell = _canManage || user.IsInRole("ProductionManager") || user.IsInRole("SalesAdmin");
            if(IsExport){_items=ExportItems!.ToList();_canTransfer=_canManage||user.IsInRole("ProductionManager")||user.IsInRole("SalesAdmin");_canSell=_canSell||user.IsInRole("Workshop");return;}
            var warehouses = ProductionService.GetInstrumentWarehousesAsync();
            var items = ProductionService.GetWarehouseAsync();
            await Task.WhenAll(warehouses, items);
            _warehouses = await warehouses;
            _items = (await items).ToList();
            await OpenRequestedSaleAsync();
        }
        catch (Exception e) { _error = e.Message; }
        finally { _loading = false; }
    }

    private Guid? _openedSaleId;
    protected override async Task OnParametersSetAsync()
    {
        if(!_loading)await OpenRequestedSaleAsync();

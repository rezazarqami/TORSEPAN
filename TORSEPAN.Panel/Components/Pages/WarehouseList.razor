@implements IAsyncDisposable
@page "/warehouse/list"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ProductionService ProductionService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject HandpanPhotoService PhotoService
@inject SalesAttributionService AttributionService
@inject IJSRuntime JS
@if(!IsExport){
<PageTitle>انبار سازها</PageTitle>
<section class="warehouse-hero instrument-hero inventory-photo-hero theme-hero theme-page-intro" aria-labelledby="inventory-title">
    <div class="inventory-hero-art" aria-hidden="true"><div></div><div></div><div></div></div>
    <svg class="inventory-hero-lines" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true"><path d="M340 170 C540 180 575 0 760 0"/><path d="M300 500 C480 380 565 410 710 500"/></svg>
    <div class="inventory-hero-copy">
        <span class="hero-kicker">INSTRUMENT INVENTORY</span>
        <h1 id="inventory-title">انبار سازها</h1>
        <div class="hero-stats"><span>موجودی کل</span><strong>@_items.Count</strong></div>
    </div>
    @if (_canManage) { <details class="warehouse-menu hero-menu"><summary aria-label="گزینه‌های مدیریت انبار">⋯</summary><div><button @onclick="OpenWarehouseManagement">مدیریت انبارها</button></div></details> }
</section>
}
<div class="navy-workspace-page navy-warehouse navy-instruments warehouse-redesign">
@if (!string.IsNullOrWhiteSpace(_notice)) { <div class="warehouse-notice" role="status">✓ @_notice <button aria-label="بستن پیام" @onclick="()=>_notice=null">×</button></div> }
@if(!IsExport){
<nav class="warehouse-tabs" role="tablist" aria-label="انبارهای ساز">
    @foreach (var warehouse in _warehouses)
    {
        <button type="button" id="warehouse-tab-@warehouse.Id" role="tab" aria-selected="@(_activeWarehouseId==warehouse.Id?"true":"false")" tabindex="@(_activeWarehouseId==warehouse.Id?0:-1)" @onkeydown="e=>WarehouseTabKeyAsync(warehouse.Id,e)" aria-controls="warehouse-inventory" class="warehouse-tab tier-@warehouse.Id @(_activeWarehouseId==warehouse.Id?"active":null)" @onclick="()=>SelectWarehouse(warehouse.Id)">
            <span class="warehouse-tier-icon"><InventoryGlyph Kind="@(warehouse.Id==1?"cube":warehouse.Id==2?"pulse":"layers")" /></span><span class="warehouse-tier-text"><small>انبار سازها</small><strong dir="auto">@warehouse.Name</strong></span>
            <b class="warehouse-tier-count" aria-label="@($"{_items.Count(x=>x.QualityWarehouseId==warehouse.Id)} ساز")">@_items.Count(x=>x.QualityWarehouseId==warehouse.Id)</b>
        </button>
    }
</nav>
}
<section class="warehouse-content-panel" id="warehouse-inventory" role="tabpanel" aria-label="@ActiveWarehouseName"><div class="warehouse-collection">
    <div class="warehouse-collection-heading"><span class="collection-icon"><InventoryGlyph Kind="cube" /></span><div><span class="collection-label">موجودی انبار</span><h2 dir="auto">@ActiveWarehouseName</h2></div><span class="collection-count"><InventoryGlyph Kind="check" /> @_items.Count(x=>(IsExport||x.QualityWarehouseId==_activeWarehouseId)) ساز آمادهٔ تحویل</span></div>
    <div class="warehouse-note-tabs" role="group" aria-label="فیلتر تعداد نت ساز">
    @foreach(var notes in new[]{9,10,11,12}){<button type="button" class="note-tab @(_noteFilter==notes?"active":null)" aria-pressed="@(_noteFilter==notes?"true":"false")" title="انتخاب دوباره برای نمایش همه تعداد نت‌ها" @onclick="()=>SelectNotesAsync(notes)"><InventoryGlyph Kind="music" /><strong>@notes نت</strong></button>}
    </div>
</div>
<div class="inventory-board">
    <div class="inventory-view-toolbar"><span>نوع نمایش</span><div class="inventory-view-switch" role="group" aria-label="نوع نمایش موجودی"><button type="button" class="@(!_galleryMode?"active":null)" aria-pressed="@(!_galleryMode?"true":"false")" @onclick="()=>SetViewAsync(false)"><InventoryGlyph Kind="list" />لیست</button><button type="button" class="@(_galleryMode?"active":null)" aria-pressed="@(_galleryMode?"true":"false")" @onclick="()=>SetViewAsync(true)"><InventoryGlyph Kind="grid" />پنجره‌ای</button></div>
    @if(_canSell||_canTransfer){<label class="stock-select-all"><input type="checkbox" aria-label="انتخاب همه سازهای نمایش‌داده‌شده" checked="@AllVisibleSelected" @onchange="ToggleAllVisible" /> انتخاب همه</label>}
    </div>
    @if(_loading){<div class="detail-loading" role="status"><span class="spinner-border spinner-border-sm"></span> دریافت موجودی…</div>}
    else if(!string.IsNullOrWhiteSpace(_error)){<div class="alert alert-danger">@_error</div>}
    else {
    @if(!Items.Any()){<EmptyState Title="سازی پیدا نشد" Description="این انبار برای تعداد نت انتخاب‌شده موجودی ندارد؛ با انتخاب دوبارهٔ تعداد نت، همهٔ سازها نمایش داده می‌شوند." />}
    @if(_galleryMode&&_galleryLoading){<div class="detail-loading" role="status">در حال دریافت عکس‌های موجودی…</div>}
    @if(_galleryMode&&_galleryError is not null){<div class="alert alert-warning">@_galleryError <button type="button" @onclick="LoadGalleryAsync">تلاش دوباره</button></div>}
    <div class="stock-list @(_galleryMode?"stock-grid":null)">
    @foreach(var item in Items){
        var photo=_galleryPhotos.FirstOrDefault(x=>x.HandpanId==item.HandpanId);
        <article @key="item.HandpanId" class="stock-item @(_selected.Contains(item.HandpanId)?"selected-row":null) @(_expanded.Contains(item.HandpanId)?"is-expanded":null)">
            @if(_galleryMode){<div class="stock-tile-image"><button type="button" aria-label="نمایش عکس ساز @item.SerialNumber" @onclick="()=>OpenTilePhotoAsync(item,photo)"><img loading="lazy" src="@(photo is null?"/images/production/handpan-no-photo.png":ThumbnailUrl(photo))" alt="@(photo is null?$"ساز {item.SerialNumber}؛ بدون عکس ثبت‌شده":$"عکس ساز {item.SerialNumber}")" /></button>@if(photo is null){<span>بدون عکس</span>}</div>}
            <div class="stock-summary">
                <button type="button" class="stock-expand" aria-label="جزئیات ساز @item.SerialNumber" aria-expanded="@(_expanded.Contains(item.HandpanId)?"true":"false")" disabled="@_detailsLoading.Contains(item.HandpanId)" @onclick="()=>ToggleAsync(item)">@if(_detailsLoading.Contains(item.HandpanId)){<span class="spinner-border spinner-border-sm"></span>}else{@(_expanded.Contains(item.HandpanId)?"−":"+")}</button>
                <div class="stock-code-block"><small>کد ساز</small><strong class="stock-code" dir="ltr">@item.SerialNumber</strong></div>
                <div class="stock-scale-block"><strong class="stock-scale" dir="auto">@item.ScaleName</strong><time class="stock-entry"><InventoryGlyph Kind="calendar" /><bdi>@EntryTime(item)</bdi></time></div>
                <span class="stock-material" dir="auto">@item.MaterialName</span>
                @if(_canSell||_canTransfer){<input class="stock-checkbox" type="checkbox" aria-label="انتخاب ساز @item.SerialNumber" checked="@_selected.Contains(item.HandpanId)" @onchange="e=>ToggleSelected(item.HandpanId,(bool?)e.Value==true)" />}
            </div>
            @if(_expanded.Contains(item.HandpanId)){
            <section class="stock-details" aria-label="جزئیات ساز @item.SerialNumber">
                <div class="instrument-detail-top">
                    <div class="warehouse-photo"><HandpanPhotoGallery HandpanId="@item.HandpanId" UseLineIcons="true" /></div>
                    <div class="instrument-facts"><div class="instrument-fact"><span class="fact-icon"><InventoryGlyph Kind="ingot" /></span><div><small>متریال</small><strong dir="auto">@item.MaterialName</strong></div></div><div class="instrument-fact"><span class="fact-icon"><InventoryGlyph Kind="sliders" /></span><div><small>اسکیل</small><strong dir="auto">@item.ScaleName</strong></div></div><div class="instrument-fact"><span class="fact-icon"><InventoryGlyph Kind="layers" /></span><div><small>وضعیت</small><strong class="warehouse-status"><i></i>انبار</strong></div></div>
                    <div class="instrument-location"><span><InventoryGlyph Kind="palette" /><span><small>دیزاین</small><b>@(item.DesignName??"…")</b></span></span><span><InventoryGlyph Kind="tag" /><span><small>کد کاسه زیر</small><b><bdi>@item.BottomBowlCode</bdi> <span class="bottom-design">(@(item.BottomDesignName??"…"))</span></b></span></span></div></div>
                </div>
                @if(_detailErrors.Contains(item.HandpanId)){<div class="alert alert-warning">دریافت جزئیات انجام نشد. <button type="button" @onclick="()=>RetryDetailsAsync(item)">تلاش دوباره</button></div>}
                else if(_detailsLoaded.Contains(item.HandpanId)){
                <div class="instrument-detail-lower">
                    <section class="warehouse-packaging"><h3><InventoryGlyph Kind="cube" /> اقلام بسته‌بندی</h3><div>@if(item.PackagingItems.Count==0){<span class="packaging-empty">اقلامی ثبت نشده است</span>}else{foreach(var packaging in item.PackagingItems){<div class="packaging-item"><InventoryGlyph Kind="@PackagingKind(packaging)" /><span>@packaging</span><i>✓</i></div>}}</div></section>
                    <section class="warehouse-history" aria-label="سوابق تولید"><div class="operation-tiles">@foreach(var op in item.Operations){<div class="operation-tile operation-@StageKey(op.Operation)"><div class="operation-title"><InventoryGlyph Kind="@OperationKind(op.Operation)" /><strong>@op.Operation</strong></div><div class="operation-person"><span><InventoryGlyph Kind="user" />@op.PerformedBy</span><time><InventoryGlyph Kind="calendar" /><bdi>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</bdi></time></div></div>}</div></section>
                </div>
                @if(item.Notes.Count>0||!string.IsNullOrWhiteSpace(item.OrderCustomerName)){<div class="warehouse-notes">@if(!string.IsNullOrWhiteSpace(item.OrderCustomerName)){<strong>سفارش @item.OrderCustomerName</strong>}@foreach(var note in item.Notes){<p>@note</p>}</div>}
                }else{<div class="detail-loading" role="status">در حال دریافت سوابق و اقلام بسته‌بندی…</div>}
                <footer class="warehouse-row-actions">@if(_canTransfer){<button type="button" class="row-transfer" @onclick="()=>BeginTransfer(item)"><InventoryGlyph Kind="transfer" />انتقال</button>}@if(_canSell){<button type="button" @onclick="()=>BeginSale(item)"><InventoryGlyph Kind="cart" />ثبت فروش</button>}<AuthorizeView Roles="Administrator">@if(!IsExport){<button type="button" disabled="@_rollingBack.Contains(item.HandpanId)" @onclick="()=>RequestRollback(item)"><InventoryGlyph Kind="undo" />بازگشت</button>}<button type="button" class="row-delete" @onclick="()=>DeleteAsync(item)"><InventoryGlyph Kind="trash" />حذف</button></AuthorizeView></footer>
            </section>}
        </article>
    }
    </div>}
</div>
@BeforeBulkActions
@if(_canSell||_canTransfer){<footer class="warehouse-selection-bar"><span>@(SelectedVisibleCount>0?$"{SelectedVisibleCount} ساز انتخاب‌شده":"برای عملیات گروهی، سازها را انتخاب کنید")</span><div>@if(_canTransfer){<button type="button" class="transfer-selected" disabled="@(SelectedVisibleCount==0)" @onclick="BeginSelectedTransfer"><InventoryGlyph Kind="transfer" /> انتقال به انبار دیگر</button>}@if(_canSell){<button type="button" class="bulk-sale-button" disabled="@(SelectedVisibleCount==0)" @onclick="BeginSelectedSale"><InventoryGlyph Kind="cart" /> ثبت فروش <span>@SelectedVisibleCount</span></button>}</div></footer>}
</section>

@if (_manageWarehouses)
{
    <div class="warehouse-dialog-overlay" @onclick="CloseWarehouseManagement"><section class="warehouse-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="warehouse-settings-title" @onclick:stopPropagation="true">
        <header><div><small>تنظیمات انبار</small><h3 id="warehouse-settings-title">مدیریت انبارها</h3></div><button aria-label="بستن مدیریت انبارها" disabled="@_renameBusyId.HasValue" @onclick="CloseWarehouseManagement">×</button></header>
        <p class="dialog-hint">نام هر انبار را تغییر دهید؛ سازهای داخل آن در همان رده باقی می‌مانند.</p>
        <div class="warehouse-settings-list">@foreach(var warehouse in _warehouses){<div class="warehouse-name-row"><span class="tier-dot tier-@warehouse.Id"></span><label><span>انبار @warehouse.Id</span><input class="form-control" aria-label="نام انبار @warehouse.Id" maxlength="60" @bind="_warehouseNames[warehouse.Id]" /></label><button class="btn" disabled="@(_renameBusyId.HasValue || string.IsNullOrWhiteSpace(_warehouseNames[warehouse.Id]) || _warehouseNames[warehouse.Id].Trim()==warehouse.Name)" @onclick="()=>RenameWarehouseAsync(warehouse.Id)">@(_renameBusyId==warehouse.Id?"ذخیره…":"ذخیره")</button></div>}</div>
        @if (!string.IsNullOrWhiteSpace(_manageError)) { <div class="dialog-error" role="alert">@_manageError <button class="btn btn-sm btn-light" disabled="@_renameBusyId.HasValue" @onclick="ReloadWarehousesAsync">دریافت اطلاعات تازه</button></div> }
        <footer><button class="btn btn-light" disabled="@_renameBusyId.HasValue" @onclick="CloseWarehouseManagement">بستن</button></footer>
    </section></div>
}
@if (_transferItems.Count>0)
{
    <div class="warehouse-dialog-overlay" @onclick="CancelTransfer"><section class="warehouse-transfer-dialog" role="dialog" aria-modal="true" aria-labelledby="warehouse-transfer-title" @onclick:stopPropagation="true">
        <header><div><small>جابه‌جایی موجودی</small><h3 id="warehouse-transfer-title">انتقال @(_transferItems.Count==1?"ساز":$"{_transferItems.Count} ساز")</h3></div><button aria-label="بستن انتقال" disabled="@_transferring" @onclick="CancelTransfer">×</button></header>
        <div class="transfer-codes">@foreach(var row in _transferItems){<span dir="ltr">@row.SerialNumber</span>}</div>
        <div class="transfer-route"><div><small>انبار فعلی</small><strong dir="auto">@TransferSourceName</strong></div><span aria-hidden="true">←</span><div><small>انبار مقصد</small><button type="button" class="transfer-picker-trigger" disabled="@_transferring" aria-expanded="@_showTransferOptions" @onclick="()=>_showTransferOptions=!_showTransferOptions">@TransferTargetName <span>⌄</span></button></div></div>
        @if (_showTransferOptions)
        {
            <div class="transfer-options" role="group" aria-label="انتخاب انبار مقصد">
                @foreach(var warehouse in _warehouses)
                {
                    <button type="button" disabled="@_transferring" class="@(_transferWarehouseId==warehouse.Id?"selected":"")" @onclick="()=>SelectTransferWarehouse(warehouse.Id)">@warehouse.Name</button>
                }
                <button type="button" disabled="@_transferring" class="@(_transferWarehouseId==0?"selected":"")" aria-expanded="@(_transferWarehouseId==0)" @onclick="()=>SelectTransferWarehouse(0)">انبار صادراتی <span>⌄</span></button>
            </div>
        }
        @if (_transferWarehouseId==0)
        {
            <div class="transfer-locations" role="group" aria-label="مقصد انبار صادراتی">
                @foreach(var location in new (int Id,string Name)[]{(4,"ایران 🇮🇷"),(1,"ترکیه 🇹🇷"),(2,"لندن 🇬🇧"),(3,"آلمان 🇩🇪"),(5,"مصر 🇪🇬"),(6,"ریاض 🇸🇦"),(7,"لبنان 🇱🇧")})
                {
                    <button type="button" disabled="@_transferring" class="@(_transferExportLocation==location.Id?"selected":"")" aria-pressed="@(_transferExportLocation==location.Id)" @onclick="()=>SelectTransferLocation(location.Id)">@location.Name</button>
                }
            </div>
        }
        <p class="dialog-hint">مقصد انبار را انتخاب کنید؛ سوابق تولید و اقلام بسته‌بندی حفظ می‌شوند.</p>
        @if (!string.IsNullOrWhiteSpace(_transferError)) { <div class="dialog-error" role="alert">@_transferError <button class="btn btn-sm btn-light" disabled="@_transferring" @onclick="ReloadInventoryAsync">دریافت موجودی تازه</button></div> }
        <footer><button class="btn btn-light" disabled="@_transferring" @onclick="CancelTransfer">انصراف</button><button class="btn btn-primary" disabled="@(_transferring||!_transferWarehouseId.HasValue||(_transferWarehouseId==0&&!_transferExportLocation.HasValue))" @onclick="ConfirmTransferAsync">@(_transferring?"در حال انتقال…":"تأیید انتقال")</button></footer>
    </section></div>
}

<AppConfirmDialog IsOpen="@(_rollbackCandidate is not null)"
                  Title="بازگشت از انبار سازها"
                  Message="@RollbackMessage"
                  ConfirmText="بازگشت به بسته‌بندی"
                  Error="@_rollbackError"
                  Busy="@RollbackBusy"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />

@if(_galleryPreviewUrl is not null){<div class="gallery-preview-overlay" @onclick="CloseGalleryPreview"><button aria-label="بستن" @onclick="CloseGalleryPreview">×</button><figure><img src="@_galleryPreviewUrl" alt="نمایش بزرگ عکس ساز" /><figcaption>@_previewInstrument?.SerialNumber · @_previewInstrument?.MaterialName · @_previewInstrument?.ScaleName</figcaption></figure></div>}

@if(_saleIds.Count > 0)
{
    <div class="sale-overlay" role="presentation" @onclick="Cancel">
        <section class="sale-dialog" role="dialog" aria-modal="true" aria-labelledby="sale-title" @onclick:stopPropagation="true">
            <header><div><span class="sale-eyebrow">ثبت خروج از انبار</span><h3 id="sale-title">@(_saleIds.Count==1?$"فروش ساز {SaleCodes.FirstOrDefault()}":$"فروش گروهی {_saleIds.Count} ساز")</h3></div><button class="sale-close" aria-label="بستن" @onclick="Cancel">×</button></header>
            @if(_saleIds.Count>1){<div class="selected-sales">@foreach(var saleCode in SaleCodes){<span>@saleCode</span>}</div>}
            <div class="sale-fields">
                <label><span>خریدار از حسابداری</span><select class="form-select" @bind="_selectedPartyId"><option value="">انتخاب نشده</option>@foreach(var p in _parties){<option value="@p.Id">@p.DisplayName @(string.IsNullOrWhiteSpace(p.Phone)?"":$"— {p.Phone}")</option>}</select></label>
                <label><span>نام خریدار آزاد</span><input class="form-control" @bind="_buyer" placeholder="اختیاری" /></label>
                <label><span>شماره تلفن خریدار</span><input class="form-control" inputmode="tel" @bind="_buyerPhone" placeholder="اختیاری" /></label>
                <div class="sale-money-group wide"><SaleMoneyInput Id="sale-price" Label="قیمت فروش" @bind-Amount="_price" @bind-Currency="_priceCurrency" /></div>
                <div class="sale-money-group wide"><SaleMoneyInput Id="sale-profit" Label="سود خالص" @bind-Amount="_netProfit" @bind-Currency="_profitCurrency" /></div>
                <label><span>مبلغ دریافتی @(_priceCurrency==2?"(USD)":"(تومان)")</span><input type="number" min="0" step="@(_priceCurrency==2?"0.01":"1")" class="form-control" @bind="_receivedAmount" placeholder="اختیاری" /></label>
                <label><span>مبلغ مانده</span><input class="form-control" value="@RemainingAmountText" disabled /></label>
                <fieldset class="wide sale-kind-field">
                    <legend>نوع فروش</legend>
                    <label><input type="radio" name="sale-kind" checked="@(_isExportSale==false)" @onchange="()=>SetSaleKind(false)" /><span>داخلی</span></label>
                    <label><input type="radio" name="sale-kind" checked="@(_isExportSale==true)" @onchange="()=>SetSaleKind(true)" /><span>صادراتی</span></label>
                </fieldset>
                @if(_isExportSale==true){<label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="مثلاً کانادا (اختیاری)" /></label>}
                <label><span>نحوه آشنایی</span><select class="form-select" @bind="_leadSourceId" @bind:after="LeadSourceChanged"><option value="">انتخاب نشده</option>@foreach(var source in _attribution.Sources){<option value="@source.Id">@source.Name</option>}</select></label>
                <div class="inline-add"><input class="form-control" @bind="_newSource" placeholder="روش جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddSourceAsync">افزودن</button></div>
                @if(SelectedSourceRequiresReferrer){<label><span>نام معرف (اختیاری)</span><select class="form-select" @bind="_referrerId"><option value="">انتخاب معرف</option>@foreach(var item in _attribution.Referrers){<option value="@item.Id">@item.Name</option>}</select></label><div class="inline-add"><input class="form-control" @bind="_newReferrer" placeholder="نام معرف جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddReferrerAsync">افزودن</button></div>}
                <label class="paid-field wide"><input type="checkbox" checked disabled /><span>فعال‌سازی گارانتی</span></label>
            </div>
            @if(!string.IsNullOrWhiteSpace(_saleError)){<div class="sale-error">@_saleError</div>}
            <footer><button class="btn btn-light" disabled="@_saving" @onclick="Cancel">انصراف</button><button class="btn btn-success" disabled="@_saving" @onclick="SellAsync">@if(_saving){<span class="spinner-border spinner-border-sm"></span>} ثبت فروش @(_saleIds.Count>1?$"{_saleIds.Count} ساز":"")</button></footer>
        </section>
    </div>
}

</div>

@code {
    [Parameter] public IReadOnlyList<WarehouseHandpanDto>? ExportItems { get; set; }
    [Parameter] public string ExportWarehouseName { get; set; }="انبار صادراتی";
    [Parameter] public RenderFragment? BeforeBulkActions { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Guid>> ExportSale { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Guid>> ExportTransfer { get; set; }
    [Parameter] public EventCallback<Guid> ExportDeleted { get; set; }
    private bool IsExport=>ExportItems is not null;
    [SupplyParameterFromQuery(Name="sell")] public Guid? SellHandpanId { get; set; }
    private List<WarehouseHandpanDto> _items=[]; private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties=[];
    private readonly HashSet<Guid> _expanded=[]; private readonly HashSet<Guid> _selected=[]; private readonly HashSet<Guid> _detailsLoaded=[]; private readonly HashSet<Guid> _detailsLoading=[]; private readonly HashSet<Guid> _detailErrors=[]; private readonly HashSet<Guid> _rollingBack=[]; private readonly List<Guid> _saleIds=[];
    private bool _canSell, _canTransfer, _canManage, _manageWarehouses, _transferring;
    private int _activeWarehouseId=1;
    private int? _noteFilter; private bool _galleryMode; private int _galleryGeneration; private string? _galleryError;
    private int? _renameBusyId, _transferWarehouseId, _transferExportLocation;
    private bool _showTransferOptions;
    private string TransferSourceName => string.Join("، ",_transferItems.Select(x=>_warehouses.FirstOrDefault(w=>w.Id==x.QualityWarehouseId)?.Name??"انبار").Distinct());
    private string TransferTargetName => _transferWarehouseId==0?"انبار صادراتی":_warehouses.FirstOrDefault(x=>x.Id==_transferWarehouseId)?.Name??"انتخاب کنید";
    private void SelectTransferLocation(int id){_transferExportLocation=id;_showTransferOptions=false;}
    private void SelectTransferWarehouse(int id){_transferWarehouseId=id;_transferExportLocation=null;_showTransferOptions=false;}

    private List<InstrumentWarehouseDto> _warehouses=InstrumentWarehouseDto.Defaults();
    private Dictionary<int,string> _warehouseNames=[];
    private List<WarehouseHandpanDto> _transferItems=[];
    private string? _notice, _manageError, _transferError;
    private string ActiveWarehouseName=>IsExport?ExportWarehouseName:_warehouses.FirstOrDefault(x=>x.Id==_activeWarehouseId)?.Name??"Economy";
    private int SelectedVisibleCount=>Items.Count(x=>_selected.Contains(x.HandpanId));

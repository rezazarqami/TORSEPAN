    private static string OperationKind(string operation)=>operation.Contains("دیمپل")?"bowl":operation.Contains("شیپ")?"cube":operation.Contains("فاین")?"tune":operation.Contains("تیون")?"cube":operation.Contains("QC")||operation.Contains("کیفیت")?"qc":"cube";
    private void OpenWarehouseManagement(){if(!_canManage)return;_warehouseNames=_warehouses.ToDictionary(x=>x.Id,x=>x.Name);_manageError=null;_manageWarehouses=true;}
    private void CloseWarehouseManagement(){if(!_renameBusyId.HasValue)_manageWarehouses=false;}
    private async Task ReloadWarehousesAsync(){try{_warehouses=await ProductionService.GetInstrumentWarehousesAsync(forceRefresh:true);_manageError=null;}catch(Exception ex){_manageError=ex.Message;}}
    private async Task RenameWarehouseAsync(int id){if(!_canManage||_renameBusyId.HasValue)return;_renameBusyId=id;_manageError=null;try{var item=_warehouses.Single(x=>x.Id==id);var updated=await ProductionService.RenameWarehouseAsync(id,_warehouseNames[id],item.Version);if(updated is null)throw new InvalidOperationException("ذخیره نام انجام نشد.");item.Name=updated.Name;item.Version=updated.Version;_warehouseNames[id]=item.Name;_notice="نام انبار ذخیره شد.";}catch(Exception ex){_manageError=ex.Message;}finally{_renameBusyId=null;}}
    private async Task BeginTransfer(WarehouseHandpanDto item){if(!_canTransfer)return;if(IsExport){await ExportTransfer.InvokeAsync(new List<Guid>{item.HandpanId});return;}_transferItems=[item];_transferWarehouseId=null;_transferExportLocation=null;_showTransferOptions=true;_transferError=null;}
    private async Task BeginSelectedTransfer(){if(!_canTransfer)return;if(IsExport){await ExportTransfer.InvokeAsync(Items.Where(x=>_selected.Contains(x.HandpanId)).Select(x=>x.HandpanId).ToList());return;}_transferItems=Items.Where(x=>_selected.Contains(x.HandpanId)).ToList();_transferWarehouseId=null;_transferExportLocation=null;_showTransferOptions=true;_transferError=null;}
    private void CancelTransfer(){if(!_transferring)_transferItems=[];}
    private async Task ReloadInventoryAsync(){try{_items=(await ProductionService.GetWarehouseAsync()).ToList();_transferItems=[];_selected.Clear();_transferError=null;_notice="موجودی تازه دریافت شد؛ سازها را دوباره انتخاب کنید.";}catch(Exception ex){_transferError=ex.Message;}}
    private async Task ConfirmTransferAsync(){if(_transferring||!_canTransfer||!_transferWarehouseId.HasValue||(_transferWarehouseId==0&&!_transferExportLocation.HasValue)||_transferItems.Count==0)return;_transferring=true;_transferError=null;try{var result=await ProductionService.TransferWarehouseAsync(_transferWarehouseId.Value,_transferItems.Select(x=>new WarehouseMoveItem(x.HandpanId,x.Version)).ToList(),_transferWarehouseId==0?_transferExportLocation:null);if(result.Count!=_transferItems.Count)throw new InvalidOperationException("پاسخ انتقال کامل نیست؛ موجودی را تازه کنید.");foreach(var row in result){var item=_items.Single(x=>x.HandpanId==row.HandpanId);item.QualityWarehouseId=row.QualityWarehouseId;item.Version=row.Version;if(row.Stage=="ExportWarehouse")_items.Remove(item);}_notice=$"{result.Count} ساز به {TransferTargetName} منتقل شد.";_transferItems=[];_selected.Clear();_expanded.Clear();}catch(Exception ex){_transferError=ex.Message;}finally{_transferring=false;}}

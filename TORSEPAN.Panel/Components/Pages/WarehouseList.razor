    private Task BeginSelectedSale()=>OpenSale(Items.Where(x=>_selected.Contains(x.HandpanId)).Select(x=>x.HandpanId).ToList());
    private bool _saleOptionsLoaded, _saleOptionsLoading;
    private async Task OpenSale(IEnumerable<Guid> ids){
        if(IsExport){await ExportSale.InvokeAsync(ids.ToList());return;}
        if(_saleOptionsLoading)return;
        if(!_saleOptionsLoaded){
            _saleOptionsLoading=true;
            try{
                var parties=AccountingService.PartiesAsync();
                var attribution=AttributionService.OptionsAsync();
                await Task.WhenAll(parties,attribution);
                _parties=await parties;_attribution=await attribution;_saleOptionsLoaded=true;
            }catch(Exception ex){_error="دریافت اطلاعات فروش انجام نشد: "+ex.Message;_openedSaleId=null;return;}
            finally{_saleOptionsLoading=false;}
        }
_saleIds.Clear();_saleIds.AddRange(ids);_buyer="";_buyerPhone="";_destination="";_selectedPartyId=null;_leadSourceId=null;_referrerId=null;_isExportSale=false;_netProfit=null;_priceCurrency=_profitCurrency=1;_price=null;_receivedAmount=null;_saleError=null;
        var names=_items.Where(x=>_saleIds.Contains(x.HandpanId)).Select(x=>x.OrderCustomerName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().ToList();
        if(names.Count==1)_buyer=names[0]!;
    }

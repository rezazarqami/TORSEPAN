@page "/warehouse/list"
@inject ProductionService ProductionService
@inject IJSRuntime JS
<PageTitle>انبار سازها</PageTitle><PageHeader Title="انبار سازها" SubTitle="سازهای بسته‌بندی‌شده و آماده فروش" />
<div class="mb-4"><input class="form-control" placeholder="جست‌وجوی کد ساز، کاسه، متریال یا اسکیل..." @bind="_search" @bind:event="oninput" /></div>
<Card>@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}else if(!string.IsNullOrWhiteSpace(_error)){<div class="alert alert-danger">@_error</div>}else{<DataTable><thead><tr><th></th><th>کد ساز</th><th>کاسه رو</th><th>کاسه زیر</th><th>متریال</th><th>اسکیل</th><th>تاریخ ورود</th><th>فروش</th><th>حذف</th></tr></thead><tbody>
@if(!Items.Any()){<tr><td colspan="8"><EmptyState Title="انبار خالی است" Description="ساز آماده فروشی در انبار وجود ندارد." /></td></tr>}
@foreach(var item in Items){<tr><td><button class="btn btn-sm btn-outline-primary" @onclick="()=>Toggle(item.HandpanId)">@(_expanded.Contains(item.HandpanId)?"−":"+")</button></td><td>@item.SerialNumber</td><td>@item.TopBowlCode</td><td>@item.BottomBowlCode</td><td>@item.MaterialName</td><td>@item.ScaleName</td><td>@(item.WarehouseEntryDate.HasValue?PersianDateTime.FormatDateTime(item.WarehouseEntryDate.Value):null??"—")</td><td><button class="btn btn-sm btn-success" @onclick="()=>BeginSale(item)">فروخته شد</button></td><td><AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item)">حذف</button></AuthorizeView></td></tr>
@if(_expanded.Contains(item.HandpanId)){<tr class="table-light"><td></td><td colspan="8"><div class="p-3"><h6>اقلام بسته‌بندی ساز @item.SerialNumber</h6><div class="mb-3">@if(item.PackagingItems.Count==0){<span class="text-muted">ثبت نشده</span>}else{@foreach(var p in item.PackagingItems){<span class="badge bg-success me-2">✓ @p</span>}}</div><table class="table table-sm table-bordered"><thead><tr><th>عملیات</th><th>انجام‌دهنده</th><th>زمان</th></tr></thead><tbody>@foreach(var op in item.Operations){<tr><td>@op.Operation</td><td>@op.PerformedBy</td><td>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</td></tr>}</tbody></table></div></td></tr>}}
</tbody></DataTable>}</Card>
@if(_selling is not null){<div class="modal d-block" style="background:rgba(0,0,0,.45)"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5>ثبت فروش ساز @_selling.SerialNumber</h5><button class="btn-close" @onclick="Cancel"></button></div><div class="modal-body"><label class="form-label">نام خریدار</label><input class="form-control mb-3" @bind="_buyer" /><label class="form-label">قیمت</label><input type="number" min="0" class="form-control mb-3" @bind="_price" /><label class="form-label">مقصد</label><input class="form-control" @bind="_destination" placeholder="مثلاً کانادا" />@if(!string.IsNullOrWhiteSpace(_saleError)){<div class="text-danger mt-2">@_saleError</div>}</div><div class="modal-footer"><button class="btn btn-secondary" @onclick="Cancel">انصراف</button><button class="btn btn-success" disabled="@_saving" @onclick="SellAsync">ثبت فروش و خروج از انبار</button></div></div></div></div>}
@code{private List<WarehouseHandpanDto> _items=[];private bool _loading=true,_saving;private string _search="";private string? _error,_saleError;private HashSet<Guid> _expanded=[];private WarehouseHandpanDto? _selling;private string _buyer="",_destination="";private decimal _price;private IEnumerable<WarehouseHandpanDto> Items=>string.IsNullOrWhiteSpace(_search)?_items:_items.Where(x=>x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.TopBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BottomBowlCode.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync(){try{_items=(await ProductionService.GetWarehouseAsync()).ToList();}catch(Exception e){_error=e.Message;}finally{_loading=false;}}private async Task DeleteAsync(WarehouseHandpanDto item){if(!await JS.InvokeAsync<bool>("confirm",$"ساز {item.SerialNumber} و تمام سوابق آن برای همیشه حذف شود؟"))return;await ProductionService.DeleteAsync(item.HandpanId);_items.Remove(item);}private void Toggle(Guid id){if(!_expanded.Add(id))_expanded.Remove(id);}private void BeginSale(WarehouseHandpanDto x){_selling=x;_buyer="";_destination="";_price=0;_saleError=null;}private void Cancel(){_selling=null;}private async Task SellAsync(){if(_selling is null)return;if(string.IsNullOrWhiteSpace(_buyer)||string.IsNullOrWhiteSpace(_destination)){_saleError="نام خریدار و مقصد را وارد کنید.";return;}_saving=true;try{await ProductionService.SellAsync(_selling.HandpanId,_buyer.Trim(),_price,_destination.Trim());_items.Remove(_selling);_selling=null;}catch{_saleError="ثبت فروش انجام نشد.";}finally{_saving=false;}}}



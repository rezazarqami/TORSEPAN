@page "/warehouse/list"

<PageTitle>انبار</PageTitle>

<PageHeader Title="انبار"
            SubTitle="موجودی">

    <Actions>

        <PrimaryButton Text="ثبت کالا" />

    </Actions>

</PageHeader>

<SearchBox Placeholder="جستجو..." />

<Card>

    <DataTable>

        <thead>

            <tr>

                <th>کد</th>
                <th>نام</th>
                <th>تعداد</th>
                <th>محل نگهداری</th>

            </tr>

        </thead>

        <tbody>

            <tr>

                <td colspan="4">

                    <EmptyState Title="انبار خالی است"
                                Description="هیچ کالایی ثبت نشده است." />

                </td>

            </tr>

        </tbody>

    </DataTable>

</Card>
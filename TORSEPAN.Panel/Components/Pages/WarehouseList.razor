@page "/warehouse/list"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ProductionService ProductionService

<PageTitle>انبار</PageTitle>

<PageHeader Title="انبار" SubTitle="سازهای بسته‌بندی‌شده" />

<div class="mb-4">
    <input class="form-control"
           placeholder="جستجوی کد ساز، کاسه، متریال یا اسکیل..."
           @bind="_search"
           @bind:event="oninput" />
</div>

<Card>
    @if (_loading)
    {
        <div class="text-center p-4"><div class="spinner-border"></div></div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <DataTable>
            <thead>
                <tr>
                    <th style="width: 48px;"></th>
                    <th>کد ساز</th>
                    <th>کد کاسه بالا</th>
                    <th>کد کاسه پایین</th>
                    <th>متریال</th>
                    <th>اسکیل</th>
                    <th>تاریخ ورود</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredItems.Any())
                {
                    <tr>
                        <td colspan="7">
                            <EmptyState Title="انبار خالی است" Description="هنوز هیچ ساز بسته‌بندی‌شده‌ای وارد انبار نشده است." />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"
                                        title="نمایش عملیات انجام‌شده"
                                        @onclick="() => ToggleDetails(item.HandpanId)">
                                    @(_expanded.Contains(item.HandpanId) ? "−" : "+")
                                </button>
                            </td>
                            <td>@item.SerialNumber</td>
                            <td>@item.TopBowlCode</td>
                            <td>@item.BottomBowlCode</td>
                            <td>@item.MaterialName</td>
                            <td>@item.ScaleName</td>
                            <td>@(item.WarehouseEntryDate?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        </tr>
                        @if (_expanded.Contains(item.HandpanId))
                        {
                            <tr class="table-light">
                                <td></td>
                                <td colspan="6">
                                    <div class="p-3">
                                        <h6 class="mb-3">عملیات انجام‌شده روی ساز @item.SerialNumber</h6>
                                        <div class="mb-4">
                                            <strong>اقلام استفاده‌شده در بسته‌بندی:</strong>
                                            @if (item.PackagingItems.Count == 0)
                                            {
                                                <span class="text-muted me-2">برای این ساز ثبت نشده است.</span>
                                            }
                                            else
                                            {
                                                @foreach (var packagingItem in item.PackagingItems)
                                                {
                                                    <span class="badge bg-success me-2 mb-1">✓ @packagingItem</span>
                                                }
                                            }
                                        </div>
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr>
                                                    <th>عملیات</th>
                                                    <th>انجام‌دهنده</th>
                                                    <th>زمان انجام</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var operation in item.Operations)
                                                {
                                                    <tr>
                                                        <td>@operation.Operation</td>
                                                        <td>@operation.PerformedBy</td>
                                                        <td>@(operation.PerformedAt == default
                                                            ? "-"
                                                            : operation.PerformedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </DataTable>
    }
</Card>

@code {
    private readonly List<WarehouseHandpanDto> _items = [];
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private readonly HashSet<Guid> _expanded = [];

    private IEnumerable<WarehouseHandpanDto> FilteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x =>
                x.SerialNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                x.TopBowlCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                x.BottomBowlCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                x.MaterialName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                x.ScaleName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items.AddRange(await ProductionService.GetWarehouseAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleDetails(Guid handpanId)
    {
        if (!_expanded.Add(handpanId))
            _expanded.Remove(handpanId);
    }
}

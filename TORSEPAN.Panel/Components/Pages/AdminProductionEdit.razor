@page "/admin/production-edit"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles="Administrator")]
@using TORSEPAN.Application.Auth.Queries.GetUsers
@inject AdminProductionEditService EditService
@inject ScaleService ScaleService
@inject IUserService UserService

<PageTitle>ویرایش اطلاعات تولید</PageTitle>

<section class="edit-hero theme-hero theme-page-intro">
    <div class="edit-hero-copy"><small>ابزار اختصاصی مدیر سیستم</small><h1>ویرایش شناسنامه تولید</h1><p>کد ساز یا کاسه را وارد کنید؛ اطلاعات در هر مرحله‌ای از تولید، انبار یا فروش قابل بازیابی است.</p></div>
</section>

<section class="edit-lookup" aria-labelledby="production-search-title">
    <header><h2 id="production-search-title">جست‌وجوی شناسنامه</h2><p>با واردکردن کد، اسکیل‌ها، تعداد نوت و سوابق تولید برای ویرایش نمایش داده می‌شوند.</p></header>
    <EditForm Model="_search" OnValidSubmit="SearchAsync" class="edit-search">
        <label for="production-code">کد ساز یا کاسه</label>
        <div class="edit-search-controls"><InputText id="production-code" @bind-Value="_search.Code" autocomplete="off" placeholder="مثلاً 7113" /><button type="submit" disabled="@_loading">@if(_loading){<span class="spinner-border spinner-border-sm"></span>}else{<span>جست‌وجو</span>}</button></div>
    </EditForm>
</section>

@if(!string.IsNullOrWhiteSpace(_message))
{
    <div class="edit-message @(_record is not null?"save-feedback":"") @(_messageError?"error":"success")" role="@(_messageError?"alert":"status")" aria-live="polite"><span>@_message</span><button type="button" aria-label="بستن پیام" @onclick="()=>_message=null">×</button></div>
}

@if(_record is not null)
{
    <section class="identity-card">
        <div><small>شناسنامه بازیابی‌شده</small><h2>@_record.Code</h2><p>@_record.ItemType • @_record.StatusTitle</p></div>
        <span class="stage-pill">@_record.StageTitle</span>
    </section>

    <section class="edit-section">
        <header><div><small>تنظیمات فنی</small><h3>Scale و تعداد نوت کاسه‌ها</h3></div><span>@_record.Bowls.Count کاسه مرتبط</span></header>
        <div class="scale-grid">
            @if(_record.HandpanId.HasValue)
            {
                <article class="scale-card handpan-scale"><div class="card-icon">🎵</div><div class="scale-copy"><small>Scale نهایی ساز</small><strong>@_record.Code</strong><span>هماهنگ با شناسنامه ساز</span></div><label><span>انتخاب Scale</span><select @bind="_record.HandpanScaleId"><option value="">بدون Scale</option>@foreach(var scale in ScalesFor(4)){<option value="@scale.Id">@scale.Name</option>}</select></label></article>
            }
            @foreach(var bowl in _record.Bowls)
            {
                <article class="scale-card"><div class="card-icon">🥣</div><div class="scale-copy"><small>@bowl.BowlType</small><strong>@bowl.Code</strong><span>@bowl.Material • @bowl.StageTitle</span></div><label><span>Scale این کاسه</span><select @bind="bowl.ScaleId"><option value="">بدون Scale</option>@foreach(var scale in ScalesFor(bowl.BowlType.Contains("رو")?1:2)){<option value="@scale.Id">@scale.Name</option>}</select></label><label><span>تعداد نوت ثبت‌شده در شیپ</span><input type="number" min="@(bowl.BowlType=="کاسه رو"?1:0)" step="1" @bind="bowl.NoteCount" placeholder="نامشخص" disabled="@(bowl.BowlType=="کاسه زیر خام")" /><small>خالی: تعداد نوت بدون تغییر می‌ماند</small></label></article>
            }
        </div>
    </section>

    <section class="edit-section operations-section">
        <header><div><small>سابقه تولید</small><h3>تاریخ، ساعت و ثبت‌کننده مراحل</h3></div><span>@_record.Events.Count عملیات</span></header>
        @if(_record.Events.Count==0)
        {
            <p class="empty-events">هنوز عملیاتی برای این کد ثبت نشده است.</p>
        }
        else
        {
            <div class="event-list">
                @foreach(var item in _record.Events)
                {
                    <article class="event-card" @key="item.Id">
                        <div class="event-mark">@ActionIcon(item.Action)</div>
                        <div class="event-title"><strong>@item.ActionTitle</strong><span>@item.RelatedCode</span></div>
                        <div class="event-meta"><span>@PersianDateTime.FormatDateTime(item.EventDate)</span><small>@item.Duration</small></div>
                        <label><span>ثبت‌کننده</span><select @bind="item.UserId">@foreach(var user in _users){<option value="@user.Id">@UserLabel(user)</option>}</select></label>
                        <div class="event-date-editor"><label><span>تاریخ ثبت (شمسی)</span><PersianDatePicker @bind-Value="_dates[item.Id].Date" /></label><label><span>ساعت ثبت (به وقت ایران)</span><input type="time" step="1" value="@_dates[item.Id].Time" @onchange="e=>_dates[item.Id].Time=e.Value?.ToString()??string.Empty" disabled="@_saving" /></label></div>
                        @if(!string.IsNullOrWhiteSpace(item.Description)){<p>@item.Description</p>}
                    </article>
                }
            </div>
        }
        <footer><button class="save-button" @onclick="RequestSave" disabled="@_saving">ذخیره همه تغییرات</button><button class="secondary-button" @onclick="Reset">جست‌وجوی کد دیگر</button></footer>
    </section>
}

@if(_confirming&&_record is not null)
{
    <div class="confirm-backdrop" @onclick="CloseConfirmation"><section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-confirm-title" @onclick:stopPropagation="true"><div class="confirm-icon">✓</div><h3 id="edit-confirm-title">ذخیره تغییرات شناسنامه؟</h3><p>Scale‌ها، تعداد نوت کاسه‌ها، تاریخ و ساعت و ثبت‌کننده‌های نمایش‌داده‌شده برای کد <strong>@_record.Code</strong> به‌روزرسانی می‌شوند.</p><div><button class="save-button" @onclick="SaveAsync" disabled="@_saving">@if(_saving){<span class="spinner-border spinner-border-sm"></span>}else{<span>تأیید و ذخیره</span>}</button><button class="secondary-button" @onclick="CloseConfirmation" disabled="@_saving">انصراف</button></div></section></div>
}

@code{
    [SupplyParameterFromQuery(Name = "code")] public string? InitialCode { get; set; }
    private string? _appliedQueryCode;
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialCode) && InitialCode != _appliedQueryCode)
        {
            _appliedQueryCode = InitialCode; _search.Code = InitialCode; await SearchAsync();
        }
    }

    private readonly SearchModel _search=new();
    private AdminProductionEditDto? _record;
    private List<ScaleDto> _scales=[];
    private List<UserDto> _users=[];
    private bool _loading,_saving,_confirming,_messageError;
    private string? _message;
    private readonly Dictionary<Guid, EventDateDraft> _dates=[];
    private sealed class EventDateDraft
    {
        public DateTime? Date{get;set;}
        public string Time{get;set;}="";
        public DateTime OriginalLocal{get;init;}
    }
    private void LoadDates()
    {
        _dates.Clear();
        if(_record is null)return;
        foreach(var item in _record.Events)
        {
            var local=PersianDateTime.ToIranTime(item.EventDate);
            _dates[item.Id]=new(){Date=local.Date,Time=local.ToString("HH:mm:ss",CultureInfo.InvariantCulture),OriginalLocal=local};
        }
    }
    private DateTime? EditedDate(AdminEditableEventDto item)
    {
        var draft=_dates[item.Id];
        if(!draft.Date.HasValue || !TimeOnly.TryParseExact(draft.Time,new[]{"HH:mm","HH:mm:ss"},CultureInfo.InvariantCulture,DateTimeStyles.None,out var time))
            throw new FormatException("تاریخ و ساعت همه عملیات‌ها را کامل و معتبر وارد کنید.");
        var local=draft.Date.Value.Date.Add(time.ToTimeSpan());
        if(local.Date==draft.OriginalLocal.Date && time==TimeOnly.FromDateTime(draft.OriginalLocal.AddTicks(-(draft.OriginalLocal.Ticks%TimeSpan.TicksPerSecond))))return null;
        return PersianDateTime.FromIranTime(local);
    }

    protected override async Task OnInitializedAsync()
    {
        var scales=ScaleService.GetAsync();var users=UserService.GetUsersAsync();
        await Task.WhenAll(scales,users);_scales=(await scales).ToList();_users=(await users).OrderBy(x=>x.FullName).ToList();
    }

    private async Task SearchAsync()
    {
        if(string.IsNullOrWhiteSpace(_search.Code))return;
        _loading=true;_message=null;_record=null;
        try{_record=await EditService.GetAsync(_search.Code);if(_record is null){_message="ساز یا کاسه‌ای با این کد پیدا نشد.";_messageError=true;}}
        catch{_message="ساز یا کاسه‌ای با این کد پیدا نشد یا بازیابی اطلاعات آن ممکن نیست.";_messageError=true;}
        finally{LoadDates();_loading=false;}
    }

    private void RequestSave()
    {
        if(_record is null)return;
        if(_record.Bowls.Any(x=>x.NoteCount<0||(x.BowlType=="کاسه رو"&&x.NoteCount==0)))
        {_message="تعداد نوت کاسه رو باید مثبت باشد؛ تعداد منفی مجاز نیست.";_messageError=true;return;}
        try{foreach(var item in _record.Events)EditedDate(item);}
        catch(FormatException e){_message=e.Message;_messageError=true;return;}
        _message=null;_confirming=true;
    }
    private void CloseConfirmation()=>_confirming=false;
    private async Task SaveAsync()
    {
        if(_record is null||_saving)return;
        _saving=true;_message=null;
        try
        {
            var request=new AdminProductionEditRequest(_record.HandpanScaleId,_record.Bowls.Select(x=>new AdminBowlScaleUpdate(x.Id,x.ScaleId,x.NoteCount)).ToList(),_record.Events.Select(x=>new AdminEventUserUpdate(x.Id,x.UserId,EditedDate(x),x.EventDate)).ToList());
            var updated=await EditService.UpdateAsync(_record.RequestedCode,request);
            if(updated is null)throw new InvalidOperationException("Empty save response");
            var order=_record.Events.Select((x,i)=>(x.Id,i)).ToDictionary(x=>x.Id,x=>x.i);
            updated.Events=updated.Events.OrderBy(x=>order.GetValueOrDefault(x.Id,int.MaxValue)).ToList();
            _record=updated;LoadDates();_confirming=false;_message="تغییرات شناسنامه با موفقیت ذخیره شد.";_messageError=false;
        }
        catch(HttpRequestException e) when(e.StatusCode==System.Net.HttpStatusCode.Conflict)
        {_confirming=false;_message="تاریخ یکی از عملیات‌ها تغییر کرده است؛ دوباره جست‌وجو کنید و تغییرات را ثبت کنید.";_messageError=true;}
        catch{_confirming=false;_message="ذخیره تغییرات انجام نشد. Scale، تعداد نوت، تاریخ و ساعت و ثبت‌کننده‌های انتخاب‌شده را دوباره بررسی کنید.";_messageError=true;}
        finally{_saving=false;}
    }

    private IEnumerable<ScaleDto> ScalesFor(int usage)=>_scales.Where(x=>(x.Usage&usage)==usage);
    private static string UserLabel(UserDto user)=>string.IsNullOrWhiteSpace(user.FullName)?user.UserName:$"{user.FullName} ({user.UserName})";
    private static string ActionIcon(int action)=>action switch{2=>"D",3=>"S",4=>"B",5=>"G",6=>"T",7=>"F",8=>"Q",9=>"P",10=>"W",12=>"$",13=>"A",_=>"•"};
    private void Reset(){_record=null;_message=null;_search.Code="";}
    private sealed class SearchModel{public string Code{get;set;}="";}
}

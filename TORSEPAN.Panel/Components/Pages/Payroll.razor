@page "/reports/payroll"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization
@inject PayrollService PayrollService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>محاسبه دستمزد تولید</PageTitle>
<PageHeader Title="محاسبه دستمزد تولید" SubTitle="محاسبه دستمزد اعضا بر اساس عملیات ثبت‌شده" />

<div class="card p-3 mb-4">
    <div class="payroll-date-row">
        <div><label class="form-label">از تاریخ</label><PersianDatePicker @bind-Value="_from" /></div>
        <div><label class="form-label">تا تاریخ</label><PersianDatePicker @bind-Value="_to" /></div>
        <button class="btn btn-primary payroll-calculate" @onclick="LoadAsync">محاسبه</button>
    </div>
    <div class="payroll-stage-filters">
        <label class="stage-filter"><input type="checkbox" @bind="_readyForQc" /><span>سازهای آماده QC</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_readyForPackaging" /><span>سازهای آماده بسته‌بندی</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_enteredWarehouse" /><span>سازهای واردشده به انبار</span></label>
    </div>
    <div class="mt-3"><button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/reports/payroll/payments")'>مشاهده سوابق پرداخت‌ها</button></div>
</div>

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border"></div></div>
}
else
{
    @if (HasStageFilter)
    {
        <div class="alert alert-info"><strong>مبنای محاسبه:</strong> سازهایی که در بازه انتخاب‌شده به مرحله‌های علامت‌خورده رسیده‌اند و قبلاً پرداخت نشده‌اند. سازهای فروخته‌شده‌ای که در این بازه وارد انبار شده‌اند نیز محاسبه می‌شوند.<div class="mt-2">کد سازها: @( _payroll.HandpanCodes.Count == 0 ? "موردی وجود ندارد" : string.Join("، ", _payroll.HandpanCodes))</div></div>
    }
    <div class="row g-4">
        <div class="col-xl-8">
            <Card>
                <h4>خلاصه دستمزد</h4>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>عضو</th><th>شرح عملیات</th><th>تعداد</th><th>نرخ واحد</th><th>جمع</th></tr></thead>
                        <tbody>
                        @foreach (var user in UserGroups)
                        {
                            var first = true;
                            @foreach (var line in user.Lines)
                            {
                                <tr>
                                    <td>@(first ? user.Name : "")</td>
                                    <td>@LineDescription(line)</td>
                                    <td>@line.Count</td><td>@line.Rate.ToString("N0")</td><td><strong>@line.Total.ToString("N0")</strong></td>
                                </tr>
                                first = false;
                            }
                            <tr class="table-light"><td colspan="4"><strong>جمع @user.Name</strong></td><td><strong>@user.Lines.Sum(x => x.Total).ToString("N0")</strong></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </Card>
            @if (HasStageFilter)
            {
                <button class="btn btn-success btn-lg w-100 mt-3" disabled="@(_savingPayment || _payroll.HandpanCodes.Count == 0 || _payroll.Lines.Count == 0)" @onclick="MarkPaidAsync">@(_savingPayment ? "در حال ثبت..." : "پرداخت شد و ثبت در سوابق")</button>
            }
        </div>
        <div class="col-xl-4">
            <Card>
                <h4>تعریف نرخ عملیات</h4>
                <label class="form-label mt-2">عملیات</label>
                <select class="form-select" @bind="_rateAction" @bind:after="RateFilterChanged">@foreach (var a in Actions) { <option value="@a.Id">@a.Title</option> }</select>
                <label class="form-label mt-2">متریال</label>
                <select class="form-select" @bind="_rateMaterial"><option value="">همه متریال‌ها</option>@foreach (var m in _materials) { <option value="@m.Id">@m.Name</option> }</select>
                <label class="form-label mt-2">نوع کاسه</label>
                <select class="form-select" @bind="_rateBowlType" @bind:after="RateFilterChanged"><option value="">بدون تفکیک</option><option value="1">کاسه رو</option><option value="2">کاسه زیر</option></select>
                <label class="form-label mt-2">اسکیل کاسه</label>
                <select class="form-select" @bind="_rateScale"><option value="">همه اسکیل‌ها</option>@foreach (var scale in AvailableRateScales) { <option value="@scale.Id">@scale.Name</option> }</select>
                <label class="form-label mt-2">نرخ واحد</label><input type="number" min="0" class="form-control" @bind="_rateAmount" />
                <button class="btn btn-success w-100 mt-3" @onclick="SaveRateAsync">ثبت نرخ</button>
                <hr /><h5>نرخ‌های ثبت‌شده</h5>
                <div class="table-responsive payroll-rates-table"><table class="table table-sm align-middle mb-0">
                    <thead><tr><th>عملیات</th><th>متریال</th><th>نوع</th><th>اسکیل</th><th>نرخ</th></tr></thead>
                    <tbody>@foreach (var rate in _payroll.Rates) { <tr><td>@rate.ActionTitle</td><td>@rate.MaterialName</td><td>@BowlTypeTitle(rate.BowlType)</td><td>@(string.IsNullOrWhiteSpace(rate.ScaleName) ? "همه" : rate.ScaleName)</td><td><strong>@rate.Amount.ToString("N0")</strong></td></tr> }</tbody>
                </table></div>
            </Card>
        </div>
    </div>
}

@code {
    private PayrollDto _payroll = new();
    private List<MaterialDto> _materials = [];
    private List<ScaleDto> _scales = [];
    private bool _loading = true, _readyForQc, _readyForPackaging, _enteredWarehouse, _savingPayment;
    private DateTime? _from, _to;
    private int _rateAction = 2;
    private string _rateMaterial = "", _rateBowlType = "", _rateScale = "";
    private decimal _rateAmount;
    private static readonly (int Id, string Title)[] Actions = [(2, "دیمپل"), (3, "شیپ"), (5, "چسب"), (6, "تیون"), (7, "فاین تیون")];
    private IEnumerable<UserPayrollGroup> UserGroups => _payroll.Lines.GroupBy(x => new { x.UserId, x.UserName, x.DisplayOrder }).OrderBy(x => x.Key.DisplayOrder).ThenBy(x => x.Key.UserName).Select(x => new UserPayrollGroup(x.Key.UserName, x.ToList()));
    protected override async Task OnInitializedAsync() { _materials = (await MaterialService.GetAsync()).Where(x => x.Category == 4).ToList(); _scales = (await ScaleService.GetAsync()).ToList(); await LoadAsync(); }
    private bool HasStageFilter => _readyForQc || _readyForPackaging || _enteredWarehouse;
    private IEnumerable<ScaleDto> AvailableRateScales => _rateBowlType switch
    {
        "1" => _scales.Where(x => (x.Usage & 1) != 0),
        "2" => _scales.Where(x => (x.Usage & 2) != 0),
        _ => _scales.Where(x => (x.Usage & 3) != 0)
    };
    private async Task LoadAsync() { _loading = true; try { _payroll = await PayrollService.GetAsync(_from, _to, _readyForQc, _readyForPackaging, _enteredWarehouse) ?? new(); if (!_from.HasValue) { _from = _payroll.From; _to = _payroll.To; } } finally { _loading = false; } }
    private async Task SaveRateAsync() { Guid? material = Guid.TryParse(_rateMaterial, out var m) ? m : null; int? bowl = int.TryParse(_rateBowlType, out var b) ? b : null; Guid? scale = Guid.TryParse(_rateScale, out var s) ? s : null; await PayrollService.SaveRateAsync(_rateAction, material, bowl, scale, _rateAmount); await LoadAsync(); }
    private void RateFilterChanged() { if (Guid.TryParse(_rateScale, out var id) && !AvailableRateScales.Any(x => x.Id == id)) _rateScale = ""; }
    private static string BowlTypeTitle(int? bowlType) => bowlType == 1 ? "کاسه رو" : bowlType == 2 ? "کاسه زیر" : "همه";
    private static string LineDescription(PayrollLineDto line)
    {
        var parts = new List<string> { line.ActionTitle, line.MaterialName };
        if (line.Action == 6 && !string.IsNullOrWhiteSpace(line.ScaleName)) parts.Add(line.ScaleName);
        else
        {
            if (line.BowlType.HasValue) parts.Add(BowlTypeTitle(line.BowlType));
            if (!string.IsNullOrWhiteSpace(line.ScaleName)) parts.Add(line.ScaleName);
        }
        return string.Join(" — ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
    private async Task MarkPaidAsync(){if(!_from.HasValue||!_to.HasValue)return;if(!await JS.InvokeAsync<bool>("confirm",$"دستمزد {_payroll.HandpanCodes.Count} ساز با مبلغ کل {_payroll.Lines.Sum(x=>x.Total):N0} به‌عنوان پرداخت‌شده ثبت شود؟"))return;_savingPayment=true;try{await PayrollService.MarkPaidAsync(_from.Value,_to.Value,_readyForQc,_readyForPackaging,_enteredWarehouse);await LoadAsync();Navigation.NavigateTo("/reports/payroll/payments");}finally{_savingPayment=false;}}
    private sealed record UserPayrollGroup(string Name, List<PayrollLineDto> Lines);
}

@page "/reports/payroll"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization
@inject PayrollService PayrollService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject ReportService ReportService
@inject NavigationManager Navigation

<PageTitle>محاسبه دستمزد تولید</PageTitle>
<PageHeader Title="محاسبه دستمزد تولید" SubTitle="محاسبه دستمزد اعضا بر اساس عملیات ثبت‌شده" />

<nav class="payroll-sections" aria-label="بخش‌های دستمزد تولید">
    <button class="@SectionClass(0)" @onclick="() => _activeSection = 0"><span class="section-icon">◫</span><span><strong>محاسبه دستمزد</strong><small>جدول عملکرد و پرداخت</small></span></button>
    <button class="@SectionClass(1)" @onclick="() => _activeSection = 1"><span class="section-icon">﷼</span><span><strong>تعریف نرخ‌ها</strong><small>ثبت و مدیریت نرخ عملیات</small></span></button>
    <button class="@SectionClass(2)" @onclick="() => _activeSection = 2"><span class="section-icon">◉</span><span><strong>آمار تولید</strong><small>نمودارهای مدیریتی</small></span></button>
</nav>

@if (_activeSection == 0)
{
<div class="card p-3 mb-4">
    <div class="payroll-date-row">
        <div><label class="form-label">از تاریخ</label><PersianDatePicker @bind-Value="_from" /></div>
        <div><label class="form-label">تا تاریخ</label><PersianDatePicker @bind-Value="_to" /></div>
        <button class="btn btn-primary payroll-calculate" @onclick="LoadAsync">محاسبه</button>
    </div>
    <div class="payroll-stage-filters">
        <label class="stage-filter"><input type="checkbox" @bind="_readyForQc" /><span>سازهای آماده QC</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_readyForPackaging" /><span>سازهای آماده بسته‌بندی</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_enteredWarehouse" /><span>سازهای واردشده به انبار</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_readyForExportPackaging" /><span>آماده بسته‌بندی صادراتی</span></label>
        <label class="stage-filter"><input type="checkbox" @bind="_exportWarehouse" /><span>انبار صادراتی</span></label>
    </div>
    <div class="mt-3"><button class="btn btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/reports/payroll/payments")'>مشاهده سوابق پرداخت‌ها</button></div>
    <div class="mt-2"><button class="btn btn-primary" disabled="@(_payroll.Lines.Count == 0)" @onclick="OpenTable">مشاهده جدول عملکرد</button></div>
</div>

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border"></div></div>
}
else
{
    @if (HasStageFilter)
    {
        <div class="alert alert-info"><strong>مبنای محاسبه:</strong> فقط عملیات مرتبط با سازهایی که در بازه انتخاب‌شده به وضعیت‌های علامت‌خورده رسیده‌اند و قبلاً پرداخت نشده‌اند. <span class="ms-2">تعداد موارد: <strong>@_payroll.HandpanCodes.Count</strong></span></div>
    }
    @if (_payroll.Lines.Count == 0)
    {
        <div class="alert alert-warning">در این بازه، مورد پرداخت‌نشده‌ای مطابق گزینه‌های انتخاب‌شده پیدا نشد.</div>
    }
    <div class="row g-4">
        <div class="col-12">
            <Card>
                <h4>دستمزد تولید عادی</h4>
                <div class="table-responsive payroll-result-table">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>عضو</th><th>شرح عملیات</th><th>تعداد</th><th>نرخ واحد</th><th>جمع</th></tr></thead>
                        <tbody>
                        @foreach (var user in UserGroups)
                        {
                            var first = true;
                            @foreach (var line in user.Lines)
                            {
                                <tr>
                                    <td class="payroll-member">@(first ? user.Name : "")</td>
                                    <td class="payroll-operation"><PayrollLineDescription Line="line" /></td>
                                    <td class="payroll-number" data-label="تعداد"><strong>@line.Count.ToString("N0")</strong></td>
                                    <td class="payroll-number" data-label="نرخ واحد"><strong>@line.Rate.ToString("N0")</strong><small> ریال</small></td>
                                    <td class="payroll-number payroll-line-total" data-label="مبلغ"><strong>@line.Total.ToString("N0")</strong><small> ریال</small></td>
                                </tr>
                                first = false;
                            }
                            <tr class="table-light payroll-user-total"><td colspan="4"><strong>جمع @user.Name</strong></td><td><strong>@user.Lines.Sum(x => x.Total).ToString("N0")</strong><small> ریال</small></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </Card>
            @if (CustomUserGroups.Any())
            {
                <div class="mt-4">
                <Card>
                    <h4>دستمزد تولید Custom</h4>
                    <div class="alert alert-light border">این بخش مربوط به سازهایی است که Scale آن‌ها در مرحله شیپ انتخاب شده است.</div>
                    <div class="table-responsive payroll-result-table">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>عضو</th><th>شرح عملیات</th><th>تعداد</th><th>نرخ واحد</th><th>جمع</th></tr></thead>
                            <tbody>
                            @foreach (var user in CustomUserGroups)
                            {
                                var first = true;
                                @foreach (var line in user.Lines)
                                {
                                    <tr><td class="payroll-member">@(first ? user.Name : "")</td><td class="payroll-operation"><PayrollLineDescription Line="line" /></td><td class="payroll-number" data-label="تعداد"><strong>@line.Count.ToString("N0")</strong></td><td class="payroll-number" data-label="نرخ واحد"><strong>@line.Rate.ToString("N0")</strong><small> ریال</small></td><td class="payroll-number payroll-line-total" data-label="مبلغ"><strong>@line.Total.ToString("N0")</strong><small> ریال</small></td></tr>
                                    first = false;
                                }
                                <tr class="table-light payroll-user-total"><td colspan="4"><strong>جمع Custom @user.Name</strong></td><td><strong>@user.Lines.Sum(x => x.Total).ToString("N0")</strong><small> ریال</small></td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </Card>
                </div>
            }
            @if (ExportUserGroups.Any())
            {
                <div class="mt-4">
                <Card>
                    <h4>دستمزد تولید صادراتی</h4>
                    <div class="alert alert-light border">این بخش فقط مربوط به کاسه‌هایی است که واقعاً در مسیر صادراتی قرار دارند.</div>
                    <div class="table-responsive payroll-result-table">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>عضو</th><th>شرح عملیات</th><th>تعداد</th><th>نرخ واحد</th><th>جمع</th></tr></thead>
                            <tbody>
                            @foreach (var user in ExportUserGroups)
                            {
                                var first = true;
                                @foreach (var line in user.Lines)
                                {
                                    <tr><td class="payroll-member">@(first ? user.Name : "")</td><td class="payroll-operation"><PayrollLineDescription Line="line" /></td><td class="payroll-number" data-label="تعداد"><strong>@line.Count.ToString("N0")</strong></td><td class="payroll-number" data-label="نرخ واحد"><strong>@line.Rate.ToString("N0")</strong><small> ریال</small></td><td class="payroll-number payroll-line-total" data-label="مبلغ"><strong>@line.Total.ToString("N0")</strong><small> ریال</small></td></tr>
                                    first = false;
                                }
                                <tr class="table-light payroll-user-total"><td colspan="4"><strong>جمع صادراتی @user.Name</strong></td><td><strong>@user.Lines.Sum(x => x.Total).ToString("N0")</strong><small> ریال</small></td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </Card>
                </div>
            }
            @if (HasStageFilter)
            {
                <button class="btn btn-success btn-lg w-100 mt-3" disabled="@(_savingPayment || _payroll.HandpanCodes.Count == 0 || _payroll.Lines.Count == 0)" @onclick="MarkPaidAsync">@(_savingPayment ? "در حال ثبت..." : "پرداخت شد و ثبت در سوابق")</button>
            }
        </div>
    </div>
}
}

@if (_activeSection == 1)
{
    <section class="rate-manager">
        <header class="rate-manager-header"><div class="rate-manager-icon">﷼</div><div><small>تنظیمات دستمزد</small><h4>تعریف نرخ عملیات</h4><p>مشخصات نرخ را انتخاب کنید؛ پیش از ثبت، خلاصه نهایی برای تأیید نمایش داده می‌شود.</p></div></header>
        <div class="rate-form-grid">
            <div class="rate-field"><label>مسیر تولید</label><select class="form-select" @bind="_ratePath" @bind:after="RateFilterChanged"><option value="0">عادی</option><option value="2">Custom</option><option value="1">صادراتی</option></select></div>
            <div class="rate-field"><label>عملیات</label><select class="form-select" @bind="_rateAction" @bind:after="RateFilterChanged">@foreach (var a in Actions) { <option value="@a.Id">@a.Title</option> }</select></div>
            @if (!IsSimpleRate)
            {
                <div class="rate-field"><label>متریال</label><select class="form-select" @bind="_rateMaterial"><option value="">همه متریال‌ها</option>@foreach (var m in _materials) { <option value="@m.Id">@m.Name</option> }</select></div>
                @if (!IsHandpanRate)
                {
                    <div class="rate-field"><label>نوع کاسه</label><select class="form-select" @bind="_rateBowlType" @bind:after="RateFilterChanged"><option value="">بدون تفکیک</option><option value="1">کاسه رو</option><option value="2">کاسه زیر</option></select></div>
                }
                <div class="rate-field"><label>@(IsHandpanRate ? "Scale ساز" : "Scale کاسه")</label><select class="form-select" @bind="_rateScale"><option value="">همه Scale‌ها</option>@foreach (var scale in AvailableRateScales) { <option value="@scale.Id">@scale.Name</option> }</select></div>
            }
            <div class="rate-field rate-amount"><label>نرخ واحد <span>ریال</span></label><input type="number" min="0" inputmode="numeric" class="form-control" @bind="_rateAmount" placeholder="مبلغ را وارد کنید" /></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_rateMessage)) { <div class="rate-success">✓ @_rateMessage</div> }
        <div class="rate-actions"><button class="btn btn-success" @onclick="SaveRateAsync">@(_editingRateId.HasValue ? "ذخیره تغییرات نرخ" : "ثبت نرخ جدید")</button>@if (_editingRateId.HasValue) { <button class="btn btn-outline-secondary" @onclick="CancelRateEdit">انصراف</button> }</div>
        <button class="rates-toggle @(_showRegisteredRates ? "open" : "")" @onclick="ToggleRegisteredRates"><span><small>@_payroll.Rates.Count</small> نرخ ثبت‌شده</span><strong>@(_showRegisteredRates ? "بستن فهرست" : "مشاهده نرخ‌های قبلی") <i>@(_showRegisteredRates ? "⌃" : "⌄")</i></strong></button>
        @if (_showRegisteredRates)
        {
            <div class="registered-rates-panel">
                <div class="registered-rates-heading"><div><small>آرشیو نرخ‌ها</small><h5>نرخ‌های ثبت‌شده</h5></div><span>@_payroll.Rates.Count مورد</span></div>
                <div class="table-responsive payroll-rates-table"><table class="table table-sm align-middle mb-0">
                    <thead><tr><th>مسیر</th><th>عملیات</th><th>متریال</th><th>نوع</th><th>Scale</th><th>نرخ</th><th>مدیریت</th></tr></thead>
                    <tbody>@foreach (var rate in SortedRates) { <tr class="@(_editingRateId == rate.Id ? "table-success" : "")"><td><span class="badge @(rate.IsExport ? "bg-warning text-dark" : rate.IsCustom ? "bg-primary" : "bg-secondary")">@RatePathTitle(rate)</span></td><td>@rate.ActionTitle</td><td>@rate.MaterialName</td><td>@RateTypeTitle(rate)</td><td>@(string.IsNullOrWhiteSpace(rate.ScaleName) ? "همه" : rate.ScaleName)</td><td><strong>@rate.Amount.ToString("N0")</strong></td><td class="text-nowrap"><button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditRate(rate)">ویرایش</button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRateAsync(rate)">حذف</button></td></tr> }</tbody>
                </table></div>
            </div>
        }
    </section>
}

@if(_activeSection == 2 && !_loading && _analytics.Donuts.Count>0)
{
    <section class="payroll-analytics"><header><div><small>ترکیب تولید ماه جاری</small><h3>سهم مراحل، اعضا، متریال و Scale</h3></div><span>شش نمودار مدیریتی</span></header><ReportDonutGrid Charts="@_analytics.Donuts" /></section>
}

@if (_confirmVisible)
{
    <div class="modal d-block" style="background:rgba(0,0,0,.45)" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" dir="rtl">
                <div class="modal-header">
                    <h5 class="modal-title">@_confirmTitle</h5>
                    <button type="button" class="btn-close ms-0" disabled="@_confirmBusy" @onclick="CloseConfirmation"></button>
                </div>
                <div class="modal-body"><p class="mb-0">@_confirmMessage</p></div>
                <div class="modal-footer justify-content-start">
                    <button class="btn btn-outline-secondary" disabled="@_confirmBusy" @onclick="CloseConfirmation">انصراف</button>
                    <button class="btn @(_confirmDanger ? "btn-danger" : "btn-success")" disabled="@_confirmBusy" @onclick="ConfirmAsync">
                        @(_confirmBusy ? "در حال انجام..." : _confirmButton)
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PayrollDto _payroll = new();
    private ProductionAnalyticsDto _analytics = new();
    private List<MaterialDto> _materials = [];
    private List<ScaleDto> _scales = [];
    private bool _loading = true, _readyForQc, _readyForPackaging, _enteredWarehouse, _readyForExportPackaging, _exportWarehouse, _savingPayment, _showRegisteredRates;
    private DateTime? _from, _to;
    private int _activeSection;
    private int _rateAction = 2;
    private int _ratePath;
    private string _rateMaterial = "", _rateBowlType = "", _rateScale = "";
    private string _rateMessage = "";
    private Guid? _editingRateId;
    private decimal _rateAmount;
    private bool _confirmVisible, _confirmBusy, _confirmDanger;
    private string _confirmTitle = "", _confirmMessage = "", _confirmButton = "تأیید";
    private Func<Task>? _confirmAction;
    private static readonly (int Id, string Title)[] Actions = [(2, "دیمپل"), (3, "شیپ"), (5, "چسب"), (6, "تیون"), (7, "فاین تیون")];
    private IEnumerable<UserPayrollGroup> UserGroups => GroupLines(_payroll.Lines.Where(x => !x.IsExport && !x.IsCustom));
    private IEnumerable<UserPayrollGroup> CustomUserGroups => GroupLines(_payroll.Lines.Where(x => x.IsCustom && !x.IsExport));
    private IEnumerable<UserPayrollGroup> ExportUserGroups => GroupLines(_payroll.Lines.Where(x => x.IsExport));
    private IEnumerable<PayrollRateDto> SortedRates => _payroll.Rates.OrderBy(x => x.IsExport ? 2 : x.IsCustom ? 1 : 0).ThenBy(x => ActionOrder(x.Action)).ThenBy(x => x.MaterialName).ThenBy(x => x.BowlType).ThenBy(x => x.ScaleName).ThenBy(x => x.Amount);
    private static IEnumerable<UserPayrollGroup> GroupLines(IEnumerable<PayrollLineDto> lines) => lines.GroupBy(x => new { x.UserId, x.UserName, x.DisplayOrder }).OrderBy(x => x.Key.DisplayOrder).ThenBy(x => x.Key.UserName).Select(x => new UserPayrollGroup(x.Key.UserName, x.OrderBy(y => ActionOrder(y.Action)).ThenBy(y => y.MaterialName).ThenBy(y => y.BowlType).ThenBy(y => y.ScaleName).ToList()));
    protected override async Task OnInitializedAsync() { _materials = (await MaterialService.GetAsync()).Where(x => x.Category == 4).ToList(); _scales = (await ScaleService.GetAsync()).ToList(); await LoadAsync(); }
    private bool HasStageFilter => _readyForQc || _readyForPackaging || _enteredWarehouse || _readyForExportPackaging || _exportWarehouse;
    private string SectionClass(int section) => _activeSection == section ? "payroll-section-tab active" : "payroll-section-tab";
    private bool IsHandpanRate => _rateAction == 7;
    private bool IsSimpleRate => _rateAction == 5;
    private IEnumerable<ScaleDto> AvailableRateScales => _rateBowlType switch
    {
        _ when _ratePath == 2 && IsHandpanRate => _scales.Where(x => (x.Usage & 32) != 0),
        _ when _ratePath == 2 && _rateBowlType == "1" => _scales.Where(x => (x.Usage & 8) != 0),
        _ when _ratePath == 2 && _rateBowlType == "2" => _scales.Where(x => (x.Usage & 16) != 0),
        _ when _ratePath == 2 => _scales.Where(x => (x.Usage & 24) != 0),
        _ when IsHandpanRate => _scales.Where(x => (x.Usage & 4) != 0),
        "1" => _scales.Where(x => (x.Usage & 1) != 0),
        "2" => _scales.Where(x => (x.Usage & 2) != 0),
        _ => _scales.Where(x => (x.Usage & 3) != 0)
    };
    private async Task LoadAsync() { _loading = true; try { var payroll=PayrollService.GetAsync(_from, _to, _readyForQc, _readyForPackaging, _enteredWarehouse, _readyForExportPackaging, _exportWarehouse);var analytics=ReportService.GetProductionAsync(null,null,[],[],"all","all");await Task.WhenAll(payroll,analytics);_payroll=await payroll??new();_analytics=await analytics;if (!_from.HasValue) { _from = _payroll.From; _to = _payroll.To; } } finally { _loading = false; } }
    private Task SaveRateAsync()
    {
        Guid? material = Guid.TryParse(_rateMaterial, out var m) ? m : null;
        int? bowl = int.TryParse(_rateBowlType, out var b) ? b : null;
        Guid? scale = Guid.TryParse(_rateScale, out var s) ? s : null;
        if (IsSimpleRate) { material = null; bowl = null; scale = null; }
        var isExport = _ratePath == 1;
        var isCustom = _ratePath == 2;
        var summary = RateConfirmationSummary(material, bowl, scale, isExport, isCustom);
        var existing = _payroll.Rates.FirstOrDefault(x => x.Id != _editingRateId && x.Action == _rateAction && x.MaterialId == material && x.BowlType == bowl && x.ScaleId == scale && x.IsExport == isExport && x.IsCustom == isCustom);
        if (existing is not null)
        {
            ShowConfirmation("تأیید جایگزینی نرخ", $"{summary} — نرخ قبلی {existing.Amount:N0} ریال است و با نرخ جدید جایگزین می‌شود. آیا مطمئن هستید؟", "تأیید و جایگزینی", false,
                () => PersistRateAsync(material, bowl, scale, isExport, isCustom, true));
            return Task.CompletedTask;
        }
        ShowConfirmation(_editingRateId.HasValue ? "تأیید ویرایش نرخ" : "تأیید ثبت نرخ",
            $"{summary} — آیا از ثبت این نرخ مطمئن هستید؟",
            _editingRateId.HasValue ? "تأیید و ذخیره تغییرات" : "تأیید و ثبت نرخ", false,
            () => PersistRateAsync(material, bowl, scale, isExport, isCustom, false));
        return Task.CompletedTask;
    }
    private async Task PersistRateAsync(Guid? material, int? bowl, Guid? scale, bool isExport, bool isCustom, bool replacing)
    {
        await PayrollService.SaveRateAsync(_editingRateId, _rateAction, material, bowl, scale, isExport, isCustom, _rateAmount);
        _rateMessage = _editingRateId.HasValue ? "تغییرات نرخ ذخیره شد." : replacing ? "نرخ قبلی با مبلغ جدید جایگزین شد." : "نرخ جدید ثبت شد.";
        _editingRateId = null;
        await LoadAsync();
    }
    private void EditRate(PayrollRateDto rate)
    {
        _showRegisteredRates = true;
        _editingRateId = rate.Id; _ratePath = rate.IsExport ? 1 : rate.IsCustom ? 2 : 0; _rateAction = rate.Action; _rateMaterial = rate.MaterialId?.ToString() ?? "";
        _rateBowlType = rate.BowlType?.ToString() ?? ""; _rateScale = rate.ScaleId?.ToString() ?? ""; _rateAmount = rate.Amount;
        _rateMessage = ""; RateFilterChanged();
    }
    private void CancelRateEdit() { _editingRateId = null; _rateAmount = 0; _rateMessage = ""; }
    private void ToggleRegisteredRates() => _showRegisteredRates = !_showRegisteredRates;
    private Task DeleteRateAsync(PayrollRateDto rate)
    {
        ShowConfirmation("حذف نرخ", $"نرخ {RatePathTitle(rate)} «{rate.ActionTitle} — {rate.MaterialName} — {RateTypeTitle(rate)} — {(string.IsNullOrWhiteSpace(rate.ScaleName) ? "همه" : rate.ScaleName)}» حذف شود؟", "حذف نرخ", true, () => DeleteRateConfirmedAsync(rate));
        return Task.CompletedTask;
    }
    private async Task DeleteRateConfirmedAsync(PayrollRateDto rate)
    {
        await PayrollService.DeleteRateAsync(rate.Id);
        if (_editingRateId == rate.Id) CancelRateEdit();
        _rateMessage = "نرخ حذف شد.";
        await LoadAsync();
    }
    private void RateFilterChanged() { if (IsHandpanRate) _rateBowlType = ""; if (IsSimpleRate) { _rateMaterial = ""; _rateBowlType = ""; _rateScale = ""; } if (Guid.TryParse(_rateScale, out var id) && !AvailableRateScales.Any(x => x.Id == id)) _rateScale = ""; }
    private static string BowlTypeTitle(int? bowlType) => bowlType == 1 ? "کاسه رو" : bowlType == 2 ? "کاسه زیر" : "همه";
    private static int ActionOrder(int action) => action switch { 2 => 1, 3 => 2, 5 => 3, 6 => 4, 7 => 5, _ => 99 };
    private static string RateTypeTitle(PayrollRateDto rate) => rate.Action == 7 ? "ساز" : BowlTypeTitle(rate.BowlType);
    private static string RatePathTitle(PayrollRateDto rate) => rate.IsExport ? "صادراتی" : rate.IsCustom ? "Custom" : "عادی";
    private string RateConfirmationSummary(Guid? material, int? bowl, Guid? scale, bool isExport, bool isCustom)
    {
        var path = isExport ? "صادراتی" : isCustom ? "Custom" : "عادی";
        var action = Actions.FirstOrDefault(x => x.Id == _rateAction).Title ?? "عملیات";
        var materialName = material.HasValue ? _materials.FirstOrDefault(x => x.Id == material.Value)?.Name ?? "متریال انتخاب‌شده" : "همه متریال‌ها";
        var type = IsHandpanRate ? "ساز" : bowl.HasValue ? BowlTypeTitle(bowl) : "همه نوع‌ها";
        var scaleName = scale.HasValue ? _scales.FirstOrDefault(x => x.Id == scale.Value)?.Name ?? "Scale انتخاب‌شده" : "همه Scale‌ها";
        return $"مسیر {path}، {action}، {materialName}، {type}، {scaleName}، نرخ {_rateAmount:N0} ریال";
    }
    private void OpenTable(){if(!_from.HasValue||!_to.HasValue)return;Navigation.NavigateTo($"/reports/payroll/table?from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}&qc={_readyForQc}&pack={_readyForPackaging}&warehouse={_enteredWarehouse}&exportPack={_readyForExportPackaging}&exportWarehouse={_exportWarehouse}");}
    private Task MarkPaidAsync(){if(!_from.HasValue||!_to.HasValue)return Task.CompletedTask;ShowConfirmation("تأیید پرداخت",$"دستمزد {_payroll.HandpanCodes.Count} ساز با مبلغ کل {_payroll.Lines.Sum(x=>x.Total):N0} به‌عنوان پرداخت‌شده ثبت شود؟","ثبت پرداخت",false,CompletePaymentAsync);return Task.CompletedTask;}
    private async Task CompletePaymentAsync(){if(!_from.HasValue||!_to.HasValue)return;_savingPayment=true;try{await PayrollService.MarkPaidAsync(_from.Value,_to.Value,_readyForQc,_readyForPackaging,_enteredWarehouse,_readyForExportPackaging,_exportWarehouse);await LoadAsync();Navigation.NavigateTo("/reports/payroll/payments");}finally{_savingPayment=false;}}
    private void ShowConfirmation(string title,string message,string button,bool danger,Func<Task> action){_confirmTitle=title;_confirmMessage=message;_confirmButton=button;_confirmDanger=danger;_confirmAction=action;_confirmVisible=true;}
    private void CloseConfirmation(){if(_confirmBusy)return;_confirmVisible=false;_confirmAction=null;}
    private async Task ConfirmAsync(){if(_confirmBusy||_confirmAction is null)return;_confirmBusy=true;var action=_confirmAction;try{await action();_confirmVisible=false;_confirmAction=null;}finally{_confirmBusy=false;}}
    private sealed record UserPayrollGroup(string Name, List<PayrollLineDto> Lines);
}

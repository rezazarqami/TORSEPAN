@page "/scales"
@page "/custom-scales"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ScaleService ScaleService

<PageTitle>مدیریت اسکیل‌ها | تورسپن</PageTitle>
<section class="scales-hero scales-photo-hero theme-hero theme-page-intro" aria-labelledby="scales-title">
    <div class="scales-hero-art" aria-hidden="true"></div>
    <div class="scales-hero-copy"><span dir="ltr">SCALE MANAGEMENT</span><h1 id="scales-title">مدیریت اسکیل‌ها</h1></div>
</section>
<div class="navy-workspace-page navy-scales">
<nav class="scale-tabs" aria-label="بخش‌های مدیریت اسکیل">
    <button type="button" class="@(!_createTab ? "active" : null)" aria-pressed="@(!_createTab)" disabled="@(_busy || _playgroundEditing)" @onclick="() => SelectTab(false)"><strong>اسکیل‌ها</strong></button>
    <button type="button" class="@(_createTab ? "active" : null)" aria-pressed="@_createTab" disabled="@(_busy || _playgroundEditing)" @onclick="() => SelectTab(true)"><strong>ثبت اسکیل جدید</strong></button>
</nav>
@if (_message is not null && (!_isError || _editingId is null))
{
    <div class="scale-notice @(_isError ? "error" : "success")" role="@(_isError ? "alert" : "status")">@_message</div>
}
@if (_loading)
{
    <div class="scale-empty" role="status">در حال دریافت اسکیل‌ها…</div>
}
else if (_createTab)
{
    <section class="scale-card">
        <header><h2>اسکیل جدید</h2></header>
        <div class="scale-create" @key="_newPhotos">
            <label for="new-scale-name">نام اسکیل<input id="new-scale-name" class="form-control" maxlength="100" @bind="_name" @bind:event="oninput" disabled="@_busy" /></label>
            @PhotoPickers(_newPhotos)
            <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">ثبت اسکیل</button>
        </div>
    </section>
}
else
{
    <section class="scale-card">
        <header><h2>اسکیل‌ها</h2><p>ویرایش نام، در تمام سازها و کاسه‌های مرتبط هم نمایش داده می‌شود.</p></header>
        @if (Items(_usage).Count == 0)
        {
            <div class="scale-empty">هنوز اسکیلی ثبت نشده است.</div>
        }
        else
        {
            <div class="scale-list">
                @foreach (var scale in Items(_usage))
                {
                    <div class="scale-row" @key="scale.Id">
                        @if (_editingId == scale.Id)
                        {
                            <div class="scale-edit">
                                <label for="edit-scale-name">نام جدید اسکیل<input id="edit-scale-name" class="form-control" maxlength="100" @bind="_editingName" @bind:event="oninput" disabled="@_busy" /></label>
                                @PhotoPickers(_editPhotos)
                                @if (_isError && _message is not null)
                                {
                                    <div class="scale-notice error" role="alert">@_message</div>
                                }
                                <div class="scale-actions"><button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editingName))" @onclick="SaveEditAsync">ذخیره تغییرات</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="CancelEdit">انصراف</button></div>
                            </div>
                        }
                        else
                        {
                            <div class="scale-summary">
                                <div class="scale-actions"><button type="button" class="btn btn-outline-primary" disabled="@(_busy || _playgroundEditing)" @onclick="() => BeginEdit(scale)">ویرایش</button><button type="button" class="btn btn-outline-danger" disabled="@(_busy || _playgroundEditing)" @onclick="() => _deleting = scale">حذف</button></div>
                                <div class="scale-title">
                                    @if (PhotosAvailable)
                                    {
                                        <button type="button" class="scale-photo-toggle" aria-label="@($"عکس کاسه‌های {scale.Name}")" aria-expanded="@(_expandedId == scale.Id)" disabled="@_playgroundEditing" @onclick="() => TogglePhotosAsync(scale.Id)">
                                            <span aria-hidden="true">⌄</span>
                                        </button>
                                    }
                                    <strong class="scale-name"><bdi>@scale.Name</bdi></strong>
                                </div>
                            </div>
                            @if (_expandedId == scale.Id)
                            {
                                @if (_photoLoading)
                                {
                                    <div class="scale-photo-status" role="status">در حال دریافت عکس‌ها…</div>
                                }
                                else if (_photoError is not null)
                                {
                                    <div class="scale-photo-status" role="alert">@_photoError</div>
                                }
                                else
                                {
                                    <ScalePlaygroundEditor @key="scale.Id" ScaleId="scale.Id" ScaleName="@scale.Name"
                                                           Photos="_visiblePhotos" PhotosChanged="value => _visiblePhotos = value" EditingChanged="value => _playgroundEditing = value">
                                        <div class="scale-photo-pair">
                                            @PhotoTile("کاسه رو", _visiblePhotos?.Top)
                                            @PhotoTile("کاسه زیر", _visiblePhotos?.Bottom)
                                        </div>
                                    </ScalePlaygroundEditor>
                                }
                            }
                        }
                    </div>
                }
            </div>
        }
    </section>
}
@if (_deleting is not null)
{
    <div class="scale-overlay"><section class="scale-dialog" role="dialog" aria-modal="true" aria-labelledby="scale-delete-title"><h2 id="scale-delete-title">حذف اسکیل</h2><p>اسکیل «@_deleting.Name» از فهرست انتخاب حذف شود؟ اطلاعات سازها و کاسه‌های قبلی حفظ می‌شود.</p><div class="scale-actions"><button type="button" class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">تأیید حذف</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="() => _deleting = null">انصراف</button></div></section></div>
}
</div>

@code {
    private readonly List<ScaleDto> _scales = [];
    private const int MaxPhotoBytes = 5_000_000;
    private static bool PhotosAvailable => !OperatingSystem.IsBrowser();
    private PhotoDraft _newPhotos = new();
    private PhotoDraft _editPhotos = new();
    private Guid? _expandedId;
    private int _photoRequest;
    private bool _photoLoading, _playgroundEditing;
    private string? _photoError;
    private ScalePhotoSources? _visiblePhotos;

    private sealed class PhotoDraft
    {
        public byte[]? Top { get; set; }
        public byte[]? Bottom { get; set; }
        public string? Error { get; set; }
    }

    private RenderFragment PhotoPickers(PhotoDraft draft) => @<div class="scale-photo-fields">
        @if (PhotosAvailable)
        {
            <div class="scale-photo-pair">
                @PhotoPicker(draft, "کاسه رو", true)
                @PhotoPicker(draft, "کاسه زیر", false)
            </div>
            @if (draft.Error is not null)
            {
                <p role="alert">@draft.Error</p>
            }
        }
    </div>;

    private RenderFragment PhotoPicker(PhotoDraft draft, string label, bool top) => @<label class="scale-photo-picker @(_busy ? "is-disabled" : null)">
        <InputFile OnChange="args => ReadPhotoAsync(args, draft, top)" accept="image/jpeg,image/png,image/webp" disabled="@_busy" aria-label="@label" />
        <span aria-hidden="true">@((top ? draft.Top : draft.Bottom) is null ? "+" : "✓")</span>
        @label
    </label>;

    private static RenderFragment PhotoTile(string label, string? source) => @<figure class="scale-photo-tile">
        @if (source is not null)
        {
            <img src="@source" alt="@label" />
        }
        else
        {
            <div class="scale-photo-missing">ثبت نشده</div>
        }
        <figcaption>@label</figcaption>
    </figure>;

    private async Task ReadPhotoAsync(InputFileChangeEventArgs args, PhotoDraft draft, bool top)
    {
        _busy = true;
        draft.Error = null;
        try
        {
            var file = args.File;
            if (file.Size is <= 0 or > MaxPhotoBytes || file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
            {
                draft.Error = "عکس باید JPEG، PNG یا WebP و حداکثر ۵ مگابایت باشد.";
                return;
            }

            await using var stream = file.OpenReadStream(MaxPhotoBytes);
            using var buffer = new MemoryStream((int)file.Size);
            await stream.CopyToAsync(buffer);
            if (top) draft.Top = buffer.ToArray();
            else draft.Bottom = buffer.ToArray();
        }
        catch (Exception)
        {
            draft.Error = "خواندن عکس انجام نشد. دوباره عکس را انتخاب کنید.";
        }
        finally { _busy = false; }
    }

    private async Task TogglePhotosAsync(Guid id)
    {
        var request = ++_photoRequest;
        _expandedId = _expandedId == id ? null : id;
        _visiblePhotos = null;
        _photoError = null;
        _photoLoading = _expandedId is not null;
        if (!_photoLoading) return;

        try
        {
            var photos = await ScaleService.GetPhotosAsync(id);
            if (request == _photoRequest) _visiblePhotos = photos;
        }
        catch (Exception)
        {
            if (request == _photoRequest) _photoError = "دریافت عکس‌ها انجام نشد.";
        }
        finally
        {
            if (request == _photoRequest) _photoLoading = false;
        }
    }
    private bool _createTab;
    private void SelectTab(bool create) { _createTab = create; CancelEdit(); _message = null; }
    private const int _usage = 63;
    private string _name = "", _editingName = "";
    private Guid? _editingId;
    private ScaleDto? _deleting;
    private bool _loading = true, _busy, _isError;
    private string? _message;
    private List<ScaleDto> Items(int usage) => _scales.Where(x => (x.Usage & usage) != 0).OrderBy(x => x.Name).ToList();
    protected override async Task OnInitializedAsync()
    {
        try { await ReloadAsync(); } catch (Exception ex) { ShowError(ex); } finally { _loading = false; }
    }
    private void BeginEdit(ScaleDto scale)
    {
        _photoRequest++;
        _expandedId = null;
        _visiblePhotos = null;
        _editingId = scale.Id;
        _editingName = scale.Name;
        _editPhotos = new();
        _message = null;
    }
    private void CancelEdit() { _editingId = null; _editingName = ""; _editPhotos = new(); }
    private void ShowError(Exception ex) { _isError = true; _message = ex.Message; }
    private async Task ReloadAsync()
    {
        var scales = await ScaleService.GetAsync(); _scales.Clear(); _scales.AddRange(scales);
    }
    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true; _message = null;
        try { await ScaleService.CreateAsync(_name, _usage, _newPhotos.Top, _newPhotos.Bottom); _name = ""; _newPhotos = new(); await ReloadAsync(); _isError = false; _message = "اسکیل ثبت شد."; }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task SaveEditAsync()
    {
        if (_busy || !_editingId.HasValue || string.IsNullOrWhiteSpace(_editingName)) return;
        _busy = true; _message = null;
        try { await ScaleService.RenameAsync(_editingId.Value, _editingName, _editPhotos.Top, _editPhotos.Bottom); await ReloadAsync(); CancelEdit(); _isError = false; _message = "تغییرات اسکیل ذخیره شد."; }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true; _message = null;
        try { await ScaleService.DeleteAsync(_deleting.Id, _usage); if (_expandedId == _deleting.Id) _expandedId = null; _deleting = null; await ReloadAsync(); _isError = false; _message = "اسکیل از فهرست انتخاب حذف شد."; }
        catch (Exception ex) { _deleting = null; ShowError(ex); } finally { _busy = false; }
    }
}

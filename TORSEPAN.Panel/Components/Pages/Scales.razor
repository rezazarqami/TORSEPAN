@page "/scales"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ScaleService ScaleService

<PageTitle>مدیریت اسکیل‌ها | تورسپن</PageTitle>
<section class="scales-hero">
    <span dir="ltr">SCALE MANAGEMENT</span>
    <img src="/images/brand/torsepan-mark-new.webp" alt="تورسپن" />
    <h1>مدیریت اسکیل‌ها</h1>
    <p>اسکیل کاسه رو، کاسه زیر و ساز؛ مرتب و در دسترس</p>
</section>
<nav class="scale-tabs" aria-label="دسته‌بندی اسکیل‌ها">
    @foreach (var category in Categories)
    {
        <button type="button" class="@(_usage == category.Usage ? "active" : "")" aria-pressed="@(_usage == category.Usage)" disabled="@_busy" @onclick="() => SelectCategory(category.Usage)">
            <strong>@category.Title</strong><small>@Items(category.Usage).Count اسکیل</small>
        </button>
    }
</nav>
@if (_message is not null)
{
    <div class="scale-notice @(_isError ? "error" : "success")" role="@(_isError ? "alert" : "status")">@_message</div>
}
@if (_loading)
{
    <div class="scale-empty" role="status">در حال دریافت اسکیل‌ها…</div>
}
else
{
    <section class="scale-card">
        <header><h2>اسکیل جدید · @CurrentTitle</h2><p>اسکیل جدید در همین دسته ثبت می‌شود.</p></header>
        <div class="scale-create">
            <label for="new-scale-name">نام اسکیل<input id="new-scale-name" class="form-control" maxlength="100" placeholder="مثلاً ۱۱ نت (۹+۲)" @bind="_name" @bind:event="oninput" disabled="@_busy" /></label>
            <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">ثبت اسکیل</button>
        </div>
    </section>
    <section class="scale-card">
        <header><h2>اسکیل‌های @CurrentTitle</h2><p>ویرایش نام، در تمام سازها و کاسه‌های مرتبط هم نمایش داده می‌شود.</p></header>
        @if (Items(_usage).Count == 0)
        {
            <div class="scale-empty">هنوز اسکیلی در این دسته ثبت نشده است.</div>
        }
        else
        {
            <div class="scale-list">
                @foreach (var scale in Items(_usage))
                {
                    <div class="scale-row" @key="scale.Id">
                        @if (_editingId == scale.Id)
                        {
                            <div class="scale-edit">
                                <label for="edit-scale-name">نام جدید اسکیل<input id="edit-scale-name" class="form-control" maxlength="100" @bind="_editingName" @bind:event="oninput" disabled="@_busy" /></label>
                                <p>نام «@scale.Name» برای همهٔ سازها و کاسه‌های مرتبط اصلاح می‌شود.</p>
                                @if (_isError && _message is not null) { <div class="scale-notice error" role="alert">@_message</div> }
                                <div class="scale-actions"><button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editingName))" @onclick="SaveEditAsync">ذخیره تغییرات</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="CancelEdit">انصراف</button></div>
                            </div>
                        }
                        else
                        {
                            <strong class="scale-name">@scale.Name</strong>
                            <div class="scale-actions"><button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="() => BeginEdit(scale)">ویرایش</button><button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="() => _deleting = scale">حذف از دسته</button></div>
                        }
                    </div>
                }
            </div>
        }
    </section>
}
@if (_deleting is not null)
{
    <div class="scale-overlay"><section class="scale-dialog" role="dialog" aria-modal="true" aria-labelledby="scale-delete-title"><h2 id="scale-delete-title">حذف از دستهٔ @CurrentTitle</h2><p>اسکیل «@_deleting.Name» از این دسته حذف شود؟ اطلاعات سازها و کاسه‌های قبلی حفظ می‌شود.</p><div class="scale-actions"><button type="button" class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">تأیید حذف</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="() => _deleting = null">انصراف</button></div></section></div>
}
@code {
    private readonly List<ScaleDto> _scales = [];
    private static readonly (int Usage, string Title)[] Categories = [(1, "کاسه رو"), (2, "کاسه زیر"), (4, "ساز")];
    private int _usage = 1;
    private string _name = "", _editingName = "";
    private Guid? _editingId;
    private ScaleDto? _deleting;
    private bool _loading = true, _busy, _isError;
    private string? _message;
    private string CurrentTitle => Categories.Single(x => x.Usage == _usage).Title;
    private List<ScaleDto> Items(int usage) => _scales.Where(x => (x.Usage & usage) != 0).OrderBy(x => x.Name).ToList();
    protected override async Task OnInitializedAsync()
    {
        try { await ReloadAsync(); } catch (Exception ex) { ShowError(ex); } finally { _loading = false; }
    }
    private void SelectCategory(int usage) { _usage = usage; CancelEdit(); _deleting = null; _message = null; }
    private void BeginEdit(ScaleDto scale) { _editingId = scale.Id; _editingName = scale.Name; _message = null; }
    private void CancelEdit() { _editingId = null; _editingName = ""; }
    private void ShowError(Exception ex) { _isError = true; _message = ex.Message; }
    private async Task ReloadAsync()
    {
        var scales = await ScaleService.GetAsync(); _scales.Clear(); _scales.AddRange(scales);
    }
    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true; _message = null;
        try { await ScaleService.CreateAsync(_name, _usage); _name = ""; await ReloadAsync(); _isError = false; _message = "اسکیل در دستهٔ مربوطه ثبت شد."; }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task SaveEditAsync()
    {
        if (_busy || !_editingId.HasValue || string.IsNullOrWhiteSpace(_editingName)) return;
        _busy = true; _message = null;
        try { await ScaleService.RenameAsync(_editingId.Value, _editingName); await ReloadAsync(); CancelEdit(); _isError = false; _message = "نام اسکیل اصلاح شد؛ سازها و کاسه‌های مرتبط هم با نام جدید نمایش داده می‌شوند."; }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true; _message = null;
        try { await ScaleService.DeleteAsync(_deleting.Id, _usage); _deleting = null; await ReloadAsync(); _isError = false; _message = "اسکیل از این دسته حذف شد."; }
        catch (Exception ex) { _deleting = null; ShowError(ex); } finally { _busy = false; }
    }
}

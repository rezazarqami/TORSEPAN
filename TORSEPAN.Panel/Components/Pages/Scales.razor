@page "/scales"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ScaleService ScaleService

<PageTitle>اسکیل‌ها</PageTitle>

<h3 class="mb-4">مدیریت اسکیل‌ها</h3>

<div class="card p-4 mb-4">
    <label class="form-label">نام اسکیل جدید</label>
    <div class="input-group">
        <input class="form-control" placeholder="مثلاً ۹ نت، ۱۰ نت یا ۱۲ نت" @bind="_name" />
        <button class="btn btn-primary" disabled="@(_loading || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">
            ثبت اسکیل
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger mt-3 mb-0">@_error</div>
    }
</div>

<table class="table table-striped">
    <thead><tr><th>اسکیل‌های قابل انتخاب هنگام چسب‌کاری</th></tr></thead>
    <tbody>
        @foreach (var scale in _scales)
        {
            <tr><td>@scale.Name</td></tr>
        }
    </tbody>
</table>

@code {
    private readonly List<ScaleDto> _scales = [];
    private string _name = string.Empty;
    private string? _error;
    private bool _loading;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task CreateAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            await ScaleService.CreateAsync(_name);
            _name = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        _scales.Clear();
        _scales.AddRange(await ScaleService.GetAsync());
    }
}

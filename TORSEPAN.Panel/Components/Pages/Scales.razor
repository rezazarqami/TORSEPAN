@page "/scales"
@page "/custom-scales"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Application.Scales
@using ScaleDto = TORSEPAN.Panel.Models.ScaleDto
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ScaleService ScaleService

<PageTitle>مدیریت اسکیل‌ها | تورسپن</PageTitle>
<section class="scales-hero scales-photo-hero theme-hero theme-page-intro" aria-labelledby="scales-title">
    <div class="scales-hero-art" aria-hidden="true"></div>
    <div class="scales-hero-copy"><span dir="ltr">SCALE MANAGEMENT</span><h1 id="scales-title">مدیریت اسکیل‌ها</h1></div>
</section>
<div class="navy-workspace-page navy-scales">
<nav class="scale-tabs" aria-label="بخش‌های مدیریت اسکیل">
    <button type="button" class="@(!_createTab ? "active" : null)" aria-pressed="@(!_createTab)" disabled="@(_busy)" @onclick="() => SelectTab(false)"><strong>اسکیل‌ها</strong></button>
    <button type="button" class="@(_createTab ? "active" : null)" aria-pressed="@_createTab" disabled="@(_busy)" @onclick="() => SelectTab(true)"><strong>ثبت اسکیل جدید</strong></button>
</nav>
@if (_message is not null && (!_isError || _editingId is null))
{
    <div class="scale-notice @(_isError ? "error" : "success")" role="@(_isError ? "alert" : "status")">@_message</div>
}
@if (_loading)
{
    <div class="scale-empty" role="status">در حال دریافت اسکیل‌ها…</div>
}
else if (_createTab)
{
    <section class="scale-card">
        <header><h2>اسکیل جدید</h2></header>
        <div class="scale-create" @key="_newPhotos">
            <label for="new-scale-name">نام اسکیل<input id="new-scale-name" class="form-control" maxlength="100" @bind="_name" @bind:event="oninput" disabled="@(_busy || _createdId.HasValue)" /></label>
            @PhotoPicker(_newPhotos, ReadNewPhotoAsync)
            <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">ثبت اسکیل</button>
        </div>
    </section>
}
else
{
    <section class="scale-card">
        <header><h2>اسکیل‌ها</h2><p>ویرایش نام، در تمام سازها و کاسه‌های مرتبط هم نمایش داده می‌شود.</p></header>
        @if (Items(_usage).Count == 0)
        {
            <div class="scale-empty">هنوز اسکیلی ثبت نشده است.</div>
        }
        else
        {
            <div class="scale-list">
                @foreach (var scale in Items(_usage))
                {
                    <div class="scale-row" @key="scale.Id">
                        @if (_editingId == scale.Id)
                        {
                            <div class="scale-edit">
                                <label for="edit-scale-name">نام جدید اسکیل<input id="edit-scale-name" class="form-control" maxlength="100" @bind="_editingName" @bind:event="oninput" disabled="@_busy" /></label>
                                @if (PhotosAvailable)
                                {
                                    @if (_photoLoading)
                                    {
                                        <p role="status">در حال دریافت عکس‌ها…</p>
                                    }
                                    else if (_photoError is not null)
                                    {
                                        <p role="alert">@_photoError</p>
                                        <button type="button" class="btn btn-light" @onclick="() => LoadAlbumAsync(scale.Id)">تلاش دوباره</button>
                                    }
                                    else
                                    {
                                        <ScaleAlbum @key="scale.Id" Images="_album" Editing="true" Disabled="_busy" NotesChanged="SaveNotesAsync" />
                                        @PhotoPicker(_editPhotos, AppendPhotoAsync)
                                    }
                                }
                                @if (_isError && _message is not null)
                                {
                                    <div class="scale-notice error" role="alert">@_message</div>
                                }
                                <div class="scale-actions"><button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editingName))" @onclick="SaveEditAsync">ذخیره تغییرات</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="CancelEdit">انصراف</button></div>
                            </div>
                        }
                        else
                        {
                            <div class="scale-summary">
                                <div class="scale-actions"><button type="button" class="btn btn-outline-primary" disabled="@(_busy)" @onclick="() => BeginEditAsync(scale)">ویرایش</button><button type="button" class="btn btn-outline-danger" disabled="@(_busy)" @onclick="() => _deleting = scale">حذف</button></div>
                                <div class="scale-title">
                                    @if (PhotosAvailable)
                                    {
                                        <button type="button" class="scale-photo-toggle" aria-label="@($"آلبوم عکس {scale.Name}")" aria-expanded="@(_expandedId == scale.Id)" disabled="@(_editingId is not null || _busy)" @onclick="() => TogglePhotosAsync(scale.Id)">
                                            <span aria-hidden="true">⌄</span>
                                        </button>
                                    }
                                    <strong class="scale-name"><bdi>@scale.Name</bdi></strong>
                                </div>
                            </div>
                            @if (_expandedId == scale.Id)
                            {
                                @if (_photoLoading)
                                {
                                    <div class="scale-photo-status" role="status">در حال دریافت عکس‌ها…</div>
                                }
                                else if (_photoError is not null)
                                {
                                    <div class="scale-photo-status" role="alert">@_photoError</div>
                                }
                                else
                                {
                                    <ScaleAlbum @key="scale.Id" Images="_album" />
                                }
                            }
                        }
                    </div>
                }
            </div>
        }
    </section>
}
@if (_deleting is not null)
{
    <div class="scale-overlay"><section class="scale-dialog" role="dialog" aria-modal="true" aria-labelledby="scale-delete-title"><h2 id="scale-delete-title">حذف اسکیل</h2><p>اسکیل «@_deleting.Name» از فهرست انتخاب حذف شود؟ اطلاعات سازها و کاسه‌های قبلی حفظ می‌شود.</p><div class="scale-actions"><button type="button" class="btn btn-danger" disabled="@_busy" @onclick="DeleteAsync">تأیید حذف</button><button type="button" class="btn btn-light" disabled="@_busy" @onclick="() => _deleting = null">انصراف</button></div></section></div>
}
</div>

@code {
    private readonly List<ScaleDto> _scales = [];
    private const int MaxPhotoBytes = 5_000_000;
    private static bool PhotosAvailable => !OperatingSystem.IsBrowser();
    private PhotoDraft _newPhotos = new();
    private PhotoDraft _editPhotos = new();
    private Guid? _expandedId;
    private int _photoRequest;
    private bool _photoLoading;
    private string? _photoError;
    private IReadOnlyList<ScaleAlbumImage> _album = [];
    private Guid? _createdId;

    private sealed class PhotoDraft
    {
        public byte[]? Image { get; set; }
        public string? Error { get; set; }
    }

    private RenderFragment PhotoPicker(PhotoDraft draft, Func<InputFileChangeEventArgs, Task> onChange) => @<div class="scale-photo-fields">
        @if (PhotosAvailable)
        {
            <label class="scale-photo-picker @(_busy ? "is-disabled" : null)">
                <InputFile OnChange="onChange" accept="image/jpeg,image/png,image/webp" disabled="@_busy" aria-label="افزودن عکس" />
                <span aria-hidden="true">@(draft.Image is null ? "+" : "✓")</span>
                افزودن عکس
            </label>
            @if (draft.Error is not null)
            {
                <p role="alert">@draft.Error</p>
            }
        }
    </div>;

    private async Task<byte[]?> ReadPhotoAsync(InputFileChangeEventArgs args, PhotoDraft draft)
    {
        draft.Error = null;
        var file = args.File;
        if (file.Size is <= 0 or > MaxPhotoBytes || file.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            draft.Error = "عکس باید JPEG، PNG یا WebP و حداکثر ۵ مگابایت باشد.";
            return null;
        }

        await using var stream = file.OpenReadStream(MaxPhotoBytes);
        using var buffer = new MemoryStream((int)file.Size);
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private async Task ReadNewPhotoAsync(InputFileChangeEventArgs args)
    {
        _busy = true;
        try { _newPhotos.Image = await ReadPhotoAsync(args, _newPhotos); }
        catch (Exception ex) { _newPhotos.Error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task AppendPhotoAsync(InputFileChangeEventArgs args)
    {
        if (_editingId is not { } id || _busy) return;
        _busy = true;
        try
        {
            var image = await ReadPhotoAsync(args, _editPhotos);
            if (image is null) return;
            var photoId = await ScaleService.AddAlbumImageAsync(id, image);
            _album = [.. _album, new(photoId, $"data:{args.File.ContentType};base64,{Convert.ToBase64String(image)}", [])];
        }
        catch (Exception ex) { _editPhotos.Error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveNotesAsync(ScaleAlbumImage image)
    {
        if (_editingId is not { } id || _busy) return;
        _busy = true;
        _message = null;
        try
        {
            await ScaleService.SaveAlbumNotesAsync(id, image.Id, image.Notes);
            _album = _album.Select(item => item.Id == image.Id ? image : item).ToArray();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { _busy = false; }
    }

    private Task TogglePhotosAsync(Guid id)
    {
        _expandedId = _expandedId == id ? null : id;
        if (_expandedId.HasValue) return LoadAlbumAsync(id);
        _photoRequest++;
        _album = [];
        return Task.CompletedTask;
    }

    private async Task LoadAlbumAsync(Guid id)
    {
        var request = ++_photoRequest;
        _album = [];
        _photoError = null;
        _photoLoading = true;
        try
        {
            var photos = await ScaleService.GetAlbumAsync(id);
            if (request == _photoRequest) _album = photos;
        }
        catch (Exception)
        {
            if (request == _photoRequest) _photoError = "دریافت عکس‌ها انجام نشد.";
        }
        finally
        {
            if (request == _photoRequest) _photoLoading = false;
        }
    }
    private bool _createTab;
    private void SelectTab(bool create) { _createTab = create; CancelEdit(); _message = null; }
    private const int _usage = 63;
    private string _name = "", _editingName = "";
    private Guid? _editingId;
    private ScaleDto? _deleting;
    private bool _loading = true, _busy, _isError;
    private string? _message;
    private List<ScaleDto> Items(int usage) => _scales.Where(x => (x.Usage & usage) != 0).OrderBy(x => x.Name).ToList();
    protected override async Task OnInitializedAsync()
    {
        try { await ReloadAsync(); } catch (Exception ex) { ShowError(ex); } finally { _loading = false; }
    }
    private async Task BeginEditAsync(ScaleDto scale)
    {
        _photoRequest++;
        _expandedId = null;
        _album = [];
        _editingId = scale.Id;
        _editingName = scale.Name;
        _editPhotos = new();
        _message = null;
        if (PhotosAvailable) await LoadAlbumAsync(scale.Id);
    }
    private void CancelEdit()
    {
        _photoRequest++;
        _photoLoading = false;
        _editingId = null;
        _editingName = "";
        _editPhotos = new();
    }
    private void ShowError(Exception ex) { _isError = true; _message = ex.Message; }
    private async Task ReloadAsync()
    {
        var scales = await ScaleService.GetAsync(); _scales.Clear(); _scales.AddRange(scales);
    }
    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_name)) return;
        _busy = true; _message = null;
        try
        {
            _createdId ??= await ScaleService.CreateAsync(_name, _usage);
            if (_newPhotos.Image is { } image)
                await ScaleService.AddAlbumImageAsync(_createdId.Value, image);
            _createdId = null;
            _name = "";
            _newPhotos = new();
            await ReloadAsync();
            _isError = false;
            _message = "اسکیل ثبت شد.";
        }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task SaveEditAsync()
    {
        if (_busy || !_editingId.HasValue || string.IsNullOrWhiteSpace(_editingName)) return;
        _busy = true; _message = null;
        try { await ScaleService.RenameAsync(_editingId.Value, _editingName); await ReloadAsync(); CancelEdit(); _isError = false; _message = "تغییرات اسکیل ذخیره شد."; }
        catch (Exception ex) { ShowError(ex); } finally { _busy = false; }
    }
    private async Task DeleteAsync()
    {
        if (_busy || _deleting is null) return;
        _busy = true; _message = null;
        try { await ScaleService.DeleteAsync(_deleting.Id, _usage); if (_expandedId == _deleting.Id) _expandedId = null; _deleting = null; await ReloadAsync(); _isError = false; _message = "اسکیل از فهرست انتخاب حذف شد."; }
        catch (Exception ex) { _deleting = null; ShowError(ex); } finally { _busy = false; }
    }
}

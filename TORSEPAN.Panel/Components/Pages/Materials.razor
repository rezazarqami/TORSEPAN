@page "/materials"
@page "/warehouse/materials/manage"

@using TORSEPAN.Panel.Models
@using Microsoft.AspNetCore.Components.Authorization
@using TORSEPAN.Panel.Services.Api

@inject MaterialService MaterialService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>انبار مواد اولیه</PageTitle>

<PageHeader Title="انبار مواد اولیه" SubTitle="مدیریت موجودی کاسه‌ها و اقلام مصرفی تولید و بسته‌بندی">
    <Actions>
        <button class="btn btn-outline-secondary" @onclick="BackToOverview">بازگشت به نمای موجودی</button>
    </Actions>
</PageHeader>

<div class="inventory-actions">
    <div>
        <strong>مدیریت موجودی انبار</strong>
        <small>موجودی، حد هشدار و قالب کدها را از کارت‌های زیر تنظیم کنید.</small>
    </div>
    <button type="button" class="btn btn-success add-material-button" @onclick="NewMaterial">
        <span aria-hidden="true">＋</span> افزودن قلم جدید
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-success">@_message</div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border"></div></div>
}
else
{
    <h5 class="inventory-section-title">موجودی کاسه‌ها</h5>
    <div class="inventory-table-shell mb-4">
        <table class="inventory-management-table">
            <thead><tr><th>متریال</th><th>موجودی فعلی</th><th>مدیریت موجودی، هشدار و قالب کد</th></tr></thead>
            <tbody>
                @foreach (var item in BowlItems)
                {
                    <tr>
                        <td class="material-name"><strong>@item.Name</strong></td>
                        <td>
                            <div class="stock-summary compact-stock-summary">
                                <span><small>کاسه رو</small><strong>@item.TopBowlQuantity</strong></span>
                                <span><small>کاسه زیر</small><strong>@item.BottomBowlQuantity</strong></span>
                            </div>
                        </td>
                        <td><BowlStockControls Item="item" OnSaved="StockSaved" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="inventory-list-heading">
        <h5 class="mb-0">سایر مواد اولیه و اقلام بسته‌بندی</h5>
        <input class="form-control" style="max-width:320px" placeholder="جست‌وجوی ماده اولیه..."
               @bind="_search" @bind:event="oninput" />
    </div>

    <div class="inventory-table-shell">
        <table class="inventory-management-table other-items-table">
            <thead><tr><th>نام قلم</th><th>موجودی فعلی</th><th>افزایش یا ثبت موجودی</th><th>حد هشدار</th></tr></thead>
            <tbody>
                @foreach (var item in OtherItems)
                {
                    <tr>
                        <td class="material-name"><strong>@item.Name</strong></td>
                        <td><span class="current-quantity">@item.Quantity</span></td>
                        <td colspan="2"><StockControls Item="item" OnSaved="StockSaved" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<MaterialDto> _items = [];
    private bool _loading = true;
    private bool _isAdministrator;
    private string _search = string.Empty;
    private string? _error;
    private string? _message;

    private IEnumerable<MaterialDto> BowlItems => _items
        .Where(x => x.Category == 4)
        .OrderBy(x => x.Name);

    private IEnumerable<MaterialDto> OtherItems => _items
        .Where(x => x.Category == 3 &&
            (string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(x => x.Name);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdministrator = state.User.IsInRole("Administrator");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items.Clear();
            _items.AddRange(await MaterialService.GetAsync());
        }
        catch
        {
            _error = "دریافت موجودی انبار انجام نشد.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StockSaved()
    {
        _message = "موجودی با موفقیت به‌روزرسانی شد.";
        await LoadAsync();
    }

    private void NewMaterial() => Navigation.NavigateTo("/warehouse/materials/new");
    private void BackToOverview() => Navigation.NavigateTo("/warehouse/materials");
}

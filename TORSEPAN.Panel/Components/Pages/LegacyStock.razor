@page "/admin/legacy-stock"
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Application.Auth.Queries.GetUsers
@attribute [Authorize(Roles = "Administrator")]
@inject LegacyStockService LegacyService
@inject DesignService DesignService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject IUserService UserService
@inject ProductionService ProductionService

<PageTitle>ثبت سازهای قدیمی</PageTitle>
<div class="legacy-stock-page navy-management-page">
    <ManagementPhotoHeader Kind="legacy" Title="ثبت" SecondLine="سازهای قدیمی" Description="از شناسنامهٔ قدیمی به موجودی امروز؛ فقط با کد کاسه رو" CssClass="legacy-hero" />
    <p class="legacy-paid" style="text-align:center;width:100%;box-sizing:border-box">✓ دستمزد این سازها قبلاً محاسبه شده است</p>
    @if (_loading)
    {
        <p role="status" class="legacy-feedback">در حال دریافت فهرست‌ها…</p>
    }
    else if (_loadFailed)
    {
        <div role="alert" class="legacy-feedback error">فهرست‌ها دریافت نشدند. اتصال را بررسی کنید. <button @onclick="LoadAsync">تلاش دوباره</button></div>
    }
    else
    {
        @if (_saved is not null)
        {
            <section class="legacy-saved" role="status" aria-live="polite">
                <span class="legacy-check">✓</span><h2>ساز @_saved.Code ثبت شد</h2>
                <p>موجود در @DestinationTitle(_saved)؛ بدون محاسبهٔ دوبارهٔ دستمزد</p>
                <div class="legacy-actions"><button class="legacy-primary" @onclick="Next">ثبت ساز بعدی</button><a href="@PassportUrl(_saved.Code)">مشاهده شناسنامه</a><a class="legacy-stock-link" href="@(_saved.ExportLocation.HasValue ? "/warehouse/export" : "/warehouse/list")">رفتن به انبار</a></div>
            </section>
        }
        else
        {
            <EditForm Model="_draft" OnValidSubmit="SaveAsync" class="legacy-form">
                <DataAnnotationsValidator />
                <fieldset disabled="@(_saving || _pending is not null)">
                    <section class="legacy-card" aria-labelledby="legacy-identity">
                        <header><span>۰۱</span><div><h2 id="legacy-identity">مشخصات ساز</h2><p>کد کاسه زیر لازم نیست؛ داخل ساز بسته است.</p></div></header>
                        <div class="legacy-grid">
                            <label class="legacy-wide" for="legacy-code">کد کاسه رو<InputText id="legacy-code" @bind-Value="_draft.Code" maxlength="50" autocomplete="off" dir="ltr" placeholder="کد روی شناسنامه قدیمی" /><ValidationMessage For="()=>_draft.Code" /></label>
                            <label for="legacy-material">متریال<CompactPicker TValue="Guid?" Title="متریال" Options="MaterialOptions" id="legacy-material" @bind-Value="_draft.MaterialId" /><ValidationMessage For="()=>_draft.MaterialId" /></label>
                            <label for="legacy-scale">اسکیل ساز<CompactPicker TValue="Guid?" Title="اسکیل ساز" Options="ScaleOptions(4)" id="legacy-scale" @bind-Value="_draft.ScaleId" /><ValidationMessage For="()=>_draft.ScaleId" /></label>
                            <label for="legacy-top">تعداد نت کاسه رو<InputNumber id="legacy-top" @bind-Value="_draft.TopNotes" min="1" max="100" step="1" /><ValidationMessage For="()=>_draft.TopNotes" /></label>
                            <label for="legacy-bottom">تعداد نت کاسه زیر<InputNumber id="legacy-bottom" @bind-Value="_draft.BottomNotes" min="0" max="100" step="1" /><small>کاسه زیر بدون نت: صفر</small><ValidationMessage For="()=>_draft.BottomNotes" /></label>
                        </div>
                        <details class="legacy-advanced"><summary>اسکیل جداگانهٔ کاسه‌ها (اختیاری)</summary><div class="legacy-grid">
                            <label for="legacy-top-scale">اسکیل کاسه رو<CompactPicker TValue="Guid?" Title="اسکیل کاسه رو" Options="ScaleOptions(1)" id="legacy-top-scale" @bind-Value="_draft.TopScaleId" /></label>
                            <label for="legacy-bottom-scale">اسکیل کاسه زیر<CompactPicker TValue="Guid?" Title="اسکیل کاسه زیر" Options="ScaleOptions(2)" id="legacy-bottom-scale" @bind-Value="_draft.BottomScaleId" disabled="@(_draft.BottomNotes == 0)" /></label>
                        </div></details>
                    </section>
                    <section class="legacy-card" aria-labelledby="legacy-location">
                        <header><span>۰۲</span><div><h2 id="legacy-location">محل نگهداری فعلی</h2><p>ساز مستقیم در موجودی انبار انتخاب‌شده قرار می‌گیرد.</p></div></header>
                        <div class="legacy-grid">
                            <label for="legacy-destination">نوع انبار<CompactPicker TValue="string" Title="نوع انبار" Options="DestinationOptions" id="legacy-destination" @bind-Value="_draft.Destination" /></label>
                            @if (_draft.Destination == "export")
                            {
                                <label for="legacy-country">انبار صادراتی<CompactPicker TValue="int?" Title="انبار صادراتی" Options="CountryOptions" id="legacy-country" @bind-Value="_draft.ExportLocation" /></label>
                            }
                            @if (_draft.Destination == "domestic")
                            {
                            <label for="legacy-warehouse">انبار سازها<CompactPicker TValue="int?" Title="انبار سازها" Options="WarehouseOptions" id="legacy-warehouse" @bind-Value="_draft.WarehouseId" /><ValidationMessage For="()=>_draft.WarehouseId" /></label>
                            }
                        </div>
                    </section>
                    <section class="legacy-card" aria-labelledby="legacy-makers">
                        <header><span>۰۳</span><div><h2 id="legacy-makers">سازندگان</h2><p>نام‌های روی شناسنامه را انتخاب کنید؛ موارد نامعلوم را خالی بگذارید.</p></div></header>
                        <div class="legacy-grid">
                            <label for="legacy-dimple">دیمپل<CompactPicker TValue="Guid?" Title="دیمپل" Options="UserOptions" id="legacy-dimple" @bind-Value="_draft.DimpleUserId" /></label>
                            <label for="legacy-shape">شیپ<CompactPicker TValue="Guid?" Title="شیپ" Options="UserOptions" id="legacy-shape" @bind-Value="_draft.ShapeUserId" /></label>
                            <label for="legacy-tune">تیون<CompactPicker TValue="Guid?" Title="تیون" Options="UserOptions" id="legacy-tune" @bind-Value="_draft.TuneUserId" /></label>
                            <label for="legacy-fine">فاین‌تیون<CompactPicker TValue="Guid?" Title="فاین‌تیون" Options="UserOptions" id="legacy-fine" @bind-Value="_draft.FineTuneUserId" /></label>
                            <label for="legacy-design">دیزاین<CompactPicker TValue="Guid?" Title="دیزاین" Options="UserOptions" id="legacy-design" @bind-Value="_draft.DesignUserId" /></label>
                            <label for="legacy-design-type">نوع دیزاین<CompactPicker TValue="Guid?" Title="نوع دیزاین" Options="DesignOptions" id="legacy-design-type" @bind-Value="_draft.DesignTypeId" /></label>
                        </div>
                    </section>
                </fieldset>
                @if (_error is not null){<p class="legacy-feedback error" role="alert">@_error</p>}
                <footer class="legacy-submit"><p>موجودی مواد اولیه و دستمزدها تغییر نمی‌کنند.</p><button type="submit" class="legacy-primary" disabled="@_saving">@(_saving ? "در حال ثبت…" : _pending is not null ? "تلاش دوباره برای ثبت همین ساز" : "ثبت ساز در انبار")</button>
                @if (_pending is not null && !_saving){<button type="button" @onclick="EditDraft">اصلاح اطلاعات</button>}</footer>
            </EditForm>
        }

    }
</div>
@code {
    private IReadOnlyList<(Guid? Value,string Text)> MaterialOptions => new (Guid?,string)[]{(null,"انتخاب کنید")}.Concat(_materials.Select(x=>((Guid?)x.Id,x.Name))).ToArray();
    private IReadOnlyList<(Guid? Value,string Text)> ScaleOptions(int usage) => new (Guid?,string)[]{(null,"نامشخص")}.Concat(ScalesFor(usage).Select(x=>((Guid?)x.Id,x.Name))).ToArray();
    private IReadOnlyList<(Guid? Value,string Text)> UserOptions => new (Guid?,string)[]{(null,"نامشخص")}.Concat(_users.Select(x=>((Guid?)x.Id,UserLabel(x)))).ToArray();
    private IReadOnlyList<(Guid? Value,string Text)> DesignOptions => new (Guid?,string)[]{(null,"نامشخص / ساده")}.Concat(_designTypes.Select(x=>((Guid?)x.Id,x.Name))).ToArray();
    private IReadOnlyList<(int? Value,string Text)> WarehouseOptions => new (int?,string)[]{(null,"انتخاب کنید")}.Concat(_warehouses.Select(x=>((int?)x.Id,x.Name))).ToArray();
    private static readonly (string Value,string Text)[] DestinationOptions=[("domestic","انبار داخلی"),("export","انبار صادراتی")];
    private static readonly (int? Value,string Text)[] CountryOptions=[(null,"انتخاب کنید"),(3,"آلمان 🇩🇪"),(2,"لندن 🇬🇧"),(1,"ترکیه 🇹🇷"),(4,"ایران 🇮🇷"),(5,"مصر 🇪🇬"),(6,"ریاض 🇸🇦"),(7,"لبنان 🇱🇧")];
    private LegacyStockDraft _draft = new();
    private List<DesignTypeDto> _designTypes = [];
    private List<MaterialDto> _materials = [];
    private List<ScaleDto> _scales = [];
    private List<UserDto> _users = [];
    private List<InstrumentWarehouseDto> _warehouses = [];
    private bool _loading = true, _loadFailed, _saving;
    private string? _error;
    private LegacyStockRequest? _pending;
    private LegacyStockReceipt? _saved;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _loadFailed = false;
        try
        {
            _designTypes = await DesignService.GetTypesAsync();
            var materials = MaterialService.GetAsync(); var scales = ScaleService.GetAsync(); var users = UserService.GetUsersAsync();
            var warehouses = ProductionService.GetInstrumentWarehousesAsync();
            await Task.WhenAll(materials, scales, users, warehouses);
            _materials = (await materials).Where(x => x.Category == 4).ToList(); _scales = (await scales).ToList(); _users = (await users).OrderBy(UserLabel).ToList();
            _warehouses = (await warehouses).ToList();
        }
        catch { _loadFailed = true; }
        finally { _loading = false; }
    }
    private async Task SaveAsync()
    {
        if (_saving || _saved is not null) return;
        _error = null;
        if (_draft.Destination == "domestic" && !_draft.WarehouseId.HasValue){_error = "انبار داخلی را انتخاب کنید.";return;}
        if (_draft.Destination == "export" && !_draft.ExportLocation.HasValue){_error = "انبار صادراتی را انتخاب کنید.";return;}
        _pending ??= new(Guid.NewGuid(), _draft.Code, _draft.MaterialId!.Value, _draft.ScaleId!.Value, _draft.TopNotes!.Value, _draft.BottomNotes!.Value,
            _draft.WarehouseId ?? 1, _draft.Destination == "export" ? _draft.ExportLocation : null,
            _draft.DimpleUserId, _draft.ShapeUserId, _draft.TuneUserId, _draft.FineTuneUserId, _draft.DesignUserId, _draft.TopScaleId, _draft.BottomNotes == 0 ? null : _draft.BottomScaleId, _draft.DesignTypeId);
        _saving = true;
        try
        {
            var receipt = await LegacyService.CreateAsync(_pending);
            if (receipt is null) throw new InvalidOperationException();
            _saved = receipt;
        }
        catch (OrderActionException error){_error = error.Message;}
        catch {_error = "پاسخ ثبت دریافت نشد؛ اطلاعات حفظ شده است. برای بررسی و تکمیل همین ثبت، دوباره تلاش کنید.";}
        finally {_saving = false;}
    }
    private void EditDraft(){_pending = null; _error = null;}
    private void Next(){_draft.Code = ""; _pending = null; _saved = null; _error = null;}
    private IEnumerable<ScaleDto> ScalesFor(int usage) => _scales.Where(x => (x.Usage & usage) == usage);
    private static string UserLabel(UserDto user) => (string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName) + (user.IsActive ? "" : " (غیرفعال)");
    private static string PassportUrl(string code) => "/production/process?code=" + Uri.EscapeDataString(code);
    private string DestinationTitle(LegacyStockReceipt item) => item.ExportLocation switch { 1 => "انبار صادراتی ترکیه 🇹🇷", 2 => "انبار صادراتی لندن 🇬🇧", 3 => "انبار صادراتی آلمان 🇩🇪", 4 => "انبار صادراتی ایران 🇮🇷", 5 => "انبار صادراتی مصر 🇪🇬", 6 => "انبار صادراتی ریاض 🇸🇦", 7 => "انبار صادراتی لبنان 🇱🇧", _ => _warehouses.FirstOrDefault(x => x.Id == item.WarehouseId)?.Name ?? "انبار داخلی" };
}

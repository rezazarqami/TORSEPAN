@page "/bowls"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject BowlService BowlService
@inject NavigationManager Navigation

<PageTitle>تولید</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">

    <h3>تولید</h3>

    <button class="btn btn-primary"
            @onclick="NewBowl">
        ثبت کاسه
    </button>

</div>

@if (_loading)
{
    <p>در حال بارگذاری...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">
        @_error
    </div>
}
else if (_bowls.Count == 0)
{
    <div class="alert alert-info">
        هیچ کاسه‌ای ثبت نشده است.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>کد</th>
                <th>نوع کاسه</th>
                <th>دارای نت</th>
                <th>نوع ساز</th>
                <th>وضعیت</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var bowl in _bowls)
            {
                <tr>
                    <td>@bowl.ProductionCode</td>
                    <td>@(bowl.BowlType == 1 ? "کاسه بالا" : "کاسه پایین")</td>
                    <td>@(bowl.HasNotes ? "بله" : "خیر")</td>
                    <td>@(bowl.InstrumentType == 1 ? "۹ نت" : "سفارشی")</td>
                    <td><span class="badge bg-primary">@StageText(bowl.Stage)</span></td>
                </tr>
            }

        </tbody>

    </table>
}

@code
{
    private bool _loading = true;

    private string? _error;

    private List<BowlDto> _bowls = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _bowls = (await BowlService.GetAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void NewBowl()
    {
        Navigation.NavigateTo("/bowls/new");
    }

    private static string StageText(int stage) => stage switch
    {
        1 => "ثبت شده",
        2 => "در انتظار دیمپل",
        3 => "در حال دیمپل",
        4 => "در انتظار شیپ",
        5 => "در حال شیپ",
        6 => "در انتظار پخت",
        7 => "در حال پخت",
        8 => "در انتظار کوک",
        9 => "در حال کوک",
        10 => "در انتظار چسب‌کاری",
        11 => "در حال چسب‌کاری",
        12 => "در انتظار فاین تیون",
        13 => "کوک نهایی",
        14 => "در انتظار کنترل کیفیت",
        15 => "کنترل کیفیت",
        16 => "در انتظار بسته‌بندی",
        17 => "بسته‌بندی",
        18 => "تکمیل شده",
        19 => "رد شده",
        _ => "نامشخص"
    };
}

@page "/bowls"
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject BowlService BowlService
@inject HandpanService HandpanService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject NavigationManager Navigation

<PageTitle>مدیریت تولید | تورسپن</PageTitle>
<section class="production-hero">
    <span class="production-kicker" dir="ltr">PRODUCTION MANAGEMENT</span>
    <img src="/images/brand/torsepan-mark-new.webp" alt="تورسپن" />
    <h1>مدیریت تولید</h1><p>کاسه‌ها و سازها؛ اطلاعات فنی، وضعیت ساخت و سوابق عملیات در یک نگاه</p>
</section>
<div class="production-toolbar"><p>فهرست تولید را بررسی کنید یا کاسهٔ جدید ثبت کنید.</p><button type="button" class="btn btn-primary" @onclick="NewBowl">＋ ثبت کاسه</button></div>
<nav class="production-tabs" aria-label="بخش‌های تولید">
    <button type="button" class="@(_tab == "bowls" ? "active" : "")" aria-pressed="@(_tab == "bowls")" disabled="@(_deleting || _rollingBack)" @onclick='() => _tab = "bowls"'><span aria-hidden="true">◒</span><div><strong>کاسه‌ها</strong><small>کاسه رو و کاسه زیر</small></div><b>@(_loading ? "…" : _bowlTotalItems.ToString())</b></button>
    <button type="button" class="@(_tab == "handpans" ? "active" : "")" aria-pressed="@(_tab == "handpans")" disabled="@(_deleting || _rollingBack)" @onclick='() => _tab = "handpans"'><span aria-hidden="true">◎</span><div><strong>سازها</strong><small>سازهای تشکیل‌شده</small></div><b>@(_loading ? "…" : _handpans.Count.ToString())</b></button>
</nav>
@if (_loading)
{
    <div class="production-empty" role="status"><span class="spinner-border spinner-border-sm"></span> در حال دریافت اطلاعات تولید…</div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_tab == "bowls")
{
    <section class="production-panel" aria-label="فهرست کاسه‌ها">
        <header class="production-heading"><div><small>کاسه رو و کاسه زیر</small><h2>کاسه‌های تولید</h2></div><span>@_bowlTotalItems کاسه</span></header>
        <details class="production-filters"><summary>فیلتر کاسه‌ها</summary><div class="production-filter-grid">
            <label>نوع کاسه<select class="form-select" @bind="_bowlTypeFilter"><option value="">همه کاسه‌ها</option><option value="1">کاسه رو</option><option value="2">کاسه زیر</option></select></label>
            <label>دارای نت<select class="form-select" @bind="_notesFilter"><option value="">همه</option><option value="true">دارای نت</option><option value="false">بدون نت</option></select></label>
            <label>متریال<select class="form-select" @bind="_materialFilter"><option value="">همه متریال‌ها</option>@foreach(var item in _materials){<option value="@item.Id">@item.Name</option>}</select></label>
            <label>اسکیل کاسه<select class="form-select" @bind="_scaleFilter"><option value="">همه اسکیل‌ها</option>@foreach(var item in _scales.Where(x => (x.Usage & 3) != 0)){<option value="@item.Id">@item.Name</option>}</select></label>
            <label>وضعیت<select class="form-select" @bind="_stageFilter"><option value="">همه وضعیت‌ها</option>@foreach(var item in StageOptions){<option value="@item.Value">@item.Text</option>}</select></label>
        </div><div class="production-filter-actions"><button type="button" class="btn btn-primary" disabled="@_filtering" @onclick="ApplyFiltersAsync">اعمال فیلترها</button><button type="button" class="btn btn-light" disabled="@_filtering" @onclick="ClearFiltersAsync">پاک کردن فیلترها</button></div></details>
        @if (_filterError is not null) { <div class="alert alert-danger" role="alert">@_filterError</div> }
        @if (_bowls.Count == 0)
        {
            <div class="production-empty">کاسه‌ای با این مشخصات پیدا نشد. فیلترها را تغییر دهید یا کاسهٔ جدید ثبت کنید.</div>
        }
        else
        {
            <div class="production-card-grid">
                @foreach (var bowl in _bowls)
                {
                    <article class="production-card" @key="bowl.Id">
                        <header><strong class="card-code"><bdi dir="ltr">@bowl.ProductionCode</bdi></strong><small>@(bowl.BowlType == 1 ? "کاسه رو" : "کاسه زیر")</small></header>
                        <p class="card-scale">@bowl.ScaleName</p>
                        <span class="card-stage">@StageText(bowl.Stage)</span>
                        <button type="button" class="card-expand" aria-label="@($"جزئیات و عملیات کاسه {bowl.ProductionCode}")" aria-expanded="@_expandedBowls.Contains(bowl.Id)" @onclick="() => ToggleBowlDetails(bowl.Id)">@(_expandedBowls.Contains(bowl.Id) ? "بستن جزئیات −" : "جزئیات و عملیات +")</button>
                        @if (_expandedBowls.Contains(bowl.Id))
                        {
                            <div class="production-card-details">
                                <dl><div><dt>متریال</dt><dd>@bowl.MaterialName</dd></div><div><dt>دارای نت</dt><dd>@(bowl.HasNotes ? "بله" : "خیر")</dd></div></dl>
                                <div class="item-actions"><AuthorizeView Roles="Administrator"><button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_deleting || _rollingBack)" @onclick="() => RequestRollback(bowl)">مرحله قبل</button><button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_deleting || _rollingBack)" @onclick="() => RequestDelete(bowl)">حذف</button></AuthorizeView></div>
                                <div class="production-details"><ProductionOperationDetails Title="@($"عملیات انجام‌شده روی کاسه {bowl.ProductionCode}")" Operations="bowl.Operations" /></div>
                            </div>
                        }
                    </article>
                }
            </div>
            @if (_bowlTotalPages > 1)
            {
                <nav aria-label="صفحه‌بندی کاسه‌ها"><ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item"><button type="button" class="page-link" disabled="@(_filtering || _bowlPage <= 1)" @onclick="() => GoToBowlPageAsync(_bowlPage - 1)">قبلی</button></li>
                    @foreach (var page in VisiblePages(_bowlPage, _bowlTotalPages)) { var selectedPage = page; <li class="page-item @(selectedPage == _bowlPage ? "active" : null)"><button type="button" class="page-link" aria-current="@(selectedPage == _bowlPage ? "page" : null)" disabled="@_filtering" @onclick="() => GoToBowlPageAsync(selectedPage)">@selectedPage</button></li> }
                    <li class="page-item"><button type="button" class="page-link" disabled="@(_filtering || _bowlPage >= _bowlTotalPages)" @onclick="() => GoToBowlPageAsync(_bowlPage + 1)">بعدی</button></li>
                </ul><p class="production-page-caption">صفحهٔ @_bowlPage از @_bowlTotalPages</p></nav>
            }
        }
    </section>
}
else
{
    <section class="production-panel" aria-label="فهرست سازها">
        <header class="production-heading"><div><small>سازهای تشکیل‌شده</small><h2>سازهای تولید</h2></div><span>@FilteredHandpans.Count() ساز</span></header>
        <details class="production-filters"><summary>فیلتر سازها</summary><div class="production-filter-grid">
            <label>متریال<select class="form-select" @bind="_handpanMaterialFilter"><option value="">همه متریال‌ها</option>@foreach(var name in _handpans.Select(x=>x.MaterialName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select></label>
            <label>اسکیل ساز<select class="form-select" @bind="_handpanScaleFilter"><option value="">همه اسکیل‌ها</option>@foreach(var name in _handpans.Select(x=>x.ScaleName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select></label>
            <label>وضعیت<select class="form-select" @bind="_handpanStageFilter"><option value="">همه وضعیت‌ها</option>@foreach(var item in HandpanStageOptions){<option value="@item.Value">@item.Text</option>}</select></label>
        </div><div class="production-filter-actions"><button type="button" class="btn btn-primary" @onclick="ApplyHandpanFilters">اعمال فیلترها</button><button type="button" class="btn btn-light" @onclick="ClearHandpanFilters">پاک کردن فیلترها</button></div></details>
        @if (!FilteredHandpans.Any())
        {
            <div class="production-empty">سازی با این مشخصات پیدا نشد. فیلترها را تغییر دهید.</div>
        }
        else
        {
            <div class="production-card-grid">
                @foreach (var handpan in PagedHandpans)
                {
                    <article class="production-card" @key="handpan.Id">
                        <header><strong class="card-code"><bdi dir="ltr">@handpan.SerialNumber</bdi></strong><small>ساز</small></header>
                        <p class="card-scale">@handpan.ScaleName</p>
                        <span class="card-stage">@StageText(handpan.Stage)</span>
                        <button type="button" class="card-expand" aria-label="@($"جزئیات و عملیات ساز {handpan.SerialNumber}")" aria-expanded="@_expandedHandpans.Contains(handpan.Id)" @onclick="() => ToggleHandpanDetails(handpan.Id)">@(_expandedHandpans.Contains(handpan.Id) ? "بستن جزئیات −" : "جزئیات و عملیات +")</button>
                        @if (_expandedHandpans.Contains(handpan.Id))
                        {
                            <div class="production-card-details">
                                <dl><div><dt>متریال</dt><dd>@handpan.MaterialName</dd></div><div><dt>کد کاسه رو</dt><dd><bdi dir="ltr">@handpan.TopBowlCode</bdi></dd></div><div><dt>کد کاسه زیر</dt><dd><bdi dir="ltr">@handpan.BottomBowlCode</bdi></dd></div></dl>
                                <div class="item-actions"><AuthorizeView Roles="Administrator"><button type="button" class="btn btn-sm btn-outline-warning" disabled="@(_deleting || _rollingBack)" @onclick="() => RequestRollback(handpan)">مرحله قبل</button><button type="button" class="btn btn-sm btn-outline-danger" disabled="@(_deleting || _rollingBack)" @onclick="() => RequestDelete(handpan)">حذف</button></AuthorizeView></div>
                                <div class="production-details"><ProductionOperationDetails Title="@($"عملیات انجام‌شده روی ساز {handpan.SerialNumber}")" Operations="handpan.Operations" /></div>
                            </div>
                        }
                    </article>
                }
            </div>
            @if (HandpanTotalPages > 1)
            {
                <nav aria-label="صفحه‌بندی سازها"><ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item"><button type="button" class="page-link" disabled="@(_handpanPage <= 1)" @onclick="() => ChangeHandpanPage(_handpanPage - 1)">قبلی</button></li>
                    @foreach (var page in VisiblePages(_handpanPage, HandpanTotalPages)) { var selectedPage = page; <li class="page-item @(selectedPage == _handpanPage ? "active" : null)"><button type="button" class="page-link" aria-current="@(selectedPage == _handpanPage ? "page" : null)" @onclick="() => ChangeHandpanPage(selectedPage)">@selectedPage</button></li> }
                    <li class="page-item"><button type="button" class="page-link" disabled="@(_handpanPage >= HandpanTotalPages)" @onclick="() => ChangeHandpanPage(_handpanPage + 1)">بعدی</button></li>
                </ul></nav>
            }
        }
    </section>
}

<AppConfirmDialog IsOpen="@(_rollbackBowl is not null || _rollbackHandpan is not null)"
                  Title="بازگشت به مرحله قبل"
                  Message="@_rollbackMessage"
                  ConfirmText="تأیید و بازگشت"
                  Error="@_rollbackError"
                  Busy="@_rollingBack"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />
@if (_rollbackNotice is not null)
{
    <div class="production-delete-notice" role="status"><span>@_rollbackNotice</span><button type="button" aria-label="بستن پیام" @onclick="() => _rollbackNotice = null">×</button></div>
}

@if (_deleteBowl is not null || _deleteHandpan is not null)
{
    <div class="production-delete-overlay"><section class="production-delete-dialog" role="dialog" aria-modal="true" aria-labelledby="production-delete-title">
        <h2 id="production-delete-title">تأیید حذف @(_deleteBowl is not null ? "کاسه" : "ساز")</h2>
        <p>کد <strong>@(_deleteBowl?.ProductionCode ?? _deleteHandpan?.SerialNumber)</strong> برای همیشه حذف شود؟</p>
        <p class="delete-warning">@(_deleteBowl is not null ? "کاسه و سوابق مرتبط حذف می‌شوند. اگر کاسه به ساز متصل باشد، ساز و کاسهٔ دیگر آن هم حذف می‌شوند." : "ساز، کاسه‌های مرتبط و تمام سوابق آن حذف می‌شوند.")</p>
        @if (_deleteError is not null) { <div class="alert alert-danger" role="alert">@_deleteError</div> }
        <div class="production-delete-actions"><button type="button" class="btn btn-danger" disabled="@(_deleting || _rollingBack)" @onclick="ConfirmDeleteAsync">@(_deleting ? "در حال حذف…" : "تأیید و حذف")</button><button type="button" class="btn btn-light" disabled="@(_deleting || _rollingBack)" @onclick="CancelDelete">انصراف</button></div>
    </section></div>
}
@if (_deleteNotice is not null)
{
    <div class="production-delete-notice" role="status"><span>@_deleteNotice</span><button type="button" aria-label="بستن پیام" @onclick="() => _deleteNotice = null">×</button></div>
}

@code {
    private BowlDto? _rollbackBowl;
    private HandpanDto? _rollbackHandpan;
    private bool _rollingBack;
    private string? _rollbackError, _rollbackNotice;
    private string _rollbackMessage = string.Empty;
    private int? _rollbackTarget;
    private BowlDto? _deleteBowl;
    private HandpanDto? _deleteHandpan;
    private bool _deleting;
    private string? _deleteError, _deleteNotice;
    private bool _loading = true, _filtering;
    private string _tab = "bowls";
    private string? _filterError;
    private int _bowlTotalItems;
    private string? _error;
    private List<BowlDto> _bowls = [];
    private List<HandpanDto> _handpans = [];
    private const int PageSize = 20;
    private int _bowlPage = 1;
    private int _bowlTotalPages;
    private int _handpanPage = 1;
    private static IEnumerable<int> VisiblePages(int current, int total)
    {
        var count = Math.Min(5, Math.Max(0, total));
        var start = Math.Clamp(current - 2, 1, Math.Max(1, total - count + 1));
        return Enumerable.Range(start, count);
    }
    private IEnumerable<HandpanDto> FilteredHandpans => _handpans.Where(x =>
        (string.IsNullOrWhiteSpace(_handpanMaterialFilter) || x.MaterialName == _handpanMaterialFilter) &&
        (string.IsNullOrWhiteSpace(_handpanScaleFilter) || x.ScaleName == _handpanScaleFilter) &&
        (!int.TryParse(_handpanStageFilter, out var stage) || x.Stage == stage));
    private IEnumerable<HandpanDto> PagedHandpans => FilteredHandpans.Skip((_handpanPage - 1) * PageSize).Take(PageSize);
    private int HandpanTotalPages => (int)Math.Ceiling((double)FilteredHandpans.Count() / PageSize);
    private readonly HashSet<Guid> _expandedBowls = [];
    private readonly HashSet<Guid> _expandedHandpans = [];
    private readonly List<MaterialDto> _materials = [];
    private readonly List<ScaleDto> _scales = [];
    private string _bowlTypeFilter="", _notesFilter="", _materialFilter="", _scaleFilter="", _stageFilter="";
    private string _handpanMaterialFilter="", _handpanScaleFilter="", _handpanStageFilter="";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadBowlPageAsync(1);
            _handpans = (await HandpanService.GetAllAsync()).ToList();
            _materials.AddRange(await MaterialService.GetAsync());
            _scales.AddRange(await ScaleService.GetAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleBowlDetails(Guid id) { if (!_expandedBowls.Add(id)) _expandedBowls.Remove(id); }
    private void ToggleHandpanDetails(Guid id) { if (!_expandedHandpans.Add(id)) _expandedHandpans.Remove(id); }
    private void NewBowl() => Navigation.NavigateTo("/bowls/new");

    private async Task LoadBowlPageAsync(int page)
    {
        var result = await BowlService.GetPageAsync(page, PageSize,
            int.TryParse(_bowlTypeFilter,out var bt)?bt:null,
            bool.TryParse(_notesFilter,out var notes)?notes:null,
            Guid.TryParse(_materialFilter,out var material)?material:null,
            Guid.TryParse(_scaleFilter,out var scale)?scale:null,
            int.TryParse(_stageFilter,out var stage)?stage:null);
        _bowlPage = result?.Page ?? page;
        _bowlTotalPages = result?.TotalPages ?? 0;
        _bowlTotalItems = result?.TotalItems ?? 0;
        _bowls = result?.Items.ToList() ?? [];
        _expandedBowls.Clear();
    }

    private void ChangeHandpanPage(int page)
    {
        _handpanPage = page;
        _expandedHandpans.Clear();
    }
    private void ApplyHandpanFilters(){_handpanPage=1;_expandedHandpans.Clear();}
    private void ClearHandpanFilters(){_handpanMaterialFilter=_handpanScaleFilter=_handpanStageFilter="";ApplyHandpanFilters();}

    private void RequestDelete(BowlDto bowl)
    {
        if (_deleting || _rollingBack) return;
        _deleteBowl = bowl; _deleteHandpan = null; _deleteError = null; _deleteNotice = null;
    }
    private void RequestDelete(HandpanDto handpan)
    {
        if (_deleting || _rollingBack) return;
        _deleteHandpan = handpan; _deleteBowl = null; _deleteError = null; _deleteNotice = null;
    }
    private void CancelDelete()
    {
        if (_deleting || _rollingBack) return;
        _deleteBowl = null; _deleteHandpan = null; _deleteError = null;
    }
    private async Task ConfirmDeleteAsync()
    {
        if (_deleting || (_deleteBowl is null && _deleteHandpan is null)) return;
        _deleting = true; _deleteError = null;
        var code = _deleteBowl?.ProductionCode ?? _deleteHandpan!.SerialNumber;
        try
        {
            if (_deleteBowl is not null) await BowlService.DeleteAsync(_deleteBowl.Id);
            else await HandpanService.DeleteAsync(_deleteHandpan!.Id);
        }
        catch (Exception ex)
        {
            _deleteError = string.IsNullOrWhiteSpace(ex.Message) ? "حذف انجام نشد؛ دوباره تلاش کنید." : ex.Message;
            _deleting = false;
            return;
        }
        _deleteBowl = null; _deleteHandpan = null;
        _deleteNotice = $"کد {code} و سوابق مرتبط حذف شد.";
        try
        {
            await LoadBowlPageAsync(_bowlPage);
            if (_bowls.Count == 0 && _bowlPage > 1) await LoadBowlPageAsync(_bowlPage - 1);
            _handpans = (await HandpanService.GetAllAsync()).ToList();
            if (_handpanPage > HandpanTotalPages && _handpanPage > 1) _handpanPage = Math.Max(1, HandpanTotalPages);
        }
        catch
        {
            _deleteNotice = $"کد {code} حذف شد؛ برای دریافت فهرست جدید، صفحه را تازه کنید.";
        }
        finally { _deleting = false; }
    }
    private Task ApplyFiltersAsync() => GoToBowlPageAsync(1);
    private async Task GoToBowlPageAsync(int page)
    {
        if (_filtering) return;
        _filtering = true; _filterError = null;
        try { await LoadBowlPageAsync(page); }
        catch (Exception ex) { _filterError = ex.Message; }
        finally { _filtering = false; }
    }
    private async Task ClearFiltersAsync(){_bowlTypeFilter=_notesFilter=_materialFilter=_scaleFilter=_stageFilter="";await GoToBowlPageAsync(1);}
    private void RequestRollback(BowlDto bowl)
    {
        if (_deleting || _rollingBack) return;
        var handpan = _handpans.FirstOrDefault(x => x.TopBowlCode == bowl.ProductionCode || x.BottomBowlCode == bowl.ProductionCode);
        OpenRollback(bowl, handpan);
    }
    private void RequestRollback(HandpanDto handpan)
    {
        if (_deleting || _rollingBack) return;
        OpenRollback(null, handpan);
    }
    private void OpenRollback(BowlDto? bowl, HandpanDto? handpan)
    {
        var stage = handpan?.Stage ?? bowl!.Stage;
        var target = RollbackStage(stage, handpan is not null);
        _rollbackError = null; _rollbackNotice = null;
        if (target is null)
        {
            _rollbackNotice = $"برای وضعیت «{StageText(stage)}» بازگشت به مرحله قبل امکان‌پذیر نیست.";
            return;
        }
        _rollbackBowl = bowl; _rollbackHandpan = handpan; _rollbackTarget = target;
        var code = bowl?.ProductionCode ?? handpan!.SerialNumber;
        _rollbackMessage = $"کد {code} از «{StageText(stage)}» به «{StageText(target.Value)}» برگردد؟ سابقهٔ عملیات همان مرحله نیز برگردانده می‌شود.";
        if (handpan is not null)
            _rollbackMessage += $" این تغییر برای ساز {handpan.SerialNumber} و هر دو کاسهٔ آن انجام می‌شود.";
    }
    private void CancelRollback()
    {
        if (_rollingBack) return;
        _rollbackBowl = null; _rollbackHandpan = null; _rollbackError = null; _rollbackTarget = null;
    }
    private async Task ConfirmRollbackAsync()
    {
        if (_deleting || _rollingBack || _rollbackTarget is null || (_rollbackBowl is null && _rollbackHandpan is null)) return;
        _rollingBack = true; _rollbackError = null;
        var code = _rollbackBowl?.ProductionCode ?? _rollbackHandpan!.SerialNumber;
        var target = _rollbackTarget.Value;
        try
        {
            if (_rollbackHandpan is not null) await HandpanService.RollbackAsync(_rollbackHandpan.Id);
            else await BowlService.RollbackAsync(_rollbackBowl!.Id);
        }
        catch
        {
            _rollbackError = "بازگشت انجام نشد. وضعیت رکورد و اتصال را بررسی کنید و دوباره تلاش کنید.";
            _rollingBack = false;
            return;
        }
        _rollbackBowl = null; _rollbackHandpan = null; _rollbackTarget = null;
        _rollbackNotice = $"کد {code} به «{StageText(target)}» برگشت.";
        try
        {
            await LoadBowlPageAsync(_bowlPage);
            if (_bowls.Count == 0 && _bowlPage > 1) await LoadBowlPageAsync(_bowlPage - 1);
            _handpans = (await HandpanService.GetAllAsync()).ToList();
            _expandedHandpans.Clear();
            if (_handpanPage > HandpanTotalPages && _handpanPage > 1) _handpanPage = Math.Max(1, HandpanTotalPages);
        }
        catch { _rollbackNotice += " برای دریافت فهرست جدید، صفحه را تازه کنید."; }
        finally { _rollingBack = false; }
    }
    // Match the supported transitions in ProductionRollbackService.
    private static int? RollbackStage(int stage, bool handpan) => handpan
        ? stage switch { 11 => 10, 12 => 11, 14 => 12, 16 => 14, 18 => 16, 20 => 18, _ => null }
        : stage switch { 4 => 2, 6 => 4, 8 => 6, 10 => 8, 21 => 8, 22 => 21, 20 => 22, _ => null };
    private static readonly (int Value,string Text)[] StageOptions=[(2,"در انتظار دیمپل"),(4,"در انتظار شیپ"),(6,"در انتظار پخت"),(8,"در انتظار تیون"),(10,"در انتظار چسب"),(11,"اتاق چسب"),(12,"در انتظار فاین تیون"),(14,"در انتظار QC"),(16,"در انتظار بسته‌بندی"),(21,"در انتظار بسته‌بندی صادراتی"),(22,"انبار صادراتی")];
    private static readonly (int Value,string Text)[] HandpanStageOptions=[(11,"اتاق چسب"),(12,"در انتظار فاین تیون"),(14,"در انتظار QC"),(16,"در انتظار بسته‌بندی")];


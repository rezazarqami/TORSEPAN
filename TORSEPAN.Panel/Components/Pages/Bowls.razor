@page "/bowls"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject BowlService BowlService
@inject HandpanService HandpanService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>تولید</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3>تولید</h3>
    <button class="btn btn-primary" @onclick="NewBowl">ثبت کاسه</button>
</div>

@if (_loading)
{
    <p>در حال بارگذاری...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <h4 class="mb-3">کاسه‌ها</h4>
    @if (_bowls.Count == 0)
    {
        <div class="alert alert-info">هیچ کاسه‌ای ثبت نشده است.</div>
    }
    else
    {
        <table class="table table-striped mb-5">
            <thead>
                <tr>
                    <th style="width: 48px;"></th>
                    <th>کد</th><th>نوع کاسه</th><th>دارای نت</th><th>متریال</th><th>Scale کاسه</th><th>وضعیت</th><th>مدیریت</th>
                </tr>
                <tr class="align-middle">
                    <th></th>
                    <th></th>
                    <th><select class="form-select form-select-sm" @bind="_bowlTypeFilter"><option value="">همه کاسه‌ها</option><option value="1">کاسه بالا</option><option value="2">کاسه پایین</option></select></th>
                    <th><select class="form-select form-select-sm" @bind="_notesFilter"><option value="">همه</option><option value="true">دارای نوت</option><option value="false">بدون نوت</option></select></th>
                    <th><select class="form-select form-select-sm" @bind="_materialFilter"><option value="">همه متریال‌ها</option>@foreach(var item in _materials){<option value="@item.Id">@item.Name</option>}</select></th>
                    <th><select class="form-select form-select-sm" @bind="_scaleFilter"><option value="">همه Scale‌ها</option>@foreach(var item in _scales.Where(x => (x.Usage & 3) != 0)){<option value="@item.Id">@item.Name</option>}</select></th>
                    <th><select class="form-select form-select-sm" @bind="_stageFilter"><option value="">همه وضعیت‌ها</option>@foreach(var item in StageOptions){<option value="@item.Value">@item.Text</option>}</select></th>
                    <th><div class="d-flex gap-1"><button class="btn btn-sm btn-primary text-nowrap" @onclick="ApplyFiltersAsync">اعمال</button><button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="ClearFiltersAsync">پاک کردن</button></div></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bowl in _bowls)
                {
                    <tr>
                        <td><button class="btn btn-sm btn-outline-primary" title="نمایش عملیات انجام‌شده" @onclick="() => ToggleBowlDetails(bowl.Id)">@(_expandedBowls.Contains(bowl.Id) ? "−" : "+")</button></td>
                        <td>@bowl.ProductionCode</td>
                        <td>@(bowl.BowlType == 1 ? "کاسه بالا" : "کاسه پایین")</td>
                        <td>@(bowl.HasNotes ? "بله" : "خیر")</td>
                        <td>@bowl.MaterialName</td>
                        <td>@bowl.ScaleName</td>
                        <td><span class="badge bg-primary">@StageText(bowl.Stage)</span></td>
                        <td><AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-warning ms-1" @onclick="() => RollbackBowlAsync(bowl)">مرحله قبل</button><button class="btn btn-sm btn-outline-danger" disabled="@_deleting" @onclick="() => RequestDelete(bowl)">حذف</button></AuthorizeView></td>
                    </tr>
                    @if (_expandedBowls.Contains(bowl.Id))
                    {
                        <tr class="table-light">
                            <td></td><td colspan="7"><ProductionOperationDetails Title="@($"عملیات انجام‌شده روی کاسه {bowl.ProductionCode}")" Operations="bowl.Operations" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (_bowlTotalPages > 1)
        {
            <nav class="mb-5"><ul class="pagination justify-content-center flex-wrap">
                @for (var page = 1; page <= _bowlTotalPages; page++)
                {
                    var selectedPage = page;
                    <li class="page-item @(selectedPage == _bowlPage ? "active" : null)"><button class="page-link" @onclick="() => LoadBowlPageAsync(selectedPage)">@selectedPage</button></li>
                }
            </ul></nav>
        }
    }

    <h4 class="mb-3">سازها</h4>
    @if (_handpans.Count == 0)
    {
        <div class="alert alert-info">هنوز سازی تشکیل نشده است.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width: 48px;"></th>
                    <th>کد ساز</th><th>کد کاسه بالا</th><th>کد کاسه پایین</th><th>متریال</th><th>Scale</th><th>وضعیت</th><th>مدیریت</th>
                </tr>
                <tr class="align-middle">
                    <th></th><th></th><th></th><th></th>
                    <th><select class="form-select form-select-sm" @bind="_handpanMaterialFilter"><option value="">همه متریال‌ها</option>@foreach(var name in _handpans.Select(x=>x.MaterialName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select></th>
                    <th><select class="form-select form-select-sm" @bind="_handpanScaleFilter"><option value="">همه Scale‌ها</option>@foreach(var name in _handpans.Select(x=>x.ScaleName).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x)){<option value="@name">@name</option>}</select></th>
                    <th><select class="form-select form-select-sm" @bind="_handpanStageFilter"><option value="">همه وضعیت‌ها</option>@foreach(var item in HandpanStageOptions){<option value="@item.Value">@item.Text</option>}</select></th>
                    <th><div class="d-flex gap-1"><button class="btn btn-sm btn-primary text-nowrap" @onclick="ApplyHandpanFilters">اعمال</button><button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="ClearHandpanFilters">پاک کردن</button></div></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var handpan in PagedHandpans)
                {
                    <tr>
                        <td><button class="btn btn-sm btn-outline-primary" title="نمایش عملیات انجام‌شده" @onclick="() => ToggleHandpanDetails(handpan.Id)">@(_expandedHandpans.Contains(handpan.Id) ? "−" : "+")</button></td>
                        <td>@handpan.SerialNumber</td><td>@handpan.TopBowlCode</td><td>@handpan.BottomBowlCode</td>
                        <td>@handpan.MaterialName</td><td>@handpan.ScaleName</td>
                        <td><span class="badge bg-primary">@StageText(handpan.Stage)</span></td>
                        <td><AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-warning ms-1" @onclick="() => RollbackHandpanAsync(handpan)">مرحله قبل</button><button class="btn btn-sm btn-outline-danger" disabled="@_deleting" @onclick="() => RequestDelete(handpan)">حذف</button></AuthorizeView></td>
                    </tr>
                    @if (_expandedHandpans.Contains(handpan.Id))
                    {
                        <tr class="table-light">
                            <td></td><td colspan="6"><ProductionOperationDetails Title="@($"عملیات انجام‌شده روی ساز {handpan.SerialNumber}")" Operations="handpan.Operations" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (HandpanTotalPages > 1)
        {
            <nav><ul class="pagination justify-content-center flex-wrap">
                @for (var page = 1; page <= HandpanTotalPages; page++)
                {
                    var selectedPage = page;
                    <li class="page-item @(selectedPage == _handpanPage ? "active" : null)"><button class="page-link" @onclick="() => ChangeHandpanPage(selectedPage)">@selectedPage</button></li>
                }
            </ul></nav>
        }
    }
}

@if (_deleteBowl is not null || _deleteHandpan is not null)
{
    <div class="production-delete-overlay"><section class="production-delete-dialog" role="dialog" aria-modal="true" aria-labelledby="production-delete-title">
        <h2 id="production-delete-title">تأیید حذف @(_deleteBowl is not null ? "کاسه" : "ساز")</h2>
        <p>کد <strong>@(_deleteBowl?.ProductionCode ?? _deleteHandpan?.SerialNumber)</strong> برای همیشه حذف شود؟</p>
        <p class="delete-warning">@(_deleteBowl is not null ? "کاسه و سوابق مرتبط حذف می‌شوند. اگر کاسه به ساز متصل باشد، ساز و کاسهٔ دیگر آن هم حذف می‌شوند." : "ساز، کاسه‌های مرتبط و تمام سوابق آن حذف می‌شوند.")</p>
        @if (_deleteError is not null) { <div class="alert alert-danger" role="alert">@_deleteError</div> }
        <div class="production-delete-actions"><button type="button" class="btn btn-danger" disabled="@_deleting" @onclick="ConfirmDeleteAsync">@(_deleting ? "در حال حذف…" : "تأیید و حذف")</button><button type="button" class="btn btn-light" disabled="@_deleting" @onclick="CancelDelete">انصراف</button></div>
    </section></div>
}
@if (_deleteNotice is not null)
{
    <div class="production-delete-notice" role="status"><span>@_deleteNotice</span><button type="button" aria-label="بستن پیام" @onclick="() => _deleteNotice = null">×</button></div>
}

@code {
    private BowlDto? _deleteBowl;
    private HandpanDto? _deleteHandpan;
    private bool _deleting;
    private string? _deleteError, _deleteNotice;
    private bool _loading = true;
    private string? _error;
    private List<BowlDto> _bowls = [];
    private List<HandpanDto> _handpans = [];
    private const int PageSize = 20;
    private int _bowlPage = 1;
    private int _bowlTotalPages;
    private int _handpanPage = 1;
    private IEnumerable<HandpanDto> FilteredHandpans => _handpans.Where(x =>
        (string.IsNullOrWhiteSpace(_handpanMaterialFilter) || x.MaterialName == _handpanMaterialFilter) &&
        (string.IsNullOrWhiteSpace(_handpanScaleFilter) || x.ScaleName == _handpanScaleFilter) &&
        (!int.TryParse(_handpanStageFilter, out var stage) || x.Stage == stage));
    private IEnumerable<HandpanDto> PagedHandpans => FilteredHandpans.Skip((_handpanPage - 1) * PageSize).Take(PageSize);
    private int HandpanTotalPages => (int)Math.Ceiling((double)FilteredHandpans.Count() / PageSize);
    private readonly HashSet<Guid> _expandedBowls = [];
    private readonly HashSet<Guid> _expandedHandpans = [];
    private readonly List<MaterialDto> _materials = [];
    private readonly List<ScaleDto> _scales = [];
    private string _bowlTypeFilter="", _notesFilter="", _materialFilter="", _scaleFilter="", _stageFilter="";
    private string _handpanMaterialFilter="", _handpanScaleFilter="", _handpanStageFilter="";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadBowlPageAsync(1);
            _handpans = (await HandpanService.GetAllAsync()).ToList();
            _materials.AddRange(await MaterialService.GetAsync());
            _scales.AddRange(await ScaleService.GetAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleBowlDetails(Guid id) { if (!_expandedBowls.Add(id)) _expandedBowls.Remove(id); }
    private void ToggleHandpanDetails(Guid id) { if (!_expandedHandpans.Add(id)) _expandedHandpans.Remove(id); }
    private void NewBowl() => Navigation.NavigateTo("/bowls/new");

    private async Task LoadBowlPageAsync(int page)
    {
        var result = await BowlService.GetPageAsync(page, PageSize,
            int.TryParse(_bowlTypeFilter,out var bt)?bt:null,
            bool.TryParse(_notesFilter,out var notes)?notes:null,
            Guid.TryParse(_materialFilter,out var material)?material:null,
            Guid.TryParse(_scaleFilter,out var scale)?scale:null,
            int.TryParse(_stageFilter,out var stage)?stage:null);
        _bowlPage = result?.Page ?? page;
        _bowlTotalPages = result?.TotalPages ?? 0;
        _bowls = result?.Items.ToList() ?? [];
        _expandedBowls.Clear();
    }

    private void ChangeHandpanPage(int page)
    {
        _handpanPage = page;
        _expandedHandpans.Clear();
    }
    private void ApplyHandpanFilters(){_handpanPage=1;_expandedHandpans.Clear();}
    private void ClearHandpanFilters(){_handpanMaterialFilter=_handpanScaleFilter=_handpanStageFilter="";ApplyHandpanFilters();}

    private void RequestDelete(BowlDto bowl)
    {
        if (_deleting) return;
        _deleteBowl = bowl; _deleteHandpan = null; _deleteError = null; _deleteNotice = null;
    }
    private void RequestDelete(HandpanDto handpan)
    {
        if (_deleting) return;
        _deleteHandpan = handpan; _deleteBowl = null; _deleteError = null; _deleteNotice = null;
    }
    private void CancelDelete()
    {
        if (_deleting) return;
        _deleteBowl = null; _deleteHandpan = null; _deleteError = null;
    }
    private async Task ConfirmDeleteAsync()
    {
        if (_deleting || (_deleteBowl is null && _deleteHandpan is null)) return;
        _deleting = true; _deleteError = null;
        var code = _deleteBowl?.ProductionCode ?? _deleteHandpan!.SerialNumber;
        try
        {
            if (_deleteBowl is not null) await BowlService.DeleteAsync(_deleteBowl.Id);
            else await HandpanService.DeleteAsync(_deleteHandpan!.Id);
        }
        catch (Exception ex)
        {
            _deleteError = string.IsNullOrWhiteSpace(ex.Message) ? "حذف انجام نشد؛ دوباره تلاش کنید." : ex.Message;
            _deleting = false;
            return;
        }
        _deleteBowl = null; _deleteHandpan = null;
        _deleteNotice = $"کد {code} و سوابق مرتبط حذف شد.";
        try
        {
            await LoadBowlPageAsync(_bowlPage);
            if (_bowls.Count == 0 && _bowlPage > 1) await LoadBowlPageAsync(_bowlPage - 1);
            _handpans = (await HandpanService.GetAllAsync()).ToList();
            if (_handpanPage > HandpanTotalPages && _handpanPage > 1) _handpanPage = Math.Max(1, HandpanTotalPages);
        }
        catch
        {
            _deleteNotice = $"کد {code} حذف شد؛ برای دریافت فهرست جدید، صفحه را تازه کنید.";
        }
        finally { _deleting = false; }
    }
    private Task ApplyFiltersAsync() => LoadBowlPageAsync(1);
    private async Task ClearFiltersAsync(){_bowlTypeFilter=_notesFilter=_materialFilter=_scaleFilter=_stageFilter="";await LoadBowlPageAsync(1);}
    private async Task RollbackBowlAsync(BowlDto bowl){if(!await JS.InvokeAsync<bool>("confirm",$"کاسه {bowl.ProductionCode} به مرحله قبل برگردد؟ سابقه همان مرحله نیز برگردانده می‌شود."))return;try{await BowlService.RollbackAsync(bowl.Id);await LoadBowlPageAsync(_bowlPage);_handpans=(await HandpanService.GetAllAsync()).ToList();}catch{_error="بازگشت این کاسه در وضعیت فعلی امکان‌پذیر نیست.";}}
    private async Task RollbackHandpanAsync(HandpanDto handpan){if(!await JS.InvokeAsync<bool>("confirm",$"ساز {handpan.SerialNumber} به مرحله قبل برگردد؟"))return;try{await HandpanService.RollbackAsync(handpan.Id);await LoadBowlPageAsync(_bowlPage);_handpans=(await HandpanService.GetAllAsync()).ToList();}catch{_error="بازگشت این ساز در وضعیت فعلی امکان‌پذیر نیست.";}}
    private static readonly (int Value,string Text)[] StageOptions=[(2,"در انتظار دیمپل"),(4,"در انتظار شیپ"),(6,"در انتظار پخت"),(8,"در انتظار تیون"),(10,"در انتظار چسب"),(11,"اتاق چسب"),(12,"در انتظار فاین تیون"),(14,"در انتظار QC"),(16,"در انتظار بسته‌بندی"),(21,"در انتظار بسته‌بندی صادراتی"),(22,"انبار صادراتی")];
    private static readonly (int Value,string Text)[] HandpanStageOptions=[(11,"اتاق چسب"),(12,"در انتظار فاین تیون"),(14,"در انتظار QC"),(16,"در انتظار بسته‌بندی")];

    private static string StageText(int stage) => stage switch
    {
        1 => "ثبت شده", 2 => "در انتظار دیمپل", 3 => "در حال دیمپل", 4 => "در انتظار شیپ",
        5 => "در حال شیپ", 6 => "در انتظار پخت", 7 => "در حال پخت", 8 => "در انتظار کوک",
        9 => "در حال کوک", 10 => "در انتظار چسب‌کاری", 11 => "در اتاق چسب",
        12 => "در انتظار فاین تیون", 13 => "کوک نهایی", 14 => "در انتظار QC", 15 => "QC",
        16 => "در انتظار بسته‌بندی", 17 => "بسته‌بندی", 18 => "انبار", 19 => "رد شده", 20 => "فروخته شده",
        21 => "در انتظار بسته‌بندی صادراتی", 22 => "انبار صادراتی", _ => "نامشخص"
    };
}

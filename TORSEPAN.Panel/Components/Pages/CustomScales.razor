@page "/custom-scales"
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api
@inject ScaleService ScaleService

<PageTitle>اسکیل کاستوم</PageTitle>
<PageHeader Title="اسکیل کاستوم" SubTitle="ثبت جداگانه اسکیل کاسه رو، کاسه زیر و ساز" />

@foreach (var category in Categories)
{
    <div class="card p-4 mb-4">
        <h5 class="mb-3">@category.Title</h5>
        <div class="input-group mb-3">
            <input class="form-control" placeholder="نام اسکیل را وارد کنید" @bind="category.Name" @bind:event="oninput" />
            <button class="btn btn-primary" disabled="@(_loading || string.IsNullOrWhiteSpace(category.Name))" @onclick="() => CreateAsync(category)">
                @(_loading ? "در حال ثبت..." : "ثبت اسکیل")
            </button>
        </div>
        @if (Items(category.Usage).Count == 0)
        {
            <div class="alert alert-light border mb-0">هنوز اسکیلی در این بخش ثبت نشده است.</div>
        }
        else
        {
            <div class="table-responsive"><table class="table table-striped mb-0">
                <thead><tr><th>نام اسکیل</th></tr></thead>
                <tbody>@foreach (var scale in Items(category.Usage)) { <tr><td>@scale.Name</td></tr> }</tbody>
            </table></div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
}

@code {
    private readonly List<ScaleDto> _scales = [];
    private bool _loading;
    private bool _success;
    private string? _message;
    private readonly List<CustomScaleCategory> Categories =
    [
        new(8, "اسکیل کاستوم کاسه رو"),
        new(16, "اسکیل کاستوم کاسه زیر"),
        new(32, "اسکیل کاستوم ساز")
    ];
    private List<ScaleDto> Items(int usage) => _scales.Where(x => (x.Usage & usage) != 0).OrderBy(x => x.Name).ToList();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task CreateAsync(CustomScaleCategory category)
    {
        _loading = true;
        _message = null;
        try
        {
            await ScaleService.CreateAsync(category.Name, category.Usage);
            category.Name = string.Empty;
            await ReloadAsync();
            _success = true;
            _message = "اسکیل کاستوم در بخش مربوطه ثبت شد.";
        }
        catch (Exception ex)
        {
            _success = false;
            _message = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task ReloadAsync()
    {
        _scales.Clear();
        _scales.AddRange(await ScaleService.GetAsync());
    }

    private sealed class CustomScaleCategory(int usage, string title)
    {
        public int Usage { get; } = usage;
        public string Title { get; } = title;
        public string Name { get; set; } = string.Empty;
    }
}

@page "/accounting"
@using TORSEPAN.Panel.Models
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
<PageTitle>حسابداری</PageTitle><PageHeader Title="حسابداری" SubTitle="اشخاص، درآمدها، هزینه‌ها و مطالبات" />
@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}else{
<div class="accounting-summary"><div><span>دریافت‌شده</span><strong>@Money(_summary.CashIn)</strong></div><div><span>پرداخت‌شده</span><strong>@Money(_summary.CashOut)</strong></div><div><span>مطالبات</span><strong>@Money(_summary.Receivables)</strong></div><div><span>بدهی‌ها</span><strong>@Money(_summary.Payables)</strong></div><div><span>سررسید گذشته</span><strong>@_summary.Overdue</strong></div></div>
<div class="accounting-grid">
 <section class="account-card form-card"><h4>ثبت شخص یا شرکت</h4><div class="party-form"><input class="form-control" @bind="_partyName" placeholder="نام شخص" /><input class="form-control" @bind="_company" placeholder="نام شرکت (اختیاری)" /><input class="form-control" @bind="_phone" placeholder="شماره تماس" /><textarea class="form-control party-notes" @bind="_partyNotes" placeholder="توضیحات"></textarea></div><button class="btn btn-primary form-submit" @onclick="AddParty" disabled="@_saving">ثبت پرونده</button></section>
 <section class="account-card form-card"><h4>ثبت سند مالی</h4><div class="document-form"><select class="form-select" @bind="_type"><option value="1">درآمد / طلب</option><option value="2">هزینه / بدهی</option></select><input class="form-control" @bind="_title" placeholder="عنوان؛ مثلاً خرید ورق" /><select class="form-select" @bind="_partyId"><option value="">بدون شخص</option>@foreach(var p in _parties){<option value="@p.Id">@p.DisplayName</option>}</select><input type="number" min="0" class="form-control" @bind="_total" placeholder="مبلغ کل" /><input type="number" min="0" class="form-control" @bind="_paid" placeholder="پرداخت‌شده" /><div class="due-field"><label>تاریخ سررسید</label><input type="date" class="form-control" @bind="_dueDate" /></div><textarea class="form-control document-notes" @bind="_notes" placeholder="توضیحات"></textarea></div><button class="btn btn-success form-submit" @onclick="AddDocument" disabled="@_saving">ثبت سند</button></section>
</div>
@if(!string.IsNullOrWhiteSpace(_message)){<div class="alert @(_ok?"alert-success":"alert-danger") mt-3">@_message</div>}
<section class="account-card mt-3"><div class="section-head"><h4>حساب اشخاص</h4><input class="form-control" @bind="_search" @bind:event="oninput" placeholder="جست‌وجوی شخص یا شرکت..." /></div><div class="party-list">@foreach(var p in FilteredParties){<button class="party-item @(_selectedParty==p.Id?"active":"")" @onclick="()=>SelectParty(p.Id)"><span><strong>@p.Name</strong><small>@p.Company @p.Phone</small></span><b class="@(p.Balance>=0?"text-success":"text-danger")">@Money(Math.Abs(p.Balance))</b></button>}</div></section>
<section class="account-card mt-3"><div class="section-head"><h4>@(_selectedParty.HasValue?"گردش حساب شخص":"آخرین اسناد مالی")</h4>@if(_selectedParty.HasValue){<button class="btn btn-sm btn-outline-secondary" @onclick="()=>SelectParty(null)">نمایش همه</button>}</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>نوع</th><th>عنوان</th><th>شخص</th><th>مبلغ</th><th>پرداخت</th><th>مانده</th><th>سررسید</th><th></th></tr></thead><tbody>@foreach(var d in _documents){<tr><td><span class="badge @(d.Type==1?"bg-success":"bg-danger")">@(d.Type==1?"درآمد":"هزینه")</span></td><td>@d.Title@if(!string.IsNullOrWhiteSpace(d.HandpanCode)){<small class="d-block">ساز @d.HandpanCode</small>}</td><td>@d.PartyName</td><td>@Money(d.TotalAmount)</td><td>@Money(d.PaidAmount)</td><td><strong>@Money(d.Balance)</strong></td><td>@(d.DueDate.HasValue?PersianDateTime.FormatDateTime(d.DueDate.Value):"—")</td><td>@if(d.Balance>0){<button class="btn btn-sm btn-outline-success" @onclick="()=>OpenPayment(d)">ثبت پرداخت</button>}</td></tr>}</tbody></table></div></section>}
@if(_paying is not null){<div class="modal d-block" style="background:rgba(0,0,0,.45)"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5>ثبت پرداخت — @_paying.Title</h5></div><div class="modal-body"><div class="mb-2">مانده: <strong>@Money(_paying.Balance)</strong></div><input type="number" min="1" max="@_paying.Balance" class="form-control" @bind="_payment" /></div><div class="modal-footer"><button class="btn btn-secondary" @onclick="()=>_paying=null">انصراف</button><button class="btn btn-success" @onclick="SavePayment">ثبت پرداخت</button></div></div></div></div>}
@code{private bool _loading=true,_saving,_ok;private AccountingSummaryDto _summary=new();private List<AccountingPartyDto>_parties=[];private List<AccountingDocumentDto>_documents=[];private string _partyName="",_company="",_phone="",_partyNotes="",_title="",_notes="",_search="",_message="";private int _type=1;private decimal _total,_paid,_payment;private Guid? _partyId,_selectedParty;private DateTime? _dueDate;private AccountingDocumentDto?_paying;private IEnumerable<AccountingPartyDto>FilteredParties=>_parties.Where(x=>string.IsNullOrWhiteSpace(_search)||x.DisplayName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.Phone?.Contains(_search)==true);protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){_loading=true;_summary=await AccountingService.SummaryAsync()??new();_parties=await AccountingService.PartiesAsync();_documents=await AccountingService.DocumentsAsync(_selectedParty);_loading=false;}private async Task AddParty(){if(string.IsNullOrWhiteSpace(_partyName)){Show(false,"نام شخص را وارد کنید.");return;}_saving=true;try{await AccountingService.AddPartyAsync(_partyName,_company,_phone,_partyNotes);_partyName=_company=_phone=_partyNotes="";await Load();Show(true,"پرونده شخص ثبت شد.");}finally{_saving=false;}}private async Task AddDocument(){if(string.IsNullOrWhiteSpace(_title)||_total<=0||_paid<0||_paid>_total){Show(false,"اطلاعات مبلغ و عنوان را بررسی کنید.");return;}_saving=true;try{await AccountingService.AddDocumentAsync(_type,_title,_total,_paid,_partyId,_paid<_total?_dueDate:null,_notes);_title=_notes="";_total=_paid=0;_dueDate=null;await Load();Show(true,"سند مالی ثبت شد.");}finally{_saving=false;}}private async Task SelectParty(Guid?id){_selectedParty=id;_documents=await AccountingService.DocumentsAsync(id);}private void OpenPayment(AccountingDocumentDto d){_paying=d;_payment=d.Balance;}private async Task SavePayment(){if(_paying is null||_payment<=0||_payment>_paying.Balance)return;await AccountingService.AddPaymentAsync(_paying.Id,_payment);_paying=null;await Load();Show(true,"پرداخت ثبت شد.");}private void Show(bool ok,string message){_ok=ok;_message=message;}private static string Money(decimal x)=>$"{x:N0} تومان";}

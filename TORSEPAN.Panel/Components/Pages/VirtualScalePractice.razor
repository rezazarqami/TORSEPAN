@page "/virtual-scales/practice"
@layout TORSEPAN.Panel.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Application.Scales
@attribute [Authorize]
@inject IJSRuntime JS

<PageTitle>تمرین ملودی | تورسپن</PageTitle>

<main class="practice-page" dir="rtl" data-handpan-practice data-practice-score="@Current.Score" @ref="_practice">
    <header class="practice-header">
        <h1>تمرین ملودی</h1>
        <p dir="ltr" data-practice-scale>@Current.Scale</p>
    </header>

    <section class="practice-panel" aria-label="تایم‌لاین و کنترل تمرین">
        <div class="practice-controls practice-selectors">
            <details class="practice-picker" name="practice-picker">
                <summary><span>تمرین</span><strong>@ExerciseLabel(SelectedIndex)</strong></summary>
                <select hidden class="form-select" data-practice-exercise>
                    @for (var i = 0; i < Exercises.Length; i++)
                    {
                        <option value="@Exercises[i].Score" data-notes="@Exercises[i].NoteCount" data-scale-name="@Exercises[i].Scale" data-extra="@(string.Join(" ", Exercises[i].ExtraHits.Select(hit => hit.Symbol)))" selected="@(i == SelectedIndex)">@ExerciseLabel(i)</option>
                    }
                </select>
                <div class="practice-options"></div>
            </details>
            <details class="practice-picker" name="practice-picker">
                <summary><span>بخش تمرین</span><strong>کل تمرین</strong></summary>
                <select hidden data-practice-phrase class="form-select">
                    <option value="all">کل تمرین</option>
                </select>
                <div class="practice-options"></div>
            </details>
        </div>
        <div class="practice-controls practice-transport">
            <div class="practice-modes" role="group" aria-label="حالت تمرین">
                <button type="button" data-practice-action="step" aria-label="قدم‌به‌قدم" title="قدم‌به‌قدم">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                        <rect x="3" y="14" width="4" height="7" rx="1" />
                        <rect x="10" y="9" width="4" height="12" rx="1" />
                        <rect x="17" y="3" width="4" height="18" rx="1" />
                    </svg>
                </button>
                <button type="button" data-practice-action="guide" aria-label="تمرین با ریتم" title="تمرین با ریتم">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 3h6l5 18H4L9 3Z M7 17h10 M11 15l8-11" />
                        <path d="m16 6 2 2" />
                    </svg>
                </button>
            </div>
            <div class="practice-playback" role="group" aria-label="کنترل پخش">
                <button type="button" data-practice-action="stop" aria-label="توقف" title="توقف">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2" /></svg>
                </button>
                <button type="button" data-practice-action="listen" aria-label="گوش دادن" title="گوش دادن">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M7 4.8a1 1 0 0 1 1.5-.9l12 7.2a1 1 0 0 1 0 1.8l-12 7.2a1 1 0 0 1-1.5-.9Z" /></svg>
                </button>
            </div>
            <details class="practice-picker" name="practice-picker">
                <summary><span>سرعت</span><strong>۱۰۰٪</strong></summary>
                <select hidden data-practice-speed>
                    <option value="0.5">۵۰٪</option>
                    <option value="0.75">۷۵٪</option>
                    <option value="1" selected>۱۰۰٪</option>
                </select>
                <div class="practice-options"></div>
            </details>
        </div>
        <div class="practice-track" data-practice-timeline dir="ltr" tabindex="0"
             role="region" aria-label="تایم‌لاین نت‌ها و ضرب‌ها"></div>
        <div class="practice-duration" dir="ltr">
            <time data-practice-elapsed>0:00</time>
            <progress data-practice-progress value="0" max="1" aria-label="پیشرفت قطعه"></progress>
            <time data-practice-duration>0:00</time>
        </div>
        <p class="practice-status" data-practice-status role="status">در حال آماده‌سازی تمرین…</p>
    </section>

    <section class="practice-instrument @(_photoView ? "" : "practice-schematic")" aria-label="هنگ‌درام تمرین">
        <div class="practice-links">
            <a class="practice-view" href="/virtual-scales" data-practice-action="stop">
                <span aria-hidden="true">›</span> بازگشت به اسکیل‌ها
            </a>
            <button type="button" class="practice-view" data-practice-action="stop"
                    data-practice-photo hidden="@(Current.NoteCount == 21)" aria-pressed="@_photoView" @onclick="TogglePhoto">
                <span class="practice-camera" aria-hidden="true"></span>
                @(_photoView ? "نمای شماتیک" : "عکس ساز")
            </button>
        </div>
        <div data-practice-layout="10" hidden="@(Current.NoteCount != 10)">
            <ScalePlaygroundEditor @key="_photoView" Photos="@(_photoView ? TenNotePhoto : TenNoteSchematic)"
                                   ReadOnly="true" FixedBottom="false" />
        </div>
        <div data-practice-layout="9" hidden="@(Current.NoteCount != 9)">
            <ScalePlaygroundEditor @key="_photoView" Photos="@(_photoView ? NineNotePhoto : NineNoteSchematic)"
                                   ReadOnly="true" FixedBottom="false" />
        </div>
        <div class="practice-low-pygmy practice-schematic" data-practice-layout="21" hidden="@(Current.NoteCount != 21)">
            <ScalePlaygroundEditor Photos="@LowPygmyDiagram" ReadOnly="true" FixedBottom="false" ShowBothShells="true" />
        </div>
        <div class="practice-percussion" aria-label="ضربه‌های بدنه">
            <button type="button" data-practice-percussion="T" data-scale-multitouch="true">
                <strong dir="ltr">T</strong><span>ضربهٔ انگشت</span>
            </button>
            <button type="button" data-practice-percussion="K" data-scale-multitouch="true">
                <strong dir="ltr">K</strong><span>ناک بدنه</span>
            </button>
            @foreach (var hit in ExtraHits)
            {
                <button type="button" data-practice-percussion="@hit.Symbol" data-practice-extra-hit hidden="@(!Current.ExtraHits.Contains(hit))" data-scale-multitouch="true">
                    <strong dir="ltr">@hit.Label</strong><span>@hit.Description</span>
                </button>
            }
        </div>
    </section>
</main>

@code {
    private sealed record BodyHit(string Symbol, string Label, string Description);
    private sealed record Exercise(string Title, string Score, int NoteCount, BodyHit[] ExtraHits, string Scale = "D Kurd 9");

    private static readonly BodyHit Soft = new("•", "•", "ضربهٔ خیلی آرام");
    private static readonly BodyHit Palm = new("P", "P", "ضربهٔ خفه با کف دست");
    private static readonly BodyHit MutedDing = new("DM", "Dᴹ", "دینگ خفه");
    private static readonly BodyHit Slap = new("S", "S", "سیلی به بدنه");
    private static readonly BodyHit[] ExtraHits = [Soft, Palm, MutedDing, Slap];
    private const string ExerciseNumbers = "۱۲۳۴۵۶۷۸۹";
    private static readonly Exercise[] Exercises =
    [
        new("تمرین اول", "01-d-kurd", 10, [], "D Kurd 10"),
        new("Pocket Groove 1", "02-pocket-groove-1", 9, [Soft]),
        new("Pocket Groove 2", "03-pocket-groove-2", 9, [Palm]),
        new("Pocket Groove 4", "04-pocket-groove-4", 9, [Palm, Soft, MutedDing]),
        new("Seven Nation Army", "05-seven-nation-army", 9, [Soft, Slap]),
        new("In The End (Intro)", "06-in-the-end-intro", 9, []),
        new("4/4 | 3/3/2 Variation A", "07-low-pygmy-variation-a", 21, [], "F# Low Pygmy 21"),
        new("La Valse d’Amélie (Easy)", "08-la-valse-d-amelie", 9, []),
        new("Groove B–E", "09-groove-b-e", 9, [Soft])
    ];

    private static readonly VirtualScalePreset NineNotePreset = VirtualScalePresets.All.Single(preset => preset.Name == "D Kurd 9");
    private static readonly VirtualScalePreset TenNotePreset = VirtualScalePresets.All.Single(preset => preset.Name == "D Minor / Kurd 10");
    private static readonly ScalePhotoSources NineNotePhoto = NineNotePreset.CreateDiagram();
    private static readonly ScalePhotoSources NineNoteSchematic = (NineNotePreset with
    {
        TopImage = "",
        TopPositions = "50,49 50,85 24,76 76,76 13,47 87,47 26,23 74,23 50,12"
    }).CreateDiagram();
    private static readonly ScalePhotoSources TenNotePhoto = TenNotePreset.CreateDiagram();
    private static readonly ScalePhotoSources TenNoteSchematic = (TenNotePreset with { TopImage = "", TopPositions = "" }).CreateDiagram();

    private static readonly ScalePhotoSources LowPygmyDiagram =
        (VirtualScalePresets.All.Single(preset => preset.Name == "F# Low Pygmy 21") with
        {
            TopPositions = "50,59 50,83 33,76 67,76 26,60 74,60 30,44 70,44 41,34 44,46 59,34 56,46",
            BottomPositions = "86,74 14,74 88,51 12,51 19,28 81,28 33,15 67,15 50,9"
        }).CreateDiagram();

    [SupplyParameterFromQuery(Name = "exercise")]
    public int? ExerciseNumber { get; set; }

    private int SelectedIndex => ExerciseNumber is int number && number >= 1 && number <= Exercises.Length
        ? number - 1
        : 0;
    private ElementReference _practice;
    private bool _photoView;
    private Exercise Current => Exercises[SelectedIndex];
    private static string ExerciseLabel(int i) => $"{ExerciseNumbers[i]} · {Exercises[i].Title} ({Exercises[i].Scale})";

    private void TogglePhoto() => _photoView = !_photoView;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("scalePlayground.preparePractice", _practice);
    }
}

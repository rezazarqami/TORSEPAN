@page "/virtual-scales/practice"
@layout TORSEPAN.Panel.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Application.Scales
@attribute [Authorize]
@inject IJSRuntime JS

<PageTitle>تمرین ملودی | تورسپن</PageTitle>

<main class="practice-page" dir="rtl" data-handpan-practice @ref="_practice">
    <header class="practice-header">
        <a href="/virtual-scales" data-practice-action="stop">بازگشت به اسکیل‌ها</a>
        <h1>تمرین شمارهٔ ۱</h1>
        <p dir="ltr">D Kurd · 10 notes</p>
    </header>

    <section class="practice-panel" aria-label="تایم‌لاین و کنترل تمرین">
        <div class="practice-controls">
            <label>بخش تمرین
                <select data-practice-phrase class="form-select">
                    <option value="all">کل تمرین</option>
                    <option value="0">جملهٔ ۱</option>
                    <option value="1">جملهٔ ۲</option>
                    <option value="2">جملهٔ ۳</option>
                    <option value="3">جملهٔ ۴</option>
                </select>
            </label>
            <label>سرعت
                <select data-practice-speed class="form-select">
                    <option value="0.5">۵۰٪</option>
                    <option value="0.75">۷۵٪</option>
                    <option value="1" selected>۱۰۰٪</option>
                </select>
            </label>
        </div>
        <div class="practice-controls">
            <button type="button" data-practice-action="listen">گوش دادن</button>
            <button type="button" data-practice-action="guide">تمرین با ریتم</button>
            <button type="button" data-practice-action="step">قدم‌به‌قدم</button>
            <button type="button" data-practice-action="stop">توقف</button>
        </div>
        <div class="practice-track" data-practice-timeline dir="ltr" tabindex="0"
             role="region" aria-label="تایم‌لاین نت‌ها و ضرب‌ها"></div>
        <p class="practice-status" data-practice-status role="status">در حال آماده‌سازی تمرین…</p>
    </section>

    <section class="practice-instrument @(_photoView ? "" : "practice-schematic")" aria-label="هنگ‌درام تمرین">
        <button type="button" class="practice-view" data-practice-action="stop"
                aria-pressed="@_photoView" @onclick="TogglePhoto">
            @(_photoView ? "نمای شماتیک" : "عکس ساز")
        </button>
        <ScalePlaygroundEditor @key="_photoView" Photos="@(_photoView ? PhotoDiagram : SchematicDiagram)"
                               ReadOnly="true" FixedBottom="false" />
        <div class="practice-percussion" aria-label="ضربه‌های بدنه">
            <button type="button" data-practice-percussion="T" data-scale-multitouch="true">
                <strong dir="ltr">T</strong><span>ضربهٔ انگشت</span>
            </button>
            <button type="button" data-practice-percussion="K" data-scale-multitouch="true">
                <strong dir="ltr">K</strong><span>ناک بدنه</span>
            </button>
        </div>
    </section>
</main>

@code {
    private static readonly VirtualScalePreset Preset = VirtualScalePresets.All.Single(preset => preset.Name == "D Minor / Kurd 10");
    private static ScalePhotoSources PhotoDiagram { get; } = Preset.CreateDiagram();
    private static ScalePhotoSources SchematicDiagram { get; } =
        (Preset with { TopImage = "", TopPositions = "" }).CreateDiagram();

    private ElementReference _practice;
    private bool _photoView;

    private void TogglePhoto() => _photoView = !_photoView;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("scalePlayground.preparePractice", _practice);
    }
}

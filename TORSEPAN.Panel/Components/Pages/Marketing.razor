@page "/marketing"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject MarketingService MarketingService

<PageTitle>بازاریابی</PageTitle><PageHeader Title="بازاریابی" SubTitle="مدیریت فروشگاه‌ها و پیگیری ارتباطات صادراتی" />
<div class="d-flex gap-2 flex-wrap mb-3"><input class="form-control" style="max-width:320px" placeholder="جستجوی فروشگاه، شهر یا کشور..." @bind="_search"/><button class="btn btn-primary" @onclick="NewLead">افزودن فروشگاه</button></div>
@if(_editing is not null){<Card><h4>@(_editing.Id==Guid.Empty?"پرونده فروشگاه جدید":"ویرایش پرونده فروشگاه")</h4><div class="row g-3">
<div class="col-md-4"><label>نام فروشگاه</label><input class="form-control" @bind="_editing.Name"/></div><div class="col-md-4"><label>نام شرکت</label><input class="form-control" @bind="_editing.CompanyName"/></div><div class="col-md-2"><label>کشور</label><input class="form-control" @bind="_editing.Country"/></div><div class="col-md-2"><label>شهر</label><input class="form-control" @bind="_editing.City"/></div>
<div class="col-md-4"><label>وب‌سایت</label><input class="form-control" @bind="_editing.Website"/></div><div class="col-md-4"><label>ایمیل</label><input class="form-control" @bind="_editing.Email"/></div><div class="col-md-4"><label>تلفن</label><input class="form-control" @bind="_editing.Phone"/></div>
<div class="col-md-4"><label>شبکه اجتماعی / واتساپ</label><input class="form-control" @bind="_editing.SocialContact"/></div><div class="col-md-4"><label>مسئول خرید</label><input class="form-control" @bind="_editing.ContactPerson"/></div><div class="col-md-2"><label>اولویت ۱ تا ۵</label><input type="number" min="1" max="5" class="form-control" @bind="_editing.Priority"/></div><div class="col-md-2"><label>وضعیت</label><select class="form-select" @bind="_editing.Status">@foreach(var s in Statuses){<option>@s</option>}</select></div>
<div class="col-md-3"><label>احتمال همکاری از ۱۰</label><input type="number" min="0" max="10" step=".5" class="form-control" @bind="_editing.CooperationScore"/></div><div class="col-md-3"><label>احتمال خرید نمونه</label><input type="number" min="0" max="10" step=".5" class="form-control" @bind="_editing.SamplePurchaseScore"/></div><div class="col-md-6"><label>هدف اولیه</label><input class="form-control" @bind="_editing.Target"/></div>
<div class="col-md-6"><label>محصولات فعلی</label><textarea class="form-control" @bind="_editing.CurrentProducts"></textarea></div><div class="col-md-6"><label>یادداشت مدیریتی</label><textarea class="form-control" @bind="_editing.Notes"></textarea></div></div><div class="mt-3 d-flex gap-2"><button class="btn btn-success" @onclick="SaveLead">ثبت پرونده</button><button class="btn btn-outline-secondary" @onclick='()=>_editing=null'>انصراف</button></div></Card>}

@foreach(var lead in Filtered){<Card><div class="d-flex justify-content-between gap-3 flex-wrap"><div><h4>@lead.Name</h4><div class="text-muted">@lead.City، @lead.Country · اولویت @lead.Priority · @lead.Status</div></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" @onclick="()=>EditLead(lead)">ویرایش پرونده</button><button class="btn btn-primary" @onclick="()=>StartActivity(lead)">ثبت ارتباط</button></div></div>
<div class="row g-2 mt-2 small"><div class="col-md-3"><strong>وب‌سایت:</strong> @lead.Website</div><div class="col-md-3"><strong>ایمیل:</strong> @lead.Email</div><div class="col-md-3"><strong>تلفن:</strong> @lead.Phone</div><div class="col-md-3"><strong>امتیاز همکاری:</strong> @lead.CooperationScore از ۱۰</div></div>
@if(_activityLead==lead.Id){<div class="marketing-activity-form mt-3"><h5>ثبت ارتباط جدید</h5><div class="row g-2"><div class="col-md-2"><label>تاریخ</label><InputDate class="form-control" @bind-Value="_activity.Date"/></div><div class="col-md-2"><label>روش ارتباط</label><select class="form-select" @bind="_activity.Method"><option>ایمیل</option><option>واتساپ</option><option>تلفن</option><option>اینستاگرام</option><option>حضوری</option><option>سایر</option></select></div><div class="col-md-4"><label>متن ارسال‌شده</label><textarea class="form-control" @bind="_activity.SentText"></textarea></div><div class="col-md-2"><label>نتیجه</label><textarea class="form-control" @bind="_activity.Result"></textarea></div><div class="col-md-2"><label>اقدام بعدی</label><textarea class="form-control" @bind="_activity.NextAction"></textarea></div></div><button class="btn btn-success mt-2" @onclick="()=>SaveActivity(lead.Id)">ثبت ارتباط</button></div>}
@if(lead.Activities.Count>0){<div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>تاریخ</th><th>روش</th><th>متن ارسال‌شده</th><th>نتیجه</th><th>اقدام بعدی</th><th>ثبت‌کننده</th></tr></thead><tbody>@foreach(var a in lead.Activities.OrderByDescending(x=>x.Date)){<tr><td>@a.Date.ToString("yyyy/MM/dd")</td><td>@a.Method</td><td>@a.SentText</td><td>@a.Result</td><td>@a.NextAction</td><td>@a.RegisteredBy</td></tr>}</tbody></table></div>}</Card>}

@code{private List<MarketingLeadDto> _items=[];private MarketingLeadDto? _editing;private Guid? _activityLead;private MarketingActivityDto _activity=new(){Date=DateTime.Today,Method="ایمیل"};private string _search="";private static readonly string[] Statuses=["در حال بررسی","آماده برای برقراری ارتباط","ارتباط برقرار شد","پیگیری لازم است","مذاکره","پیشنهاد ارسال شد","سفارش ثبت شد","رد شد"];
private IEnumerable<MarketingLeadDto> Filtered=>string.IsNullOrWhiteSpace(_search)?_items:_items.Where(x=>(x.Name+x.City+x.Country+x.Status).Contains(_search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync()=>_items=await MarketingService.GetAsync();private void NewLead()=>_editing=new(){Country="Poland",Priority=1,Status=Statuses[1],Target="فروش ۱ تا ۳ ساز ۹ نت"};private void EditLead(MarketingLeadDto x)=>_editing=x;private async Task SaveLead(){if(_editing is null||string.IsNullOrWhiteSpace(_editing.Name))return;await MarketingService.SaveAsync(_editing);_items=await MarketingService.GetAsync();_editing=null;}private void StartActivity(MarketingLeadDto x){_activityLead=x.Id;_activity=new(){Date=DateTime.Today,Method="ایمیل"};}private async Task SaveActivity(Guid id){await MarketingService.AddActivityAsync(id,_activity);_items=await MarketingService.GetAsync();_activityLead=null;}}

@page "/materials/new"
@page "/warehouse/materials/new"

@using TORSEPAN.Panel.Models
@using Microsoft.AspNetCore.Components.Authorization
@using TORSEPAN.Panel.Services.Api
@inject MaterialService MaterialService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>افزودن ماده اولیه</PageTitle>
<PageHeader Title="افزودن ماده اولیه جدید" SubTitle="تعریف قلم جدید در بخش سایر مواد اولیه و اقلام بسته‌بندی" />

@if (!_isAdministrator)
{
    <div class="alert alert-danger">فقط مدیر سیستم اجازه افزودن ماده اولیه را دارد.</div>
}
else
{
    <Card>
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }
            <div class="mb-3">
                <label class="form-label">نام ماده اولیه یا قلم بسته‌بندی</label>
                <InputText class="form-control" placeholder="مثلاً جعبه هدیه" @bind-Value="_model.Name" />
                <ValidationMessage For="@(() => _model.Name)" />
            </div>
            <div class="mb-3">
                <label class="form-label">تعداد اولیه موجود در انبار</label>
                <InputNumber class="form-control" min="0" @bind-Value="_model.InitialQuantity" />
                <ValidationMessage For="@(() => _model.InitialQuantity)" />
            </div>
            <button class="btn btn-success" type="submit" disabled="@_saving">ثبت در انبار مواد اولیه</button>
            <button class="btn btn-outline-secondary me-2" type="button" @onclick="BackToList">انصراف</button>
        </EditForm>
    </Card>
}

@code {
    private readonly CreateMaterialRequest _model = new() { Category = 3 };
    private bool _saving;
    private bool _isAdministrator;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdministrator = state.User.IsInRole("Administrator");
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            if (await MaterialService.CreateMaterialAsync(_model) is null)
            {
                _error = "ثبت ماده اولیه انجام نشد.";
                return;
            }
            Navigation.NavigateTo("/warehouse/materials");
        }
        catch
        {
            _error = "ثبت انجام نشد؛ نام قلم نباید تکراری باشد.";
        }
        finally { _saving = false; }
    }

    private void BackToList() => Navigation.NavigateTo("/warehouse/materials");
}

@page "/error"

<PageTitle>خطا</PageTitle>

<PageContainer>

    <CenteredMessage Title="خطایی رخ داده است"
                     Message="در پردازش درخواست مشکلی به وجود آمده است." />

    <ActionBar>

        <PrimaryButton Text="بازگشت به داشبورد"
                       OnClick="GoHome" />

    </ActionBar>

</PageContainer>

@code {

    [Inject]
    NavigationManager Navigation { get; set; } = default!;

    void GoHome()
    {
        Navigation.NavigateTo("/");
    }

}
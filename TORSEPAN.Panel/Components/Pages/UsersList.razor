@page "/users/list"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization

@using TORSEPAN.Panel.Services
@using TORSEPAN.Application.Auth.Queries.GetUsers

@inject NavigationManager Navigation
@inject IUserService UserService

<PageTitle>Users</PageTitle>

<PageHeader Title="Users"
            SubTitle="System Users">

    <Actions>

        <PrimaryButton Text="New User"
                       OnClick="NewUser" />

    </Actions>

</PageHeader>

<SearchBox Placeholder="Search user..." />

<Card>

    <DataTable>

        <thead>

            <tr>

                <th>Username</th>
                <th>Full Name</th>
                <th>عنوان</th>
                <th>Roles</th>
                <th>Status</th>
                <th></th>

            </tr>

        </thead>

        <tbody>

            @foreach (var user in Users)
            {
                <tr>

                    <td>@user.UserName</td>

                    <td>@user.FullName</td>
                    <td>@(string.IsNullOrWhiteSpace(user.Title) ? "—" : user.Title)</td>

                    <td>
                        @(user.Roles.Count > 0
                            ? string.Join(", ", user.Roles)
                            : user.Role)
                    </td>

                    <td>
                        @(user.IsActive ? "Active" : "Inactive")
                    </td>

                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => EditUser(user.Id)">
                            ویرایش
                        </button>
                    </td>

                </tr>
            }

        </tbody>

    </DataTable>

</Card>

@code
{
    private List<UserDto> Users = new();

    protected override async Task OnInitializedAsync()
    {
        Users = await UserService.GetUsersAsync();
    }

    private void NewUser()
    {
        Navigation.NavigateTo("/users/new");
    }

    private void EditUser(Guid userId)
    {
        Navigation.NavigateTo($"/users/{userId}/edit");
    }
}

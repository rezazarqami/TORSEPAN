@page "/users/list"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Panel.Services
@using TORSEPAN.Application.Auth.Queries.GetUsers
@inject NavigationManager Navigation
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationState
<PageTitle>کاربران</PageTitle>
<div class="navy-management-page">
<PageHeader Title="کاربران" SubTitle="فهرست اعضای کارگاه" />
<section class="users-management" aria-labelledby="users-management-title" dir="rtl">
    <div class="users-heading">
        <div><h2 id="users-management-title">مدیریت کاربران</h2><p>مشاهده، ویرایش و مدیریت دسترسی کاربران</p></div>
        <button type="button" class="users-add" @onclick="NewUser"><span aria-hidden="true">＋</span> افزودن کاربر</button>
    </div>
    <div class="users-filters">
        <label class="users-search"><span aria-hidden="true">⌕</span><input aria-label="جست‌وجوی کاربران" placeholder="جست‌وجوی نام، نام کاربری یا نقش…" @bind="_search" @bind:event="oninput" /></label>
        <select aria-label="فیلتر نقش کاربران" @bind="_role"><option value="">همه نقش‌ها</option>@foreach (var role in RoleOptions) { <option value="@role">@role</option> }</select>
    </div>
    @if (_loading) { <p role="status">در حال دریافت کاربران…</p> }
    else if (_loadError is not null) { <div role="alert">@_loadError <button type="button" @onclick="LoadAsync">تلاش دوباره</button></div> }
    else
    {
        <div class="users-rows">
        @foreach (var user in FilteredUsers)
        {
            <article class="user-row" @key="user.Id">
                <div class="user-identity"><UserAvatar UserId="user.Id" Name="@user.FullName" Version="user.AvatarVersion" /><div><strong title="@user.FullName">@user.FullName</strong></div></div>
                <span class="user-display-title" title="@user.Title">@(string.IsNullOrWhiteSpace(user.Title) ? "—" : user.Title)</span>
                <div class="user-state"><button type="button" role="switch" aria-checked="@(user.IsActive ? "true" : "false")" aria-label="@($"وضعیت {user.FullName}")" class="user-switch @(user.IsActive ? "is-active" : "")" disabled="@(_statusBusy.HasValue)" @onclick="() => ToggleActiveAsync(user)"><span></span></button><span>@(user.IsActive ? "فعال" : "غیرفعال")</span></div>
                <details class="user-menu"><summary aria-label="@($"گزینه‌های {user.FullName}")">⋮</summary><div class="user-menu-options"><p class="user-menu-login" dir="auto">@user.UserName</p><details class="user-role-menu"><summary>نقش‌ها</summary><ul>@foreach (var role in Roles(user)) { <li>@role</li> }</ul></details><button type="button" @onclick="() => EditUser(user.Id)">مشخصات و ویرایش</button><button type="button" class="user-delete" disabled="@(user.Id == _currentUserId || _deleting)" @onclick="() => AskDelete(user)">حذف کاربر</button></div></details>
            </article>
        }
        </div>
        @if (!FilteredUsers.Any()) { <p class="users-empty" role="status">کاربری با این مشخصات پیدا نشد.</p> }
    }
    @if (_statusError is not null) { <p class="alert alert-danger" role="alert">@_statusError</p> }
    @if (!string.IsNullOrWhiteSpace(_deleteNotice)) { <p class="alert alert-success" role="status">@_deleteNotice</p> }
</section>
<AppConfirmDialog IsOpen="@(_deleteUser is not null)" Title="حذف کاربر" Danger="true"
 Message="@DeleteMessage" ConfirmText="حذف حساب کاربر" Busy="@_deleting" Error="@_deleteError"
 OnConfirm="DeleteAsync" OnCancel="CancelDelete" />
</div>
@code
{
    private Guid _currentUserId;
    private UserDto? _deleteUser;
    private bool _deleting;
    private string? _deleteError, _deleteNotice;
    private string DeleteMessage => $"حساب «{_deleteUser?.FullName}» با نام کاربری «{_deleteUser?.UserName}» از فهرست کاربران حذف و دسترسی آن قطع شود؟ سوابق تولید، پرداخت و پیام‌های قبلی حفظ می‌شوند.";
    private void AskDelete(UserDto user) { _deleteUser = user; _deleteError = _deleteNotice = null; }
    private void CancelDelete() { if (!_deleting) { _deleteUser = null; _deleteError = null; } }
    private async Task DeleteAsync()
    {
        if (_deleting || _deleteUser is null) return;
        var user = _deleteUser; _deleting = true; _deleteError = null;
        try
        {
            await UserService.DeleteUserAsync(user.Id);
            Users.RemoveAll(x => x.Id == user.Id);

            _deleteNotice = $"حساب {user.FullName} حذف شد."; _deleteUser = null;
        }
        catch (AccountActionException ex) { _deleteError = ex.Message; }
        catch { _deleteError = "حذف انجام نشد؛ دوباره تلاش کنید."; }
        finally { _deleting = false; }
    }

    private List<UserDto> Users = new();
    private bool _loading = true;
    private string? _loadError, _statusError;
    private Guid? _statusBusy;
    private string _search = "", _role = "";
    private static IEnumerable<string> Roles(UserDto user) => user.Roles.Count > 0 ? user.Roles : new[] { user.Role };
    private IEnumerable<string> RoleOptions => Users.SelectMany(Roles).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<UserDto> FilteredUsers => Users.Where(u =>
        (string.IsNullOrEmpty(_role) || Roles(u).Contains(_role)) &&
        (string.IsNullOrWhiteSpace(_search) || new[] { u.FullName, u.UserName, u.Title }.Concat(Roles(u))
            .Any(x => Normalize(x).Contains(Normalize(_search.Trim()), StringComparison.OrdinalIgnoreCase))));
    private static string Normalize(string value) => value.Replace('ي', 'ی').Replace('ك', 'ک').Replace("\u200c", " ");

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var state = await AuthenticationState.GetAuthenticationStateAsync();
            Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _currentUserId);
            Users = await UserService.GetUsersAsync();
        }
        catch { _loadError = "دریافت کاربران انجام نشد؛ دوباره تلاش کنید."; }
        finally { _loading = false; }
    }
    private async Task ToggleActiveAsync(UserDto user)
    {
        if (_statusBusy.HasValue) return;
        _statusBusy = user.Id; _statusError = null;
        try { await UserService.SetActiveAsync(user.Id, !user.IsActive); user.IsActive = !user.IsActive; }
        catch { _statusError = "تغییر وضعیت ذخیره نشد؛ دوباره تلاش کنید."; }
        finally { _statusBusy = null; }
    }

    private void NewUser()
    {
        Navigation.NavigateTo("/users/new");
    }

    private void EditUser(Guid userId)
    {
        Navigation.NavigateTo($"/users/{userId}/edit");
    }

}

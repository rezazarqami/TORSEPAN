@page "/users/list"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization

@using TORSEPAN.Panel.Services
@using TORSEPAN.Application.Auth.Queries.GetUsers

@inject NavigationManager Navigation
@inject IUserService UserService
@inject PayrollService PayrollService
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Users</PageTitle>

<PageHeader Title="Users"
            SubTitle="System Users">

    <Actions>

        <PrimaryButton Text="New User"
                       OnClick="NewUser" />

    </Actions>

</PageHeader>

<SearchBox Placeholder="Search user..." />

<Card>

    <DataTable>

        <thead>

            <tr>

                <th>Username</th>
                <th>Full Name</th>
                <th>عنوان</th>
                <th>Roles</th>
                <th>Status</th>
                <th></th>

            </tr>

        </thead>

        <tbody>

            @foreach (var user in Users)
            {
                <tr>

                    <td>@user.UserName</td>

                    <td>@user.FullName</td>
                    <td>@(string.IsNullOrWhiteSpace(user.Title) ? "—" : user.Title)</td>

                    <td>
                        @(user.Roles.Count > 0
                            ? string.Join(", ", user.Roles)
                            : user.Role)
                    </td>

                    <td>
                        @(user.IsActive ? "Active" : "Inactive")
                    </td>

                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => EditUser(user.Id)">
                            ویرایش
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                disabled="@(user.Id == _currentUserId || _deleting)"
                                @onclick="() => AskDelete(user)">حذف کاربر</button>
                    </td>

                </tr>
            }

        </tbody>

    </DataTable>

</Card>

<Card>
    <h4>ترتیب نمایش کاربران در داشبورد</h4>
    <div class="row g-2">
        @foreach (var user in DashboardUsers)
        {
            <div class="col-md-4"><label class="form-label">@user.FullName</label><input type="number" min="0" class="form-control" @bind="user.DisplayOrder" /></div>
        }
    </div>
    <button class="btn btn-primary mt-3" disabled="@SavingOrder" @onclick="SaveOrderAsync">@(SavingOrder ? "در حال ثبت..." : "ثبت ترتیب نمایش")</button>
    <div class="small text-muted mt-2">عدد کمتر، جایگاه بالاتری در جدول داشبورد دارد.</div>
    @if (!string.IsNullOrWhiteSpace(OrderMessage)) { <div class="alert alert-success mt-2 mb-0">@OrderMessage</div> }
</Card>

@if (!string.IsNullOrWhiteSpace(_deleteNotice)) { <div class="alert alert-success" role="status">@_deleteNotice</div> }
<AppConfirmDialog IsOpen="@(_deleteUser is not null)" Title="حذف کاربر" Danger="true"
                  Message="@DeleteMessage" ConfirmText="حذف حساب کاربر" Busy="@_deleting" Error="@_deleteError"
                  OnConfirm="DeleteAsync" OnCancel="CancelDelete" />

@code
{
    private Guid _currentUserId;
    private UserDto? _deleteUser;
    private bool _deleting;
    private string? _deleteError, _deleteNotice;
    private string DeleteMessage => $"حساب «{_deleteUser?.FullName}» با نام کاربری «{_deleteUser?.UserName}» از فهرست کاربران حذف و دسترسی آن قطع شود؟ سوابق تولید، پرداخت و پیام‌های قبلی حفظ می‌شوند.";
    private void AskDelete(UserDto user) { _deleteUser = user; _deleteError = _deleteNotice = null; }
    private void CancelDelete() { if (!_deleting) { _deleteUser = null; _deleteError = null; } }
    private async Task DeleteAsync()
    {
        if (_deleting || _deleteUser is null) return;
        var user = _deleteUser; _deleting = true; _deleteError = null;
        try
        {
            await UserService.DeleteUserAsync(user.Id);
            Users.RemoveAll(x => x.Id == user.Id);
            DashboardUsers.RemoveAll(x => x.Id == user.Id);
            _deleteNotice = $"حساب {user.FullName} حذف شد."; _deleteUser = null;
        }
        catch (AccountActionException ex) { _deleteError = ex.Message; }
        catch { _deleteError = "حذف انجام نشد؛ دوباره تلاش کنید."; }
        finally { _deleting = false; }
    }

    private List<UserDto> Users = new();
    private List<PayrollUserDto> DashboardUsers = new();
    private bool SavingOrder;
    private string? OrderMessage;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _currentUserId);
        Users = await UserService.GetUsersAsync();
        DashboardUsers = ((await PayrollService.GetAsync())?.Users ?? []).Where(x => Users.Any(u => u.Id == x.Id)).ToList();
    }

    private void NewUser()
    {
        Navigation.NavigateTo("/users/new");
    }

    private void EditUser(Guid userId)
    {
        Navigation.NavigateTo($"/users/{userId}/edit");
    }

    private async Task SaveOrderAsync()
    {
        SavingOrder = true;
        OrderMessage = null;
        try { await PayrollService.SaveOrderAsync(DashboardUsers); OrderMessage = "ترتیب نمایش کاربران ثبت شد."; }
        finally { SavingOrder = false; }
    }
}

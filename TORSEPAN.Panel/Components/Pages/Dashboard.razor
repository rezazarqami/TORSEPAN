@page "/"

@inject ProductionService ProductionService

<PageTitle>داشبورد</PageTitle>

@if (_loading)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="container-fluid">

        <div class="mb-4">

            <h2 class="fw-bold">
                داشبورد
            </h2>

            <p class="text-secondary">
                سامانه مدیریت تولید TORSEPAN
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card p-4">

                    <div class="stat-title">
                        کل هنگدرام‌ها
                    </div>

                    <div class="stat-value">
                        @_dashboard.TotalHandpans
                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card p-4">

                    <div class="stat-title">
                        در حال تولید
                    </div>

                    <div class="stat-value text-primary">
                        @_dashboard.InProduction
                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card p-4">

                    <div class="stat-title">
                        تکمیل شده
                    </div>

                    <div class="stat-value text-success">
                        @_dashboard.Finished
                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card p-4">

                    <div class="stat-title">
                        برگشتی
                    </div>

                    <div class="stat-value text-danger">
                        @_dashboard.Rejected
                    </div>

                </div>

            </div>

        </div>

        <div class="card mt-4 p-4">

            <h5 class="mb-3">
                درصد پیشرفت تولید
            </h5>

            <div class="progress" style="height:24px">

                <div class="progress-bar"
                     role="progressbar"
                     style="width:@($"{_dashboard.CompletionRate}%")">

                    @_dashboard.CompletionRate%

                </div>

            </div>

        </div>

    </div>
}

@code
{
    private bool _loading = true;

    private ProductionDashboardDto _dashboard = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await ProductionService.GetDashboardAsync() ?? new();
        }
        finally
        {
            _loading = false;
        }
    }
}
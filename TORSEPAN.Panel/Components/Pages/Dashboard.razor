@page "/"

@inject ProductionService ProductionService
@inject NavigationManager Navigation

<PageTitle>داشبورد تولید</PageTitle>

@if (_loading)
{
    <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">ورود به عملیات تولید</h4>
            <div class="input-group input-group-lg">
                <input class="form-control" placeholder="کد کاسه یا ساز را وارد کنید"
                       @bind="_productionCode" @bind:event="oninput" @onkeydown="OpenProductionOnEnter" />
                <button class="btn btn-primary px-5" @onclick="OpenProduction">ورود</button>
            </div>
        </div>
    </div>

    <Card>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-1">صف‌های آماده تولید</h4>
                <div class="text-muted">کد کاسه‌ها و سازهایی که منتظر مرحله بعد هستند</div>
            </div>
            <button class="btn btn-outline-primary" @onclick="ReloadAsync">به‌روزرسانی</button>
        </div>

        <DataTable>
            <thead>
                <tr><th style="width:260px">مرحله آماده</th><th style="width:90px">تعداد</th><th>کدها</th></tr>
            </thead>
            <tbody>
                @foreach (var queue in _dashboard.Queues)
                {
                    <tr>
                        <td><strong>@queue.Stage</strong></td>
                        <td><span class="badge @(queue.Codes.Count == 0 ? "bg-secondary" : "bg-primary") fs-6">@queue.Codes.Count</span></td>
                        <td>
                            @if (queue.Codes.Count == 0)
                            {
                                <span class="text-muted">موردی وجود ندارد</span>
                            }
                            else
                            {
                                @foreach (var itemCode in queue.Codes)
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1 fs-6">@itemCode</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>
    </Card>
}

@code {
    private bool _loading = true;
    private ProductionDashboardDto _dashboard = new();
    private string _productionCode = string.Empty;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _dashboard = await ProductionService.GetDashboardAsync() ?? new(); }
        catch { Navigation.NavigateTo("/login", true); }
        finally { _loading = false; }
    }

    private void OpenProduction()
    {
        if (!string.IsNullOrWhiteSpace(_productionCode))
            Navigation.NavigateTo($"/production/process?code={Uri.EscapeDataString(_productionCode.Trim())}");
    }

    private void OpenProductionOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") OpenProduction();
    }
}

@page "/"

@inject ProductionService ProductionService
@inject NavigationManager Navigation
@using System.Net

<PageTitle>داشبورد تولید</PageTitle>

@if (_loading)
{
    <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error <button class="btn btn-sm btn-outline-danger me-2" @onclick="ReloadAsync">تلاش دوباره</button></div>
    }
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-3">ورود به عملیات تولید</h4>
            <div class="input-group input-group-lg">
                <input class="form-control" placeholder="کد کاسه یا ساز را وارد کنید"
                       @bind="_productionCode" @bind:event="oninput" @onkeydown="OpenProductionOnEnter" />
                <button class="btn btn-primary px-5" @onclick="OpenProduction">ورود</button>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
    <div class="col-xl-7">
    <Card>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-1">صف‌های آماده تولید</h4>
                <div class="text-muted">کد کاسه‌ها و سازهایی که منتظر مرحله بعد هستند</div>
            </div>
            <button class="btn btn-outline-primary" @onclick="ReloadAsync">به‌روزرسانی</button>
        </div>

        <DataTable>
            <thead>
                <tr><th style="width:210px">مرحله آماده</th><th style="width:70px">تعداد</th><th>کدها</th></tr>
            </thead>
            <tbody>
                @foreach (var queue in _dashboard.Queues)
                {
                    <tr>
                        <td><strong>@queue.Stage</strong></td>
                        <td><span class="badge @(queue.Codes.Count == 0 ? "bg-secondary" : "bg-primary") fs-6">@queue.Codes.Count</span></td>
                        <td>
                            @if (queue.Codes.Count == 0)
                            {
                                <span class="text-muted">موردی وجود ندارد</span>
                            }
                            else
                            {
                                @foreach (var itemCode in queue.Codes)
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1 dashboard-code">@itemCode</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </DataTable>
    </Card>
    </div>
    <div class="col-xl-5">
        <Card>
            <div class="mb-3"><h4 class="mb-1">خلاصه عملکرد کاربران</h4><div class="text-muted small">از ابتدای @_dashboard.CurrentPersianMonthTitle تا امروز</div></div>
            @if (_dashboard.MonthlyUserOperations.Count == 0)
            { <div class="text-center text-muted py-4">هنوز عملیاتی در این ماه ثبت نشده است.</div> }
            else
            {
                <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>کاربر</th><th>عملیات</th><th class="text-center">تعداد</th></tr></thead><tbody>
                @foreach(var user in MonthlyUsers){<tr><td class="small fw-semibold">@user.UserName</td><td>@foreach(var op in user.Operations){<span class="badge bg-light text-dark border me-1 mb-1">@op.Operation: <strong>@op.Count</strong></span>}</td><td class="text-center"><strong>@user.Operations.Sum(x=>x.Count)</strong></td></tr>}
                </tbody></table></div>
            }
        </Card>
    </div>
    </div>
}

@code {
    private bool _loading = true;
    private ProductionDashboardDto _dashboard = new();
    private string _productionCode = string.Empty;
    private string? _error;
    private IEnumerable<UserMonthlyGroup> MonthlyUsers => _dashboard.MonthlyUserOperations.GroupBy(x=>new{x.UserName,x.DisplayOrder}).OrderBy(x=>x.Key.DisplayOrder).ThenBy(x=>x.Key.UserName).Select(x=>new UserMonthlyGroup(x.Key.UserName,x.ToList()));
    private sealed record UserMonthlyGroup(string UserName,List<MonthlyUserOperationDto> Operations);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try { _dashboard = await ProductionService.GetDashboardAsync() ?? new(); }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/login", true); }
        catch
        { _error = "دریافت اطلاعات داشبورد انجام نشد. لطفاً دوباره تلاش کنید."; }
        finally { _loading = false; }
    }

    private void OpenProduction()
    {
        if (!string.IsNullOrWhiteSpace(_productionCode))
            Navigation.NavigateTo($"/production/process?code={Uri.EscapeDataString(_productionCode.Trim())}");
    }

    private void OpenProductionOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") OpenProduction();
    }
}

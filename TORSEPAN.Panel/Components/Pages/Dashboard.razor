@page "/"

@inject ProductionService ProductionService
@inject NavigationManager Navigation

<PageTitle>داشبورد</PageTitle>

@if (_loading)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="row g-4">

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="dashboard-icon blue">🥁</div>
                <div>
                    <div class="dashboard-title">
                        کل هنگدرام‌ها
                    </div>
                    <div class="dashboard-value">
                        @_dashboard.TotalHandpans
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="dashboard-icon orange">⚙️</div>
                <div>
                    <div class="dashboard-title">
                        در حال تولید
                    </div>
                    <div class="dashboard-value">
                        @_dashboard.InProduction
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="dashboard-icon green">✅</div>
                <div>
                    <div class="dashboard-title">
                        تکمیل شده
                    </div>
                    <div class="dashboard-value">
                        @_dashboard.Finished
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card">
                <div class="dashboard-icon red">❌</div>
                <div>
                    <div class="dashboard-title">
                        برگشتی
                    </div>
                    <div class="dashboard-value">
                        @_dashboard.Rejected
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card mt-4">

        <div class="card-body p-4">
            <h5 class="fw-bold">عملیات دیمپل</h5>
            <label class="form-label">کد ساز را وارد کنید</label>
            <div class="input-group">
                <input class="form-control"
                       placeholder="کد ساز را وارد کنید"
                       @bind="_dimplingCode"
                       @bind:event="oninput"
                       @onkeydown="OpenDimplingOnEnter" />
                <button class="btn btn-primary" @onclick="OpenDimpling">
                    ورود
                </button>
            </div>
        </div>

    </div>

    <div class="card mt-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    پیشرفت تولید
                </h5>

                <strong>
                    @_dashboard.CompletionRate%
                </strong>

            </div>

            <div class="progress">

                <div class="progress-bar"
                     role="progressbar"
                     style="width:@($"{_dashboard.CompletionRate}%")">
                </div>

            </div>

        </div>

    </div>

    <div class="card mt-4">

        <div class="card-header">
            خلاصه وضعیت سیستم
        </div>

        <div class="card-body">

            <div class="row text-center">

                <div class="col-md-4">
                    <h2 class="fw-bold text-primary">
                        @_dashboard.TotalHandpans
                    </h2>
                    <div class="text-secondary">
                        کل تولید
                    </div>
                </div>

                <div class="col-md-4">
                    <h2 class="fw-bold text-success">
                        @_dashboard.Finished
                    </h2>
                    <div class="text-secondary">
                        آماده تحویل
                    </div>
                </div>

                <div class="col-md-4">
                    <h2 class="fw-bold text-warning">
                        @_dashboard.InProduction
                    </h2>
                    <div class="text-secondary">
                        داخل کارگاه
                    </div>
                </div>

            </div>

        </div>

    </div>
}

@code
{
    private bool _loading = true;

    private ProductionDashboardDto _dashboard = new();
    private string _dimplingCode = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await ProductionService.GetDashboardAsync() ?? new();
        }
        catch
        {
            Navigation.NavigateTo("/login", true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenDimpling()
    {
        if (!string.IsNullOrWhiteSpace(_dimplingCode))
            Navigation.NavigateTo($"/dimpling?code={Uri.EscapeDataString(_dimplingCode.Trim())}");
    }

    private void OpenDimplingOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            OpenDimpling();
    }
}

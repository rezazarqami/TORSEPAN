@page "/reports"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject ReportService ReportService

<PageTitle>گزارش‌ها</PageTitle>

<PageHeader Title="گزارش‌ها"
            SubTitle="آمار و گزارش تولید" />

@if (_loading)
{
    <div class="spinner-border"></div>
}
else
{
    <div class="row g-4">

        <div class="col-md-3">
            <StatCard Title="تعداد گزارش‌ها"
                      Value="@_reports.Count.ToString()" />
        </div>

    </div>

    <Card Class="mt-4">

        @if (_reports.Count == 0)
        {
            <EmptyState Title="گزارشی وجود ندارد"
                        Description="هنوز اطلاعاتی برای نمایش ثبت نشده است." />
        }
        else
        {
            <table class="table">

                <thead>

                    <tr>
                        <th>عنوان</th>
                        <th>توضیح</th>
                        <th>تاریخ</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in _reports)
                    {
                        <tr>

                            <td>@item.Title</td>

                            <td>@item.Description</td>

                            <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </Card>
}

@code
{
    private readonly List<ReportItemDto> _reports = [];

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _reports.AddRange(await ReportService.GetAsync());
        }
        finally
        {
            _loading = false;
        }
    }
}
@page "/reports"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@inject ReportService ReportService
@inject MaterialService MaterialService
@inject ScaleService ScaleService
@inject IJSRuntime JS

<PageTitle>گزارش‌های مدیریتی</PageTitle>
<section class="report-hero"><small>مرکز تحلیل</small><h1>TORSEPAN</h1><p>نمای یکپارچه از عملیات، تولید و موجودی کارگاه</p></section>
<nav class="report-tabs">
    <button class="@TabClass("operations")" @onclick='()=>SwitchTab("operations")'><i>01</i><span><b>گزارش عملیات</b><small>کارکرد اعضای کارگاه</small></span></button>
    <button class="@TabClass("production")" @onclick='()=>SwitchTab("production")'><i>02</i><span><b>گزارش تولید</b><small>تحلیل سازها و مراحل</small></span></button>
    <button class="@TabClass("inventory")" @onclick='()=>SwitchTab("inventory")'><i>03</i><span><b>گزارش انبار</b><small>سازها و مواد اولیه</small></span></button>
</nav>

<section class="report-filter-card">
    <header><div><small>فیلتر گزارش</small><h2>@TabTitle</h2></div><span>انتخاب نکردن فیلتر یعنی همه موارد</span></header>
    <div class="filter-grid">
        <label><span>از تاریخ</span><PersianDatePicker @bind-Value="_from" /></label>
        <label><span>تا تاریخ</span><PersianDatePicker @bind-Value="_to" /></label>
        @if(_tab=="operations")
        {
            <label><span>کاربر</span><select class="form-select" @bind="_user"><option value="">همه کاربران</option>@foreach(var u in _operations.Users){<option value="@u.Id">@(string.IsNullOrWhiteSpace(u.FullName)?u.UserName:u.FullName)</option>}</select></label>
            <label><span>عملیات</span><select class="form-select" @bind="_action"><option value="">همه عملیات‌ها</option>@foreach(var a in Actions){<option value="@a.Id">@a.Title</option>}</select></label>
        }
        else if(_tab=="production")
        {
            <MultiPicker Title="متریال" Items="@MaterialOptions" Selected="@_materials" OnToggle="ToggleMaterial" />
            <MultiPicker Title="اسکیل" Items="@ScaleOptions" Selected="@_scales" OnToggle="ToggleScale" />
            <label><span>دستمزد</span><select class="form-select" @bind="_payroll"><option value="all">همه موارد</option><option value="calculated">محاسبه شده</option><option value="uncalculated">محاسبه نشده</option></select></label>
            <label><span>مقصد</span><select class="form-select" @bind="_destination"><option value="all">همه</option><option value="domestic">داخلی</option><option value="export">صادراتی</option></select></label>
        }
        else
        {
            <label><span>نوع انبار</span><select class="form-select" @bind="_inventoryKind"><option value="instruments">انبار سازها</option><option value="materials">انبار مواد اولیه</option></select></label>
            @if(_inventoryKind=="instruments")
            {
                <MultiPicker Title="متریال" Items="@MaterialOptions" Selected="@_materials" OnToggle="ToggleMaterial" />
                <MultiPicker Title="اسکیل" Items="@ScaleOptions" Selected="@_scales" OnToggle="ToggleScale" />
                <label><span>مقصد</span><select class="form-select" @bind="_destination"><option value="all">همه</option><option value="domestic">داخلی</option><option value="export">صادراتی</option></select></label>
            }
        }
    </div>
    @if(!string.IsNullOrWhiteSpace(_filterNotice)){<p class="filter-notice">@_filterNotice</p>}
    <footer><button class="btn run-report" @onclick="LoadCurrentAsync" disabled="@_loading">@(_loading?"در حال تحلیل…":"نمایش گزارش")</button><button class="btn btn-light" @onclick="ClearAsync">پاک کردن فیلترها</button><div class="export-actions"><button class="btn pdf-button" disabled="@_exporting" @onclick="DownloadPdfAsync">↓ خروجی PDF</button><button class="btn telegram-button" disabled="@_exporting" @onclick="SendTelegramAsync">ارسال PDF به تلگرام</button></div></footer>
    @if(!string.IsNullOrWhiteSpace(_message)){<div class="report-message @(_messageError?"error":"success")">@_message</div>}
</section>

@if(_loading){<div class="report-loading"><div class="spinner-border"></div><span>در حال ساخت گزارش…</span></div>}
else if(_tab=="operations")
{
    <div class="metric-row two"><article><small>کل عملیات</small><strong>@_operations.TotalOperations</strong></article><article><small>مجموع زمان ثبت‌شده</small><strong>@_operations.TotalDurationMinutes <i>دقیقه</i></strong></article></div>
    @if(_operations.UserTrend is not null)
    {
        <div class="user-analysis-grid">
            <article><small>عملیات این ماه</small><strong>@_operations.UserTrend.CurrentOperationCount</strong></article>
            <article><small>تغییر نسبت به ماه قبل</small><strong class="@DeltaClass(_operations.UserTrend.CurrentOperationCount-_operations.UserTrend.PreviousOperationCount)">@Signed(_operations.UserTrend.CurrentOperationCount-_operations.UserTrend.PreviousOperationCount)</strong></article>
            <article><small>میانگین شش‌ماهه عملیات</small><strong>@_operations.UserTrend.AverageOperationCount.ToString("0.#")</strong></article>
            <article><small>زمان این ماه</small><strong>@_operations.UserTrend.CurrentDurationMinutes <i>دقیقه</i></strong></article>
            <article><small>تغییر زمان نسبت به ماه قبل</small><strong class="@DeltaClass(_operations.UserTrend.CurrentDurationMinutes-_operations.UserTrend.PreviousDurationMinutes)">@Signed(_operations.UserTrend.CurrentDurationMinutes-_operations.UserTrend.PreviousDurationMinutes) <i>دقیقه</i></strong></article>
            <article><small>میانگین شش‌ماهه زمان</small><strong>@_operations.UserTrend.AverageDurationMinutes.ToString("0.#") <i>دقیقه</i></strong></article>
        </div>
        <div class="user-trend-grid"><ReportTrendChart Points="@_operations.Trend" Title="روند تعداد عملیات فرد" /><ReportTrendChart Points="@_operations.DurationTrend" Title="روند زمان ثبت‌شده فرد (دقیقه)" /></div>
    }
    <section class="result-card performance-section">
        <header><h3>عملکرد اعضای کارگاه</h3><span>@_operations.UserPerformance.Count نفر</span></header>
        @if(_operations.UserPerformance.Count==0)
        {
            <p class="empty-cell">اطلاعاتی پیدا نشد.</p>
        }
        else
        {
            <div class="performance-grid">
                @foreach(var user in _operations.UserPerformance)
                {
                    <article class="performance-card">
                        <div class="performance-user">
                            <div><strong>@(string.IsNullOrWhiteSpace(user.FullName)?user.UserName:user.FullName)</strong><small>@user.UserName</small></div>
                            <span>@user.TimedOperations.Sum(x=>x.Count) عملیات زمان‌دار</span>
                        </div>
                        @if(user.TimedOperations.Count>0)
                        {
                            <div class="timed-operation-list">
                                @foreach(var operation in user.TimedOperations)
                                {
                                    <div class="timed-operation">
                                        <strong>@operation.ActionTitle</strong>
                                        <span><b>@operation.Count</b><small>تعداد</small></span>
                                        <span><b>@operation.TotalDurationMinutes</b><small>دقیقه کل</small></span>
                                        <span><b>@operation.AverageDurationMinutes.ToString("0.#")</b><small>میانگین دقیقه</small></span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="no-timed-operation">برای این کاربر عملیات زمان‌دار ثبت نشده است.</p>
                        }
                        @if(user.UntimedOperations.Count>0)
                        {
                            <div class="untimed-operations"><small>سایر عملیات بدون زمان</small><div>@foreach(var operation in user.UntimedOperations){<span>@operation.ActionTitle <b>@operation.Count</b></span>}</div></div>
                        }
                    </article>
                }
            </div>
        }
    </section>
    <section class="result-card"><header><h3>ریز فعالیت‌ها</h3><span>@_operations.Activities.Count مورد</span></header><div class="table-responsive"><table class="table"><thead><tr><th>تاریخ</th><th>کاربر</th><th>عملیات</th><th>کد</th><th>مدت</th><th>توضیحات</th></tr></thead><tbody>@if(_operations.Activities.Count==0){<tr><td colspan="6" class="empty-cell">فعالیتی در این بازه ثبت نشده است.</td></tr>}@foreach(var item in _operations.Activities){<tr><td class="text-nowrap">@PersianDateTime.FormatDateTime(item.EventDate)</td><td>@(string.IsNullOrWhiteSpace(item.FullName)?item.UserName:item.FullName)</td><td><span class="operation-pill">@item.ActionTitle</span></td><td>@(string.IsNullOrWhiteSpace(item.ProductionCode)?"—":item.ProductionCode)</td><td>@item.DurationTitle</td><td>@(string.IsNullOrWhiteSpace(item.Description)?"—":item.Description)</td></tr>}</tbody></table></div></section>
}
else if(_tab=="production")
{
    <div class="metric-row"><article><small>کاسه‌های یکتای تولیدشده</small><strong>@_production.TotalBowlCount</strong></article><article><small>کاسه رو</small><strong>@_production.TopBowlCount</strong></article><article><small>کاسه زیر نت‌دار</small><strong>@_production.BottomNoteBowlCount</strong></article><article><small>سازهای واردشده به انبار</small><strong>@_production.TotalHandpanCount</strong></article></div>
    <div class="metric-row two production-route-metrics"><article><small>کاسه‌های داخلی رسیده به انبار</small><strong>@_production.DomesticBowlCount</strong></article><article><small>کاسه‌های صادراتی آماده بسته‌بندی یا ارسال</small><strong>@_production.ExportBowlCount</strong></article></div>
    <div class="production-trend-grid">
        <ReportTrendChart Points="@_production.DomesticBowlTrend" Title="روند ماهانه کاسه‌های داخلی رسیده به انبار" Unit="کاسه" />
        <ReportTrendChart Points="@_production.ExportBowlTrend" Title="روند ماهانه کاسه‌های صادراتی آماده بسته‌بندی یا ارسال" Unit="کاسه" />
        <div class="handpan-trend"><ReportTrendChart Points="@_production.HandpanTrend" Title="روند ماهانه سازهای واردشده به انبار" Unit="ساز" /></div>
    </div>
    <section class="analytics-card"><header><div><small>نمای فشرده کارگاه</small><h3>شش نمودار کلیدی تولید</h3></div><span>بازه انتخاب‌شده</span></header><ReportDonutGrid Charts="@_production.Donuts" /></section>
    <section class="result-card"><header><h3>خلاصه تولید</h3><span>@_production.Summary.Sum(x=>x.Count) کاسه</span></header><div class="table-responsive"><table class="table"><thead><tr><th>متریال</th><th>اسکیل</th><th>مقصد</th><th>تعداد</th></tr></thead><tbody>@foreach(var item in _production.Summary){<tr><td><strong>@item.Material</strong></td><td>@item.Scale</td><td><span class="destination-pill">@item.Destination</span></td><td>@item.Count</td></tr>}</tbody></table></div></section>
}
else
{
    @if(_inventoryKind=="instruments")
    {
        <div class="metric-row two"><article><small>موجودی داخلی</small><strong>@_inventory.DomesticCount</strong></article><article><small>موجودی صادراتی</small><strong>@_inventory.ExportCount</strong></article></div>
        <section class="result-card"><header><h3>موجودی انبار سازها</h3><span>@_inventory.Instruments.Count مورد</span></header><div class="table-responsive"><table class="table"><thead><tr><th>کد</th><th>نوع</th><th>متریال</th><th>اسکیل</th><th>مقصد</th></tr></thead><tbody>@if(_inventory.Instruments.Count==0){<tr><td colspan="5" class="empty-cell">موردی با این فیلترها پیدا نشد.</td></tr>}@foreach(var item in _inventory.Instruments){<tr><td><strong>@item.Code</strong></td><td>@item.ItemType</td><td>@item.Material</td><td>@item.Scale</td><td><span class="destination-pill">@item.Destination</span></td></tr>}</tbody></table></div></section>
    }
    else
    {
        <section class="result-card"><header><h3>موجودی فعلی مواد اولیه</h3><span>@_inventory.Stock.Count قلم</span></header><div class="stock-grid">@foreach(var item in _inventory.Stock){<article><div><strong>@item.Name</strong><small>@item.Category</small></div>@if(item.TopQuantity>0||item.BottomQuantity>0){<span>رو <b>@item.TopQuantity</b></span><span>زیر <b>@item.BottomQuantity</b></span>}else{<span>موجودی <b>@item.Quantity</b></span>}</article>}</div></section>
        <section class="result-card"><header><h3>خروجی مواد در بازه انتخاب‌شده</h3><span>@_inventory.Outflow.Sum(x=>x.Quantity) عدد</span></header><div class="outflow-grid">@if(_inventory.Outflow.Count==0){<p>خروجی ثبت‌شده‌ای در این بازه وجود ندارد.</p>}@foreach(var item in _inventory.Outflow){<article><strong>@item.Quantity</strong><span>@item.MaterialName</span><small>@item.StockKind</small></article>}</div></section>
        <section class="result-card"><header><h3>گردش ورودی و خروجی انبار</h3><span>@_inventory.Movements.Count رویداد</span></header><div class="table-responsive"><table class="table"><thead><tr><th>تاریخ</th><th>متریال</th><th>نوع</th><th>گردش</th><th>تعداد</th><th>ثبت‌کننده</th></tr></thead><tbody>@if(_inventory.Movements.Count==0){<tr><td colspan="6" class="empty-cell">از زمان فعال شدن گزارش جدید، گردشی در این بازه ثبت نشده است.</td></tr>}@foreach(var item in _inventory.Movements){<tr><td>@PersianDateTime.FormatDateTime(item.OccurredAt)</td><td><strong>@item.MaterialName</strong></td><td>@item.StockKind</td><td>@item.Direction</td><td>@Math.Abs(item.Delta)</td><td>@item.PerformedBy</td></tr>}</tbody></table></div></section>
    }
}

@code{
    private string _tab="operations",_user="",_action="",_payroll="all",_destination="all",_inventoryKind="instruments";
    private DateTime? _from,_to;private bool _loading=true,_exporting,_messageError;private string? _message,_filterNotice;
    private ProductionReportDto _operations=new();private ProductionAnalyticsDto _production=new();private InventoryReportDto _inventory=new();
    private List<MaterialDto> _materialOptions=[];private List<ScaleDto> _scaleOptions=[];private readonly HashSet<Guid> _materials=[];private readonly HashSet<Guid> _scales=[];
    private IEnumerable<PickerItem> MaterialOptions=>_materialOptions.Where(x=>x.Category==4).Select(x=>new PickerItem(x.Id,x.Name));private IEnumerable<PickerItem> ScaleOptions=>_scaleOptions.Select(x=>new PickerItem(x.Id,x.Name));
    private static readonly (int Id,string Title)[] Actions=[(1,"ثبت اولیه"),(2,"دیمپل"),(3,"شیپ"),(4,"پخت"),(5,"چسب"),(6,"تیون"),(7,"فاین‌تیون"),(8,"کنترل کیفیت"),(9,"بسته‌بندی"),(10,"ورود به انبار"),(11,"برگشتی"),(12,"فروش")];
    private string TabTitle=>_tab switch{"production"=>"گزارش تولید","inventory"=>"گزارش انبار",_=>"گزارش عملیات"};private string TabClass(string value)=>_tab==value?"report-tab active":"report-tab";
    private static string Signed(double value)=>value.ToString("+0.#;-0.#;0");private static string DeltaClass(double value)=>value>=0?"positive":"negative";
    protected override async Task OnInitializedAsync(){var materials=MaterialService.GetAsync();var scales=ScaleService.GetAsync();var operations=ReportService.GetAsync();await Task.WhenAll(materials,scales,operations);_materialOptions=(await materials).ToList();_scaleOptions=(await scales).ToList();_operations=await operations;_loading=false;}
    private async Task SwitchTab(string tab){_tab=tab;_message=null;await LoadCurrentAsync();}
    private async Task LoadCurrentAsync(){_loading=true;_message=null;try{if(_tab=="operations"){Guid? user=Guid.TryParse(_user,out var u)?u:null;int? action=int.TryParse(_action,out var a)?a:null;_operations=await ReportService.GetAsync(_from,_to,user,action);}else if(_tab=="production")_production=await ReportService.GetProductionAsync(_from,_to,_materials,_scales,_payroll,_destination);else _inventory=await ReportService.GetInventoryAsync(_from,_to,_inventoryKind,_materials,_scales,_destination);}catch(Exception ex){_message=ex.Message;_messageError=true;}finally{_loading=false;}}
    private Task ToggleMaterial(Guid id)=>ToggleLimited(_materials,id,"متریال");private Task ToggleScale(Guid id)=>ToggleLimited(_scales,id,"اسکیل");private Task ToggleLimited(HashSet<Guid> set,Guid id,string title){if(!set.Remove(id)){if(set.Count>=3){_filterNotice=$"حداکثر سه {title} را می‌توانید هم‌زمان انتخاب کنید.";return Task.CompletedTask;}set.Add(id);}_filterNotice=null;return Task.CompletedTask;}
    private async Task ClearAsync(){_from=_to=null;_user=_action="";_payroll=_destination="all";_materials.Clear();_scales.Clear();_filterNotice=null;await LoadCurrentAsync();}
    private (Guid? User,int? Action) OperationFilters(){Guid? u=Guid.TryParse(_user,out var user)?user:null;int? a=int.TryParse(_action,out var action)?action:null;return(u,a);}
    private async Task DownloadPdfAsync(){_exporting=true;_message=null;try{var f=OperationFilters();var bytes=await ReportService.PdfAsync(_tab,_from,_to,_materials,_scales,_payroll,_destination,_inventoryKind,f.User,f.Action);await JS.InvokeVoidAsync("torsepanReports.download",$"torsepan-{_tab}-{DateTime.Now:yyyyMMdd-HHmm}.pdf",bytes);_message="فایل PDF آماده و دانلود شد.";_messageError=false;}catch(Exception ex){_message=ex.Message;_messageError=true;}finally{_exporting=false;}}
    private async Task SendTelegramAsync(){_exporting=true;_message=null;try{var f=OperationFilters();await ReportService.SendTelegramAsync(_tab,_from,_to,_materials,_scales,_payroll,_destination,_inventoryKind,f.User,f.Action);_message="فایل PDF به ربات هشدار تلگرام ارسال شد.";_messageError=false;}catch(Exception ex){_message=ex.Message;_messageError=true;}finally{_exporting=false;}}
}

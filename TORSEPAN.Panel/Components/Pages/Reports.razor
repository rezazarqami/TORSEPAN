@page "/reports"

<PageTitle>Reports</PageTitle>

<PageHeader Title="Reports"
            SubTitle="Production Reports" />

<div class="row g-4">

    <div class="col-md-3">

        <StatCard Title="Today"
                  Value="0" />

    </div>

    <div class="col-md-3">

        <StatCard Title="This Week"
                  Value="0" />

    </div>

    <div class="col-md-3">

        <StatCard Title="This Month"
                  Value="0" />

    </div>

    <div class="col-md-3">

        <StatCard Title="Finished"
                  Value="0" />

    </div>

</div>

<div class="mt-4">

    <SearchBox Placeholder="Search reports..." />

</div>

<div class="mt-3">

    <Card>

        <DataTable>

            <thead>

                <tr>

                    <th>Production Code</th>
                    <th>Stage</th>
                    <th>Date</th>
                    <th>User</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td colspan="4">

                        <EmptyState Title="No Reports"
                                    Description="No report data found." />

                    </td>

                </tr>

            </tbody>

        </DataTable>

    </Card>

</div>
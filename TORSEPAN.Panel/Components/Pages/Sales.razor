@page "/sales"
@inject ProductionService ProductionService
<PageTitle>فروش</PageTitle><PageHeader Title="فروش" SubTitle="سازهای فروخته‌شده و اطلاعات خریداران" />
<div class="mb-4"><input class="form-control" placeholder="جست‌وجوی کد ساز، خریدار، متریال یا اسکیل..." @bind="_search" @bind:event="oninput" /></div>
<Card>@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}else if(!Items.Any()){<EmptyState Title="هنوز فروشی ثبت نشده است" Description="سازهای فروخته‌شده از انبار در این قسمت نمایش داده می‌شوند." />}else{<DataTable><thead><tr><th>کد ساز</th><th>خریدار</th><th>متریال</th><th>اسکیل</th><th>کاسه رو</th><th>کاسه زیر</th><th>ثبت‌کننده</th><th>تاریخ فروش</th></tr></thead><tbody>@foreach(var item in Items){<tr><td><strong>@item.SerialNumber</strong></td><td>@item.BuyerName</td><td>@item.MaterialName</td><td>@item.ScaleName</td><td>@item.TopBowlCode</td><td>@item.BottomBowlCode</td><td>@item.SoldBy</td><td>@item.SoldAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td></tr>}</tbody></DataTable>}</Card>
@code{private List<SaleItemDto> _items=[];private bool _loading=true;private string _search="";private IEnumerable<SaleItemDto> Items=>string.IsNullOrWhiteSpace(_search)?_items:_items.Where(x=>x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BuyerName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase));protected override async Task OnAfterRenderAsync(bool firstRender){if(!firstRender)return;try{_items=(await ProductionService.GetSalesAsync()).ToList();}finally{_loading=false;StateHasChanged();}}}

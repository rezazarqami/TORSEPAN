@page "/sales"
@attribute [Authorize(Roles = "Administrator,ProductionManager,SalesAdmin")]
@using Microsoft.AspNetCore.Authorization
@inject ProductionService ProductionService
@inject BowlService BowlService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject IJSRuntime JS

<PageTitle>فروش</PageTitle><PageHeader Title="فروش" SubTitle="سازهای فروخته‌شده و کاسه‌های صادراتی ارسال‌شده" />
<nav class="sales-segments" aria-label="نوع فروش"><button class="@SegmentClass(false)" @onclick="()=>_showExport=false"><span>فروش داخلی</span><strong>@_items.Count(x=>!x.IsBowl)</strong></button><button class="@SegmentClass(true)" @onclick="()=>_showExport=true"><span>فروش صادراتی</span><strong>@_items.Count(x=>x.IsBowl)</strong></button></nav>
<div class="mb-4"><input class="form-control" placeholder="جست‌وجوی کد، نوع، خریدار یا متریال..." @bind="_search" @bind:event="oninput" /></div>
<Card>
@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}
else if(!Items.Any()){<EmptyState Title="هنوز فروشی ثبت نشده است" Description="سازهای فروخته‌شده و کاسه‌های صادراتی ارسال‌شده اینجا نمایش داده می‌شوند." />}
else{<DataTable><thead><tr><th></th><th>نوع</th><th>کد</th><th>خریدار</th><th>@(_showExport?"روش ارسال":"قیمت")</th><th>مقصد</th><th>متریال</th><th>@(_showExport?"تسویه":"اسکیل")</th><th>ثبت‌کننده</th><th>تاریخ</th><th class="sale-actions-cell">عملیات</th></tr></thead><tbody>@foreach(var item in Items){<tr><td>@if(!item.IsBowl){<button class="btn btn-sm btn-outline-primary detail-toggle" disabled="@_detailsLoading.Contains(item.HandpanId)" @onclick="()=>ToggleDetailsAsync(item)">@if(_detailsLoading.Contains(item.HandpanId)){<span class="spinner-border spinner-border-sm"></span>}else{@(_expanded.Contains(item.HandpanId)?"−":"+")}</button>}</td><td><span class="badge @(item.IsBowl?"bg-warning text-dark":"bg-primary")">@item.ItemType</span></td><td><strong>@item.SerialNumber</strong></td><td>@(string.IsNullOrWhiteSpace(item.BuyerName)?"—":item.BuyerName)</td><td>@(item.IsBowl?ShippingName(item.ShippingMethod):(item.Price?.ToString("N0")??"—"))</td><td>@(string.IsNullOrWhiteSpace(item.Destination)?"—":item.Destination)</td><td>@item.MaterialName</td><td>@(item.IsBowl?SettledName(item.IsSettled):item.ScaleName)</td><td>@item.SoldBy</td><td>@PersianDateTime.FormatDateTime(item.SoldAt)</td><td class="sale-actions-cell"><div class="sale-actions">@if(!item.IsBowl){<button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(item)">ویرایش</button>}<AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-warning rollback-action" title="بازگشت به مرحله قبل" disabled="@_rollingBack.Contains(item.HandpanId)" @onclick="()=>RequestRollback(item)">@(_rollingBack.Contains(item.HandpanId)?"در حال انجام…":"↩ بازگشت")</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item)">حذف</button></AuthorizeView></div></td></tr>
@if(!item.IsBowl&&_expanded.Contains(item.HandpanId)){<tr class="sale-detail-row"><td colspan="11">@if(_detailErrors.Contains(item.HandpanId)){<div class="alert alert-warning">دریافت شناسنامه ساز انجام نشد. <button class="btn btn-sm btn-outline-warning" @onclick="()=>LoadDetailsAsync(item)">تلاش دوباره</button></div>}else if(_details.TryGetValue(item.HandpanId,out var detail)){<div class="sold-instrument-detail"><div class="sold-photo"><HandpanPhotoGallery HandpanId="@item.HandpanId" /></div><div class="sold-info"><h5>شناسنامه ساز @item.SerialNumber</h5><div class="sold-packaging">@if(detail.PackagingItems.Count==0){<span>اقلام بسته‌بندی ثبت نشده</span>}else{@foreach(var p in detail.PackagingItems){<span>✓ @p</span>}}</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>عملیات</th><th>انجام‌دهنده</th><th>زمان</th></tr></thead><tbody>@foreach(var op in detail.Operations){<tr><td>@op.Operation</td><td>@op.PerformedBy</td><td>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</td></tr>}</tbody></table></div></div></div>}else{<div class="sold-detail-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت شناسنامه ساز…</div>}</td></tr>}
}</tbody></DataTable>}
</Card>

<AppConfirmDialog IsOpen="@(_rollbackCandidate is not null)"
                  Title="بازگشت از فروش"
                  Message="@RollbackMessage"
                  ConfirmText="@RollbackConfirmText"
                  Error="@_rollbackError"
                  Busy="@RollbackBusy"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />

@if(_editing is not null)
{
<div class="edit-sale-overlay" @onclick="CloseEdit"><section class="edit-sale-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
    <header><div><small>تکمیل اطلاعات فروش</small><h3>ساز @_editing.SerialNumber</h3></div><button @onclick="CloseEdit">×</button></header>
    <div class="edit-sale-fields">
        <label><span>خریدار از حسابداری</span><select class="form-select" @bind="_partyId"><option value="">انتخاب نشده</option>@foreach(var p in _parties){<option value="@p.Id">@p.DisplayName</option>}</select></label>
        <label><span>نام خریدار آزاد</span><input class="form-control" @bind="_buyer" placeholder="اختیاری" /></label>
        <label><span>قیمت</span><input type="number" min="0" class="form-control" @bind="_price" placeholder="اختیاری" /></label>
        <label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="اختیاری" /></label>
        <label class="paid"><input type="checkbox" @bind="_isPaid" /><span>مبلغ کامل دریافت شده است</span></label>
        @if(!_isPaid){<label><span>تاریخ سررسید</span><input type="date" class="form-control" @bind="_dueDate" /></label>}
    </div>
    @if(!string.IsNullOrWhiteSpace(_editError)){<div class="edit-error">@_editError</div>}
    <footer><button class="btn btn-light" disabled="@_saving" @onclick="CloseEdit">انصراف</button><button class="btn btn-primary" disabled="@_saving" @onclick="SaveEdit">ذخیره تغییرات</button></footer>
</section></div>
}

@code{
    private List<SaleItemDto> _items=[];private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties=[];private readonly HashSet<Guid> _expanded=[];private readonly HashSet<Guid> _detailsLoading=[];private readonly HashSet<Guid> _detailErrors=[];private readonly HashSet<Guid> _rollingBack=[];private readonly Dictionary<Guid,WarehouseHandpanDto> _details=[];private bool _loading=true,_saving,_isPaid,_showExport;private string _search="",_buyer="",_destination="";private SaleItemDto?_editing;private SaleItemDto?_rollbackCandidate;private decimal?_price;private Guid?_partyId;private DateTime?_dueDate;private string?_editError;private string?_rollbackError;
    private IEnumerable<SaleItemDto> Items{get{var typed=_items.Where(x=>x.IsBowl==_showExport);return string.IsNullOrWhiteSpace(_search)?typed:typed.Where(x=>x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ItemType.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BuyerName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase));}}
    private string SegmentClass(bool export)=>_showExport==export?"sales-segment active":"sales-segment";
    private static string ShippingName(string? value)=>value switch{"air"=>"هوایی","land"=>"زمینی","sea"=>"دریایی",_=>"ثبت نشده"};
    private static string SettledName(bool? value)=>value switch{true=>"تسویه شده",false=>"تسویه نشده",_=>"ثبت نشده"};
    protected override async Task OnInitializedAsync(){await LoadAsync();}
    private async Task LoadAsync(){_loading=true;try{var sales=ProductionService.GetSalesAsync();var parties=AccountingService.PartiesAsync();await Task.WhenAll(sales,parties);_items=(await sales).ToList();_parties=await parties;}finally{_loading=false;}}
    private void Edit(SaleItemDto item){_editing=item;_buyer=item.BuyerName;_destination=item.Destination;_price=item.Price;_partyId=item.PartyId;_isPaid=item.Price.HasValue&&item.PaidAmount==item.Price.Value;_dueDate=item.DueDate;_editError=null;}
    private async Task ToggleDetailsAsync(SaleItemDto item){if(!_expanded.Add(item.HandpanId)){_expanded.Remove(item.HandpanId);return;}if(!_details.ContainsKey(item.HandpanId))await LoadDetailsAsync(item);}
    private async Task LoadDetailsAsync(SaleItemDto item){if(!_detailsLoading.Add(item.HandpanId))return;_detailErrors.Remove(item.HandpanId);try{var detail=await ProductionService.GetWarehouseDetailsAsync(item.HandpanId);if(detail is null)throw new InvalidOperationException();_details[item.HandpanId]=detail;}catch{_detailErrors.Add(item.HandpanId);}finally{_detailsLoading.Remove(item.HandpanId);}}
    private void CloseEdit(){if(!_saving)_editing=null;}
    private async Task SaveEdit(){if(_editing is null)return;_saving=true;_editError=null;try{var party=_parties.FirstOrDefault(x=>x.Id==_partyId);await ProductionService.UpdateSaleAsync(_editing.HandpanId,party?.Name??_buyer.Trim(),_price,_destination.Trim(),party?.Id,_isPaid,_dueDate);_editing=null;await LoadAsync();}catch{_editError="ذخیره اطلاعات فروش انجام نشد. مقادیر را بررسی و دوباره تلاش کنید.";}finally{_saving=false;}}
    private async Task DeleteAsync(SaleItemDto item){if(!await JS.InvokeAsync<bool>("confirm",$"رکورد {item.ItemType} با کد {item.SerialNumber} و تمام سوابق آن برای همیشه حذف شود؟"))return;if(item.IsBowl)await BowlService.DeleteAsync(item.HandpanId);else await ProductionService.DeleteAsync(item.HandpanId);_items.Remove(item);}
    private bool RollbackBusy=>_rollbackCandidate is not null&&_rollingBack.Contains(_rollbackCandidate.HandpanId);
    private string RollbackMessage=>_rollbackCandidate is null?string.Empty:_rollbackCandidate.IsBowl
        ?$"کاسه صادراتی {_rollbackCandidate.SerialNumber} به انبار صادراتی برگردد؟ سابقه ارسال این کاسه حذف می‌شود."
        :$"ساز {_rollbackCandidate.SerialNumber} به انبار سازها برگردد؟ اطلاعات خریدار، سند مالی و سابقه همین فروش حذف می‌شوند.";
    private string RollbackConfirmText=>_rollbackCandidate?.IsBowl==true?"بازگشت به انبار صادراتی":"بازگشت به انبار سازها";
    private void RequestRollback(SaleItemDto item){if(_rollingBack.Contains(item.HandpanId))return;_rollbackCandidate=item;_rollbackError=null;}
    private void CancelRollback(){if(RollbackBusy)return;_rollbackCandidate=null;_rollbackError=null;}
    private async Task ConfirmRollbackAsync(){var item=_rollbackCandidate;if(item is null||!_rollingBack.Add(item.HandpanId))return;_rollbackError=null;try{if(item.IsBowl)await BowlService.RollbackAsync(item.HandpanId);else await ProductionService.RollbackAsync(item.HandpanId);_items.Remove(item);_expanded.Remove(item.HandpanId);_details.Remove(item.HandpanId);_rollbackCandidate=null;}catch{_rollbackError="بازگشت از فروش انجام نشد. وضعیت رکورد را دوباره بررسی کنید.";}finally{_rollingBack.Remove(item.HandpanId);}}
}

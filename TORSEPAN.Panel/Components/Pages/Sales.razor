@page "/sales"
@attribute [Authorize(Roles = "Administrator,ProductionManager,SalesAdmin")]
@using Microsoft.AspNetCore.Authorization
@inject ProductionService ProductionService
@inject BowlService BowlService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject SalesAttributionService AttributionService
@inject IJSRuntime JS

<style>.inline-add{display:grid;grid-template-columns:1fr auto;align-items:end;gap:7px}.inline-add .btn{min-height:44px;border-radius:11px;white-space:nowrap}</style>
<PageTitle>فروش</PageTitle>
<section class="sales-hero">
    <span class="sales-kicker">SALES / TORSEPAN</span>
    <img class="sales-hero-logo" src="/images/brand/torsepan-mark-new.webp" alt="تورسپن" />
    <h1>فروش</h1><div class="sales-total"><strong>@_items.Count</strong> فروش ثبت‌شده</div>
</section>
<nav class="sales-segments" aria-label="نوع فروش">
    @for(var segment=0;segment<3;segment++)
    {
        var current=segment;
        <button type="button" class="@SegmentClass(current)" aria-pressed="@(_saleSegment==current?"true":"false")" @onclick="()=>_saleSegment=current">
            <span class="sales-tier-text"><strong>@SegmentTitle(current)</strong></span>
            <b class="sales-tier-count">@SegmentCount(current)</b>
        </button>
    }
</nav>
<div class="sales-collection-heading"><div><small>سوابق فروش</small><h2>@SegmentTitle(_saleSegment)</h2></div><span>@Items.Count() مورد</span></div>
@if(IsBowlSegment && !_loading)
{
    <div class="export-bowl-counts" aria-label="تعداد کاسه‌های صادراتی فروخته‌شده">
        <div><span>کاسه زیر ساده</span><strong>@ExportBowlCount(2, false)</strong><small>بدون نوت</small></div>
        <div><span>کاسه زیر نوت‌دار</span><strong>@ExportBowlCount(2, true)</strong><small>دارای نوت</small></div>
        <div><span>کاسه رو</span><strong>@ExportBowlCount(1)</strong><small>کاسه بالایی</small></div>
    </div>
}
<div class="sales-search-wrap"><span aria-hidden="true">⌕</span><input class="form-control" aria-label="جست‌وجو در فروش انتخاب‌شده" placeholder="کد، خریدار، متریال یا Scale…" @bind="_search" @bind:event="oninput" /></div>
<Card>
@if(_loading){<div class="text-center p-5"><div class="spinner-border"></div></div>}
else if(!Items.Any()){<EmptyState Title="فروشی پیدا نشد" Description="سوابق این بخش را بررسی کنید یا عبارت جست‌وجو را تغییر دهید." />}
else
{
    <div class="sales-stock-list">
    @foreach(var item in Items)
    {
        <article class="sales-stock-item">
            <div class="sales-stock-summary">
                <button class="sales-stock-expand" aria-label="جزئیات فروش @item.SerialNumber" aria-expanded="@(_expanded.Contains(item.HandpanId)?"true":"false")" disabled="@_detailsLoading.Contains(item.HandpanId)" @onclick="()=>ToggleDetailsAsync(item)">@if(_detailsLoading.Contains(item.HandpanId)){<span class="spinner-border spinner-border-sm"></span>}else{@(_expanded.Contains(item.HandpanId)?"−":"+")}</button>
                <strong class="sales-stock-code" dir="ltr">@item.SerialNumber</strong>
                <span class="sales-stock-material" dir="auto" title="@item.MaterialName">@item.MaterialName</span>
                <span class="sales-stock-scale" dir="auto" title="@(item.IsBowl?item.ItemType:item.ScaleName)">@(item.IsBowl?item.ItemType:item.ScaleName)</span>
            </div>
            <div class="sales-stock-date">تاریخ فروش: <bdi>@PersianDateTime.FormatDateTime(item.SoldAt)</bdi></div>
            @if(_expanded.Contains(item.HandpanId))
            {
                <section class="sales-stock-details">
                    <dl class="sales-facts">
                        <div><dt>نوع</dt><dd>@(item.IsBowl?item.ItemType:item.IsExportSale?"ساز صادراتی":"ساز داخلی")</dd></div>
                        <div><dt>خریدار</dt><dd>@(string.IsNullOrWhiteSpace(item.BuyerName)?"—":item.BuyerName)</dd></div>
                        <div><dt>شماره تلفن</dt><dd dir="auto">@(item.IsBowl?"—":string.IsNullOrWhiteSpace(item.BuyerPhoneNumber)?"—":item.BuyerPhoneNumber)</dd></div>
                        <div><dt>@(IsBowlSegment?"روش ارسال":"قیمت")</dt><dd>@(item.IsBowl?ShippingName(item.ShippingMethod):(item.Price?.ToString("N0")??"—"))</dd></div>
                        <div><dt>مقصد</dt><dd>@(string.IsNullOrWhiteSpace(item.Destination)?"—":item.Destination)</dd></div>
                        <div><dt>متریال</dt><dd dir="auto">@item.MaterialName</dd></div>
                        <div><dt>@(IsBowlSegment?"تسویه":"Scale")</dt><dd dir="auto">@(item.IsBowl?SettledName(item.IsSettled):item.ScaleName)</dd></div>
                        <div><dt>ثبت‌کننده</dt><dd>@item.SoldBy</dd></div>
                        @if(!item.IsBowl){<div><dt>گارانتی</dt><dd><span class="warranty-status @(item.IsWarrantyActive?"active":"inactive")"><i></i>@(item.IsWarrantyActive?"فعال":"غیرفعال")</span></dd></div>}
                    </dl>
                    <div class="sale-actions">@if(!item.IsBowl){<button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(item)">ویرایش</button>}<AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-warning rollback-action" title="بازگشت به مرحله قبل" disabled="@_rollingBack.Contains(item.HandpanId)" @onclick="()=>RequestRollback(item)">@(_rollingBack.Contains(item.HandpanId)?"در حال انجام…":"↩ بازگشت")</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DeleteAsync(item)">حذف</button></AuthorizeView></div>
                    @if(item.IsBowl)
                    {
                        @if(_detailErrors.Contains(item.HandpanId))
                        {
                            <div class="alert alert-warning" role="alert">دریافت سابقه ساخت کاسه انجام نشد. <button class="btn btn-sm btn-outline-warning" @onclick="()=>LoadDetailsAsync(item)">تلاش دوباره</button></div>
                        }
                        else if(_bowlDetails.TryGetValue(item.HandpanId, out var bowlDetail))
                        {
                            <div class="sold-bowl-detail">
                                <h5>سابقه ساخت کاسه @item.SerialNumber</h5>
                                @if(bowlDetail.History.Count == 0)
                                {
                                    <p class="text-muted">سابقه‌ای برای ساخت این کاسه ثبت نشده است.</p>
                                }
                                else
                                {
                                    <div class="table-responsive"><table class="table table-sm">
                                        <thead><tr><th>عملیات</th><th>انجام‌دهنده</th><th>زمان</th></tr></thead>
                                        <tbody>@foreach(var op in bowlDetail.History)
                                        {
                                            <tr><td>@op.ActionTitle</td><td>
                                                @if(op.BowlPerformers.Count > 0)
                                                {
                                                    @foreach(var performer in op.BowlPerformers)
                                                    {
                                                        <div>@performer.Label: @performer.PerformedBy</div>
                                                        @if(!string.IsNullOrWhiteSpace(performer.Details)){<small class="text-muted">@performer.Details</small>}
                                                    }
                                                }
                                                else
                                                {
                                                    @op.PerformedBy
                                                    @if(!string.IsNullOrWhiteSpace(op.Details)){<small class="d-block text-muted">@op.Details</small>}
                                                }
                                            </td><td>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</td></tr>
                                        }</tbody>
                                    </table></div>
                                }
                            </div>
                        }
                        else{<div class="sold-detail-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت سابقه ساخت کاسه…</div>}
                    }
                    else
                    {
                        @if(_detailErrors.Contains(item.HandpanId)){<div class="alert alert-warning">دریافت شناسنامه ساز انجام نشد. <button class="btn btn-sm btn-outline-warning" @onclick="()=>LoadDetailsAsync(item)">تلاش دوباره</button></div>}
                        else if(_details.TryGetValue(item.HandpanId,out var detail))
                        {
                            <div class="sold-instrument-detail"><div class="sold-photo"><HandpanPhotoGallery HandpanId="@item.HandpanId" /></div><div class="sold-info"><h5>شناسنامه ساز @item.SerialNumber</h5><div class="sold-packaging">@if(detail.PackagingItems.Count==0){<span>اقلام بسته‌بندی ثبت نشده</span>}else{@foreach(var p in detail.PackagingItems){<span>✓ @p</span>}}</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>عملیات</th><th>انجام‌دهنده</th><th>زمان</th></tr></thead><tbody>@foreach(var op in detail.Operations){<tr><td>@op.Operation</td><td>@op.PerformedBy</td><td>@(op.PerformedAt==default?"—":PersianDateTime.FormatDateTime(op.PerformedAt))</td></tr>}</tbody></table></div></div></div>
                        }
                        else{<div class="sold-detail-loading"><span class="spinner-border spinner-border-sm"></span> در حال دریافت شناسنامه ساز…</div>}
                    }
                </section>
            }
        </article>
    }
    </div>
}
</Card>

<AppConfirmDialog IsOpen="@(_rollbackCandidate is not null)"
                  Title="بازگشت از فروش"
                  Message="@RollbackMessage"
                  ConfirmText="@RollbackConfirmText"
                  Error="@_rollbackError"
                  Busy="@RollbackBusy"
                  OnConfirm="ConfirmRollbackAsync"
                  OnCancel="CancelRollback" />

@if(_editing is not null)
{
<div class="edit-sale-overlay" @onclick="CloseEdit"><section class="edit-sale-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
    <header><div><small>تکمیل اطلاعات فروش</small><h3>ساز @_editing.SerialNumber</h3></div><button @onclick="CloseEdit">×</button></header>
    <div class="edit-sale-fields">
        <label><span>خریدار از حسابداری</span><select class="form-select" @bind="_partyId"><option value="">انتخاب نشده</option>@foreach(var p in _parties){<option value="@p.Id">@p.DisplayName @(string.IsNullOrWhiteSpace(p.Phone)?"":$"— {p.Phone}")</option>}</select></label>
        <label><span>نام خریدار آزاد</span><input class="form-control" @bind="_buyer" placeholder="اختیاری" /></label>
        <label><span>شماره تلفن خریدار</span><input class="form-control" inputmode="tel" @bind="_buyerPhone" placeholder="اختیاری" /></label>
        <label><span>مبلغ کل</span><input type="number" min="0" class="form-control" @bind="_price" placeholder="اختیاری" /></label>
        <label><span>مبلغ دریافتی</span><input type="number" min="0" class="form-control" @bind="_receivedAmount" placeholder="اختیاری" /></label>
        <label><span>مبلغ مانده</span><input class="form-control" value="@RemainingAmountText" disabled /></label>
        <label class="paid export-switch"><input type="checkbox" @bind="_isExportSale" @bind:after="SaleTypeChanged" /><span>فروش صادراتی ساز</span></label>
        @if(_isExportSale){<label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="اختیاری" /></label>}
        <label><span>نحوه آشنایی</span><select class="form-select" @bind="_leadSourceId" @bind:after="LeadSourceChanged"><option value="">انتخاب نشده</option>@foreach(var source in _attribution.Sources){<option value="@source.Id">@source.Name</option>}</select></label>
        <div class="inline-add"><input class="form-control" @bind="_newSource" placeholder="روش جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddSourceAsync">افزودن</button></div>
        @if(SelectedSourceRequiresReferrer){<label><span>نام معرف <strong>*</strong></span><select class="form-select" @bind="_referrerId"><option value="">انتخاب معرف</option>@foreach(var item in _attribution.Referrers){<option value="@item.Id">@item.Name</option>}</select></label><div class="inline-add"><input class="form-control" @bind="_newReferrer" placeholder="نام معرف جدید" /><button type="button" class="btn btn-outline-primary" @onclick="AddReferrerAsync">افزودن</button></div>}
        <label class="paid"><input type="checkbox" checked disabled /><span>@(_editing.IsWarrantyActive?"گارانتی فعال است":"فعال‌سازی گارانتی")</span></label>
    </div>
    @if(!string.IsNullOrWhiteSpace(_editError)){<div class="edit-error">@_editError</div>}
    <footer><button class="btn btn-light" disabled="@_saving" @onclick="CloseEdit">انصراف</button><button class="btn btn-primary" disabled="@_saving" @onclick="SaveEdit">ذخیره تغییرات</button></footer>
</section></div>
}

@code{
    private List<SaleItemDto> _items=[];private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties=[];private readonly HashSet<Guid> _expanded=[];private readonly HashSet<Guid> _detailsLoading=[];private readonly HashSet<Guid> _detailErrors=[];private readonly HashSet<Guid> _rollingBack=[];private readonly Dictionary<Guid,WarehouseHandpanDto> _details=[];private bool _loading=true,_saving,_isExportSale;private int _saleSegment;private string _search="",_buyer="",_buyerPhone="",_destination="",_newSource="",_newReferrer="";private SaleItemDto?_editing;private SaleItemDto?_rollbackCandidate;private decimal?_price,_receivedAmount;private Guid?_partyId,_leadSourceId,_referrerId;private string?_editError;private string?_rollbackError;private SalesAttributionOptionsDto _attribution=new();
    private bool SelectedSourceRequiresReferrer=>_attribution.Sources.FirstOrDefault(x=>x.Id==_leadSourceId)?.RequiresReferrer==true;
    private string RemainingAmountText=>_price.HasValue?Math.Max(0,_price.Value-(_receivedAmount??0)).ToString("N0"):"—";
    private bool IsBowlSegment=>_saleSegment==2;
    private readonly Dictionary<Guid,DimpleBowlDto> _bowlDetails=[];
    private int ExportBowlCount(int bowlType, bool? hasNotes = null)=>Items.Count(x=>x.IsBowl && x.BowlType==bowlType && (!hasNotes.HasValue || x.HasNotes==hasNotes.Value));
    private IEnumerable<SaleItemDto> Items{get{var typed=_items.Where(x=>_saleSegment switch{0=>!x.IsBowl&&!x.IsExportSale,1=>!x.IsBowl&&x.IsExportSale,_=>x.IsBowl});return string.IsNullOrWhiteSpace(_search)?typed:typed.Where(x=>x.SerialNumber.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ItemType.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.BuyerName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.MaterialName.Contains(_search,StringComparison.OrdinalIgnoreCase)||x.ScaleName.Contains(_search,StringComparison.OrdinalIgnoreCase));}}
    private static string SegmentTitle(int segment)=>segment switch{0=>"فروش داخلی ساز",1=>"فروش صادراتی ساز",_=>"فروش صادراتی کاسه"};
    private int SegmentCount(int segment)=>_items.Count(x=>segment switch{0=>!x.IsBowl&&!x.IsExportSale,1=>!x.IsBowl&&x.IsExportSale,_=>x.IsBowl});
    private string SegmentClass(int segment)=>_saleSegment==segment?"sales-segment active":"sales-segment";
    private static string ShippingName(string? value)=>value switch{"air"=>"هوایی","land"=>"زمینی","sea"=>"دریایی",_=>"ثبت نشده"};
    private static string SettledName(bool? value)=>value switch{true=>"تسویه شده",false=>"تسویه نشده",_=>"ثبت نشده"};
    protected override async Task OnInitializedAsync(){_attribution=await AttributionService.OptionsAsync();await LoadAsync();}
    private async Task LoadAsync(){_loading=true;try{var sales=ProductionService.GetSalesAsync();var parties=AccountingService.PartiesAsync();await Task.WhenAll(sales,parties);_items=(await sales).ToList();_parties=await parties;}finally{_loading=false;}}
    private void Edit(SaleItemDto item){_editing=item;_buyer=item.BuyerName;_buyerPhone=item.BuyerPhoneNumber;_isExportSale=item.IsExportSale;_destination=item.Destination;_price=item.Price;_receivedAmount=item.PaidAmount;_partyId=item.PartyId;_leadSourceId=item.LeadSourceId;_referrerId=item.ReferrerId;_editError=null;}
    private void LeadSourceChanged(){if(!SelectedSourceRequiresReferrer)_referrerId=null;}
    private async Task AddSourceAsync(){if(string.IsNullOrWhiteSpace(_newSource))return;try{var item=await AttributionService.AddSourceAsync(_newSource);if(item is not null){_attribution.Sources.Add(item);_leadSourceId=item.Id;_newSource="";}}catch(Exception ex){_editError=ex.Message;}}
    private async Task AddReferrerAsync(){if(string.IsNullOrWhiteSpace(_newReferrer))return;try{var item=await AttributionService.AddReferrerAsync(_newReferrer);if(item is not null){_attribution.Referrers.Add(item);_referrerId=item.Id;_newReferrer="";}}catch(Exception ex){_editError=ex.Message;}}
    private void SaleTypeChanged(){if(!_isExportSale)_destination="";}
    private async Task ToggleDetailsAsync(SaleItemDto item){if(!_expanded.Add(item.HandpanId)){_expanded.Remove(item.HandpanId);return;}if(item.IsBowl?!_bowlDetails.ContainsKey(item.HandpanId):!_details.ContainsKey(item.HandpanId))await LoadDetailsAsync(item);}
    private async Task LoadDetailsAsync(SaleItemDto item)
    {
        if(!_detailsLoading.Add(item.HandpanId))return;
        _detailErrors.Remove(item.HandpanId);
        try
        {
            if(item.IsBowl)
            {
                var detail=await BowlService.GetForDimplingAsync(item.SerialNumber);
                if(detail is null)throw new InvalidOperationException();
                _bowlDetails[item.HandpanId]=detail;
            }
            else
            {
                var detail=await ProductionService.GetWarehouseDetailsAsync(item.HandpanId);
                if(detail is null)throw new InvalidOperationException();
                _details[item.HandpanId]=detail;
            }
        }
        catch{_detailErrors.Add(item.HandpanId);}
        finally{_detailsLoading.Remove(item.HandpanId);}
    }
    private void CloseEdit(){if(!_saving)_editing=null;}
    private async Task SaveEdit(){if(_editing is null)return;if(SelectedSourceRequiresReferrer&&!_referrerId.HasValue){_editError="نام معرف را انتخاب کنید.";return;}_saving=true;_editError=null;try{var party=_parties.FirstOrDefault(x=>x.Id==_partyId);var buyer=party?.Name??_buyer.Trim();await ProductionService.UpdateSaleAsync(_editing.HandpanId,buyer,party?.Phone??_buyerPhone.Trim(),_price,_receivedAmount,_isExportSale,_destination.Trim(),party?.Id,true,_leadSourceId,_referrerId);_editing=null;await LoadAsync();}catch(Exception ex){_editError=string.IsNullOrWhiteSpace(ex.Message)?"ذخیره فروش یا فعال‌سازی گارانتی انجام نشد.":ex.Message;}finally{_saving=false;}}
    private async Task DeleteAsync(SaleItemDto item){if(!await JS.InvokeAsync<bool>("confirm",$"رکورد {item.ItemType} با کد {item.SerialNumber} و تمام سوابق آن برای همیشه حذف شود؟"))return;if(item.IsBowl)await BowlService.DeleteAsync(item.HandpanId);else await ProductionService.DeleteAsync(item.HandpanId);_items.Remove(item);}
    private bool RollbackBusy=>_rollbackCandidate is not null&&_rollingBack.Contains(_rollbackCandidate.HandpanId);
    private string RollbackMessage=>_rollbackCandidate is null?string.Empty:_rollbackCandidate.IsBowl
        ?$"کاسه صادراتی {_rollbackCandidate.SerialNumber} به انبار صادراتی برگردد؟ سابقه ارسال این کاسه حذف می‌شود."
        :$"ساز {_rollbackCandidate.SerialNumber} به انبار سازها برگردد؟ اطلاعات خریدار، سند مالی و سابقه همین فروش حذف می‌شوند.";
    private string RollbackConfirmText=>_rollbackCandidate?.IsBowl==true?"بازگشت به انبار صادراتی":"بازگشت به انبار سازها";
    private void RequestRollback(SaleItemDto item){if(_rollingBack.Contains(item.HandpanId))return;_rollbackCandidate=item;_rollbackError=null;}
    private void CancelRollback(){if(RollbackBusy)return;_rollbackCandidate=null;_rollbackError=null;}
    private async Task ConfirmRollbackAsync(){var item=_rollbackCandidate;if(item is null||!_rollingBack.Add(item.HandpanId))return;_rollbackError=null;try{if(item.IsBowl)await BowlService.RollbackAsync(item.HandpanId);else await ProductionService.RollbackAsync(item.HandpanId);_items.Remove(item);_expanded.Remove(item.HandpanId);_details.Remove(item.HandpanId);_rollbackCandidate=null;}catch{_rollbackError="بازگشت از فروش انجام نشد. وضعیت رکورد را دوباره بررسی کنید.";}finally{_rollingBack.Remove(item.HandpanId);}}
}

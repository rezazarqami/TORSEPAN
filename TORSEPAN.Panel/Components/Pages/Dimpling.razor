@page "/dimpling"
@page "/production/process"

@using System.Net
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject BowlService BowlService
@inject ScaleService ScaleService
@inject NavigationManager Navigation

<PageTitle>تولید</PageTitle>

<h3 class="mb-4">تولید</h3>

<div class="alert alert-light border mb-4">
    دیمپل ← شیپ ← پخت ← تیون ← چسب ← فاین تیون ← QC
</div>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(15, 23, 42, .55); z-index: 2000;">
        <div class="card shadow-lg text-center p-5" style="min-width: min(520px, 90vw);">
            <div class="display-4 text-success mb-3">✓</div>
            <h3 class="mb-4">@_successMessage</h3>
            <button class="btn btn-primary btn-lg px-5" @onclick="ReturnToDashboard">
                تأیید و بازگشت به داشبورد
            </button>
        </div>
    </div>
}

<div class="card p-4">
    <label class="form-label">کد ساز را وارد کنید</label>
    <div class="input-group mb-3">
        <input class="form-control"
               placeholder="کد ساز را وارد کنید"
               @bind="_productionCode"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />
        <button class="btn btn-primary" disabled="@_loading" @onclick="SearchAsync">
            جست‌وجو
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_bowl is not null)
    {
        <div class="border rounded p-3 mt-2">
            <div><strong>کد:</strong> @_bowl.ProductionCode</div>
            <div><strong>نوع کاسه:</strong> @BowlTypeText(_bowl.BowlType)</div>
            <div><strong>وضعیت:</strong> @StageText(_bowl.Stage)</div>

            @if (_bowl.Stage == 2)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام دیمپل</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@_loading"
                                @onclick="CompleteAsync">
                            دیمپل انجام شد
                        </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 4)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام شیپ</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@_loading"
                                @onclick="CompleteShapeAsync">
                            شیپ انجام شد
                        </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 6)
            {
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompleteBakeAsync">
                    پخت انجام شد
                </button>
            }
            else if (_bowl.Stage == 8)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام تیون</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@_loading"
                                @onclick="CompleteTuneAsync">
                            تیون انجام شد
                        </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 10)
            {
                <div class="mt-3">
                    <label class="form-label">@PairedBowlLabel(_bowl.BowlType)</label>
                    <input class="form-control"
                           placeholder="کد کاسه مکمل را وارد کنید"
                           @bind="_pairedProductionCode"
                           @bind:event="oninput" />
                    <label class="form-label mt-3">اسکیل ساز</label>
                    <select class="form-select" @bind="_scaleId">
                        <option value="@Guid.Empty">انتخاب کنید...</option>
                        @foreach (var scale in _scales)
                        {
                            <option value="@scale.Id">@scale.Name</option>
                        }
                    </select>
                    <button class="btn btn-success mt-3"
                            disabled="@(_loading || string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)"
                            @onclick="CompleteGlueAsync">
                        چسب انجام شد
                    </button>
                </div>
            }
            else if (_bowl.Stage == 11)
            {
                <div class="alert alert-info mt-3">
                    این ساز در اتاق چسب قرار دارد.
                </div>
                <button class="btn btn-success"
                        disabled="@_loading"
                        @onclick="ReleaseFromGlueRoomAsync">
                    از اتاق چسب خارج شد
                </button>
            }
            else if (_bowl.Stage == 12)
            {
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompleteFinalTuneAsync">
                    فاین تیون انجام شد
                </button>
            }
            else if (_bowl.Stage == 14)
            {
                <div class="mt-3">
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-success"
                                disabled="@_loading"
                                @onclick="ApproveQualityControlAsync">
                            QC تأیید شد
                        </button>
                        <button class="btn btn-outline-danger"
                                disabled="@_loading"
                                @onclick="ShowQualityControlRejection">
                            QC تأیید نشد
                        </button>
                    </div>

                    @if (_showQcRejection)
                    {
                        <label class="form-label">دلیل تأیید نشدن</label>
                        <select class="form-select" @bind="_qcRejectionReason">
                            <option value="OutOfTune">کوک نبودن</option>
                            <option value="Appearance">وضعیت ظاهری</option>
                            <option value="Other">سایر موارد</option>
                        </select>

                        @if (_qcRejectionReason == "Other")
                        {
                            <label class="form-label mt-3">توضیحات سایر موارد</label>
                            <textarea class="form-control" rows="3" @bind="_qcDetails"></textarea>
                        }

                        <button class="btn btn-danger mt-3"
                                disabled="@(_loading || (_qcRejectionReason == "Other" && string.IsNullOrWhiteSpace(_qcDetails)))"
                                @onclick="RejectQualityControlAsync">
                            ثبت عدم تأیید و بازگشت به فاین تیون
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    این کاسه در مرحله دیگری از تولید قرار دارد.
                </div>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private string _productionCode = string.Empty;
    private string? _error;
    private DimpleBowlDto? _bowl;
    private bool _loading;
    private int _duration = 1;
    private string _pairedProductionCode = string.Empty;
    private Guid _scaleId;
    private readonly List<ScaleDto> _scales = [];
    private string? _successMessage;
    private bool _showQcRejection;
    private string _qcRejectionReason = "OutOfTune";
    private string _qcDetails = string.Empty;

    private static readonly (int Value, string Text)[] DurationOptions =
    [
        (1, "۵ دقیقه"), (2, "۱۰ دقیقه"), (3, "۱۵ دقیقه"),
        (4, "۲۰ دقیقه"), (5, "۲۵ دقیقه"), (6, "۳۰ دقیقه"),
        (7, "۳۵ دقیقه"), (8, "۴۰ دقیقه"), (9, "۴۵ دقیقه"),
        (10, "۵۰ دقیقه"), (11, "۵۵ دقیقه"), (12, "۶۰ دقیقه"),
        (13, "بیشتر از ۶۰ دقیقه")
    ];

    protected override async Task OnInitializedAsync()
    {
        _scales.AddRange(await ScaleService.GetAsync());
        if (_scales.Count > 0)
            _scaleId = _scales[0].Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Code) && Code != _productionCode)
        {
            _productionCode = Code;
            await SearchAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_productionCode))
        {
            _error = "کد ساز را وارد کنید.";
            return;
        }

        await ExecuteAsync(async () =>
        {
            _pairedProductionCode = string.Empty;
            _successMessage = null;
            _showQcRejection = false;
            _bowl = await BowlService.GetForDimplingAsync(_productionCode);
            if (_bowl is null)
                _error = "کاسه پیدا نشد.";
        });
    }

    private async Task CompleteAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteDimplingAsync(_productionCode, _duration);
            SetOperationResult(result, "دیمپل با موفقیت انجام شد.", "ثبت پایان دیمپل انجام نشد.");
        });
    }

    private async Task CompleteShapeAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteShapeAsync(_productionCode, _duration);
            SetOperationResult(result, "شیپ با موفقیت انجام شد.", "ثبت پایان شیپ انجام نشد.");
        });
    }

    private async Task CompleteBakeAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteBakeAsync(_productionCode);
            SetOperationResult(result, "پخت با موفقیت انجام شد.", "ثبت پایان پخت انجام نشد.");
        });
    }

    private async Task CompleteTuneAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteTuneAsync(_productionCode, _duration);
            SetOperationResult(result, "تیون با موفقیت انجام شد.", "ثبت پایان تیون انجام نشد.");
        });
    }

    private async Task CompleteGlueAsync()
    {
        if (string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)
        {
            _error = "کد کاسه مکمل را وارد کنید.";
            return;
        }

        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteGlueAsync(
                _productionCode,
                _pairedProductionCode,
                _scaleId);
            SetOperationResult(result, "چسب‌کاری با موفقیت انجام شد و ساز وارد اتاق چسب شد.", "ثبت اتصال کاسه‌ها انجام نشد.");
        });
    }

    private async Task ReleaseFromGlueRoomAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.ReleaseFromGlueRoomAsync(_productionCode);
            SetOperationResult(result, "ساز با موفقیت از اتاق چسب خارج شد.", "ثبت خروج از اتاق چسب انجام نشد.");
        });
    }

    private async Task CompleteFinalTuneAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteFinalTuneAsync(_productionCode);
            SetOperationResult(result, "فاین تیون با موفقیت انجام شد و ساز در انتظار QC قرار گرفت.", "ثبت پایان فاین تیون انجام نشد.");
        });
    }

    private void ShowQualityControlRejection() => _showQcRejection = true;

    private async Task ApproveQualityControlAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(_productionCode, true);
            SetOperationResult(result, "QC تأیید شد و ساز به انبار منتقل شد.", "ثبت تأیید QC انجام نشد.");
        });
    }

    private async Task RejectQualityControlAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(
                _productionCode,
                false,
                _qcRejectionReason,
                _qcDetails);
            SetOperationResult(result, "عدم تأیید QC ثبت شد و ساز به در انتظار فاین تیون برگشت.", "ثبت عدم تأیید QC انجام نشد.");
        });
    }

    private void SetOperationResult(
        DimpleBowlDto? result,
        string successMessage,
        string errorMessage)
    {
        if (result is null)
        {
            _error = errorMessage;
            return;
        }

        _bowl = null;
        _successMessage = successMessage;
    }

    private void ReturnToDashboard() => Navigation.NavigateTo("/");

    private async Task ExecuteAsync(Func<Task> action)
    {
        _loading = true;
        _error = null;

        try
        {
            await action();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _bowl = null;
            _error = "کاسه‌ای با این کد پیدا نشد.";
        }
        catch (HttpRequestException ex) when (
            ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized)
        {
            _error = "این عملیات فقط برای کاربر دارای نقش مرتبط با مرحله تولید یا مدیر مجاز است.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _error = "کاسه مکمل، اسکیل معتبر و وضعیت در انتظار چسب را بررسی کنید.";
        }
        catch (HttpRequestException)
        {
            _error = "ارتباط با سرویس برقرار نشد.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string BowlTypeText(int value) =>
        value == 1 ? "کاسه بالا" : "کاسه پایین";

    private static string StageText(int value) => value switch
    {
        1 => "ثبت شده",
        2 => "در انتظار دیمپل",
        3 => "در حال دیمپل",
        4 => "در انتظار شیپ",
        5 => "در حال شیپ",
        6 => "در انتظار پخت",
        7 => "در حال پخت",
        8 => "در انتظار تیون",
        9 => "در حال تیون",
        10 => "در انتظار چسب",
        11 => "در اتاق چسب",
        12 => "در انتظار فاین تیون",
        14 => "در انتظار QC",
        18 => "انبار",
        _ => "در مرحله دیگری از تولید"
    };

    private static string PairedBowlLabel(int bowlType) =>
        bowlType == 1
            ? "کد کاسه پایین را وارد کنید"
            : "کد کاسه بالا را وارد کنید";
}

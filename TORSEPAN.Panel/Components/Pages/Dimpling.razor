@page "/dimpling"
@page "/production/process"

@using System.Net
@using TORSEPAN.Application.Materials
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject BowlService BowlService
@inject ScaleService ScaleService
@inject MaterialService MaterialService
@inject ProductionService ProductionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>تولید</PageTitle>
<section class="process-hero process-photo-hero theme-hero theme-page-intro" aria-labelledby="process-title">
    <div class="process-hero-art" aria-hidden="true"></div>
    <div class="process-hero-copy"><span dir="ltr">PRODUCTION</span><h1 id="process-title">عملیات تولید</h1></div>
</section>

@if (_showOperationConfirmation)
{
    <div class="operation-confirm-backdrop" role="presentation">
        <div class="operation-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="operation-confirm-title">
            <div class="operation-confirm-icon">✓</div>
            <div class="operation-confirm-heading">
                <small>تأیید نهایی عملیات</small>
                <h4 id="operation-confirm-title">@_confirmationTitle</h4>
                <p>لطفاً اطلاعات زیر را بررسی کنید. پس از تأیید، عملیات ثبت خواهد شد.</p>
            </div>
            <div class="operation-confirm-details">
                @foreach (var detail in _confirmationDetails)
                {
                    <div><span>@detail.Label</span><strong>@detail.Value</strong></div>
                }
            </div>
            @if (_isShapeConfirmation)
            {
                <div class="shape-collaboration mt-3 mb-3">
                    <label class="form-check small fw-semibold"><input class="form-check-input" type="checkbox" @bind="_useShapeContributors" /> ثبت عملیات توسط افراد دیگر</label>
                    @if (_useShapeContributors)
                    {
                        @foreach (var part in ShapeParts)
                        {
                            <div class="shape-part-row">
                                <label class="form-check"><input class="form-check-input" type="checkbox" checked="@part.Enabled" @onchange="e => ToggleShapePart(part.Key, (bool)e.Value!)" /> @part.Label</label>
                                @if (part.Enabled)
                                {
                                    <select class="form-select form-select-sm" value="@part.UserId" @onchange="e => SelectShapeUser(part.Key, e.Value?.ToString())">
                                        <option value="">انتخاب شیپر</option>
                                        @foreach (var user in _shapers) { <option value="@user.Id">@(string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName)</option> }
                                    </select>
                                }
                            </div>
                        }
                    }
                </div>
            }
            <div class="operation-confirm-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@_confirmingOperation" @onclick="CancelOperationConfirmation">انصراف</button>
                <button type="button" class="btn btn-success" disabled="@_confirmingOperation" @onclick="ConfirmOperationAsync">
                    @(_confirmingOperation ? "در حال ثبت..." : "تأیید و ثبت عملیات")
                </button>
            </div>
        </div>
    </div>
}

<div class="production-detail-surface">
<div class="card production-passport-page luxury-passport-page">
    <label class="form-label passport-search-label" for="passport-code">کد ساز یا کاسه را وارد کنید</label>
    <div class="input-group passport-search mb-3">
        <input id="passport-code" class="form-control" @ref="_codeInput" disabled="@(_loading || _confirmingOperation)"
               placeholder="کد ساز یا کاسه را وارد کنید"
               @bind="_productionCode"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />
        <button class="btn btn-primary" disabled="@(_loading || _confirmingOperation)" @onclick="SearchAsync">
            جست‌وجو
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <section class="process-operation-success" role="status" aria-live="polite">
            <div><span class="process-success-check" aria-hidden="true">✓</span><p>@_successMessage</p></div>
            <button type="button" @onclick="ReturnToDashboard">تأیید و بازگشت به داشبورد</button>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_bowl is not null)
    {
        var isHandpan = !string.IsNullOrWhiteSpace(_bowl.HandpanCode);
        <div class="instrument-passport @(isHandpan ? "handpan-file" : "bowl-file")">
            <div class="passport-overview">
                <section class="passport-identity" aria-label="شناسنامه ساز یا کاسه">
            <div class="passport-header"><span>TORSEPAN · @(isHandpan ? "INSTRUMENT ID" : "BOWL ID")</span></div>
            <div class="passport-primary-info">
                <div class="passport-codes">
                    <div><span>@(isHandpan ? "کد ساز" : "کد کاسه")</span><strong><bdi>@(isHandpan ? _bowl.HandpanCode : _bowl.ProductionCode)</bdi></strong></div>
                    @if (isHandpan)
                    {
                        <div class="passport-bottom-code"><span>کد کاسه زیر</span><strong><bdi>@_bowl.BottomBowlCode</bdi> <span>(@_bowl.BottomDesignName)</span></strong></div>
                    }
                    else
                    {
                        <div class="passport-bottom-code"><span>نوع کاسه</span><strong>@BowlTypeText(_bowl.BowlType)</strong></div>
                    }
                </div>
                <div class="passport-info-line passport-scale"><span class="passport-feature-icon"><PassportIcon Kind="music" /></span><div><small>Scale</small><strong dir="auto">@PassportScaleTitle</strong>
                    @if (isHandpan) { <span class="passport-note-breakdown" dir="ltr" aria-label="@($"نت کاسه رو: {_bowl.TopNoteCount?.ToString() ?? "نامشخص"}؛ نت کاسه زیر: {_bowl.BottomNoteCount?.ToString() ?? "نامشخص"}")">(@(_bowl.TopNoteCount?.ToString() ?? "نامشخص")+@(_bowl.BottomNoteCount?.ToString() ?? "نامشخص"))</span> }
                </div><span class="passport-row-chevron"><PassportIcon Kind="chevron" /></span></div>
                <div class="passport-info-line"><span class="passport-feature-icon"><PassportIcon Kind="design" /></span><div><small>Design</small><strong dir="auto">@_bowl.DesignName</strong></div><span class="passport-row-chevron"><PassportIcon Kind="chevron" /></span></div>
                <div class="passport-info-line passport-status"><span class="passport-feature-icon"><PassportIcon Kind="status" /></span><div><small>وضعیت <i class="passport-status-dot"></i></small><strong>@StageText(_bowl.Stage)</strong></div><span class="passport-row-chevron"><PassportIcon Kind="chevron" /></span></div>
                @if (!string.IsNullOrWhiteSpace(_bowl.OrderCustomerName)) { <div class="passport-info-line passport-order"><strong>سفارش @_bowl.OrderCustomerName</strong></div> }

            </div>
                </section>
                <section class="passport-media" aria-label="عکس‌های ساز">
                    @if (_bowl.HandpanId.HasValue)
                    {
                        <HandpanPhotoGallery HandpanId="@_bowl.HandpanId.Value" />
                    }
                    else
                    {
                        <div class="passport-bowl-placeholder bowl-no-photo"><img src="/images/production/handpan-no-photo.png" alt="تصویر نمونه هنگ‌درام" /><strong>بدون عکس</strong></div>
                    }
                </section>
            </div>
            <section class="passport-timeline" aria-labelledby="history-title">
                <header><h3 id="history-title"><span class="history-heading-icon"><PassportIcon Kind="clock" /></span> سوابق انجام کار</h3>
                    @if (_bowl.History.Count > 6) { <button type="button" class="history-toggle" aria-expanded="@_showAllHistory" @onclick="() => _showAllHistory = !_showAllHistory">@(_showAllHistory ? "نمایش کمتر" : "نمایش همه")</button> }
                </header>
                @if (_bowl.History.Count == 0) { <p class="history-empty">هنوز سابقه‌ای ثبت نشده است.</p> }
                @foreach (var item in _bowl.History.OrderByDescending(x => x.PerformedAt).Take(_showAllHistory ? int.MaxValue : 6))
                {
                    <article class="passport-timeline-row">
                        <div class="history-operation"><span class="history-operation-icon" data-action="@item.Action" aria-hidden="true"><PassportIcon Kind="@HistoryIcon(item.Action)" /></span><strong>@item.ActionTitle</strong></div>
                        <div class="history-people"><span class="history-person-icon"><PassportIcon Kind="user" /></span><div>
                            @if (item.BowlPerformers.Count > 0)
                            {
                                @foreach (var part in item.BowlPerformers)
                                {
                                    <div class="passport-performers">@foreach (var performer in PerformerNames(part.PerformedBy)) { <span>@part.Label: @performer</span> }</div>
                                    @if (!string.IsNullOrWhiteSpace(part.Details)) { <small>@part.Details</small> }
                                }
                            }
                            else
                            {
                                <div class="passport-performers">@foreach (var performer in PerformerNames(item.PerformedBy)) { <span>@performer</span> }</div>
                                @if (!string.IsNullOrWhiteSpace(item.Details)) { <small>@item.Details</small> }
                            }
                        </div>
                        </div>
                        <time class="passport-event-date" datetime="@item.PerformedAt.ToString("O")"><span>@PersianDateTime.FormatDate(item.PerformedAt)</span><small>@PersianDateTime.FormatTime(item.PerformedAt)</small></time>
                    </article>
                }
            </section>

            @if (_bowl.InstrumentNotes.Count > 0)
            {
                <div class="alert alert-warning instrument-note-display mt-3"><strong>یادداشت مهم این ساز</strong><ul class="mb-0 mt-2">@foreach(var note in _bowl.InstrumentNotes){<li>@note</li>}</ul></div>
            }
            <section class="passport-operation" aria-label="عملیات مرحله جاری">
                <div class="passport-operation-title"><span class="operation-gear"><PassportIcon Kind="gear" /></span><div><small>مرحله جاری</small><h3>@StageActionTitle(_bowl.Stage)</h3></div></div>
            @if (_bowl.Stage is >= 4 and <= 11)
            {
                @if (_bowl.Notes.Count > 0)
                {
                    <div class="alert alert-info mt-3"><strong>توضیحات مراحل قبلی</strong><ul class="mb-0 mt-2">@foreach(var note in _bowl.Notes){<li>@note</li>}</ul></div>
                }
                @if (_bowl.Stage is not (4 or 8))
                {
                    <div class="mt-3"><label class="form-label">توضیحات این مرحله (اختیاری)</label><textarea class="form-control" rows="3" @bind="_stageNote" placeholder="اگر نکته‌ای برای همکار مرحله بعد وجود دارد اینجا بنویسید..."></textarea></div>
                }
            }

            @if (_bowl.Stage == 2)
            {
                <section class="stage-workspace">
                    <header class="stage-workspace-header"><span class="stage-workspace-number">۱</span><div><small>مرحله جاری</small><h4>ثبت پایان دیمپل</h4><p>زمان انجام دیمپل را ثبت کنید.</p></div></header>
                    <div class="stage-workspace-body"><div class="stage-fields">
                        <label class="stage-field"><span>مدت زمان انجام دیمپل *</span>
                        <CompactPicker TValue="int" @bind-Value="_duration" Options="DurationOptions" Title="مدت زمان انجام کار" />
                        </label>
                    </div></div>
                    <footer class="stage-workspace-actions">
                        <button class="stage-submit"
                                disabled="@_loading"
                                @onclick="CompleteAsync">
                            <strong>دیمپل انجام شد</strong><span>ثبت و انتقال به مرحله شیپ</span>
                        </button>
                    </footer>
                </section>
            }
            else if (_bowl.Stage == 4)
            {
                <section class="stage-workspace shape-workspace compact-stage-workspace">
                    <header class="stage-workspace-header"><span class="stage-workspace-number">۲</span><div><small>مرحله جاری</small><h4>ثبت پایان شیپ</h4></div></header>
                    <div class="stage-workspace-body"><div class="stage-fields">
                        <label class="stage-field shape-duration"><span>مدت زمان انجام شیپ *</span>
                        <CompactPicker TValue="int" @bind-Value="_duration" Options="DurationOptions" Title="مدت زمان انجام کار" />
                        </label>
                        <label class="stage-field"><span>اسکیل کاسه @(_bowl.BowlType == 1 ? "*" : "")</span>
                            <CompactPicker TValue="Guid" @bind-Value="_scaleId" Options="ScaleOptions" Title="انتخاب اسکیل" />
                        </label>
                        <label class="stage-field"><span>تعداد نوت *</span>
                            <input class="form-control" type="number" min="@(_bowl.BowlType == 1 ? 1 : 0)" step="1" @bind="_noteCount" />
                        </label>
                        <label class="stage-field stage-field-wide"><span class="stage-field-title"><span>توضیحات این مرحله</span><small>اختیاری</small></span><textarea class="form-control stage-note" rows="2" @bind="_stageNote" placeholder="توضیحات مرحله..."></textarea></label>
                    </div></div>
                    <footer class="stage-workspace-actions">
                        <button class="stage-submit"
                                disabled="@(_loading || (_bowl.BowlType == 1 && _scaleId == Guid.Empty) || !_noteCount.HasValue || _noteCount < (_bowl.BowlType == 1 ? 1 : 0))"
                                @onclick="CompleteShapeAsync">
                            <strong>شیپ انجام شد</strong>
                        </button>
                    </footer>
                </section>
            }
            else if (_bowl.Stage == 6)
            {
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompleteBakeAsync">
                    پخت انجام شد
                </button>
            }
            else if (_bowl.Stage == 8)
            {
                <section class="stage-workspace tune-workspace compact-stage-workspace">
                    <header class="stage-workspace-header"><span class="stage-workspace-number">۴</span><div><small>مرحله جاری</small><h4>ثبت پایان تیون</h4></div></header>
                    <div class="stage-workspace-body">
                        <div class="stage-fields">
                            <label class="stage-field stage-field-wide"><span>مدت زمان انجام تیون</span>
                        <CompactPicker TValue="int" @bind-Value="_duration" Options="DurationOptions" Title="مدت زمان انجام کار" />
                            </label>
                            <label class="stage-field stage-field-wide"><span class="stage-field-title"><span>توضیحات این مرحله</span><small>اختیاری</small></span><textarea class="form-control stage-note" rows="2" @bind="_stageNote" placeholder="توضیحات مرحله..."></textarea></label>
                        </div>
                        <div class="stage-route-heading"><strong>مرحله بعدی را انتخاب کنید</strong></div>
                        <div class="stage-route-actions">
                            <button type="button" class="stage-route-action" disabled="@_loading" @onclick="CompleteTuneAsync"><strong>ادامه ساخت ساز</strong><span>ارسال کاسه به مرحله چسب</span></button>
                            <button type="button" class="stage-route-action" disabled="@_loading" @onclick="CompleteTuneForExportAsync"><strong>بسته‌بندی صادراتی</strong><span>ارسال مستقیم به بسته‌بندی صادراتی</span></button>
                        </div>
                    </div>
                </section>
            }
            else if (_bowl.Stage == 21)
            {
                <div class="alert alert-info mt-3">این کاسه برای بسته‌بندی صادراتی آماده است.</div>
                <div class="export-location-picker mt-3"><strong>انبار مقصد را انتخاب کنید</strong><div class="export-location-options">@foreach(var location in ExportLocations){<button type="button" class="@ExportLocationClass(location.Id)" @onclick="()=>_exportWarehouseLocation=location.Id"><span>@location.Icon</span><b>@location.Name</b></button>}</div></div>
                <button class="btn btn-success mt-3" disabled="@(_loading || !_exportWarehouseLocation.HasValue)" @onclick="CompleteExportPackagingAsync">
                    بسته‌بندی صادراتی انجام شد
                </button>
                <button class="btn btn-outline-primary mt-3 me-2" disabled="@_loading" @onclick="AskReturnExportBowlToGlue">
                    ارسال به چسب و ادامه ساخت ساز
                </button>
            }
            else if (_bowl.Stage == 10)
            {
                <AuthorizeView Roles="Workshop,Tuner,Administrator,ProductionManager" Context="exportRouteAuth">
                    <details class="mt-3 small text-muted">
                        <summary style="cursor:pointer;width:fit-content">گزینه‌های بیشتر</summary>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" disabled="@_loading" @onclick="AskSendGlueBowlToExport">ارسال به انبار صادراتی</button>
                    </details>
                </AuthorizeView>
                <div class="mt-3">
                    <label class="form-label">@PairedBowlLabel(_bowl.BowlType)</label>
                    <input class="form-control"
                           placeholder="کد کاسه مکمل را وارد کنید"
                           @bind="_pairedProductionCode"
                           @bind:event="oninput" />
                    <label class="form-label mt-3">اسکیل ساز</label>
                        <CompactPicker TValue="Guid" @bind-Value="_scaleId" Options="GlueScaleOptions" Title="انتخاب اسکیل" />
                    <button class="btn btn-success mt-3"
                            disabled="@(_loading || string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)"
                            @onclick="CompleteGlueAsync">
                        چسب انجام شد
                    </button>
                </div>
            }
            else if (_bowl.Stage == 11)
            {
                <div class="alert alert-info mt-3">
                    این ساز در اتاق چسب قرار دارد.
                </div>
                <button class="btn btn-success"
                        disabled="@_loading"
                        @onclick="ReleaseFromGlueRoomAsync">
                    از اتاق چسب خارج شد
                </button>
            }
            else if (_bowl.Stage == 12)
            {
                <section class="stage-workspace">
                    <header class="stage-workspace-header"><span class="stage-workspace-number">۶</span><div><small>مرحله جاری</small><h4>ثبت پایان فاین تیون</h4><p>اطلاعات نهایی تیون ساز را پیش از ارسال به کنترل کیفیت ثبت کنید.</p></div></header>
                    <div class="stage-workspace-body"><div class="stage-fields">
                        <label class="stage-field stage-field-wide"><span>مدت زمان انجام فاین تیون</span>
                        <CompactPicker TValue="int" @bind-Value="_duration" Options="DurationOptions" Title="مدت زمان انجام کار" />
                        </label>
                        <label class="stage-field stage-field-wide"><span class="stage-field-title"><span>یادداشت مخصوص این ساز</span><small>اختیاری</small></span><textarea class="form-control stage-note" rows="4" @bind="_instrumentNote" placeholder="این یادداشت در پرونده ساز همیشه نمایش داده می‌شود..."></textarea></label>
                    </div></div>
                    <footer class="stage-workspace-actions">
                        <button class="stage-submit"
                        disabled="@_loading"
                        @onclick="CompleteFinalTuneAsync">
                            <strong>فاین تیون انجام شد</strong><span>ثبت و ارسال ساز به کنترل کیفیت</span>
                        </button>
                    </footer>
                </section>
            }
            else if (_bowl.Stage == 14)
            {
                <div class="mt-3">
                    <section class="qc-warehouse-picker" aria-label="انتخاب انبار پس از کنترل کیفیت">
                        <h3>انبار مقصد را انتخاب کنید</h3>
                        @if (_qualityWarehouses.Count == 0)
                        { <div class="alert alert-warning">دریافت انبارها انجام نشد. <button class="btn btn-sm btn-outline-primary" @onclick="LoadQualityWarehousesAsync">تلاش دوباره</button></div> }
                        <div class="qc-warehouse-options" role="radiogroup" aria-label="انبار مقصد">
                            @foreach (var warehouse in _qualityWarehouses)
                            { <label class="qc-warehouse-option @(!_sendToExportWarehouse && _qualityWarehouseId==warehouse.Id ? "selected" : null)"><input type="radio" name="qc-warehouse" checked="@(!_sendToExportWarehouse && _qualityWarehouseId==warehouse.Id)" @onchange="()=>SelectQcWarehouse(warehouse.Id)" /><strong dir="auto">@warehouse.Name</strong></label> }
                            <label class="qc-warehouse-option @(_sendToExportWarehouse ? "selected" : null)"><input type="radio" name="qc-warehouse" checked="@_sendToExportWarehouse" @onchange="SelectQcExport" /><strong>صادراتی</strong></label>
                        </div>
                        @if (_sendToExportWarehouse)
                        { <div class="qc-export-options" role="group" aria-label="مقصد صادراتی">@foreach(var location in ExportLocations){<button type="button" aria-pressed="@(_exportWarehouseLocation==location.Id ? "true" : "false")" class="@ExportLocationClass(location.Id)" @onclick="()=>_exportWarehouseLocation=location.Id">@location.Name</button>}</div> }
                    </section>
                    <div class="qc-actions">
                        <button class="btn btn-success qc-approve" disabled="@(_loading || (_sendToExportWarehouse ? !_exportWarehouseLocation.HasValue : !_qualityWarehouseId.HasValue))" @onclick="ApproveQualityControlAsync">QC تأیید شد</button>
                        <button class="btn btn-warning qc-reject" disabled="@_loading" @onclick="ShowQualityControlRejection">QC تأیید نشد</button>
                    </div>

                    @if (_showQcRejection)
                    {
                        <label class="form-label">دلیل تأیید نشدن</label>
                        <select class="form-select" @bind="_qcRejectionReason">
                            <option value="OutOfTune">کوک نبودن</option>
                            <option value="Appearance">وضعیت ظاهری</option>
                            <option value="Other">سایر موارد</option>
                        </select>

                        @if (_qcRejectionReason == "Other")
                        {
                            <label class="form-label mt-3">توضیحات سایر موارد</label>
                            <textarea class="form-control" rows="3" @bind="_qcDetails"></textarea>
                        }

                        <button class="btn btn-danger mt-3"
                                disabled="@(_loading || (_qcRejectionReason == "Other" && string.IsNullOrWhiteSpace(_qcDetails)))"
                                @onclick="RejectQualityControlAsync">
                            ثبت عدم تأیید و بازگشت به فاین تیون
                        </button>
                    }
                </div>
            }
            else if (_bowl.Stage == 16)
            {
                <div class="packaging-picker mt-3">
                    <div class="packaging-heading"><div><h5>اقلام بسته‌بندی عادی</h5><p>مثلثی: دو عدد؛ سایر اقلام: یک عدد از انبار کم می‌شود.</p></div><span>@_selectedPackagingMaterialIds.Count انتخاب</span><button type="button" class="btn btn-sm btn-outline-primary" disabled="@_loading" @onclick="ReloadPackagingMaterialsAsync">به‌روزرسانی اقلام</button></div>
                    <div class="packaging-accessories">
                        @foreach (var material in OtherPackagingMaterials)
                        {
                            <label class="packaging-option @(_selectedPackagingMaterialIds.Contains(material.Id)?"selected":"") @(material.Quantity < PackagingMaterialConsumption.RequiredQuantity(material.Name)?"disabled":"")">
                                <input type="checkbox" disabled="@(_loading || (material.Quantity < PackagingMaterialConsumption.RequiredQuantity(material.Name) && !_selectedPackagingMaterialIds.Contains(material.Id)))" checked="@_selectedPackagingMaterialIds.Contains(material.Id)" @onchange="e => TogglePackagingMaterial(material.Id, e.Value as bool? == true)" />
                                <span class="packaging-check">✓</span><strong>@material.Name</strong><small>موجودی @material.Quantity · مصرف @PackagingMaterialConsumption.RequiredQuantity(material.Name)</small>
                            </label>
                        }
                    </div>
                    <div class="case-picker"><div class="case-picker-title"><strong>نوع کاور ساز</strong><small>فقط یک مورد انتخاب می‌شود</small></div><div class="case-options">
                        @foreach (var material in CasePackagingMaterials)
                        {
                            <label class="case-option @(_selectedPackagingMaterialIds.Contains(material.Id)?"selected":"") @(material.Quantity < PackagingMaterialConsumption.RequiredQuantity(material.Name)?"disabled":"")">
                                <input type="radio" name="packaging-case" disabled="@(_loading || material.Quantity < PackagingMaterialConsumption.RequiredQuantity(material.Name))" checked="@_selectedPackagingMaterialIds.Contains(material.Id)" @onchange="_ => TogglePackagingMaterial(material.Id, true)" />
                                <span>@material.Name</span><small>@material.Quantity موجود</small>
                            </label>
                        }
                    </div></div>
                </div>
                @if (PackagingStockInsufficient)
                { <p class="alert alert-warning mt-2">موجودی بعضی اقلام انتخاب‌شده کافی نیست؛ موجودی را تأمین کنید یا تیک آن اقلام را بردارید.</p> }
                @if (_bowl.PackagingExportLocation.HasValue)
                { <p class="packaging-destination">مقصد انتخاب‌شده در QC: انبار صادراتی @ExportLocationName(_bowl.PackagingExportLocation.Value)</p> }
                <button class="btn btn-success mt-3"
                        disabled="@(_loading || PackagingStockInsufficient || (_sendToExportWarehouse && !_exportWarehouseLocation.HasValue))"
                        @onclick="CompletePackagingAsync">
                    بسته‌بندی عادی انجام شد
                </button>
            }
            else if (_bowl.Stage == 18)
            {
                <div class="alert alert-success mt-3 mb-0">
                    این ساز در انبار است. تاریخ بسته‌بندی و سایر مراحل انجام‌شده در جدول بالا نمایش داده شده‌اند.
                </div>
                <AuthorizeView Roles="Administrator,ProductionManager,SalesAdmin">
                    <button class="btn btn-success mt-3" @onclick="OpenPassportSale">فروخته شد</button>
                </AuthorizeView>
            }
            @if (_bowl.Stage is 14 or 16 or 18 or 20)
            {
                <div class="instrument-note-editor mt-3"><label class="form-label fw-bold">@(_bowl.Stage is 18 or 20 ? "افزودن یادداشت به شناسنامه ساز" : "یادداشت مخصوص این ساز (اختیاری)")</label><textarea class="form-control" rows="4" @bind="_instrumentNote" placeholder="این یادداشت در پرونده ساز همیشه نمایش داده می‌شود."></textarea>@if (_bowl.Stage is 18 or 20) { <button class="btn btn-primary mt-2" disabled="@string.IsNullOrWhiteSpace(_instrumentNote)" @onclick="SaveInstrumentNoteAsync">ثبت یادداشت در شناسنامه</button> }</div>
            }
            else if (_bowl.Stage == 22)
            {
                <div class="alert alert-success mt-3 mb-0">این کاسه در انبار صادراتی است.</div>
            }
            </section>
        </div>
    }
</div>

</div>

@if (_showPassportSale && _bowl?.HandpanId is Guid saleHandpanId)
{
    <div class="sale-overlay" @onclick="ClosePassportSale"><section class="sale-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <header><div><span class="sale-eyebrow">ثبت فروش از شناسنامه</span><h3>فروش ساز @_bowl.HandpanCode</h3></div><button class="sale-close" @onclick="ClosePassportSale">×</button></header>
        <div class="sale-hint">تمام اطلاعات زیر اختیاری است و بدون تکمیل آن‌ها نیز فروش ثبت می‌شود.</div>
        <div class="sale-fields">
            <label><span>نام خریدار</span><input class="form-control" @bind="_passportBuyer" placeholder="اختیاری" /></label>
            <label><span>قیمت</span><input type="number" min="0" class="form-control" @bind="_passportPrice" placeholder="اختیاری" /></label>
            <label><span>مقصد</span><input class="form-control" @bind="_passportDestination" placeholder="اختیاری" /></label>
        </div>
        @if(!string.IsNullOrWhiteSpace(_passportSaleError)){<div class="sale-error">@_passportSaleError</div>}
        <footer><button class="btn btn-light" disabled="@_passportSaleSaving" @onclick="ClosePassportSale">انصراف</button><button class="btn btn-success" disabled="@_passportSaleSaving" @onclick="()=>SellFromPassportAsync(saleHandpanId)">ثبت فروش</button></footer>
    </section></div>
}

@code {
    private bool _showAllHistory;
    private string PassportScaleTitle
    {
        get
        {
            if (_bowl is null) return string.Empty;
            if (string.IsNullOrWhiteSpace(_bowl.HandpanCode) || _bowl.TopNoteCount is not int top || _bowl.BottomNoteCount is not int bottom)
                return _bowl.ScaleName;
            var name = System.Text.RegularExpressions.Regex.Replace(_bowl.ScaleName, @"\s*[—–-]\s*تعداد نت نامشخص\s*$", "");
            var family = TORSEPAN.Domain.Entities.ScaleFamilyNames.Parse(name).FamilyName;
            return string.IsNullOrWhiteSpace(family) || family is "نامشخص" or "تعیین نشده" or "بدون اسکیل"
                ? $"{top + bottom} نت" : $"{family} {top + bottom}";
        }
    }

    private static string StageActionTitle(int stage) => stage switch { 2 => "ثبت دیمپل", 4 => "ثبت شیپ", 6 => "ثبت پخت", 8 => "ثبت تیون", 10 => "ثبت چسب", 11 => "خروج از اتاق چسب", 12 => "ثبت فاین تیون", 14 => "ثبت کنترل کیفیت", 16 => "ثبت بسته‌بندی", 21 => "ثبت بسته‌بندی صادراتی", 18 or 20 or 22 => "پرونده و وضعیت ساز", _ => StageText(stage) };
    private static string HistoryIcon(int action) => action switch { 1 => "document", 2 => "dots", 3 => "hammer", 4 => "fire", 5 => "cube", 6 or 7 => "notes", 8 => "status", 9 => "cube", _ => "document" };

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private string _productionCode = string.Empty;
    private string? _error;
    private DimpleBowlDto? _bowl;
    private bool _loading;
    private (Guid Value, string Text)[] ScaleOptions => new[] { (Guid.Empty, "انتخاب کنید...") }.Concat(_scales.Select(x => (x.Id, x.Name))).ToArray();
    private (Guid Value, string Text)[] GlueScaleOptions => new[] { (Guid.Empty, "انتخاب کنید...") }.Concat(GlueScales.Select(x => (x.Id, x.Name))).ToArray();
    private int _duration = 1;
    private string _pairedProductionCode = string.Empty;
    private Guid _scaleId;
    private int? _noteCount;
    private readonly List<ScaleDto> _scales = [];
    private IEnumerable<ScaleDto> GlueScales => _scales.Where(x => TORSEPAN.Domain.Entities.ScaleFamilyNames.Parse(x.Name) is { FamilyName: not null, NoteCount: null });
    private readonly List<MaterialDto> _packagingMaterials = [];
    private IEnumerable<MaterialDto> CasePackagingMaterials => _packagingMaterials.Where(x => IsExclusiveCase(x.Name)).OrderBy(x => CaseOrder(x.Name)).ThenBy(x => x.Name);
    private IEnumerable<MaterialDto> OtherPackagingMaterials => _packagingMaterials.Where(x => !IsExclusiveCase(x.Name)).OrderBy(x => AccessoryOrder(x.Name)).ThenBy(x => x.Name);
    private readonly HashSet<Guid> _selectedPackagingMaterialIds = [];
    private bool PackagingStockInsufficient => _packagingMaterials.Any(x => _selectedPackagingMaterialIds.Contains(x.Id) && x.Quantity < PackagingMaterialConsumption.RequiredQuantity(x.Name));
    private bool _sendToExportWarehouse;
    private int? _exportWarehouseLocation;
    private static readonly (int Id, string Name, string Icon)[] ExportLocations = [(4, "ایران", "IR"), (1, "ترکیه", "TR"), (2, "لندن", "UK"), (3, "آلمان", "DE")];
    private string? _successMessage;
    private ElementReference _codeInput;
    private bool _focusCodeAfterOperation;
    private bool _showPassportSale, _passportSaleSaving;
    private string _passportBuyer = string.Empty, _passportDestination = string.Empty;
    private string? _passportSaleError;
    private decimal? _passportPrice;
    private bool _showQcRejection;
    private string _qcRejectionReason = "OutOfTune";
    private string _qcDetails = string.Empty;
    private int? _qualityWarehouseId;
    private List<InstrumentWarehouseDto> _qualityWarehouses = [];
    private string _stageNote = string.Empty;
    private string _instrumentNote = string.Empty;
    private readonly List<ShaperDto> _shapers = [];
    private bool _isShapeConfirmation;
    private bool _useShapeContributors;
    private readonly List<ShapePart> ShapeParts = [new("Stretch", "کشش"), new("NoteArea", "دورنوت"), new("Edit", "Edit")];
    private bool _showOperationConfirmation;
    private bool _confirmingOperation;
    private string _confirmationTitle = string.Empty;
    private List<ConfirmationDetail> _confirmationDetails = [];
    private Func<Task>? _confirmedOperation;

    private static readonly (int Value, string Text)[] DurationOptions =
    [
        (1, "۵ دقیقه"), (2, "۱۰ دقیقه"), (3, "۱۵ دقیقه"),
        (4, "۲۰ دقیقه"), (5, "۲۵ دقیقه"), (6, "۳۰ دقیقه"),
        (7, "۳۵ دقیقه"), (8, "۴۰ دقیقه"), (9, "۴۵ دقیقه"),
        (10, "۵۰ دقیقه"), (11, "۵۵ دقیقه"), (12, "۶۰ دقیقه"),
        (13, "بیشتر از ۶۰ دقیقه")
    ];

    protected override async Task OnInitializedAsync()
    {
        _scales.AddRange(await ScaleService.GetAsync());
        await LoadPackagingMaterialsAsync();
        try { _shapers.AddRange(await BowlService.GetShapersAsync()); } catch { }
        if (_scales.Count > 0)
            _scaleId = _scales[0].Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Code) && Code != _productionCode)
        {
            _productionCode = Code;
            await SearchAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (_loading || _confirmingOperation || _showOperationConfirmation) return;
        if (string.IsNullOrWhiteSpace(_productionCode))
        {
            _error = "کد ساز یا کاسه را وارد کنید.";
            return;
        }

        await ExecuteAsync(async () =>
        {
            _showAllHistory = false;
            _pairedProductionCode = string.Empty;
            _successMessage = null;
            _showQcRejection = false;
            _qualityWarehouseId = null;
            _stageNote = string.Empty;
            _instrumentNote = string.Empty;
            _sendToExportWarehouse = false;
            _exportWarehouseLocation = null;
            _selectedPackagingMaterialIds.Clear();
            _bowl = await BowlService.GetForDimplingAsync(_productionCode);
            if (_bowl?.Stage == 14) await LoadQualityWarehousesAsync();
            if (_bowl?.Stage == 16)
            {
                _sendToExportWarehouse = _bowl.PackagingExportLocation.HasValue;
                _exportWarehouseLocation = _bowl.PackagingExportLocation;
                await LoadPackagingMaterialsAsync();
                SelectDefaultPackagingMaterials();
            }
            _scaleId = Guid.Empty;
            _noteCount = null;
            if (_bowl is null)
                _error = "کاسه پیدا نشد.";
        });
    }

    private Task CompleteAsync()
    {
        ShowOperationConfirmation("دیمپل انجام شد",
            [("کد کاسه", _productionCode), ("مدت زمان", DurationText())],
            CompleteDimpleConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteDimpleConfirmedAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteDimplingAsync(_productionCode, _duration, Guid.Empty);
            SetOperationResult(result, "دیمپل با موفقیت انجام شد.", "ثبت پایان دیمپل انجام نشد.");
        });
    }

    private Task CompleteShapeAsync()
    {
        _isShapeConfirmation = true;
        ShowOperationConfirmation("شیپ انجام شد",
            [("کد کاسه", _productionCode), ("Scale کاسه", SelectedScaleName()), ("تعداد نوت", _noteCount?.ToString() ?? ""), ("مدت زمان", DurationText())],
            CompleteShapeConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteShapeConfirmedAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            Guid? UserFor(string key) => _useShapeContributors ? ShapeParts.First(x => x.Key == key).SelectedUserId : null;
            var result = await BowlService.CompleteShapeAsync(_productionCode, _duration, _scaleId == Guid.Empty ? null : _scaleId, UserFor("Stretch"), UserFor("NoteArea"), UserFor("Edit"), _noteCount);
            SetOperationResult(result, "شیپ با موفقیت انجام شد.", "ثبت پایان شیپ انجام نشد.");
        });
    }

    private async Task CompleteBakeAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteBakeAsync(_productionCode);
            SetOperationResult(result, "پخت با موفقیت انجام شد.", "ثبت پایان پخت انجام نشد.");
        });
    }

    private Task CompleteTuneAsync()
    {
        ShowOperationConfirmation("تیون انجام شد",
            [("کد کاسه", _productionCode), ("Scale کاسه", _bowl?.ScaleName ?? "نامشخص"), ("مدت زمان", DurationText())],
            CompleteTuneConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteTuneConfirmedAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteTuneAsync(_productionCode, _duration);
            SetOperationResult(result, "تیون با موفقیت انجام شد.", "ثبت پایان تیون انجام نشد.");
        });
    }

    private Task AskSendGlueBowlToExport()
    {
        ShowOperationConfirmation("ارسال به انبار صادراتی",
            [("کد کاسه", _productionCode), ("مرحله بعد", "بسته‌بندی صادراتی")],
            SendGlueBowlToExportConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task SendGlueBowlToExportConfirmedAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.SendGlueBowlToExportAsync(_productionCode);
            SetOperationResult(result, "کاسه به مسیر بسته‌بندی صادراتی منتقل شد.", "انتقال به مسیر صادراتی انجام نشد.");
        });
    }

    private Task CompleteTuneForExportAsync()
    {
        ShowOperationConfirmation("تیون و ارسال به بسته‌بندی صادراتی",
            [("کد کاسه", _productionCode), ("Scale کاسه", _bowl?.ScaleName ?? "نامشخص"), ("مدت زمان", DurationText()), ("مسیر", "بسته‌بندی صادراتی")],
            CompleteTuneForExportConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteTuneForExportConfirmedAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteTuneForExportAsync(_productionCode, _duration);
            SetOperationResult(result, "تیون انجام شد و کاسه برای بسته‌بندی صادراتی آماده است.", "ثبت مسیر صادراتی انجام نشد.");
        });
    }

    private Task CompleteExportPackagingAsync()
    {
        if (!_exportWarehouseLocation.HasValue) { _error = "انبار مقصد را انتخاب کنید."; return Task.CompletedTask; }
        ShowOperationConfirmation("تأیید بسته‌بندی صادراتی",
            [("کد کاسه", _productionCode), ("Scale کاسه", _bowl?.ScaleName ?? "نامشخص"), ("انبار مقصد", ExportLocationName(_exportWarehouseLocation.Value))],
            CompleteExportPackagingConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteExportPackagingConfirmedAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteExportPackagingAsync(_productionCode, _exportWarehouseLocation!.Value);
            SetOperationResult(result, "بسته‌بندی انجام شد و کاسه وارد انبار صادراتی شد.", "ثبت بسته‌بندی صادراتی انجام نشد.");
        });
    }

    private async Task CompleteGlueAsync()
    {
        if (string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)
        {
            _error = "کد کاسه مکمل را وارد کنید.";
            return;
        }

        DimpleBowlDto? paired;
        try { paired = await BowlService.GetForDimplingAsync(_pairedProductionCode); }
        catch { _error = "بازیابی اطلاعات کاسه مکمل ممکن نشد."; return; }
        if (paired is null || paired.Stage != 10 || paired.BowlType == _bowl?.BowlType)
        { _error = "کاسه مکمل باید از نوع مقابل و آمادهٔ چسب باشد."; return; }
        var topNotes = _bowl?.BowlType == 1 ? _bowl.NoteCount : paired.NoteCount;
        var bottomNotes = _bowl?.BowlType == 2 ? _bowl.NoteCount : paired.NoteCount;
        var totalNotes = topNotes.HasValue && bottomNotes.HasValue ? (long?)topNotes.Value + bottomNotes.Value : null;
        var topCode = _bowl?.BowlType == 1 ? _productionCode : _pairedProductionCode;
        var bottomCode = _bowl?.BowlType == 1 ? _pairedProductionCode : _productionCode;
        ShowOperationConfirmation("چسب انجام شد",
            [("کد کاسه بالا", topCode), ("کد کاسه پایین", bottomCode), ("اسکیل ساز", SelectedScaleName()), ("نت رو", topNotes?.ToString() ?? "نامشخص"), ("نت زیر", bottomNotes?.ToString() ?? "نامشخص"), ("مجموع نت ساز", totalNotes?.ToString() ?? "نامشخص")],
            CompleteGlueConfirmedAsync);
        return;
    }

    private async Task CompleteGlueConfirmedAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteGlueAsync(
                _productionCode,
                _pairedProductionCode,
                _scaleId);
            SetOperationResult(result, "چسب‌کاری با موفقیت انجام شد و ساز وارد اتاق چسب شد.", "ثبت اتصال کاسه‌ها انجام نشد.");
        });
    }

    private async Task ReleaseFromGlueRoomAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.ReleaseFromGlueRoomAsync(_productionCode);
            SetOperationResult(result, "ساز با موفقیت از اتاق چسب خارج شد.", "ثبت خروج از اتاق چسب انجام نشد.");
        });
    }

    private Task CompleteFinalTuneAsync()
    {
        ShowOperationConfirmation("فاین تیون انجام شد",
            [("کد ساز", _productionCode), ("Scale ساز", _bowl?.ScaleName ?? "نامشخص"), ("مدت زمان", DurationText())],
            CompleteFinalTuneConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompleteFinalTuneConfirmedAsync()
    {
        await SaveInstrumentNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteFinalTuneAsync(_productionCode, _duration);
            SetOperationResult(result, "فاین تیون با موفقیت انجام شد و ساز در انتظار QC قرار گرفت.", "ثبت پایان فاین تیون انجام نشد.");
        });
    }

    private void ShowQualityControlRejection() => _showQcRejection = true;

    private async Task LoadQualityWarehousesAsync()
    {
        try { _qualityWarehouses=await ProductionService.GetInstrumentWarehousesAsync(); }
        catch { _qualityWarehouses=[]; }
    }
    private static string QualityTierDescription(int id) => id switch {1=>"ردهٔ اقتصادی",2=>"کیفیت بالاتر؛ ردهٔ میانی",_=>"کیفیت ممتاز و منتخب"};
    private async Task ApproveQualityControlAsync()
    {
        if (_sendToExportWarehouse ? !_exportWarehouseLocation.HasValue : !_qualityWarehouseId.HasValue) { _error="انبار مقصد ساز را انتخاب کنید."; return; }
        await SaveInstrumentNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(_productionCode, true, qualityWarehouseId: _qualityWarehouseId, exportWarehouseLocation: _sendToExportWarehouse ? _exportWarehouseLocation : null);
            SetOperationResult(result, "QC تأیید شد و ساز در انتظار بسته‌بندی قرار گرفت.", "ثبت تأیید QC انجام نشد.");
        });
    }

    private async Task RejectQualityControlAsync()
    {
        await SaveInstrumentNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(
                _productionCode,
                false,
                _qcRejectionReason,
                _qcDetails);
            SetOperationResult(result, "عدم تأیید QC ثبت شد و ساز به در انتظار فاین تیون برگشت.", "ثبت عدم تأیید QC انجام نشد.");
        });
    }

    private Task CompletePackagingAsync()
    {
        if (_sendToExportWarehouse && !_exportWarehouseLocation.HasValue) { _error = "برای ارسال صادراتی، انبار مقصد را انتخاب کنید."; return Task.CompletedTask; }
        var selectedItems = _packagingMaterials
            .Where(x => _selectedPackagingMaterialIds.Contains(x.Id))
            .Select(x => x.Name).ToList();
        ShowOperationConfirmation("تأیید بسته‌بندی ساز",
            [("کد ساز", _productionCode), ("Scale ساز", _bowl?.ScaleName ?? "نامشخص"),
             ("اقلام انتخاب‌شده", selectedItems.Count == 0 ? "بدون اقلام جانبی" : string.Join("، ", selectedItems)),
             ("نتیجه", _sendToExportWarehouse ? $"ورود به انبار {ExportLocationName(_exportWarehouseLocation!.Value)}" : "ورود ساز به انبار داخلی")],
            CompletePackagingConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task CompletePackagingConfirmedAsync()
    {
        await SaveInstrumentNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompletePackagingAsync(_productionCode, _selectedPackagingMaterialIds, _sendToExportWarehouse ? _exportWarehouseLocation : null);
            SetOperationResult(result, _sendToExportWarehouse ? "بسته‌بندی انجام شد و ساز وارد انبار صادراتی شد." : "بسته‌بندی عادی انجام شد و ساز وارد انبار شد.", "ثبت پایان بسته‌بندی انجام نشد.");
        });
    }

    private string ExportLocationClass(int id) => _exportWarehouseLocation == id ? "export-location active" : "export-location";
    private static string ExportLocationName(int id) => ExportLocations.First(x => x.Id == id).Name;

    private void TogglePackagingMaterial(Guid id, bool selected)
    {
        if (selected)
        {
            var selectedItem = _packagingMaterials.FirstOrDefault(x => x.Id == id);
            if (selectedItem is not null && IsExclusiveCase(selectedItem.Name))
            {
                foreach (var otherCase in _packagingMaterials.Where(x => x.Id != id && IsExclusiveCase(x.Name)))
                    _selectedPackagingMaterialIds.Remove(otherCase.Id);
            }
            _selectedPackagingMaterialIds.Add(id);
        }
        else
            _selectedPackagingMaterialIds.Remove(id);
    }

    private async Task SaveStageNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_stageNote)) return;
        await BowlService.AddProductionNoteAsync(_productionCode, _stageNote.Trim());
        _stageNote = string.Empty;
    }

    private Task AskReturnExportBowlToGlue()
    {
        ShowOperationConfirmation("بازگشت به مسیر ساخت ساز",
            [("کد کاسه", _productionCode), ("مرحله جدید", "آماده چسب")], ReturnExportBowlToGlueConfirmedAsync);
        return Task.CompletedTask;
    }

    private async Task ReturnExportBowlToGlueConfirmedAsync()
    {
        _loading=true;
        try { var result=await BowlService.ReturnExportBowlToGlueAsync(_productionCode); SetOperationResult(result,"کاسه به مرحله آماده چسب منتقل شد.","ارسال کاسه به چسب انجام نشد."); }
        finally { _loading=false; }
    }

    private async Task SaveInstrumentNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_instrumentNote)) return;
        await BowlService.AddInstrumentNoteAsync(_productionCode, _instrumentNote.Trim());
        _instrumentNote = string.Empty;
        await SearchAsync();
    }

    private void ToggleShapePart(string key, bool enabled) { var part = ShapeParts.First(x => x.Key == key); part.Enabled = enabled; if (!enabled) part.UserId = null; }
    private void SelectShapeUser(string key, string? value) => ShapeParts.First(x => x.Key == key).UserId = Guid.TryParse(value, out var id) ? id : null;

    private void SelectQcWarehouse(int id) { _qualityWarehouseId = id; _sendToExportWarehouse = false; _exportWarehouseLocation = null; }
    private void SelectQcExport() { _qualityWarehouseId = null; _sendToExportWarehouse = true; _exportWarehouseLocation = null; }
    private void SelectDefaultPackagingMaterials()
    {
        foreach (var material in OtherPackagingMaterials)
            _selectedPackagingMaterialIds.Add(material.Id);
        var softCase = CasePackagingMaterials.FirstOrDefault(x => x.Name.Trim().ToLowerInvariant() is "سافت کیس" or "soft case");
        if (softCase is not null) TogglePackagingMaterial(softCase.Id, true);
    }

    private async Task LoadPackagingMaterialsAsync()
    {
        var items = (await MaterialService.GetAsync()).Where(x => x.Category == 3).ToList();
        _packagingMaterials.Clear();
        _packagingMaterials.AddRange(items);
        _selectedPackagingMaterialIds.RemoveWhere(id => !items.Any(x => x.Id == id && x.Quantity >= PackagingMaterialConsumption.RequiredQuantity(x.Name)));
    }
    private Task ReloadPackagingMaterialsAsync() => ExecuteAsync(LoadPackagingMaterialsAsync);

    private static bool IsExclusiveCase(string name)
    {
        var normalized = name.Trim().ToLowerInvariant();
        return normalized is "سافت کیس" or "میدل کیس" or "هارد کیس"
            or "soft case" or "middle case" or "hard case";
    }

    private static int CaseOrder(string name)
    {
        var value = name.Trim().ToLowerInvariant();
        if (value.Contains("سافت") || value.Contains("soft")) return 0;
        if (value.Contains("میدل") || value.Contains("middle")) return 1;
        return 2;
    }

    private static int AccessoryOrder(string name)
    {
        var value = name.Trim().ToLowerInvariant();
        if (value.Contains("روغن") || value.Contains("oil")) return 0;
        if (value.Contains("دستمال") || value.Contains("cloth")) return 1;
        if (value.Contains("پایه") || value.Contains("stand")) return 2;
        if (value.Contains("پنگارد") || value.Contains("پن گارد") || value.Contains("pan guard")) return 3;
        return 10;
    }

    private static IEnumerable<string> PerformerNames(string names) => string.IsNullOrWhiteSpace(names)
        ? ["ثبت نشده"]
        : names.Split(["،", ",", " / "], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void ShowOperationConfirmation(string title, IEnumerable<(string Label, string Value)> details, Func<Task> confirmedOperation)
    {
        if (title != "شیپ انجام شد") _isShapeConfirmation = false;
        _confirmationTitle = title;
        _confirmationDetails = details.Select(x => new ConfirmationDetail(x.Label, x.Value)).ToList();
        _confirmedOperation = confirmedOperation;
        _showOperationConfirmation = true;
    }

    private void CancelOperationConfirmation()
    {
        if (_confirmingOperation) return;
        _showOperationConfirmation = false;
        _confirmedOperation = null;
    }

    private async Task ConfirmOperationAsync()
    {
        if (_confirmedOperation is null || _confirmingOperation) return;
        if (_isShapeConfirmation && _useShapeContributors && ShapeParts.Any(x => x.Enabled && !x.UserId.HasValue))
        {
            _error = "برای هر بخش انتخاب‌شده، نام شیپر را مشخص کنید.";
            return;
        }
        _confirmingOperation = true;
        var operation = _confirmedOperation;
        try
        {
            _showOperationConfirmation = false;
            _confirmedOperation = null;
            await operation();
        }
        finally { _confirmingOperation = false; }
    }

    private string SelectedScaleName() =>
        _scales.FirstOrDefault(x => x.Id == _scaleId)?.Name ?? "بدون اسکیل";

    private string DurationText() =>
        DurationOptions.FirstOrDefault(x => x.Value == _duration).Text ?? "نامشخص";

    private sealed record ConfirmationDetail(string Label, string Value);
    private sealed class ShapePart(string key, string label) { public string Key { get; } = key; public string Label { get; } = label; public bool Enabled { get; set; } public Guid? UserId { get; set; } public Guid? SelectedUserId => Enabled ? UserId : null; }

    private void SetOperationResult(
        DimpleBowlDto? result,
        string successMessage,
        string errorMessage)
    {
        if (result is null)
        {
            _error = errorMessage;
            return;
        }

        _bowl = null;
        _successMessage = successMessage;
        _focusCodeAfterOperation = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCodeAfterOperation && !_loading && !_confirmingOperation)
        {
            _focusCodeAfterOperation = false;
            await _codeInput.FocusAsync();
        }
    }

    private void ReturnToDashboard() => Navigation.NavigateTo("/");

    private void OpenPassportSale(){if(_bowl?.HandpanId is Guid id)Navigation.NavigateTo($"/warehouse/list?sell={id}");}
    private void ClosePassportSale(){if(!_passportSaleSaving)_showPassportSale=false;}
    private async Task SellFromPassportAsync(Guid handpanId)
    {
        if (_passportSaleSaving) return;
        _passportSaleSaving = true; _passportSaleError = null;
        try
        {
            await ProductionService.SellAsync(handpanId, _passportBuyer.Trim(), null, _passportPrice, _passportDestination.Trim(), null, false, null);
            _showPassportSale = false;
            await SearchAsync();
        }
        catch { _passportSaleError = "ثبت فروش انجام نشد؛ لطفاً دوباره تلاش کنید."; }
        finally { _passportSaleSaving = false; }
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        _loading = true;
        _error = null;

        try
        {
            await action();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _bowl = null;
            _error = "کاسه‌ای با این کد پیدا نشد.";
        }
        catch (HttpRequestException ex) when (
            ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized)
        {
            _error = "این عملیات فقط برای کاربر دارای نقش مرتبط با مرحله تولید یا مدیر مجاز است.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _error = "کاسه مکمل، Scale معتبر و وضعیت در انتظار چسب را بررسی کنید.";
        }
        catch (HttpRequestException)
        {
            _error = "ارتباط با سرویس برقرار نشد.";
        }
        finally
        {
            _loading = false;
        }
    }


@page "/dimpling"
@page "/production/process"

@using System.Net
@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject BowlService BowlService
@inject ScaleService ScaleService
@inject MaterialService MaterialService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>تولید</PageTitle>

<h3 class="mb-4">تولید</h3>

<div class="alert alert-light border mb-4">
    دیمپل ← شیپ ← پخت ← تیون ← چسب ← فاین تیون ← QC
</div>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(15, 23, 42, .55); z-index: 2000;">
        <div class="card shadow-lg text-center p-5" style="min-width: min(520px, 90vw);">
            <div class="display-4 text-success mb-3">✓</div>
            <h3 class="mb-4">@_successMessage</h3>
            <button class="btn btn-primary btn-lg px-5" @onclick="ReturnToDashboard">
                تأیید و بازگشت به داشبورد
            </button>
        </div>
    </div>
}

<div class="card p-4">
    <label class="form-label">کد ساز را وارد کنید</label>
    <div class="input-group mb-3">
        <input class="form-control"
               placeholder="کد ساز را وارد کنید"
               @bind="_productionCode"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown" />
        <button class="btn btn-primary" disabled="@_loading" @onclick="SearchAsync">
            جست‌وجو
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_bowl is not null)
    {
        <div class="border rounded p-3 mt-2">
            <div><strong>کد:</strong> @_bowl.ProductionCode</div>
            <div><strong>نوع کاسه:</strong> @BowlTypeText(_bowl.BowlType)</div>
            <div class="production-highlights">
                <div class="production-highlight status-highlight">
                    <span>وضعیت</span><strong>@StageText(_bowl.Stage)</strong>
                </div>
                <div class="production-highlight scale-highlight">
                    <span>@(_bowl.IsHandpanScale ? "اسکیل ساز" : "اسکیل کاسه")</span><strong>@_bowl.ScaleName</strong>
                </div>
            </div>

            @if (_bowl.History.Count > 0)
            {
                <div class="card bg-light border-0 mt-3">
                    <div class="card-body py-3">
                        <strong>مراحل انجام‌شده تا این لحظه</strong>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>مرحله</th><th>انجام‌دهنده</th><th>زمان انجام</th></tr></thead>
                                <tbody>
                                @foreach (var item in _bowl.History)
                                {
                                    <tr><td>@item.ActionTitle</td><td>@item.PerformedBy</td><td>@PersianDateTime.FormatDateTime(item.PerformedAt)</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @if (_bowl.Stage is >= 4 and <= 14)
            {
                @if (_bowl.Notes.Count > 0)
                {
                    <div class="alert alert-info mt-3"><strong>توضیحات مراحل قبلی</strong><ul class="mb-0 mt-2">@foreach(var note in _bowl.Notes){<li>@note</li>}</ul></div>
                }
                <div class="mt-3"><label class="form-label">توضیحات این مرحله (اختیاری)</label><textarea class="form-control" rows="3" @bind="_stageNote" placeholder="اگر نکته‌ای برای همکار مرحله بعد وجود دارد اینجا بنویسید..."></textarea></div>
            }

            @if (_bowl.Stage == 2)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-4">
                        <label class="form-label">مدت زمان انجام دیمپل</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">اسکیل کاسه</label>
                        <select class="form-select" @bind="_scaleId">
                            <option value="@Guid.Empty">انتخاب کنید...</option>
                            @foreach (var scale in DimpleScales)
                            {
                                <option value="@scale.Id">@scale.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@(_loading || _scaleId == Guid.Empty)"
                                @onclick="CompleteAsync">
                            دیمپل انجام شد
                        </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 4)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام شیپ</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@_loading"
                                @onclick="CompleteShapeAsync">
                            شیپ انجام شد
                        </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 6)
            {
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompleteBakeAsync">
                    پخت انجام شد
                </button>
            }
            else if (_bowl.Stage == 8)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام تیون</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <button class="btn btn-success w-100"
                                disabled="@_loading"
                                @onclick="CompleteTuneAsync">
                            تیون انجام شد و ادامه مسیر عادی
                        </button>
                        <div class="export-route-box mt-3">
                            <div class="export-route-title">✈ مسیر صادراتی</div>
                            <div class="small mb-2">این کاسه بدون چسب، فاین تیون و QC مستقیماً بسته‌بندی می‌شود.</div>
                            <button class="btn btn-warning w-100"
                                    disabled="@_loading"
                                    @onclick="CompleteTuneForExportAsync">
                                تیون انجام شد؛ ارسال به بسته‌بندی صادراتی
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 21)
            {
                <div class="alert alert-info mt-3">این کاسه برای بسته‌بندی صادراتی آماده است.</div>
                <button class="btn btn-success mt-3" disabled="@_loading" @onclick="CompleteExportPackagingAsync">
                    بسته‌بندی صادراتی انجام شد
                </button>
            }
            else if (_bowl.Stage == 10)
            {
                <div class="mt-3">
                    <label class="form-label">@PairedBowlLabel(_bowl.BowlType)</label>
                    <input class="form-control"
                           placeholder="کد کاسه مکمل را وارد کنید"
                           @bind="_pairedProductionCode"
                           @bind:event="oninput" />
                    <label class="form-label mt-3">اسکیل ساز</label>
                    <select class="form-select" @bind="_scaleId">
                        <option value="@Guid.Empty">انتخاب کنید...</option>
                        @foreach (var scale in HandpanScales)
                        {
                            <option value="@scale.Id">@scale.Name</option>
                        }
                    </select>
                    <button class="btn btn-success mt-3"
                            disabled="@(_loading || string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)"
                            @onclick="CompleteGlueAsync">
                        چسب انجام شد
                    </button>
                </div>
            }
            else if (_bowl.Stage == 11)
            {
                <div class="alert alert-info mt-3">
                    این ساز در اتاق چسب قرار دارد.
                </div>
                <button class="btn btn-success"
                        disabled="@_loading"
                        @onclick="ReleaseFromGlueRoomAsync">
                    از اتاق چسب خارج شد
                </button>
            }
            else if (_bowl.Stage == 12)
            {
                <div class="row align-items-end mt-3">
                    <div class="col-md-6">
                        <label class="form-label">مدت زمان انجام فاین تیون</label>
                        <select class="form-select" @bind="_duration">
                            @foreach (var option in DurationOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompleteFinalTuneAsync">
                    فاین تیون انجام شد
                </button>
                    </div>
                </div>
            }
            else if (_bowl.Stage == 14)
            {
                <div class="mt-3">
                    <div class="d-flex gap-2 mb-3">
                        <button class="btn btn-success"
                                disabled="@_loading"
                                @onclick="ApproveQualityControlAsync">
                            QC تأیید شد
                        </button>
                        <button class="btn btn-outline-danger"
                                disabled="@_loading"
                                @onclick="ShowQualityControlRejection">
                            QC تأیید نشد
                        </button>
                    </div>

                    @if (_showQcRejection)
                    {
                        <label class="form-label">دلیل تأیید نشدن</label>
                        <select class="form-select" @bind="_qcRejectionReason">
                            <option value="OutOfTune">کوک نبودن</option>
                            <option value="Appearance">وضعیت ظاهری</option>
                            <option value="Other">سایر موارد</option>
                        </select>

                        @if (_qcRejectionReason == "Other")
                        {
                            <label class="form-label mt-3">توضیحات سایر موارد</label>
                            <textarea class="form-control" rows="3" @bind="_qcDetails"></textarea>
                        }

                        <button class="btn btn-danger mt-3"
                                disabled="@(_loading || (_qcRejectionReason == "Other" && string.IsNullOrWhiteSpace(_qcDetails)))"
                                @onclick="RejectQualityControlAsync">
                            ثبت عدم تأیید و بازگشت به فاین تیون
                        </button>
                    }
                </div>
            }
            else if (_bowl.Stage == 16)
            {
                <div class="card bg-light border-0 p-3 mt-3">
                    <h5>اقلام مصرف‌شده در بسته‌بندی</h5>
                    <p class="text-muted">هر قلم استفاده‌شده را انتخاب کنید؛ پس از ثبت، یک عدد از موجودی آن کم می‌شود.</p>
                    <div class="row g-2">
                        @foreach (var material in _packagingMaterials)
                        {
                            <div class="col-md-4">
                                <label class="form-check border rounded p-3 w-100 @(material.Quantity == 0 ? "opacity-50" : "")">
                                    <input class="form-check-input" type="checkbox"
                                           disabled="@(material.Quantity == 0)"
                                           checked="@_selectedPackagingMaterialIds.Contains(material.Id)"
                                           @onchange="e => TogglePackagingMaterial(material.Id, e.Value as bool? == true)" />
                                    <span class="me-2">@material.Name</span>
                                    <small class="text-muted">(موجودی: @material.Quantity)</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <button class="btn btn-success mt-3"
                        disabled="@_loading"
                        @onclick="CompletePackagingAsync">
                    بسته‌بندی انجام شد
                </button>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    این کاسه در مرحله دیگری از تولید قرار دارد.
                </div>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private string _productionCode = string.Empty;
    private string? _error;
    private DimpleBowlDto? _bowl;
    private bool _loading;
    private int _duration = 1;
    private string _pairedProductionCode = string.Empty;
    private Guid _scaleId;
    private readonly List<ScaleDto> _scales = [];
    private IEnumerable<ScaleDto> DimpleScales => _bowl is null
        ? []
        : _scales.Where(x => (x.Usage & (_bowl.BowlType == 1 ? 1 : 2)) != 0);
    private IEnumerable<ScaleDto> HandpanScales => _scales.Where(x => (x.Usage & 4) != 0);
    private readonly List<MaterialDto> _packagingMaterials = [];
    private readonly HashSet<Guid> _selectedPackagingMaterialIds = [];
    private string? _successMessage;
    private bool _showQcRejection;
    private string _qcRejectionReason = "OutOfTune";
    private string _qcDetails = string.Empty;
    private string _stageNote = string.Empty;

    private static readonly (int Value, string Text)[] DurationOptions =
    [
        (1, "۵ دقیقه"), (2, "۱۰ دقیقه"), (3, "۱۵ دقیقه"),
        (4, "۲۰ دقیقه"), (5, "۲۵ دقیقه"), (6, "۳۰ دقیقه"),
        (7, "۳۵ دقیقه"), (8, "۴۰ دقیقه"), (9, "۴۵ دقیقه"),
        (10, "۵۰ دقیقه"), (11, "۵۵ دقیقه"), (12, "۶۰ دقیقه"),
        (13, "بیشتر از ۶۰ دقیقه")
    ];

    protected override async Task OnInitializedAsync()
    {
        _scales.AddRange(await ScaleService.GetAsync());
        _packagingMaterials.AddRange((await MaterialService.GetAsync()).Where(x => x.Category == 3));
        if (_scales.Count > 0)
            _scaleId = _scales[0].Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Code) && Code != _productionCode)
        {
            _productionCode = Code;
            await SearchAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_productionCode))
        {
            _error = "کد ساز را وارد کنید.";
            return;
        }

        await ExecuteAsync(async () =>
        {
            _pairedProductionCode = string.Empty;
            _successMessage = null;
            _showQcRejection = false;
            _stageNote = string.Empty;
            _bowl = await BowlService.GetForDimplingAsync(_productionCode);
            if (_bowl?.Stage == 2)
                _scaleId = DimpleScales.FirstOrDefault()?.Id ?? Guid.Empty;
            else if (_bowl?.Stage == 10)
                _scaleId = HandpanScales.FirstOrDefault()?.Id ?? Guid.Empty;
            if (_bowl is null)
                _error = "کاسه پیدا نشد.";
        });
    }

    private async Task CompleteAsync()
    {
        if (!await ConfirmOperationAsync("دیمپل", $"کد کاسه: {_productionCode}\nاسکیل کاسه: {SelectedScaleName()}\nمدت زمان: {DurationText()}")) return;
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteDimplingAsync(_productionCode, _duration, _scaleId);
            SetOperationResult(result, "دیمپل با موفقیت انجام شد.", "ثبت پایان دیمپل انجام نشد.");
        });
    }

    private async Task CompleteShapeAsync()
    {
        if (!await ConfirmOperationAsync("شیپ", $"کد کاسه: {_productionCode}\nاسکیل کاسه: {_bowl?.ScaleName ?? "نامشخص"}\nمدت زمان: {DurationText()}")) return;
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteShapeAsync(_productionCode, _duration);
            SetOperationResult(result, "شیپ با موفقیت انجام شد.", "ثبت پایان شیپ انجام نشد.");
        });
    }

    private async Task CompleteBakeAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteBakeAsync(_productionCode);
            SetOperationResult(result, "پخت با موفقیت انجام شد.", "ثبت پایان پخت انجام نشد.");
        });
    }

    private async Task CompleteTuneAsync()
    {
        if (!await ConfirmOperationAsync("تیون", $"کد کاسه: {_productionCode}\nاسکیل کاسه: {_bowl?.ScaleName ?? "نامشخص"}\nمدت زمان: {DurationText()}")) return;
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteTuneAsync(_productionCode, _duration);
            SetOperationResult(result, "تیون با موفقیت انجام شد.", "ثبت پایان تیون انجام نشد.");
        });
    }

    private async Task CompleteTuneForExportAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "تیون انجام شده و کاسه مستقیماً به بسته‌بندی صادراتی ارسال شود؟")) return;
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteTuneForExportAsync(_productionCode, _duration);
            SetOperationResult(result, "تیون انجام شد و کاسه برای بسته‌بندی صادراتی آماده است.", "ثبت مسیر صادراتی انجام نشد.");
        });
    }

    private async Task CompleteExportPackagingAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteExportPackagingAsync(_productionCode);
            SetOperationResult(result, "بسته‌بندی انجام شد و کاسه وارد انبار صادراتی شد.", "ثبت بسته‌بندی صادراتی انجام نشد.");
        });
    }

    private async Task CompleteGlueAsync()
    {
        if (string.IsNullOrWhiteSpace(_pairedProductionCode) || _scaleId == Guid.Empty)
        {
            _error = "کد کاسه مکمل را وارد کنید.";
            return;
        }

        var topCode = _bowl?.BowlType == 1 ? _productionCode : _pairedProductionCode;
        var bottomCode = _bowl?.BowlType == 1 ? _pairedProductionCode : _productionCode;
        if (!await ConfirmOperationAsync("چسب", $"کد کاسه بالا: {topCode}\nکد کاسه پایین: {bottomCode}\nاسکیل ساز: {SelectedScaleName()}")) return;

        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteGlueAsync(
                _productionCode,
                _pairedProductionCode,
                _scaleId);
            SetOperationResult(result, "چسب‌کاری با موفقیت انجام شد و ساز وارد اتاق چسب شد.", "ثبت اتصال کاسه‌ها انجام نشد.");
        });
    }

    private async Task ReleaseFromGlueRoomAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.ReleaseFromGlueRoomAsync(_productionCode);
            SetOperationResult(result, "ساز با موفقیت از اتاق چسب خارج شد.", "ثبت خروج از اتاق چسب انجام نشد.");
        });
    }

    private async Task CompleteFinalTuneAsync()
    {
        if (!await ConfirmOperationAsync("فاین تیون", $"کد ساز: {_productionCode}\nاسکیل ساز: {_bowl?.ScaleName ?? "نامشخص"}\nمدت زمان: {DurationText()}")) return;
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteFinalTuneAsync(_productionCode, _duration);
            SetOperationResult(result, "فاین تیون با موفقیت انجام شد و ساز در انتظار QC قرار گرفت.", "ثبت پایان فاین تیون انجام نشد.");
        });
    }

    private void ShowQualityControlRejection() => _showQcRejection = true;

    private async Task ApproveQualityControlAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(_productionCode, true);
            SetOperationResult(result, "QC تأیید شد و ساز در انتظار بسته‌بندی قرار گرفت.", "ثبت تأیید QC انجام نشد.");
        });
    }

    private async Task RejectQualityControlAsync()
    {
        await SaveStageNoteAsync();
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompleteQualityControlAsync(
                _productionCode,
                false,
                _qcRejectionReason,
                _qcDetails);
            SetOperationResult(result, "عدم تأیید QC ثبت شد و ساز به در انتظار فاین تیون برگشت.", "ثبت عدم تأیید QC انجام نشد.");
        });
    }

    private async Task CompletePackagingAsync()
    {
        await ExecuteAsync(async () =>
        {
            var result = await BowlService.CompletePackagingAsync(_productionCode, _selectedPackagingMaterialIds);
            SetOperationResult(result, "بسته‌بندی انجام شد و ساز وارد انبار شد.", "ثبت پایان بسته‌بندی انجام نشد.");
        });
    }

    private void TogglePackagingMaterial(Guid id, bool selected)
    {
        if (selected)
        {
            var selectedItem = _packagingMaterials.FirstOrDefault(x => x.Id == id);
            if (selectedItem is not null && IsExclusiveCase(selectedItem.Name))
            {
                foreach (var otherCase in _packagingMaterials.Where(x => x.Id != id && IsExclusiveCase(x.Name)))
                    _selectedPackagingMaterialIds.Remove(otherCase.Id);
            }
            _selectedPackagingMaterialIds.Add(id);
        }
        else
            _selectedPackagingMaterialIds.Remove(id);
    }

    private async Task SaveStageNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_stageNote)) return;
        await BowlService.AddProductionNoteAsync(_productionCode, _stageNote.Trim());
        _stageNote = string.Empty;
    }

    private static bool IsExclusiveCase(string name)
    {
        var normalized = name.Trim().ToLowerInvariant();
        return normalized is "سافت کیس" or "میدل کیس" or "هارد کیس"
            or "soft case" or "middle case" or "hard case";
    }

    private ValueTask<bool> ConfirmOperationAsync(string operation, string details) =>
        JS.InvokeAsync<bool>("confirm", $"آیا از ثبت عملیات «{operation} انجام شد» مطمئن هستید؟\n\n{details}");

    private string SelectedScaleName() =>
        _scales.FirstOrDefault(x => x.Id == _scaleId)?.Name ?? _bowl?.ScaleName ?? "نامشخص";

    private string DurationText() =>
        DurationOptions.FirstOrDefault(x => x.Value == _duration).Text ?? "نامشخص";

    private void SetOperationResult(
        DimpleBowlDto? result,
        string successMessage,
        string errorMessage)
    {
        if (result is null)
        {
            _error = errorMessage;
            return;
        }

        _bowl = null;
        _successMessage = successMessage;
    }

    private void ReturnToDashboard() => Navigation.NavigateTo("/");

    private async Task ExecuteAsync(Func<Task> action)
    {
        _loading = true;
        _error = null;

        try
        {
            await action();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _bowl = null;
            _error = "کاسه‌ای با این کد پیدا نشد.";
        }
        catch (HttpRequestException ex) when (
            ex.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.Unauthorized)
        {
            _error = "این عملیات فقط برای کاربر دارای نقش مرتبط با مرحله تولید یا مدیر مجاز است.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.BadRequest)
        {
            _error = "کاسه مکمل، اسکیل معتبر و وضعیت در انتظار چسب را بررسی کنید.";
        }
        catch (HttpRequestException)
        {
            _error = "ارتباط با سرویس برقرار نشد.";
        }
        finally
        {
            _loading = false;
        }
    }


@page "/warehouse"

@inject NavigationManager Navigation

<PageTitle>انبار</PageTitle>

<PageHeader Title="انبار"
            SubTitle="مدیریت انبار">

    <Actions>

        <PrimaryButton Text="مشاهده موجودی"
                       OnClick="OpenInventory" />

    </Actions>

</PageHeader>

<Card>

    <div class="text-center p-5">

        <h5>مدیریت انبار</h5>

        <p class="text-secondary">
            مدیریت موجودی کاسه‌ها، اسمبلی‌ها و هنگدرام‌ها
        </p>

    </div>

</Card>

@code
{
    private void OpenInventory()
    {
        Navigation.NavigateTo("/warehouse/list");
    }
}
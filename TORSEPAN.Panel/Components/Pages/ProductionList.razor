@page "/production/list"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject ProductionService ProductionService

<PageTitle>صف تولید</PageTitle>

<h3 class="mb-4">صف تولید</h3>

@if (_loading)
{
    <div class="spinner-border"></div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info">
        موردی برای نمایش وجود ندارد.
    </div>
}
else
{
    <table class="table table-striped">

        <thead>

            <tr>
                <th>Serial</th>
                <th>مرحله</th>
                <th>وضعیت</th>
                <th>تاریخ</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in _items)
            {
                <tr>

                    <td>@item.SerialNumber</td>

                    <td>@item.Stage</td>

                    <td>@item.Status</td>

                    <td>@item.CreatedAt.ToString("yyyy/MM/dd")</td>

                </tr>
            }

        </tbody>

    </table>
}

@code
{
    private readonly List<ProductionStageItemDto> _items = [];

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items.AddRange(await ProductionService.GetQueueAsync());
        }
        finally
        {
            _loading = false;
        }
    }
}
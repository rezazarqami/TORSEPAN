@page "/notfound"

<PageTitle>یافت نشد</PageTitle>

<PageContainer>

    <CenteredMessage Title="صفحه مورد نظر پیدا نشد"
                     Message="آدرس وارد شده معتبر نیست." />

    <ActionBar>

        <PrimaryButton Text="بازگشت"
                       OnClick="GoHome" />

    </ActionBar>

</PageContainer>

@code {

    [Inject]
    NavigationManager Navigation { get; set; } = default!;

    void GoHome()
    {
        Navigation.NavigateTo("/");
    }

}
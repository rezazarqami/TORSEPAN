@page "/users/new"

@using TORSEPAN.Application.Auth.Commands.CreateUser

@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>ثبت کاربر</PageTitle>

<PageHeader Title="ثبت کاربر"
            SubTitle="ایجاد کاربر جدید" />

<Card>

    <EditForm Model="_model">

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">نام کاربری</label>
                <InputText class="form-control"
                           @bind-Value="_model.UserName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">نام کامل</label>
                <InputText class="form-control"
                           @bind-Value="_model.FullName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">رمز عبور</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="_model.Password" />
            </div>

            <div class="col-12">
                <label class="form-label">نقش‌ها</label>

                <div class="row g-2">
                    @foreach (var role in _roles)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="role.IsSelected" />
                                <label class="form-check-label">@role.DisplayName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button class="btn btn-primary"
                    type="button"
                    @onclick="Save">
                ذخیره
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                انصراف
            </button>

        </div>

    </EditForm>

</Card>

@code
{
    private readonly CreateUserModel _model = new();

    private List<RoleOption> _roles = new();

    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        var roles = await UserService.GetRolesAsync();
        _roles = roles
            .Select(role => new RoleOption(
                role.Id,
                role.DisplayName,
                role.Name == "ProductionManager"))
            .ToList();
    }

    private async Task Save()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var command = new CreateUserCommand(
                _model.UserName,
                _model.FullName,
                _model.Password,
                _roles
                    .Where(x => x.IsSelected)
                    .Select(x => x.Id)
                    .ToList());

            await UserService.CreateUserAsync(command);

            Navigation.NavigateTo("/users/list", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users/list");
    }

    public sealed class CreateUserModel
    {
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private sealed class RoleOption
    {
        public RoleOption(Guid id, string displayName, bool isSelected = false)
        {
            Id = id;
            DisplayName = displayName;
            IsSelected = isSelected;
        }

        public Guid Id { get; }
        public string DisplayName { get; }
        public bool IsSelected { get; set; }
    }
}

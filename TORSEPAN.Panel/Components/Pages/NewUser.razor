@page "/users/new"

@using TORSEPAN.Application.Auth.Commands.CreateUser

@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>ثبت کاربر</PageTitle>

<PageHeader Title="ثبت کاربر"
            SubTitle="ایجاد کاربر جدید" />

<Card>

    <EditForm Model="_model">

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">نام کاربری</label>
                <InputText class="form-control"
                           @bind-Value="_model.UserName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">نام کامل</label>
                <InputText class="form-control"
                           @bind-Value="_model.FullName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">رمز عبور</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="_model.Password" />
            </div>

            <div class="col-12">
                <label class="form-label">نقش‌ها</label>

                <div class="row g-2">
                    @foreach (var role in _roles)
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="role.IsSelected" />
                                <label class="form-check-label">@role.DisplayName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button class="btn btn-primary"
                    type="button"
                    @onclick="Save">
                ذخیره
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                انصراف
            </button>

        </div>

    </EditForm>

</Card>

@code
{
    private readonly CreateUserModel _model = new();

    private readonly List<RoleOption> _roles = new()
    {
        new("11111111-1111-1111-1111-111111111111", "Administrator"),
        new("22222222-2222-2222-2222-222222222222", "Production Manager", true),
        new("33333333-3333-3333-3333-333333333333", "Dimpler"),
        new("44444444-4444-4444-4444-444444444444", "Shaper"),
        new("55555555-5555-5555-5555-555555555555", "Tuner"),
        new("66666666-6666-6666-6666-666666666666", "Fine Tuner"),
        new("77777777-7777-7777-7777-777777777777", "Quality Control"),
        new("88888888-8888-8888-8888-888888888888", "Workshop"),
        new("99999999-9999-9999-9999-999999999999", "Warehouse")
    };

    private bool _isSaving;

    private async Task Save()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var command = new CreateUserCommand(
                _model.UserName,
                _model.FullName,
                _model.Password,
                _roles
                    .Where(x => x.IsSelected)
                    .Select(x => x.Id)
                    .ToList());

            await UserService.CreateUserAsync(command);

            Navigation.NavigateTo("/users/list", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users/list");
    }

    public sealed class CreateUserModel
    {
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private sealed class RoleOption
    {
        public RoleOption(string id, string displayName, bool isSelected = false)
        {
            Id = Guid.Parse(id);
            DisplayName = displayName;
            IsSelected = isSelected;
        }

        public Guid Id { get; }
        public string DisplayName { get; }
        public bool IsSelected { get; set; }
    }
}

@page "/users/new"

@using TORSEPAN.Application.Auth.Commands.CreateUser

@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>ثبت کاربر</PageTitle>

<PageHeader Title="ثبت کاربر"
            SubTitle="ایجاد کاربر جدید" />

<Card>

    <EditForm Model="_model">

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">نام کاربری</label>
                <InputText class="form-control"
                           @bind-Value="_model.UserName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">نام کامل</label>
                <InputText class="form-control"
                           @bind-Value="_model.FullName" />
            </div>

            <div class="col-md-6">
                <label class="form-label">رمز عبور</label>
                <InputText class="form-control"
                           type="password"
                           @bind-Value="_model.Password" />
            </div>

            <div class="col-md-6">
                <label class="form-label">نقش</label>

                <InputSelect class="form-select"
                             @bind-Value="_model.RoleId">
                    <option value="11111111-1111-1111-1111-111111111111">Administrator</option>
                    <option value="22222222-2222-2222-2222-222222222222">Production Manager</option>
                    <option value="33333333-3333-3333-3333-333333333333">Dimpler</option>
                    <option value="44444444-4444-4444-4444-444444444444">Shaper</option>
                    <option value="55555555-5555-5555-5555-555555555555">Tuner</option>
                    <option value="66666666-6666-6666-6666-666666666666">Fine Tuner</option>
                    <option value="77777777-7777-7777-7777-777777777777">Quality Control</option>
                    <option value="88888888-8888-8888-8888-888888888888">Workshop</option>
                    <option value="99999999-9999-9999-9999-999999999999">Warehouse</option>
                </InputSelect>
            </div>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button class="btn btn-primary"
                    type="button"
                    @onclick="Save">
                ذخیره
            </button>

            <button class="btn btn-secondary"
                    type="button"
                    @onclick="Back">
                انصراف
            </button>

        </div>

    </EditForm>

</Card>

@code
{
    private readonly CreateUserModel _model = new()
    {
        RoleId = Guid.Parse("22222222-2222-2222-2222-222222222222")
    };

    private bool _isSaving;

    private async Task Save()
    {
        if (_isSaving)
            return;

        _isSaving = true;

        try
        {
            var command = new CreateUserCommand(
                _model.UserName,
                _model.FullName,
                _model.Password,
                new List<Guid> { _model.RoleId });

            await UserService.CreateUserAsync(command);

            Navigation.NavigateTo("/users/list", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Back()
    {
        Navigation.NavigateTo("/users/list");
    }

    public sealed class CreateUserModel
    {
        public string UserName { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Password { get; set; } = "";
        public Guid RoleId { get; set; }
    }
}
@page "/warehouse/export"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject BowlService BowlService
@inject TORSEPAN.Panel.Services.Api.AccountingService AccountingService
@inject IJSRuntime JS

<PageTitle>انبار صادراتی</PageTitle>
<section class="warehouse-hero export-hero">
    <span class="hero-kicker">EXPORT INVENTORY</span>
    <div class="hero-icon" aria-hidden="true">✈</div>
    <h1>انبار صادراتی</h1>
    <p>مدیریت یکپارچه سازها و کاسه‌های آماده ارسال در ایران و انبارهای خارجی</p>
    <div class="hero-stats"><span><strong>@_items.Count</strong> موجودی کل</span><i></i><span><strong>@Warehouses.Length</strong> مقصد فعال</span></div>
</section>

<div class="warehouse-dashboard">
    @foreach(var warehouse in Warehouses)
    {
        <button class="warehouse-card @(_activeLocation==warehouse.Id?"active":"")" @onclick="()=>SelectWarehouseAsync(warehouse.Id)"><span class="warehouse-flag">@warehouse.Code</span><div><small>انبار صادراتی</small><strong>@warehouse.Name</strong></div><b>@_items.Count(x=>x.Location==warehouse.Id)</b>@if(_activeLocation==warehouse.Id){<em>در حال نمایش</em>}</button>
    }
</div>

<div class="export-tools">
    <input class="form-control" placeholder="جست‌وجوی کد ساز، کاسه یا مشخصات..." @bind="_search" @bind:event="oninput" />
    <AuthorizeView Roles="Workshop,Administrator,ProductionManager,SalesAdmin">
        <button class="btn ship-selected" disabled="@(_selected.Count == 0)" @onclick="OpenSelectedShipment">ثبت ارسال <span>@_selected.Count</span></button>
    </AuthorizeView>
</div>
<div class="active-warehouse-banner" @ref="_inventorySection"><span class="warehouse-flag">@Warehouses.First(x=>x.Id==_activeLocation).Code</span><div><small>اکنون در حال مشاهده</small><strong>انبار @WarehouseName(_activeLocation)</strong></div><b>@WarehouseItems.Count() مورد</b></div>
@if (_loading)
{
    <Card><div class="text-center p-5"><div class="spinner-border"></div></div></Card>
}
else if (!WarehouseItems.Any())
{
    <Card><EmptyState Title="این انبار خالی است" Description="پس از انتخاب این مقصد در بسته‌بندی، سازها و کاسه‌ها در این قسمت قرار می‌گیرند." /></Card>
}
else
{
    <section class="selected-inventory">
        <header class="selected-inventory-heading"><div><small>موجودی انتخاب‌شده</small><h2>انبار @WarehouseName(_activeLocation)</h2><p>فهرست زیر مربوط به مقصد انتخاب‌شده است.</p></div><span>@WarehouseItems.Count() مورد</span></header>
        <nav class="inventory-tabs" aria-label="نوع موجودی">
            <button class="@(_activeInventoryTab=="bowls"?"active":null)" @onclick='()=>_activeInventoryTab="bowls"'><span>◉</span><strong>کاسه‌ها</strong><b>@WarehouseBowls.Count()</b></button>
            <button class="@(_activeInventoryTab=="handpans"?"active":null)" @onclick='()=>_activeInventoryTab="handpans"'><span>♫</span><strong>سازها</strong><b>@WarehouseHandpans.Count()</b></button>
        </nav>
    @if (_activeInventoryTab == "bowls")
    {
        <div class="inventory-pane">
            @if (!WarehouseBowls.Any())
            {
                <EmptyState Title="کاسه‌ای در این انبار نیست" Description="کاسه‌های بسته‌بندی‌شده برای این مقصد اینجا نمایش داده می‌شوند." />
            }
            else
            {
                <div class="inventory-cards">@foreach (var item in WarehouseBowls) { <article class="inventory-item @(_selected.Contains(item.Id)?"selected":null)"><label class="item-select"><input type="checkbox" checked="@_selected.Contains(item.Id)" @onchange="e=>Toggle(item.Id,(bool)(e.Value??false))" /><span></span></label><div class="item-main"><small>@item.ItemKind</small><strong dir="ltr">@item.ProductionCode</strong><p>@item.Detail</p></div><span class="location-badge">@WarehouseName(item.Location)</span><div class="row-actions"><AuthorizeView Roles="Administrator,ProductionManager,SalesAdmin"><button class="btn btn-sm btn-outline-primary" @onclick="()=>OpenLocationEditor(item)">تغییر انبار</button></AuthorizeView><AuthorizeView Roles="Workshop,Administrator,ProductionManager,SalesAdmin"><button class="btn btn-sm btn-success" @onclick="()=>OpenShipment(item)">ثبت ارسال</button></AuthorizeView><AuthorizeView Roles="Administrator"><button class="btn btn-sm btn-outline-danger" @onclick="()=>RequestDelete(item)">حذف</button></AuthorizeView></div></article> }</div>
            }
        </div>
    }
    else
    {
        <div class="inventory-pane">
            @if (!WarehouseHandpans.Any())
            {
                <EmptyState Title="سازی در این انبار نیست" Description="سازهای کامل ارسال‌شده به این مقصد اینجا نمایش داده می‌شوند." />
            }
            else
            {
                <div class="inventory-cards">@foreach (var item in WarehouseHandpans) { <article class="inventory-item handpan-card"><div class="item-symbol">♫</div><div class="item-main"><small>@item.ItemKind</small><strong dir="ltr">@item.ProductionCode</strong><p>@item.Detail</p></div><span class="location-badge">@WarehouseName(item.Location)</span><div class="row-actions"><AuthorizeView Roles="Administrator,ProductionManager,SalesAdmin"><button class="btn btn-sm btn-outline-primary" @onclick="()=>OpenLocationEditor(item)">تغییر انبار</button></AuthorizeView></div></article> }</div>
            }
        </div>
    }
    </section>
}

@if (_shipmentIds.Count > 0)
{
    <div class="shipment-overlay" @onclick="CloseShipment"><section class="shipment-dialog" role="dialog" aria-modal="true" aria-labelledby="shipment-title" @onclick:stopPropagation="true">
        <header><div><small>ثبت خروج از انبار صادراتی</small><h3 id="shipment-title">اطلاعات ارسال</h3><p>@_shipmentIds.Count کاسه انتخاب شده است</p></div><button @onclick="CloseShipment" aria-label="بستن">×</button></header>
        <div class="shipment-codes">@foreach(var id in _shipmentIds){<span>@_items.First(x=>x.Id==id).ProductionCode</span>}</div>
        <div class="shipment-fields">
            <label><span>نام خریدار از حسابداری</span><select class="form-select" @bind="_partyId"><option value="">انتخاب نشده</option>@foreach(var party in _parties){<option value="@party.Id">@party.DisplayName</option>}</select></label>
            <label><span>نام خریدار تایپی</span><input class="form-control" @bind="_buyerName" placeholder="اختیاری" /></label>
            <label><span>مقصد</span><input class="form-control" @bind="_destination" placeholder="کشور یا شهر مقصد، اختیاری" /></label>
            <fieldset class="wide"><legend>نحوه ارسال</legend><div class="choice-row"><button type="button" class="@ChoiceClass(_shippingMethod,null)" @onclick="()=>_shippingMethod=null">ثبت نشده</button><button type="button" class="@ChoiceClass(_shippingMethod,"air")" @onclick='()=>_shippingMethod="air"'>هوایی</button><button type="button" class="@ChoiceClass(_shippingMethod,"land")" @onclick='()=>_shippingMethod="land"'>زمینی</button><button type="button" class="@ChoiceClass(_shippingMethod,"sea")" @onclick='()=>_shippingMethod="sea"'>دریایی</button></div></fieldset>
            <fieldset class="wide"><legend>تسویه انجام شده؟</legend><div class="choice-row"><button type="button" class="@SettledClass(null)" @onclick="()=>_isSettled=null">ثبت نشده</button><button type="button" class="@SettledClass(true)" @onclick="()=>_isSettled=true">بله</button><button type="button" class="@SettledClass(false)" @onclick="()=>_isSettled=false">خیر</button></div></fieldset>
        </div>
        <p class="shipment-hint">تمام فیلدها اختیاری هستند و ارسال بدون تکمیل آن‌ها نیز ثبت می‌شود.</p>
        @if(!string.IsNullOrWhiteSpace(_error)){<div class="shipment-error">@_error</div>}
        <footer><button class="btn btn-light" disabled="@_saving" @onclick="CloseShipment">انصراف</button><button class="btn btn-success" disabled="@_saving" @onclick="ConfirmShipmentAsync">@(_saving?"در حال ثبت…":"تأیید و انتقال به فروش")</button></footer>
    </section></div>
}

@if (_locationCandidate is not null)
{
    <div class="shipment-overlay" @onclick="CloseLocationEditor"><section class="location-dialog" @onclick:stopPropagation="true"><small>ویرایش جایگاه موجودی</small><h3>@_locationCandidate.ProductionCode</h3><p>این مورد به کدام انبار منتقل شود؟</p><div class="location-choices">@foreach(var warehouse in Warehouses){<button class="@(_newLocation==warehouse.Id?"active":"")" @onclick="()=>_newLocation=warehouse.Id"><span>@warehouse.Code</span><strong>@warehouse.Name</strong></button>}</div>@if(!string.IsNullOrWhiteSpace(_locationError)){<div class="shipment-error">@_locationError</div>}<footer><button class="btn btn-light" @onclick="CloseLocationEditor">انصراف</button><button class="btn btn-primary" disabled="@_savingLocation" @onclick="SaveLocationAsync">ثبت جابه‌جایی</button></footer></section></div>
}

<AppConfirmDialog IsOpen="@(_deleteCandidate is not null)" Title="حذف کاسه صادراتی" Message="@DeleteMessage" ConfirmText="حذف برای همیشه" Error="@_deleteError" Busy="@_deleting" OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete" />

@code {
    private List<ExportWarehouseItemDto> _items = [];
    private List<TORSEPAN.Panel.Models.AccountingPartyDto> _parties = [];
    private readonly HashSet<Guid> _selected = [];
    private readonly List<Guid> _shipmentIds = [];
    private bool _loading = true, _saving, _deleting, _savingLocation;
    private string _search = "", _buyerName = "", _destination = "";
    private string? _shippingMethod, _error, _deleteError, _locationError;
    private bool? _isSettled;
    private Guid? _partyId;
    private ExportWarehouseItemDto? _deleteCandidate;
    private ExportWarehouseItemDto? _locationCandidate;
    private int _activeLocation=4, _newLocation=4;
    private string _activeInventoryTab="bowls";
    private ElementReference _inventorySection;
    private static readonly (int Id,string Name,string Code)[] Warehouses=[(4,"ایران","IR"),(1,"ترکیه","TR"),(2,"لندن","UK"),(3,"آلمان","DE")];
    private IEnumerable<ExportWarehouseItemDto> WarehouseItems => _items.Where(x=>x.Location==_activeLocation && (string.IsNullOrWhiteSpace(_search) || x.ProductionCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<ExportWarehouseItemDto> WarehouseBowls => WarehouseItems.Where(x=>x.ItemType=="bowl");
    private IEnumerable<ExportWarehouseItemDto> WarehouseHandpans => WarehouseItems.Where(x=>x.ItemType=="handpan");
    private bool AllVisibleSelected => WarehouseBowls.Any() && WarehouseBowls.All(x => _selected.Contains(x.Id));
    private string DeleteMessage => _deleteCandidate is null ? "" : $"کاسه صادراتی {_deleteCandidate.ProductionCode} برای همیشه حذف شود؟";
    protected override async Task OnInitializedAsync(){_loading=true;try{var bowls=BowlService.GetExportWarehouseAsync();var parties=AccountingService.PartiesAsync();await Task.WhenAll(bowls,parties);_items=(await bowls).ToList();_parties=await parties;}finally{_loading=false;}}
    private void Toggle(Guid id,bool selected){if(selected)_selected.Add(id);else _selected.Remove(id);}
    private async Task SelectWarehouseAsync(int id){_activeLocation=id;_selected.Clear();_activeInventoryTab="bowls";await InvokeAsync(StateHasChanged);await JS.InvokeVoidAsync("torsepanUi.scrollIntoView",_inventorySection);}
    private static string WarehouseName(int id)=>Warehouses.FirstOrDefault(x=>x.Id==id).Name??"نامشخص";
    private void OpenLocationEditor(ExportWarehouseItemDto item){_locationCandidate=item;_newLocation=item.Location;_locationError=null;}
    private void CloseLocationEditor(){if(!_savingLocation)_locationCandidate=null;}
    private async Task SaveLocationAsync(){if(_locationCandidate is null)return;_savingLocation=true;_locationError=null;try{await BowlService.ChangeExportWarehouseLocationAsync(_locationCandidate.ItemType,_locationCandidate.Id,_newLocation);_locationCandidate.Location=_newLocation;_locationCandidate=null;}catch(Exception ex){_locationError=ex.Message;}finally{_savingLocation=false;}}
    private void ToggleAll(ChangeEventArgs e){var selected=(bool)(e.Value??false);foreach(var item in WarehouseBowls){if(selected)_selected.Add(item.Id);else _selected.Remove(item.Id);}}
    private void OpenShipment(ExportWarehouseItemDto item){_shipmentIds.Clear();_shipmentIds.Add(item.Id);ResetShipment();}
    private void OpenSelectedShipment(){_shipmentIds.Clear();_shipmentIds.AddRange(_selected.Where(id=>_items.Any(x=>x.Id==id&&x.ItemType=="bowl")));ResetShipment();}
    private void ResetShipment(){_partyId=null;_buyerName="";_destination="";_shippingMethod=null;_isSettled=null;_error=null;}
    private void CloseShipment(){if(_saving)return;_shipmentIds.Clear();}
    private static string ChoiceClass(string? current,string? value)=>current==value?"choice active":"choice";
    private string SettledClass(bool? value)=>_isSettled==value?"choice active":"choice";
    private async Task ConfirmShipmentAsync(){_saving=true;_error=null;try{var buyer=string.IsNullOrWhiteSpace(_buyerName)&&_partyId.HasValue?_parties.FirstOrDefault(x=>x.Id==_partyId)?.DisplayName:_buyerName;await BowlService.ShipExportBowlsAsync(_shipmentIds,buyer,_partyId,_destination,_shippingMethod,_isSettled);var shipped=_shipmentIds.ToHashSet();_items.RemoveAll(x=>shipped.Contains(x.Id));_selected.RemoveWhere(shipped.Contains);_shipmentIds.Clear();}catch(Exception ex){_error=ex.Message;}finally{_saving=false;}}
    private void RequestDelete(ExportWarehouseItemDto item){_deleteCandidate=item;_deleteError=null;}
    private void CancelDelete(){if(_deleting)return;_deleteCandidate=null;_deleteError=null;}
    private async Task ConfirmDeleteAsync(){if(_deleteCandidate is null)return;_deleting=true;try{await BowlService.DeleteAsync(_deleteCandidate.Id);_items.Remove(_deleteCandidate);_selected.Remove(_deleteCandidate.Id);_deleteCandidate=null;}catch(Exception ex){_deleteError=ex.Message;}finally{_deleting=false;}}
}

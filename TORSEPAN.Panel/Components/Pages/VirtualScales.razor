@page "/virtual-scales"
@using Microsoft.AspNetCore.Authorization
@using TORSEPAN.Application.Scales
@attribute [Authorize]
@inject AuthenticationStateProvider Authentication
@inject ScaleService ScaleService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Host

<PageTitle>هنگ‌درام مجازی | تورسپن</PageTitle>
<header class="virtual-workshop-header" dir="rtl">
    <div class="workshop-hero-title">
        <span lang="en" dir="ltr">HANDPAN</span>
        <h1 id="virtual-workshop-title">هنگ‌درام مجازی</h1>
    </div>
</header>
<section class="virtual-workshop navy-workspace-page" dir="rtl" aria-labelledby="virtual-workshop-title">
    @if (OperatingSystem.IsBrowser())
    {
        <p>برای نواختن هنگ‌درام مجازی، به حالت آنلاین بروید.</p>
    }
    else
    {
        @if (_canUseSoundBank && _view == WorkshopView.Bank)
        {
            <button type="button" class="workshop-secondary" @onclick="ShowScales">بازگشت به اسکیل‌ها</button>
            <section class="workshop-card" aria-label="بانک صدای نت‌ها">
                <h2>بانک صدا</h2>
                <p>فا ۲ تا دو دیز ۶ · برای شنیدن صدا روی نت بزنید.</p>
                <div class="sound-bank" dir="ltr">
                    @foreach (var note in ScalePlayground.SoundBank)
                    {
                        <button type="button" class="sound-note" data-scale-pitch="@note">@note</button>
                    }
                </div>
            </section>
        }
        else if (_view != WorkshopView.Design || !_isAdministrator)
        {
            <section class="workshop-card workshop-presets" aria-label="اسکیل‌ها">
                <CompactPicker TValue="int" Title="انتخاب اسکیل" Options="PresetOptions" Searchable="true" disabled="@_addingPhoto" @bind-Value="_presetIndex" @bind-Value:after="ResetAlbumTarget" />
                @if (_presetIndex >= 0)
                {
                    var preset = VirtualScalePresets.All[_presetIndex];
                    <ScalePlaygroundEditor @key="_presetIndex" Photos="preset.CreateDiagram()" ReadOnly="true" />
                    @if (_isAdministrator)
                    {
                        <button type="button" class="workshop-action" @onclick="() => StartFromPresetAsync(_presetIndex)">طراحی از روی این اسکیل</button>
                    }
                }
                @if (_isAdministrator && _presetIndex >= 0 && _catalog.Count > 0)
                {
                    <details class="workshop-card workshop-album">
                        <summary>افزودن عکس به آلبوم اسکیل</summary>
                        <CompactPicker TValue="Guid" Title="انتخاب اسکیل مقصد" Options="AlbumOptions" Searchable="true"
                                       @bind-Value="_albumTarget" disabled="@_addingPhoto" />
                        <div class="workshop-photo-actions">
                            <button type="button" class="workshop-secondary" disabled="@(_albumTarget == Guid.Empty || _addingPhoto)"
                                    @onclick="() => AddPhotoToAlbumAsync(false)">افزودن عکس رو</button>
                            @if (VirtualScalePresets.All[_presetIndex].BottomImage.Length > 0)
                            {
                                <button type="button" class="workshop-secondary" disabled="@(_albumTarget == Guid.Empty || _addingPhoto)"
                                        @onclick="() => AddPhotoToAlbumAsync(true)">افزودن عکس زیر</button>
                            }
                        </div>
                    </details>
                }
                @if (_albumMessage is not null)
                {
                    <p role="status">@_albumMessage</p>
                }
                @if (_canUseSoundBank)
                {
                    <div class="workshop-bank-row">
                        <button type="button" class="workshop-bank-button" @onclick="() => _view = WorkshopView.Bank">بانک صدا</button>
                        <span class="workshop-wave" aria-hidden="true">▂▄▆▃▅█▅▃▆▄▂</span>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="workshop-card">
                <button type="button" class="workshop-secondary" disabled="@(_editing || _loading)" @onclick="ShowScales">بازگشت به اسکیل‌ها</button>
                <h2>طراحی اسکیل</h2>
                @if (_error is not null)
                {
                    <p role="alert">@_error</p>
                }
                <CompactPicker TValue="string" Title="انتخاب مبنای طرح" Options="DesignOptions"
                               Value="@_selection" ValueChanged="SelectAsync" ValueExpression="() => _selection"
                               disabled="@(_loading || _editing)" />
                @if (!_loading)
                {
                    <label>نام طرح
                        <input class="form-control" maxlength="100" @bind="_name" @bind:event="oninput" />
                    </label>
                    <ScalePlaygroundEditor @key="_designId" Photos="_photos" PhotosChanged="value => _photos = value"
                                           EditingChanged="value => _editing = value" SaveDesign="SaveAsync" />
                }
            </section>
        }
    }
</section>

@code {
    private enum WorkshopView { Scales, Design, Bank }
    private WorkshopView _view;
    private bool _isAdministrator;
    private bool _canUseSoundBank;

    private void ShowScales() => _view = WorkshopView.Scales;
    private bool _loading = true, _editing;
    private int _presetIndex = VirtualScalePresets.All.ToList().FindIndex(preset => preset.Name == "D Minor / Kurd 10");
    private Guid _albumTarget;
    private bool _addingPhoto;
    private string? _albumMessage;

    private IReadOnlyList<(Guid Value, string Text)> AlbumOptions =>
        _catalog.OrderBy(scale => scale.Name).Select(scale => (scale.Id, scale.Name)).ToArray();

    private void ResetAlbumTarget() => _albumMessage = null;

    private async Task AddPhotoToAlbumAsync(bool bottom)
    {
        if (!_isAdministrator || _addingPhoto || _albumTarget == Guid.Empty || _presetIndex < 0) return;
        _addingPhoto = true;
        _albumMessage = null;
        try
        {
            var photos = VirtualScalePresets.All[_presetIndex].CreateDiagram();
            var image = await ReadPresetPhotoAsync(bottom ? photos.Bottom : photos.Top);
            if (image is null)
            {
                _albumMessage = "برای این سمت عکسی وجود ندارد.";
                return;
            }
            await ScaleService.AddAlbumImageAsync(_albumTarget, image);
            _albumMessage = "عکس به آلبوم اسکیل اضافه شد.";
        }
        catch (Exception ex) { _albumMessage = ex.Message; }
        finally { _addingPhoto = false; }
    }

    private static IReadOnlyList<(int Value, string Text)> PresetOptions { get; } =
        VirtualScalePresets.All.Select((preset, index) => (index, preset.Name)).ToArray();

    private IReadOnlyList<(string Value, string Text)> DesignOptions =>
        [("", "اسکیل جدید"), .. _designs.Select(design => ($"saved:{design.Id}", $"طرح کارگاه · {design.Name}")),
            .. _catalog.Select(scale => ($"catalog:{scale.Id}", $"اسکیل سامانه · {scale.Name}")),
            .. PresetDesignOption()];

    private IEnumerable<(string Value, string Text)> PresetDesignOption()
    {
        if (_selection.StartsWith("preset:", StringComparison.Ordinal))
            yield return (_selection, _presetName);
    }

    private string _presetName = "";

    private async Task StartFromPresetAsync(int index)
    {
        await SelectAsync($"preset:{index}");
        _view = WorkshopView.Design;
    }

    private string _selection = "", _name = "";
    private string? _error;
    private Guid _designId = Guid.NewGuid();
    private Guid? _sourceId;
    private ScalePhotoSources? _photos;
    private IReadOnlyList<TORSEPAN.Panel.Models.ScaleDto> _catalog = [];
    private List<VirtualScaleSummary> _designs = [];

    protected override async Task OnInitializedAsync()
    {
        if (OperatingSystem.IsBrowser()) return;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        _isAdministrator = user.IsInRole("Administrator");
        _canUseSoundBank = _isAdministrator || user.IsInRole("ProductionManager");
        if (!_isAdministrator) return;

        try
        {
            _catalog = await ScaleService.GetAsync();
            _designs = [.. await ScaleService.GetVirtualDesignsAsync()];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SelectAsync(string selected)
    {
        _loading = true;
        _error = null;
        try
        {
            var parts = selected.Split(':', 2);
            var id = parts.Length == 2 && Guid.TryParse(parts[1], out var parsed) ? parsed : Guid.Empty;
            ScalePhotoSources? photos = null;
            var name = "";
            if (parts[0] == "catalog")
            {
                name = _catalog.First(x => x.Id == id).Name;
                photos = await ScaleService.GetPlaygroundAsync(id);
                if (photos?.Playground is null)
                {
                    var preset = VirtualScalePresets.All.FirstOrDefault(item =>
                        item.Name.Equals(name, StringComparison.OrdinalIgnoreCase) ||
                        item.Name.Equals($"{name} 9", StringComparison.OrdinalIgnoreCase));
                    if (preset is not null)
                        photos = new(photos?.Top, photos?.Bottom, preset.CreateDiagram().Playground);
                }
            }
            else if (parts[0] == "saved")
            {
                name = _designs.First(x => x.Id == id).Name;
                photos = await ScaleService.GetVirtualDesignAsync(id);
            }
            else if (parts[0] == "preset")
            {
                var preset = VirtualScalePresets.All[int.Parse(parts[1])];
                name = _presetName = preset.Name;
                photos = preset.CreateDiagram();
            }
            _designId = parts[0] == "saved" ? id : Guid.NewGuid();
            _sourceId = parts[0] == "catalog" ? id : null;
            _photos = photos;
            _name = name;
            _selection = selected;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveAsync(SaveScalePlayground design)
    {
        var name = _name.Trim();
        if (name.Length is 0 or > 100)
            throw new InvalidOperationException("نام طرح را وارد کنید.");

        if (_selection.StartsWith("preset:", StringComparison.Ordinal))
        {
            design = design with
            {
                TopPhoto = design.TopPhoto ?? await ReadPresetPhotoAsync(_photos?.Top),
                BottomPhoto = design.BottomPhoto ?? await ReadPresetPhotoAsync(_photos?.Bottom)
            };
        }

        await ScaleService.SaveVirtualDesignAsync(_designId, new(name, design, _sourceId));
        _designs.RemoveAll(item => item.Id == _designId);
        _designs.Add(new(_designId, name));
        _selection = $"saved:{_designId}";
        _sourceId = null;
    }

    private async Task<byte[]?> ReadPresetPhotoAsync(string? source)
    {
        if (source is null || !source.StartsWith(VirtualScalePreset.ImageDirectory, StringComparison.Ordinal))
            return null;

        var file = Host.WebRootFileProvider.GetFileInfo(source.TrimStart('/'));
        await using var stream = file.CreateReadStream();
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }
}

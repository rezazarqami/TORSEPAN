@page "/users"

@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<PageHeader Title="Users"
            SubTitle="User Management">

    <Actions>

        <PrimaryButton Text="Users List"
                       OnClick="OpenUsers" />

        <PrimaryButton Text="New User"
                       OnClick="NewUser" />

    </Actions>

</PageHeader>

<div class="row g-4">

    <div class="col-md-4">

        <Card>

            <h4>Total Users</h4>

            <h2>1</h2>

        </Card>

    </div>

    <div class="col-md-4">

        <Card>

            <h4>Active Users</h4>

            <h2>1</h2>

        </Card>

    </div>

    <div class="col-md-4">

        <Card>

            <h4>Inactive Users</h4>

            <h2>0</h2>

        </Card>

    </div>

</div>

<Card Class="mt-4">

    <p>Select one of the actions above.</p>

</Card>

@code
{
    void OpenUsers()
    {
        Navigation.NavigateTo("/users/list");
    }

    void NewUser()
    {
        Navigation.NavigateTo("/users/new");
    }
}
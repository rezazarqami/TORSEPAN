@page "/users"
@attribute [Authorize(Roles = "Administrator,ProductionManager")]
@using Microsoft.AspNetCore.Authorization

@inject NavigationManager Navigation

<PageTitle>کاربران</PageTitle>
<div class="navy-management-page">


<PageHeader Title="کاربران"
            SubTitle="مدیریت کاربران و دسترسی‌ها">

    <Actions>

        <PrimaryButton Text="فهرست کاربران"
                       OnClick="OpenUsers" />

        <PrimaryButton Text="ثبت کاربر"
                       OnClick="NewUser" />

    </Actions>

</PageHeader>

<div class="row g-4">

    <div class="col-md-4">

        <Card>

            <h4>تعداد کاربران</h4>

            <h2>1</h2>

        </Card>

    </div>

    <div class="col-md-4">

        <Card>

            <h4>کاربران فعال</h4>

            <h2>1</h2>

        </Card>

    </div>

    <div class="col-md-4">

        <Card>

            <h4>کاربران غیرفعال</h4>

            <h2>0</h2>

        </Card>

    </div>

</div>

<Card Class="mt-4">

    <p>برای مدیریت اعضا یکی از گزینه‌های بالا را انتخاب کنید.</p>

</Card>


</div>

@code
{
    void OpenUsers()
    {
        Navigation.NavigateTo("/users/list");
    }

    void NewUser()
    {
        Navigation.NavigateTo("/users/new");
    }
}

@page "/production"

@using TORSEPAN.Panel.Models
@using TORSEPAN.Panel.Services.Api

@inject NavigationManager Navigation
@inject ProductionService ProductionService

<PageTitle>تولید</PageTitle>

<PageHeader Title="تولید"
            SubTitle="مدیریت خط تولید">

    <Actions>

        <PrimaryButton Text="صف تولید"
                       OnClick="OpenQueue" />

    </Actions>

</PageHeader>

@if (_loading)
{
    <div class="text-center mt-5">
        <div class="spinner-border"></div>
    </div>
}
else if (_dashboard is null)
{
    <EmptyState Title="اطلاعاتی وجود ندارد"
                Description="داشبورد تولید در دسترس نیست." />
}
else
{
    <div class="row g-3">

        <div class="col-md-3">
            <StatCard Title="کل کاسه‌ها"
                      Value="@_dashboard.TotalBowls.ToString()" />
        </div>

        <div class="col-md-3">
            <StatCard Title="کل اسمبلی"
                      Value="@_dashboard.TotalAssemblies.ToString()" />
        </div>

        <div class="col-md-3">
            <StatCard Title="کل هنگدرام"
                      Value="@_dashboard.TotalHandpans.ToString()" />
        </div>

        <div class="col-md-3">
            <StatCard Title="تکمیل شده"
                      Value="@_dashboard.Finished.ToString()" />
        </div>

    </div>
}

@code
{
    private bool _loading = true;

    private ProductionDashboardDto? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await ProductionService.GetDashboardAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenQueue()
    {
        Navigation.NavigateTo("/production/list");
    }
}